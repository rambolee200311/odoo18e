<?xml version="1.0" encoding="utf-8"?>
<templates>
<!-- 首页 - Inbound + Outbound -->
    <t t-name="stock_barcode_lite.Homepage">
        <div class="o_stock_barcode_lite_homepage">
            <div class="container-fluid py-2 o_stock_barcode_lite_homepage_content">

                <!-- Inbound -->
                <div class="section-header">
                    <h5 class="section-title">Inbound</h5>
                </div>
                <div class="row justify-content-center justify-content-lg-start g-3 g-md-4">
                    <!-- lg卡片宽度-->
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_inbound_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-in me-2"/>Full Pallet Putaway
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Receive pallets &amp; complete full pallet putaway operations.</p>
                                <button class="btn btn-primary mt-3" t-on-click="_onInboundClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_inbound_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-in me-2"/>Inbound Actual Pallet Binding
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Bind scanned products and serial numbers to actual inbound pallets.</p>
                                <button class="btn btn-primary mt-3" t-on-click="_onInboundBindClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_actual_inbound_confirmation_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-check-circle me-2"/>Actual Inbound Confirmation
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Confirm actual inbound time for confirmed orders.</p>
                                <button class="btn btn-secondary mt-3" t-on-click="_onActualInboundConfirmationClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Outbound -->
                <div class="section-header">
                    <h5 class="section-title">Outbound</h5>
                </div>
                <div class="row o_homepage_card_grid justify-content-center g-3 g-md-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_whole_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-out me-2"/>Full Pallet Pick
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Direct full pallet picking &amp; shipment for bulk orders.</p>
                                <button class="btn btn-success mt-3" t-on-click="_onOutboundWholeClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_break_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-out me-2"/>Break Bulk Pick
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Break pallets &amp; pick single items from mixed pallets.</p>
                                <button class="btn btn-success mt-3" t-on-click="_onOutboundBreakClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_pallet_binding_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-cubes me-2"/>Pallet Consolidation
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Group picked products onto an existing or newly generated pallet.</p>
                                <button class="btn btn-success mt-3" t-on-click="_onOutboundPalletBindingClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_pallet_binding_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-check-circle me-2"/>Actual Outbound Confirm
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Confirm actual outbound time for confirmed orders.</p>
                                <button class="btn btn-secondary mt-3" t-on-click="">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Internal Transfer -->
                <div class="section-header">
                    <h5 class="section-title">Internal Transfer</h5>
                </div>
                <div class="row justify-content-center justify-content-lg-start g-3 g-md-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm o_homepage_card o_internal_transfer_card">
                            <div class="card-header bg-light text-dark o_homepage_card_header">
                                <h3 class="mb-0">
                                    <i class="fa fa-arrows-alt me-2"/>Internal Transfer
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Move pallets between internal locations.</p>
                                <button class="btn btn-info mt-3" t-on-click="_onInternalTransferClick">
                                    <i class="fa fa-arrow-right me-2"/>Go
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
