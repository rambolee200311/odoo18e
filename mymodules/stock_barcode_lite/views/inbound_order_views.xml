<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chenyang_chemical_inbound_order_form_inherit" model="ir.ui.view">
        <field name="name">chenyang.chemical.inbound.order.form.inherit</field>
        <field name="model">world.depot.inbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//field[@name='inbound_order_product_ids']" position="before">
                <div class="mb-2">
                    <button name="action_open_inbound_product_import_wizard"
                            type="object"
                            string="Import Products"
                            class="btn btn-primary"
                            icon="fa-upload"
                            invisible="state != 'new'"/>
                </div>
            </xpath>
            <xpath expr="//button[@name='action_create_stock_picking']" position="after">
                <button name="action_sunrise_create_incoming_stock_picking"
                        type="object"
                        string="Sunrise Create Receipt"
                        class="oe_stat_button"
                        icon="fa-file-text"
                        />
            </xpath>
            <xpath expr="//field[@name='inbound_order_product_ids']/list/field[@name='pallet_no']" position="after">
                <field name="sunrise_pallet_no" optional="show"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sunrise Sync">
                    <group>
                        <group>
                            <field name="set_sunrise_inbound_sync" readonly="1"/>
                            <field name="set_sunrise_inbound_sync_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="sunrise_inbound_task_number" readonly="1"/>
                            <field name="sunrise_inbound_sync_error_msg" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_sync_u8c_inbound"
                                type="object"
                                string="Sync U8C Inbound"
                                class="btn btn-primary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

