<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunrise_inbound_pallet_summary_report_list" model="ir.ui.view">
        <field name="name">sunrise.inbound.pallet.summary.report.list</field>
        <field name="model">sunrise.inbound.pallet.summary.report</field>
        <field name="arch" type="xml">
            <list string="Inbound Pallet Summary Reports">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="location_scope"/>
                <field name="cprojectid"/>
                <field name="state"/>
                <field name="refreshed_by_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="refreshed_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_inbound_pallet_summary_report_form" model="ir.ui.view">
        <field name="name">sunrise.inbound.pallet.summary.report.form</field>
        <field name="model">sunrise.inbound.pallet.summary.report</field>
        <field name="arch" type="xml">
            <form string="Inbound Pallet Summary Report" duplicate="false">
                <header>
                    <button name="action_refresh_report" type="object" string="Refresh Report" class="oe_highlight"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                            <field name="location_scope"/>
                            <field name="cprojectid"/>
                        </group>
                        <group>
                            <field name="refreshed_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="refreshed_datetime" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inbound Summary">
                            <field name="inbound_summary_lines" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="report_id" column_invisible="True"/>
                                    <field name="first_inbound_date"/>
                                    <field name="inbound_order_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="cproject_ids"/>
                                    <field name="outbound_cproject_ids"/>
                                    <field name="opening_pallet_count" sum="Total"/>
                                    <field name="inbound_pallet_count" sum="Total"/>
                                    <field name="outbound_pallet_count" sum="Total"/>
                                    <field name="closing_pallet_count" sum="Total"/>
                                    <field name="closing_location_summary"/>
                                    <field name="remain_period_age_days" sum="Total"/>
                                    <field name="remain_total_age_days" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_inbound_pallet_summary_report_line_form" model="ir.ui.view">
        <field name="name">sunrise.inbound.pallet.summary.report.line.form</field>
        <field name="model">sunrise.inbound.pallet.summary.report.line</field>
        <field name="arch" type="xml">
            <form string="Inbound Pallet Summary" duplicate="false" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_id" invisible="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="first_inbound_date" readonly="1"/>
                            <field name="inbound_order_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="cproject_ids" readonly="1"/>
                            <field name="outbound_cproject_ids" readonly="1"/>
                            <field name="closing_location_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="opening_pallet_count" readonly="1"/>
                            <field name="inbound_pallet_count" readonly="1"/>
                            <field name="outbound_pallet_count" readonly="1"/>
                            <field name="closing_pallet_count" readonly="1"/>
                            <field name="remain_period_age_days" readonly="1"/>
                            <field name="remain_total_age_days" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outbound Details">
                            <field name="outbound_lines" readonly="1">
                                <list create="0" delete="0" edit="0" no_open="1">
                                    <field name="report_line_id" column_invisible="True"/>
                                    <field name="outbound_date"/>
                                    <field name="cproject_ids"/>
                                    <field name="outbound_cproject_ids"/>
                                    <field name="batch_names"/>
                                    <field name="pallet_count" sum="Total"/>
                                    <field name="stock_days" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sunrise_inbound_pallet_summary_report" model="ir.actions.act_window">
        <field name="name">Inbound Pallet Summary Report</field>
        <field name="res_model">sunrise.inbound.pallet.summary.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sunrise_inbound_pallet_summary_report_list"/>
    </record>
</odoo>
