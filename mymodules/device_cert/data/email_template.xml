<odoo>
    <record id="email_template_cert_guide" model="mail.template">
        <field name="name">Certificate Installation Guide</field>
        <field name="model_id" ref="device_cert.model_device_cert_bind"/>
        <field name="subject">Certificate for Device</field>
        <!-- <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.user_email }}</field> -->
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;">
                <p>Dear User,</p>
                
                <p>Your device access certificate has been successfully issued.</p>
                
                <!-- 证书详情 -->
                <h3>Certificate Details</h3>
                <ul>
                    <li><strong>File Name:</strong> <t t-out="object.cert_filename or 'certificate.p12'"/></li>
                    <li><strong>Device ID:</strong> <t t-out="object.device_id or 'First Binding Device'"/></li>
                    <li><strong>Serial Number:</strong> <t t-out="object.cert_serial or ''"/></li>
                    <li><strong>Issued On:</strong> 
                        <t t-if="object.create_date">
                            <t t-out="object.create_date.strftime('%Y-%m-%d %H:%M')"/>
                        </t>
                    </li>
                </ul>
                
                <!-- 条件显示密码 -->
                <h3>Certificate Password</h3>
                <div style="background: #f8f9fa; padding: 12px; border-radius: 4px;">
                    <t t-if="object.password_encrypted">
                        <t t-out="object._decrypt_password(object.password_encrypted) or '[Password decryption failed]'"/>
                    </t>
                    <t t-else="">
                        [No password set in system]
                    </t>
                </div>
                
                <!-- 页脚 -->
                <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
                    <t t-if="user.company_id.logo">
                        <img t-att-src="'data:image/png;base64,' + user.company_id.logo"
                            style="height: 48px; margin-right: 10px;"/>
                    </t>
                    <strong><t t-out="user.company_id.name or 'IT Security Team'"/></strong>
                </div>
            </div>
        </field>
    </record>
</odoo>