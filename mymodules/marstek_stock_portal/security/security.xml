            <field name="domain_force">[('inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_inbound_order_products_pallet_portal" model="ir.rule">
