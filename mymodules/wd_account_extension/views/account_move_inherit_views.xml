<odoo>
    <record id="account_move_form_inherit_bank_proof" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bank.proof</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="payment_info_synced" invisible="1"/>
                <field name="bank_proof_attachment_ids" widget="many2many_binary" string="Bank Proof (Water Slip)" readonly="payment_info_synced" invisible="move_type != 'in_invoice'"/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_inherit_charge_item" model="ir.ui.view">
        <field name="name">account.move.form.inherit.charge.item</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="charge_item_id" optional="show" readonly="parent.state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
