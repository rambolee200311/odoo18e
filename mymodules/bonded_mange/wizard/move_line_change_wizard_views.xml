<odoo>
    <record id="view_stock_move_line_bulk_customs_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.line.bulk.customs.wizard.form</field>
        <field name="model">stock.move.line.bulk.customs.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Edit Customs Status" duplicate="0">
                <sheet>
                    <group>
                        <field name="query_type" required="1"/>
                        <field name="mrn_id" invisible="query_type != 'mrn'" options="{'no_create': True, 'no_open': True}"/>
                        <field name="unique_identifier" invisible="query_type != 'unique_identifier'"/>
                        <button name="actionSearchInbound" type="object" string="Search" class="btn-secondary"/>
                        <field name="candidate_inbound_ids" invisible="1"/>
                        <field name="target_inbound_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Search Result">
                        <field name="preview_line_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="inbound_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="billno"/>
                                <field name="mrn_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="unique_identifier"/>
                                <field name="state"/>
                                <field name="customs_status"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="customs_status" required="1"/>
                        <field name="change_reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="actionApplyBulkCustoms" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stock_move_line_bulk_t1_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.line.bulk.t1.wizard.form</field>
        <field name="model">stock.move.line.bulk.t1.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Edit T1 Info" duplicate="0">
                <sheet>
                    <group>
                        <field name="query_type" required="1"/>
                        <field name="mrn_id" invisible="query_type != 'mrn'" options="{'no_create': True, 'no_open': True}"/>
                        <field name="unique_identifier" invisible="query_type != 'unique_identifier'"/>
                        <button name="actionSearchInbound" type="object" string="Search" class="btn-secondary"/>
                        <field name="candidate_inbound_ids" invisible="1"/>
                        <field name="target_inbound_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Search Result">
                        <field name="preview_line_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="inbound_id" options="{'no_create': True, 'no_open': True}"/>

                                <field name="mrn_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="unique_identifier"/>
                                <field name="state"/>
                                <field name="t1_document_number"/>
                                <field name="t1_status"/>
                                <field name="t1_closed_date"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="t1_document_number"/>
                        <field name="t1_status" required="1"/>
                        <field name="t1_closed_date" readonly="t1_status != 'closed'" required="t1_status == 'closed'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="actionApplyBulkT1" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
