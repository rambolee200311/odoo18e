<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_outbound_palletization_list" model="ir.ui.view">
        <field name="name">wd.vas.outbound.palletization.list</field>
        <field name="model">wd.vas.outbound.palletization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vas_order_id"/>
                <field name="state"/>
                <field name="started_by_id"/>
                <field name="started_at"/>
                <field name="validated_by_id"/>
                <field name="validated_at"/>
            </list>
        </field>
    </record>
    <record id="view_vas_outbound_palletization_form" model="ir.ui.view">
        <field name="name">wd.vas.outbound.palletization.form</field>
        <field name="model">wd.vas.outbound.palletization</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_validate_palletization" type="object" string="Validate Palletization" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_reset_palletization" type="object" string="Reset Palletization" invisible="state not in ('pending', 'in_progress')"/>
                    <button name="action_cancel_palletization" type="object" string="Cancel Palletization" invisible="state in ('validated', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,validated,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="vas_order_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="picking_ids" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="started_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="started_at" readonly="1"/>
                            <field name="validated_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="validated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transport Pallets">
                            <field name="transport_pallet_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="name" readonly="1"/>
                                    <field name="barcode" readonly="1"/>
                                    <field name="reference" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Palletization Lines">
                            <field name="palletization_lines" readonly="state not in ('pending', 'in_progress')">
                                <list editable="bottom">
                                    <field name="source_move_line_id" readonly="id" domain="[('picking_id', 'in', parent.picking_ids), ('state', '!=', 'cancel'), ('quantity', '>', 0)]" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="source_package_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="quantity"/>
                                    <field name="destination_package_id" domain="['|', ('vas_outbound_palletization_id', '=', parent.id), ('id', '=', source_package_id)]" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="handling_type"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vas_outbound_palletization" model="ir.actions.act_window">
        <field name="name">VAS Outbound Palletization</field>
        <field name="res_model">wd.vas.outbound.palletization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
