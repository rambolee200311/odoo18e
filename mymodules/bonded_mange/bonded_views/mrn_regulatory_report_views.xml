<odoo>
    <record id="view_bonded_mrn_regulatory_report_list" model="ir.ui.view">
        <field name="name">bonded.mrn.regulatory.report.list</field>
        <field name="model">bonded.mrn.regulatory.report</field>
        <field name="arch" type="xml">
            <list default_order="change_time desc,id desc" create="0" edit="0" delete="0" duplicate="0">
                <field name="record_type" optional="show"/>
                <field name="mrn_id" optional="show" readonly="1"/>
                <field name="product_code" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="customs_status" widget="badge" optional="show"/>
                <field name="mrn_status" widget="badge" optional="show"/>
                <field name="inbound_no" optional="show"/>
                <field name="outbound_no" optional="show"/>
                <field name="t1_document_number" optional="show"/>
                <field name="t1_status" widget="badge" optional="show"/>
                <field name="t1_closed_date" optional="show"/>
                <field name="stock_qty" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="change_time" optional="show"/>
                <field name="remark" optional="show"/>
                <button name="action_open_source" type="object" string="Open Source" class="btn-link"
                        icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_bonded_mrn_regulatory_report_form" model="ir.ui.view">
        <field name="name">bonded.mrn.regulatory.report.form</field>
        <field name="model">bonded.mrn.regulatory.report</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="record_type" readonly="1"/>
                            <field name="mrn_id" readonly="1"/>
                            <field name="product_code" readonly="1"/>
                            <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="customs_status" readonly="1"/>
                            <field name="mrn_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="inbound_no" readonly="1"/>
                            <field name="outbound_no" readonly="1"/>
                            <field name="stock_qty" readonly="1"/>
                            <field name="user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="change_time" readonly="1"/>
                            <field name="remark" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="source_model" readonly="1"/>
                        <field name="source_res_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bonded_mrn_regulatory_report_search" model="ir.ui.view">
        <field name="name">bonded.mrn.regulatory.report.search</field>
        <field name="model">bonded.mrn.regulatory.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="mrn_id" readonly="1"/>
                <field name="product_code"/>
                <field name="product_id"/>
                <field name="customs_status"/>
                <field name="mrn_status"/>
                <field name="inbound_no"/>
                <field name="outbound_no"/>
                <field name="change_time"/>
                <field name="user_id"/>
                <field name="t1_document_number"/>
                <field name="t1_status"/>
                <field name="t1_closed_date"/>
                <filter name="flow_only" string="Flow" domain="[('record_type','=','flow')]"/>
                <filter name="log_only" string="Log" domain="[('record_type','=','log')]"/>
                <group expand="0" string="Group By">
                    <filter string="MRN" name="group_by_mrn_id" context="{'group_by':'mrn_id'}"/>
                    <filter string="Customs Status" name="group_by_customs_status"
                            context="{'group_by':'customs_status'}"/>
                    <filter string="MRN Status" name="group_by_mrn_status" context="{'group_by':'mrn_status'}"/>
                    <filter string="Inbound No" name="group_by_inbound_no" context="{'group_by':'inbound_no'}"/>
                    <filter string="Outbound No" name="group_by_outbound_no" context="{'group_by':'outbound_no'}"/>
                    <filter string="Operator" name="group_by_user_id" context="{'group_by':'user_id'}"/>
                    <filter string="T1 Status" name="group_by_t1_status" domain="[]"
                            context="{'group_by':'t1_status'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_bonded_mrn_regulatory_report" model="ir.actions.act_window">
        <field name="name">MRN Customs Supervision Inquiry Report</field>
        <field name="res_model">bonded.mrn.regulatory.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_mange.view_bonded_mrn_regulatory_report_search"/>
    </record>

