<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 每日库存快照 -->
        <record id="cron_bonded_daily_snapshot" model="ir.cron">
            <field name="name">Bonded Stock Daily Snapshot</field>
            <field name="model_id" ref="model_bonded_stock_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_snapshot()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-06-30 23:59:00</field>
        </record>

        <!-- 月度库存报告 -->
        <record id="cron_bonded_monthly_report" model="ir.cron">
            <field name="name">Bonded Monthly Stock Report</field>
            <field name="model_id" ref="model_bonded_monthly_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall">2026-07-01 00:00:00</field>
        </record>

        <!-- T1超时监控 -->
        <record id="cron_bonded_t1_monitor" model="ir.cron">
            <field name="name">T1 Transit Deadline Monitor</field>
            <field name="model_id" ref="model_bonded_customs_file"/>
            <field name="state">code</field>
            <field name="code">model._cron_monitor_t1_deadlines()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="nextcall">2026-06-30 06:00:00</field>
        </record>
    </data>
</odoo>