    <menuitem id="menu_gate_arrival" name="Gate Arrivals" parent="menu_bonded_operations" action="action_gate_arrival" sequence="10"/>
    <menuitem id="menu_bonded_inbound" name="Bonded Inbound" parent="menu_bonded_operations" action="action_bonded_inbound" sequence="20"/>
    <menuitem id="menu_bonded_outbound" name="Bonded Outbound" parent="menu_bonded_operations" action="action_bonded_outbound" sequence="30"/>
    <menuitem id="menu_bonded_stock" name="Bonded Stock" parent="menu_bonded_root" sequence="40"/>
    <menuitem id="menu_bonded_stock_all" name="All Bonded Stock" parent="menu_bonded_stock" action="action_bonded_stock" sequence="10"/>
    <menuitem id="menu_bonded_verification" name="Verifications" parent="menu_bonded_stock" action="action_bonded_verification" sequence="20"/>
