<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_s3_permission_list" model="ir.ui.view">
        <field name="name">s3.permission.list</field>
        <field name="model">s3.permission</field>
        <field name="arch" type="xml">
            <list>
                <field name="node_id"/>
                <field name="grantee_type"/>
                <field name="user_id"/>
                <field name="group_id"/>
                <field name="department_id"/>
                <field name="permission_level"/>
                <field name="granted_by_id"/>
                <field name="granted_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_s3_permission_form" model="ir.ui.view">
        <field name="name">s3.permission.form</field>
        <field name="model">s3.permission</field>
        <field name="arch" type="xml">
            <form string="Cloud Permission" duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="node_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="grantee_type" required="1"/>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="grantee_type != 'user'"/>
                            <field name="group_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="grantee_type != 'group'"/>
                            <field name="department_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   required="grantee_type == 'department'"
                                   invisible="grantee_type != 'department'"/>

                            <field name="permission_level" required="1"/>
                            <field name="granted_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="granted_datetime" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>