<?xml version="1.0" encoding="utf-8"?>
<templates>
<!-- 首页 - 两个菜单块 -->
    <t t-name="stock_barcode_lite.Homepage">
        <div class="o_stock_barcode_lite_homepage">
            <div class="container-fluid py-4">
                <div class="text-center mb-4">
                    <h1 class="display-6">Stock Barcode Lite</h1>
                    <p class="text-muted">Select a workflow to continue</p>
                </div>
                <div class="row justify-content-center g-4">
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_inbound_card" t-on-click="_onInboundClick">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-in me-2"/>Full Pallet Putaway
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Receive pallets &amp; complete full pallet putaway operations.</p>
                                <button class="btn btn-primary mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Inbound (Full Pallet Putaway)
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_card" t-on-click="_onOutboundClick">
                            <div class="card-header bg-success text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-out me-2"/>Outbound
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Manage outbound orders and product exports.</p>
                                <button class="btn btn-success mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Outbound
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>