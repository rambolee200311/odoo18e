<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_eori_entity_view_list" model="ir.ui.view">
        <field name="name">bonded.eori.entity.list</field>
        <field name="model">bonded.eori.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="eori_no"/>
                <field name="country_id"/>
                <field name="eori_valid_until"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="bonded_eori_entity_view_form" model="ir.ui.view">
        <field name="name">bonded.eori.entity.form</field>
        <field name="model">bonded.eori.entity</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="partner_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="eori_no" required="1"/>
                            <field name="country_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group>
                            <field name="customs_office_code"/>
                            <field name="eori_valid_until"/>
                            <field name="state" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Authorizations">
                            <field name="customs_authorization_lines">
                                <list editable="bottom">
                                    <field name="auth_type"/>
                                    <field name="auth_no"/>
                                    <field name="valid_from"/>
                                    <field name="valid_until"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bonded_eori_entity_view_search" model="ir.ui.view">
        <field name="name">bonded.eori.entity.search</field>
        <field name="model">bonded.eori.entity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="eori_no"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_partner" string="Partner" context="{'group_by':'partner_id'}"/>
                    <filter name="by_country" string="Country" context="{'group_by':'country_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
