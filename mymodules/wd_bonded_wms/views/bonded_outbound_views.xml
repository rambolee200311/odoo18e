<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_outbound_view_tree" model="ir.ui.view">
        <field name="name">bonded.outbound.tree</field>
        <field name="model">bonded.outbound</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_type"/>
                <field name="order_date"/>
                <field name="reference"/>
                <field name="bonded_book_id"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="outbound_nature"/>
                <field name="is_dangerous" widget="boolean_toggle"/>
                <field name="mrn"/>
                <field name="expected_date"/>
                <field name="total_value" widget="monetary"/>
                <field name="state"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <record id="bonded_outbound_view_form" model="ir.ui.view">
        <field name="name">bonded.outbound.form</field>
        <field name="model">bonded.outbound</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed', 'declared')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,declared,released,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_outbound_customs_file" string="Create T1 Outbound" type="object" context="{'default_declaration_type': 't1_out'}" invisible="state not in ('confirmed', 'declared') or outbound_nature != 'bonded'" class="btn-primary"/>
                    <button name="action_create_outbound_customs_file" string="Create Clearance Outbound" type="object" context="{'default_declaration_type': 'clearance_out'}" invisible="state not in ('confirmed', 'declared') or outbound_nature != 'non_bonded'" class="btn-primary"/>
                        <button name="action_create_picking" string="Create Stock Picking" type="object" invisible="state != 'released'" class="oe_stat_button" icon="fa-file-text"/>
                    </div>
                    <group>
                        <group string="Outbound Info">
                            <field name="name" readonly="1"/>
                            <field name="order_type" required="1" readonly="state != 'draft'"/>
                            <field name="order_date" required="1" readonly="state != 'draft'"/>
                            <field name="reference" required="1" readonly="state != 'draft'"/>
                            <field name="bonded_book_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="owner_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="outbound_nature" required="1" readonly="state != 'draft'"/>
                            <field name="is_dangerous" readonly="state != 'draft'"/>
                            <field name="warehouse" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="warehouse_address" readonly="1"/>
                            <field name="pick_type" readonly="state != 'draft'" domain="[('code', 'in', ['outgoing', 'internal']), ('warehouse_id', '=', warehouse)]" options="{'no_create': True, 'no_open': False}"/>
<!--                            <field name="outbound_scan_mode" required="1" readonly="state != 'draft'" invisible="project_id == False"/>-->
                        </group>
                        <group string="Schedule">
                            <field name="expected_date" string="Planned Date" required="1" readonly="state != 'draft'"/>
                            <field name="total_value" readonly="1" widget="monetary"/>
                        </group>
                        <group string="Customs Status">
                            <field name="mrn_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="t1_status" readonly="1"/>
                            <field name="t1_closed_date" readonly="1"/>
                            <field name="mrn_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Remarks and Confirmation">
                        <field name="remark" readonly="state != 'draft'"/>
                        <field name="remark1" readonly="state != 'draft'"/>
                        <field name="confirm_user_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                        <field name="confirm_time_user_tz" readonly="1"/>
                        <field name="confirm_time_server" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="eligible_bonded_product_ids" column_invisible="1"/>
                                    <field name="bonded_product_id" domain="[('id', 'in', eligible_bonded_product_ids)]" required="1" readonly="parent.state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="bonded_stock_id"
                                           string="Unique Identifier No."
                                           required="1"
                                           readonly="parent.state != 'draft'"
                                           options="{'no_create': True, 'no_open': False}"
                                           context="{'outbound_show_tracking_only': 1, 'list_view_ref': 'wd_bonded_wms.view_bonded_stock_m2o_tracking_list'}"
                                           domain="[('bonded_book_id', '=', parent.bonded_book_id), ('product_id', '=', product_id),
                                                    ('quantity', '>', 0),
                                                    ('locked', '=', False),
                                                    ('current_customs_status', '=', 'entrepot'),
                                                    ('inbound_id.state', '=', 'done'),
                                                    ('inbound_id.picking_id.state', '=', 'done')]"/>
                                    <field name="inbound_tracking_no" column_invisible="1"/>
                                    <field name="customer_batch_no" readonly="1"/>
                                    <field name="demand_qty"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="declared_unit_price" required="1" widget="monetary"/>
                                    <field name="subtotal_value" readonly="1" widget="monetary"/>
                                    <field name="done_qty"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customs Declarations">
                            <field name="customs_file_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="declaration_no"/>
                                    <field name="declaration_type"/>
                                    <field name="mrn_id"/>
                                    <field name="declaration_date"/>
                                    <field name="invoice_amount" widget="monetary"/>
                                    <field name="state"/>
                                    <field name="approval_no"/>
                                    <field name="t1_closed_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
