<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_customs_authorization_view_list" model="ir.ui.view">
        <field name="name">bonded.customs.authorization.list</field>
        <field name="model">bonded.customs.authorization</field>
        <field name="arch" type="xml">
            <list>
                <field name="eori_entity_id"/>
                <field name="auth_type"/>
                <field name="auth_no"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="bonded_customs_authorization_view_form" model="ir.ui.view">
        <field name="name">bonded.customs.authorization.form</field>
        <field name="model">bonded.customs.authorization</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <sheet>
                    <group>
                        <group>
                            <field name="eori_entity_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="auth_type" required="1"/>
                            <field name="auth_no" required="1"/>
                            <field name="state" required="1"/>
                        </group>
                        <group>
                            <field name="valid_from" required="1"/>
                            <field name="valid_until" required="1"/>
                            <field name="certificate_file" filename="certificate_filename"/>
                            <field name="certificate_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="remark"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
