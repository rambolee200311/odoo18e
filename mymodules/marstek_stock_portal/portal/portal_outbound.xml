<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================== -->
    <!-- 5. 出库查询列表页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_outbounds" name="Outbound Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek 库存'}, {'url': None, 'name': '出库单查询'}]"/>

            <div class="o_portal_content">
                <!-- 筛选表单 - 可折叠 -->
                <div class="card mb-4" id="outbound_filter_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-filter me-2"/>
                            出库单查询
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#outbound_filter_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="outbound_filter_collapse" class="collapse show">
                    <div class="card-body">
                        <form action="/my/marstek/outbounds" method="get" class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="outbound_no" class="form-label">出库单号/客户参考号</label>
                                <input type="text" class="form-control" id="outbound_no" name="outbound_no" t-attf-value="#{filters.get('outbound_no', '')}" placeholder="请输入出库单号或参考号"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="bl_no" class="form-label">提单号</label>
                                <input type="text" class="form-control" id="bl_no" name="bl_no" t-attf-value="#{filters.get('bl_no', '')}" placeholder="请输入提单号"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="container_no" class="form-label">柜号</label>
                                <input type="text" class="form-control" id="container_no" name="container_no" t-attf-value="#{filters.get('container_no', '')}" placeholder="请输入柜号"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="portal_outbound_status" class="form-label">状态</label>
                                <select class="form-select" id="portal_outbound_status" name="portal_outbound_status">
                                    <option value="">全部</option>
                                    <option value="outbound_confirmed" t-att-selected="'selected' if filters.get('portal_outbound_status') == 'outbound_confirmed' else None">已确认</option>
                                    <option value="outbound_picking_processing" t-att-selected="'selected' if filters.get('portal_outbound_status') == 'outbound_picking_processing' else None">拣货中</option>
                                    <option value="outbound_picking_done" t-att-selected="'selected' if filters.get('portal_outbound_status') == 'outbound_picking_done' else None">拣货完成</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="outbound_date_from" class="form-label">开始日期</label>
                                <input type="date" class="form-control" id="outbound_date_from" name="outbound_date_from" t-attf-value="#{filters.get('outbound_date_from', '')}"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="outbound_date_to" class="form-label">结束日期</label>
                                <input type="date" class="form-control" id="outbound_date_to" name="outbound_date_to" t-attf-value="#{filters.get('outbound_date_to', '')}"/>
                            </div>
                            <div class="col-12 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fa fa-search me-1"/>
                                    查询
                                </button>
                                <a href="/my/marstek/outbounds" class="btn btn-secondary">
                                    <i class="fa fa-refresh me-1"/>
                                    重置
                                </a>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <!-- 数据表格 - 可折叠 -->
                <div class="card" id="outbound_table_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">出库单列表</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary me-3">共 <t t-esc="pager.get('total', 0)"/> 条</span>
                            <!-- 导出按钮 -->
                            <a t-attf-href="/my/marstek/export/outbounds/csv?outbound_no=#{filters.get('outbound_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;container_no=#{filters.get('container_no', '')}&amp;portal_outbound_status=#{filters.get('portal_outbound_status', '')}&amp;outbound_date_from=#{filters.get('outbound_date_from', '')}&amp;outbound_date_to=#{filters.get('outbound_date_to', '')}"
                               t-attf-class="btn btn-primary #{'disabled' if not rows else ''}"
                               t-attf-title="#{'暂无可导出数据' if not rows else '导出 CSV'}">
                                <i class="fa fa-file-text-o me-1"/>
                                导出 CSV
                            </a>
                            <a t-attf-href="/my/marstek/export/outbounds/pdf?outbound_no=#{filters.get('outbound_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;container_no=#{filters.get('container_no', '')}&amp;portal_outbound_status=#{filters.get('portal_outbound_status', '')}&amp;outbound_date_from=#{filters.get('outbound_date_from', '')}&amp;outbound_date_to=#{filters.get('outbound_date_to', '')}"
                               t-attf-class="btn btn-primary #{'disabled' if not rows else ''}"
                               t-attf-title="#{'暂无可导出数据' if not rows else '导出 PDF'}">
                                <i class="fa fa-file-pdf-o me-1"/>
                                导出 PDF
                            </a>
                            <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#outbound_table_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                    </div>
                    <div id="outbound_table_collapse" class="collapse show">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>出库单号</th>
                                            <th>提单号</th>
                                            <th>柜号</th>
                                            <th>出库日期</th>
                                            <th>状态</th>
                                            <th class="text-end">总数量</th>
                                            <th>拣货单号</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="row">
                                            <tr>
                                                <td>
                                                    <a t-if="row.get('outbound_id')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/outbounds/#{row.get('outbound_id')}">
                                                        <t t-esc="row.get('outbound_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('outbound_no', '')"/></t>
                                                </td>
                                                <td><t t-esc="row.get('bl_no', '')"/></td>
                                                <td><t t-esc="row.get('container_no', '')"/></td>
                                                <td><t t-esc="row.get('outbound_date', '')"/></td>
                                                <td>
                                                    <t t-if="row.get('portal_outbound_status') == 'outbound_confirmed'">
                                                        <span class="badge bg-info">已确认</span>
                                                    </t>
                                                    <t t-elif="row.get('portal_outbound_status') == 'outbound_picking_processing'">
                                                        <span class="badge bg-warning">拣货中</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-success">拣货完成</span>
                                                    </t>
                                                </td>
                                                <td class="text-end"><t t-esc="row.get('total_quantity', 0)"/></td>
                                                <td><t t-esc="row.get('picking_no', '')"/></td>
                                                <td>
                                                    <a t-attf-href="/my/marstek/outbounds/#{row.get('outbound_id')}" class="btn btn-sm btn-outline-primary">
                                                        查看详情
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="not rows">
                                            <tr>
                                                <td colspan="8" class="text-center text-muted py-4">暂无数据</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div t-if="pager.get('page_count', 1) > 1" class="card-footer">
                            <t t-call="portal.pager"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 6. 出库详情页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_outbound_detail" name="Outbound Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek 库存'}, {'url': '/my/marstek/outbounds', 'name': '出库单查询'}, {'url': None, 'name': '出库详情'}]"/>

            <div class="o_portal_content">
                <!-- 出库单信息 - 可折叠 -->
                <div class="card mb-4" id="outbound_order_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-file-text-o me-2"/>
                            出库单信息
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#outbound_order_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <!-- 始终显示的基础信息 -->
                    <div class="card-body pt-3 pb-2 border-bottom bg-light">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">出库单号</strong>
                                <div class="fw-bold"><t t-esc="order.billno if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">客户参考号</strong>
                                <div><t t-esc="order.reference if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">出库日期</strong>
                                <div><t t-esc="order.o_date if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">状态</strong>
                                <div>
                                    <t t-if="order and order.state == 'confirm'">
                                        <span class="badge bg-info">已确认</span>
                                    </t>
                                    <t t-elif="order and order.state == 'cancel'">
                                        <span class="badge bg-danger">已取消</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-secondary">新建</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- 可折叠的详细信息 -->
                    <div id="outbound_order_collapse" class="collapse show">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <strong>装运参考号:</strong>
                                    <span class="ms-2"><t t-esc="order.load_ref if order else ''"/></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>装运日期:</strong>
                                    <span class="ms-2"><t t-esc="order.load_date if order else ''"/></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>拣货单号:</strong>
                                    <span class="ms-2"><t t-esc="order.picking_PICK.name if order and order.picking_PICK else ''"/></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>出库单号:</strong>
                                    <span class="ms-2"><t t-esc="order.picking_Out.name if order and order.picking_Out else ''"/></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>收货公司:</strong>
                                    <span class="ms-2"><t t-esc="order.unload_company.name if order and order.unload_company else ''"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 出库明细 - 可折叠 -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fa fa-list me-2"/>
                            出库明细
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <t t-if="detail_pager and detail_pager.get('page_count', 1) > 1">
                                <span class="badge bg-secondary">共 <t t-esc="detail_pager.get('total', 0)"/> 条</span>
                            </t>
                            <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#outbound_detail_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                    </div>
                    <div id="outbound_detail_collapse" class="collapse show">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>出库单号</th>
                                            <th>提单号</th>
                                            <th>柜号</th>
                                            <th>托盘号</th>
                                            <th>产品编码</th>
                                            <th>产品名称</th>
                                            <th class="text-end">数量</th>
                                            <th>SN序列号</th>
                                            <th>扫描时间</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="detail_rows" t-as="row">
                                            <tr>
                                                <td>
                                                    <a t-if="row.get('outbound_id')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/outbounds/#{row.get('outbound_id')}">
                                                        <t t-esc="row.get('outbound_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('outbound_no', '')"/></t>
                                                </td>
                                                <td><t t-esc="row.get('bl_no', '')"/></td>
                                                <td><t t-esc="row.get('container_no', '')"/></td>
                                                <td><t t-esc="row.get('package_name', '')"/></td>
                                                <td><t t-esc="row.get('product_code', '')"/></td>
                                                <td><t t-esc="row.get('product_name', '')"/></td>
                                                <td class="text-end"><t t-esc="row.get('quantity', 0)"/></td>
                                                <td><t t-esc="row.get('sn_code', '')"/></td>
                                                <td><t t-esc="row.get('scan_time', '')"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="not detail_rows">
                                            <tr>
                                                <td colspan="9" class="text-center text-muted py-4">暂无数据</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div t-if="detail_pager and detail_pager.get('page_count', 1) > 1" class="card-footer">
                            <t t-call="portal.pager">
                                <t t-set="pager" t-value="detail_pager"/>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- 附件列表 - 可折叠 -->
                <t t-if="attachment_rows">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0 d-inline">
                                <i class="fa fa-paperclip me-2"/>
                                附件列表
                            </h5>
                            <button class="btn btn-link text-decoration-none float-end p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#outbound_attachment_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                        <div id="outbound_attachment_collapse" class="collapse show">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>文件名</th>
                                                <th>类型</th>
                                                <th>大小</th>
                                                <th class="text-center">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="attachment_rows" t-as="att">
                                                <tr>
                                                    <td><t t-esc="att.get('file_name', '')"/></td>
                                                    <td><t t-esc="att.get('file_type', '')"/></td>
                                                    <td><t t-esc="att.get('file_size', 0)"/> bytes</td>
                                                    <td class="text-center">
                                                        <a t-if="att.get('download_url')" t-attf-href="#{att.get('download_url')}" class="btn btn-sm btn-primary" target="_blank">
                                                            <i class="fa fa-download me-1"/>
                                                            下载
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- 返回按钮 -->
                <div class="mt-4">
                    <a href="/my/marstek/outbounds" class="btn btn-secondary">
                        <i class="fa fa-arrow-left me-1"/>
                        返回列表
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
