<odoo>
    <record id="view_bonded_identifier_stock_ledger_list" model="ir.ui.view">
        <field name="name">bonded.identifier.stock.ledger.list</field>
        <field name="model">bonded.identifier.stock.ledger</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <!--                <field name="company_id" optional="show"/>-->
                <field name="unique_identifier" optional="show"/>
                <field name="file_identifier" optional="show"/>
                <field name="mrn_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="package_id" optional="show"/>
                <field name="owner_id" optional="show"/>
                <field name="qty_on_hand" optional="show"/>
                <field name="customs_status" readonly="1"/>
                <field name="bonded_flag" optional="show"/>
                <field name="inbound_order_no" optional="show"/>
                <field name="outbound_order_no" optional="show"/>
                <field name="qty_inbound" optional="show"/>
                <field name="qty_outbound" optional="show"/>
                <field name="last_time" optional="show"/>
                <!--                <field name="last_move_line_id" optional="show"/>-->
                <field name="remark" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bonded_identifier_stock_ledger_form" model="ir.ui.view">
        <field name="name">bonded.identifier.stock.ledger.form</field>
        <field name="model">bonded.identifier.stock.ledger</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="1" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <!--                            <field name="company_id" readonly="1"/>-->
                            <field name="unique_identifier" readonly="1"/>
                            <field name="file_identifier" readonly="1"/>
                            <field name="mrn_id" readonly="1"/>
                            <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_model" optional="show"/>
                            <field name="flow_quantity" optional="show"/>
                            <field name="product_weight" optional="show"/>
                            <field name="flow_total_weight" optional="show"/>
                            <field name="location_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="package_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="owner_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="qty_on_hand" readonly="1"/>
                            <field name="qty_inbound" readonly="1"/>
                            <field name="qty_outbound" readonly="1"/>
                            <field name="last_time" readonly="1"/>
                            <field name="customs_status" readonly="1"/>
                            <field name="bonded_flag" optional="show"/>
                            <field name="inbound_order_no" optional="show"/>
                            <field name="outbound_order_no" optional="show"/>
                            <!--                            <field name="last_move_line_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
                            <!--                            <field name="last_picking_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="bucket_key" readonly="1"/>
                        <field name="remark" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bonded_identifier_stock_ledger_search" model="ir.ui.view">
        <field name="name">bonded.identifier.stock.ledger.search</field>
        <field name="model">bonded.identifier.stock.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="unique_identifier"/>
                <field name="file_identifier"/>
                <field name="mrn_id"/>
                <field name="product_id"/>
                <field name="product_model" optional="show"/>
                <field name="flow_quantity" optional="show"/>
                <field name="product_weight" optional="show"/>
                <field name="flow_total_weight" optional="show"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <filter name="has_unique_identifier" string="Has Unique Identifier"
                        domain="[('unique_identifier', '!=', False)]"/>
                <filter name="has_file_identifier" string="Has File Identifier"
                        domain="[('file_identifier', '!=', False)]"/>
                <filter name="on_hand_positive" string="On Hand > 0" domain="[('qty_on_hand', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Unique Identifier" name="group_by_unique_identifier"
                            context="{'group_by':'unique_identifier'}"/>
                    <filter string="File Identifier" name="group_by_file_identifier"
                            context="{'group_by':'file_identifier'}"/>
                    <filter string="MRN" name="group_by_mrn_id" context="{'group_by':'mrn_id'}"/>
                    <filter string="Product" name="group_by_product_id" context="{'group_by':'product_id'}"/>
                    <filter string="Location" name="group_by_location_id" context="{'group_by':'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bonded_identifier_stock_ledger" model="ir.actions.act_window">
        <field name="name">Identifier Stock Ledger</field>
        <field name="res_model">bonded.identifier.stock.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_mange.view_bonded_identifier_stock_ledger_search"/>
    </record>


    <menuitem id="menu_bonded_identifier_stock_ledger" name="Identifier Stock Ledger"
              parent="worlddepot.menu_world_depot_configuration"
              action="action_bonded_identifier_stock_ledger"
              sequence="984" groups="base.group_system"/>
</odoo>
