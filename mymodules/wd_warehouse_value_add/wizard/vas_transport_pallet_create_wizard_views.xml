<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_transport_pallet_create_wizard_form" model="ir.ui.view">
        <field name="name">wd.vas.transport.pallet.create.wizard.form</field>
        <field name="model">wd.vas.transport.pallet.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Transport Pallets" duplicate="false">
                <group>
                    <field name="palletization_id" required="1" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="pallet_count" required="1"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create" class="btn-secondary"/>
                    <button name="action_create_and_print" type="object" string="Create and Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
