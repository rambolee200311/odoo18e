<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_value_limit_view_list" model="ir.ui.view">
        <field name="name">bonded.value.limit.list</field>
        <field name="model">bonded.value.limit</field>
        <field name="arch" type="xml">
            <list>
                <field name="bonded_book_id"/>
                <field name="project_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_value" widget="monetary"/>
                <field name="used_value" readonly="1" widget="monetary"/>
                <field name="available_value" readonly="1" widget="monetary"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="bonded_value_limit_view_form" model="ir.ui.view">
        <field name="name">bonded.value.limit.form</field>
        <field name="model">bonded.value.limit</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="bonded_book_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="project_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="total_value" required="1" widget="monetary"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="used_value" readonly="1" widget="monetary"/>
                            <field name="available_value" readonly="1" widget="monetary"/>
                            <field name="effective_date" required="1"/>
                            <field name="expiry_date"/>
                            <field name="state" required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
