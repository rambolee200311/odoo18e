<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================== -->
    <!-- 1. 库存总览页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_stock" name="Stock Overview">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'WMS Stock'}, {'url': None, 'name': 'Stock Overview'}]"/>
            <t t-call="marstek_stock_portal.portal_breadcrumbs_slash"/>

            <div class="o_portal_content">
                <!-- 筛选表单 - 可折叠 -->
                <div class="card mb-4" id="stock_filter_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-filter me-2"/>
                            Stock Overview
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#stock_filter_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="stock_filter_collapse" class="collapse show">
                    <div class="card-body">
                        <form action="/my/marstek/stock" method="get" class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="container_no" class="form-label">Container No.</label>
                                <input type="search" class="form-control" id="container_no" name="container_no" t-attf-value="#{filters.get('container_no', '')}" placeholder="Enter container no." autocomplete="off"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="bl_no" class="form-label">BL No.</label>
                                <input type="search" class="form-control" id="bl_no" name="bl_no" t-attf-value="#{filters.get('bl_no', '')}" placeholder="Enter BL no." autocomplete="off"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="product_code" class="form-label">Product Code</label>
                                <input type="search" class="form-control" id="product_code" name="product_code" t-attf-value="#{filters.get('product_code', '')}" placeholder="Enter product code" autocomplete="off"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="location_search" class="form-label">Location</label>
                                <div class="position-relative" id="location_wrapper">
                                    <input type="search"
                                           class="form-control"
                                           id="location_search"
                                           name="location_search"
                                           placeholder="Search location (e.g. 13仓)"
                                           autocomplete="off"
                                           t-attf-value="#{filters.get('location_name', '')}"/>
                                    <input type="hidden" id="location_id" name="location_id" t-attf-value="#{filters.get('location_id', '')}" t-attf-data-name="#{filters.get('location_name', '')}"/>
                                    <div id="location_dropdown" class="dropdown-menu" style="display:none; max-height:200px; overflow:auto;"></div>
                                    <div id="location_loading" class="position-absolute top-50 end-0 translate-middle-y me-2" style="display:none;">
                                        <i class="fa fa-spinner fa-spin text-muted"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="date_from" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="date_from" name="date_from" t-attf-value="#{filters.get('date_from', '')}"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="date_to" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="date_to" name="date_to" t-attf-value="#{filters.get('date_to', '')}"/>
                            </div>
                            <div class="col-12 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fa fa-search me-1"/>
                                    Search
                                </button>
                                <a href="/my/marstek/stock" class="btn btn-secondary">
                                    <i class="fa fa-refresh me-1"/>
                                    Reset
                                </a>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <!-- 数据表格 - 可折叠 -->
                <div class="card" id="stock_table_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Stock List</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary me-3">Total: <t t-esc="pager.get('total', 0)"/></span>
                            <!-- 视图切换按钮 -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="View Switch">
                                <input type="radio" class="btn-check" name="view_mode" id="view_table" value="table" t-att-checked="'checked' if filters.get('view_mode') == 'table' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="view_table" title="Table View">
                                    <i class="fa fa-table"/>
                                    <span class="d-none d-sm-inline ms-1">Table</span>
                                </label>
                                <input type="radio" class="btn-check" name="view_mode" id="view_card" value="card" t-att-checked="'checked' if filters.get('view_mode') != 'table' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="view_card" title="Card View">
                                    <i class="fa fa-th-large"/>
                                    <span class="d-none d-sm-inline ms-1">Card</span>
                                </label>
                            </div>
                            <!-- 分组切换按钮 -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="Group Switch">
                                <input type="radio" class="btn-check" name="stock_group_mode" id="group_product" value="product" t-att-checked="'checked' if filters.get('stock_group_mode') == 'product' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="group_product" title="Product View">
                                    <i class="fa fa-cube"/>
                                    <span class="d-none d-sm-inline ms-1">Product</span>
                                </label>
                                <input type="radio" class="btn-check" name="stock_group_mode" id="group_package" value="package" t-att-checked="'checked' if filters.get('stock_group_mode') != 'product' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="group_package" title="Package View">
                                    <i class="fa fa-cubes"/>
                                    <span class="d-none d-sm-inline ms-1">Package</span>
                                </label>
                            </div>
                            <!-- 导出按钮 -->
                            <a t-attf-href="/my/marstek/export/stock/csv?container_no=#{filters.get('container_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;product_code=#{filters.get('product_code', '')}&amp;location_id=#{filters.get('location_id', '')}&amp;date_from=#{filters.get('date_from', '')}&amp;date_to=#{filters.get('date_to', '')}"
                               t-attf-class="btn btn-primary export-btn #{'disabled' if not rows else ''}"
                               t-attf-title="#{'No data to export' if not rows else 'Export CSV'}">
                                <i class="fa fa-file-text-o"/>
                                <span class="d-none d-sm-inline ms-1">Export CSV</span>
                            </a>
                            <a t-attf-href="/my/marstek/export/stock/pdf?container_no=#{filters.get('container_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;product_code=#{filters.get('product_code', '')}&amp;location_id=#{filters.get('location_id', '')}&amp;date_from=#{filters.get('date_from', '')}&amp;date_to=#{filters.get('date_to', '')}"
                               t-attf-class="btn btn-primary export-btn #{'disabled' if not rows else ''}"
                               t-attf-title="#{'No data to export' if not rows else 'Export PDF'}">
                                <i class="fa fa-file-pdf-o"/>
                                <span class="d-none d-sm-inline ms-1">Export PDF</span>
                            </a>
                            <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#stock_table_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                    </div>
                    <div id="stock_table_collapse" class="collapse show">
                        <!-- 表格视图 -->
                        <div id="table_view" class="card-body p-0">
                            <div class="table-responsive" id="table_scroll_container" style="max-height: 60vh; overflow: auto;">
                                <table id="stock_table" class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-nowrap">
                                                <span class="d-none d-md-inline">Pallet No.</span>
                                                <span class="d-md-none">Pallet</span>
                                            </th>
                                            <th class="text-nowrap">
                                                <span class="d-none d-md-inline">Container No.</span>
                                                <span class="d-md-none">Container</span>
                                            </th>
                                            <th class="text-nowrap">BL No.</th>
                                            <th t-if="filters.get('stock_group_mode') != 'package'" class="text-nowrap">Product Code</th>
                                            <th t-if="filters.get('stock_group_mode') != 'package'" class="text-nowrap">Product Name</th>
                                            <th t-if="filters.get('stock_group_mode') != 'package'" class="text-nowrap text-end">Qty</th>
                                            <th class="text-nowrap">Location</th>
                                            <th t-if="filters.get('stock_group_mode') != 'package'" class="text-nowrap">Inbound Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="row">
                                            <tr>
                                                <td><t t-esc="row.get('package_name', '')"/></td>
                                                <td>
                                                    <a t-if="row.get('container_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/container_stock?container_no=#{row.get('container_no', '')}">
                                                        <t t-esc="row.get('container_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('container_no', '')"/></t>
                                                </td>
                                                <td>
                                                    <a t-if="row.get('bl_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/inbounds?bl_no=#{row.get('bl_no', '')}">
                                                        <t t-esc="row.get('bl_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('bl_no', '')"/></t>
                                                </td>
                                                <td t-if="filters.get('stock_group_mode') != 'package'"><t t-esc="row.get('product_code', '')"/></td>
                                                <td t-if="filters.get('stock_group_mode') != 'package'"><t t-esc="row.get('product_name', '')"/></td>
                                                <td t-if="filters.get('stock_group_mode') != 'package'" class="text-end"><t t-esc="row.get('quantity', 0)"/></td>
                                                <td><t t-esc="row.get('location_name', '')"/></td>
                                                <td t-if="filters.get('stock_group_mode') != 'package'"><t t-esc="row.get('inbound_date', '')"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="not rows">
                                            <tr>
                                                <td t-att-colspan="'4' if filters.get('stock_group_mode') == 'package' else '8'" class="text-center text-muted py-4">No data found</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- 卡片视图 -->
                        <div id="card_view" class="card-body p-3" style="display: none;">
                            <div class="stock-card-list">
                                <t t-foreach="rows" t-as="row">
                                    <t t-if="filters.get('stock_group_mode') == 'package'">
                                        <div class="stock-card-item">
                                            <!-- 卡片标题：托盘名，点击折叠/展开 -->
                                            <div class="card-item-header" onclick="marstekToggleCard(this)">
                                                <div class="card-summary">
                                                    <span class="summary-item">
                                                        <i class="fa fa-cubes me-1 text-primary"></i>
                                                        <t t-esc="row.get('package_name', '')"/>
                                                    </span>
                                                    <div class="summary-row">
                                                        <span class="summary-item">
                                                            <i class="fa fa-database me-1 text-success"></i>
                                                            <t t-esc="row.get('total_quantity', 0)"/> pcs
                                                        </span>
                                                        <span class="summary-item ms-3">
                                                            <i class="fa fa-th-list me-1 text-info"></i>
                                                            Products: <t t-esc="row.get('product_count', 0)"/>
                                                        </span>
                                                    </div>
                                                </div>
                                                <i class="card-arrow fa fa-chevron-down"></i>
                                            </div>
                                            <!-- 卡片详情：产品行信息，产品名为子行标题 -->
                                            <div class="card-item-details">
                                                <div class="pallet-section">
                                                    <t t-foreach="row.get('product_lines', [])" t-as="line">
                                                        <div class="mb-2">
                                                            <div class="fw-bold text-dark">
                                                                <i class="fa fa-cube me-1 text-primary"></i>
                                                                Product: <t t-esc="line.get('product_name', '')"/>
                                                            </div>
                                                            <div class="ms-3 text-muted small">
                                                                <span class="fw-bold"><t t-esc="line.get('product_code', '')"/></span>
                                                                <span class="text-success ms-1">Qty: <t t-esc="line.get('quantity', 0)"/></span>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                    <div class="stock-card-item">
                                        <!-- 卡片标题：点击折叠/展开 -->
                                        <div class="card-item-header" onclick="marstekToggleCard(this)">
                                            <div class="card-summary">
                                                <span class="summary-item">
                                                    <i class="fa fa-cube me-1 text-primary"></i>
                                                    <t t-esc="row.get('product_name', '')"/>
                                                </span>
                                                <span class="summary-item">
                                                    <i class="fa fa-database me-1 text-success"></i>
                                                    <t t-esc="row.get('quantity', 0)"/> pcs
                                                </span>
                                            </div>
                                            <i class="card-arrow fa fa-chevron-down"></i>
                                        </div>
                                        <!-- 卡片详情：默认隐藏 -->
                                        <div class="card-item-details">
                                            <div class="detail-grid">
                                                <div class="detail-item">
                                                    <label>Pallet No.</label>
                                                    <span><t t-esc="row.get('package_name', '')"/></span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Container No.</label>
                                                    <span>
                                                        <a t-if="row.get('container_no')" class="text-primary text-decoration-none" t-attf-href="/my/marstek/container_stock?container_no=#{row.get('container_no', '')}">
                                                            <t t-esc="row.get('container_no', '')"/>
                                                        </a>
                                                        <t t-else=""><t t-esc="row.get('container_no', '')"/></t>
                                                    </span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>BL No.</label>
                                                    <span>
                                                        <a t-if="row.get('bl_no')" class="text-primary text-decoration-none" t-attf-href="/my/marstek/inbounds?bl_no=#{row.get('bl_no', '')}">
                                                            <t t-esc="row.get('bl_no', '')"/>
                                                        </a>
                                                        <t t-else=""><t t-esc="row.get('bl_no', '')"/></t>
                                                    </span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Product Code</label>
                                                    <span><t t-esc="row.get('product_code', '')"/></span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Product Name</label>
                                                    <span><t t-esc="row.get('product_name', '')"/></span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Qty</label>
                                                    <span class="text-success fw-bold"><t t-esc="row.get('quantity', 0)"/></span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Location</label>
                                                    <span><t t-esc="row.get('location_name', '')"/></span>
                                                </div>
                                                <div class="detail-item">
                                                    <label>Inbound Date</label>
                                                    <span><t t-esc="row.get('inbound_date', '')"/></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    </t>
                                </t>
                                <t t-if="not rows">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-inbox fa-3x mb-3"></i>
                                        <p>No data found</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div t-if="pager.get('page_count', 1) > 1" class="card-footer">
                            <t t-call="portal.pager"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
