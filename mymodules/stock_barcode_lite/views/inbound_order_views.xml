<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chenyang_chemical_inbound_order_form_inherit" model="ir.ui.view">
        <field name="name">chenyang.chemical.inbound.order.form.inherit</field>
        <field name="model">world.depot.inbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//field[@name='cntr_no']" position="attributes">
                <attribute name="required">project_name == 'SUNRISE'</attribute>
            </xpath>
            <xpath expr="//field[@name='cntr_no']" position="before">
                <field name="organic" readonly="0" invisible="project_name != 'SUNRISE'"/>
                <field name="vsourcebillcode" readonly="state != 'new'" invisible="project_name != 'SUNRISE'"/>
                <field name="cwarehouseid" readonly="state != 'new'" invisible="project_name !='SUNRISE'"/>
                <field name="source_sale_delivery_reference" readonly="state != 'new'"
                       required="type == 'service' and project_name == 'SUNRISE'"
                       invisible="project_name !='SUNRISE' or type != 'service'"/>
                <field name="project_package_generation_mode" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='inbound_order_product_ids']" position="before">
                <div class="mb-2">
                    <button name="action_open_inbound_product_import_wizard"
                            type="object"
                            string="Import Products"
                            class="btn btn-primary"
                            icon="fa-upload"
                            invisible="state != 'new' or project_name !='SUNRISE'"
                            groups="stock_barcode_lite.group_sunrise_stock_manager"/>
                    <button name="action_sunrise_generate_packages"
                            type="object"
                            string="Generate Packages"
                            class="btn btn-primary ms-3"
                            icon="fa-qrcode"
                            invisible="state != 'new' or project_name != 'SUNRISE' or project_package_generation_mode != 'inbound'"/>

                </div>
            </xpath>
            <xpath expr="//button[@name='view_inbound_order_product_details']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>
            <xpath expr="//button[@name='view_inbound_order_product_details']" position='before'>
                <button name="action_open_sunrise_inbound_pallet_products"
                        type="object"
                        string="Pallet Products"
                        class="btn btn-primary ms-3"
                        icon="fa-list"
                        invisible="project_name != 'SUNRISE' or not inbound_order_product_ids"/>
                <button name="action_open_sunrise_pallet_label_list"
                        type="object"
                        string="Open Pallet List"
                        class="btn btn-primary"
                        icon="fa-print"
                        invisible="state != 'confirm' or project_name != 'SUNRISE'"/>
            </xpath>
            <xpath expr="//button[@name='action_create_stock_picking']" position="after">
                <button name="action_sunrise_create_incoming_stock_picking"
                        type="object"
                        string="Sunrise Create Receipt"
                        class="oe_stat_button"
                        icon="fa-file-text"
                        invisible="project_name !='SUNRISE'"/>
                <button name="action_sunrise_prepare_recreate_incoming_picking"
                        type="object"
                        string="Prepare Recreate Receipt"
                        class="btn-secondary"
                        icon="fa-refresh"
                        confirm="Completed receipts will be returned before old receipt links are cleared. Continue?"
                        invisible="project_name != 'SUNRISE' or state != 'confirm'"
                        groups="stock_barcode_lite.group_sunrise_stock_manager"/>
            </xpath>
            <xpath expr="//field[@name='inbound_order_product_ids']/list/field[@name='pallet_no']" position="after">
                <field name="package_id" optional="show" column_invisible="parent.project_name != 'SUNRISE'"
                       options="{'no_create': True, 'no_open': True}"/>
                <!--                <field name="package_barcode" optional="show" column_invisible="parent.project_name != 'SUNRISE'"/>-->
                <!--                <field name="is_reused_package" optional="show" column_invisible="parent.project_name != 'SUNRISE'"/>-->
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sunrise Sync" invisible="project_name !='SUNRISE'">
                    <group>
                        <group>
                            <field name="set_sunrise_inbound_sync" readonly="1"/>
                            <field name="set_sunrise_inbound_sync_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="sunrise_inbound_task_number" readonly="1"/>
                            <field name="sunrise_inbound_sync_error_msg" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_sync_u8c_inbound"
                                type="object"
                                string="Sync U8C Inbound"
                                class="btn-primary" icon="fa-upload"
                                invisible="type == 'service'"/>
                        <button name="action_sync_u8c_service_return"
                                type="object"
                                string="Sync U8C Service Return"
                                class="btn btn-primary"
                                invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

