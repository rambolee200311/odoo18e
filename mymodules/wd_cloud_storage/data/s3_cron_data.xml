<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_s3_recycle_auto_purge" model="ir.cron">
            <field name="name">S3 Recycle Auto Purge</field>
            <field name="model_id" ref="model_s3_recycle_entry" />
            <field name="state">code</field>
            <field name="code">model.cron_purge_expired_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
        </record>
    </data>
</odoo>