<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_lite_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.barcode.lite.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_incoming_scan_wizard"
                        type="object"
                        string="Incoming Scan"
                        class="btn-secondary"
                        icon="fa-barcode"
                        invisible="picking_type_code != 'incoming' or state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
