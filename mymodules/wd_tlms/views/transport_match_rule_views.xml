<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_carrier_match_rule_tree" model="ir.ui.view">
        <field name="name">tlmp.carrier.match.rule.tree</field>
        <field name="model">tlmp.carrier.match.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="match_ref_type"/>
                <field name="match_ref_value"/>
                <field name="carrier_id"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_carrier_match_rule_form" model="ir.ui.view">
        <field name="name">tlmp.carrier.match.rule.form</field>
        <field name="model">tlmp.carrier.match.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="carrier_id"/>
                        </group>
                        <group>
                            <field name="match_ref_type"/>
                            <field name="match_ref_value"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tlmp_carrier_match_rule" model="ir.actions.act_window">
        <field name="name">Match Rules</field>
        <field name="res_model">tlmp.carrier.match.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Suggestion History -->
    <record id="view_tlmp_carrier_matching_history_tree" model="ir.ui.view">
        <field name="name">tlmp.carrier.matching.history.tree</field>
        <field name="model">tlmp.carrier.matching.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="change_date"/>
                <field name="operation"/>
                <field name="from_state"/>
                <field name="to_state"/>
                <field name="billing_line_id"/>
                <field name="transport_order_id"/>
                <field name="operator"/>
            </list>
        </field>
    </record>

    <record id="action_tlmp_carrier_matching_history" model="ir.actions.act_window">
        <field name="name">Matching History</field>
        <field name="res_model">tlmp.carrier.matching.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
