<odoo>
    <record id="group_invoice_applicant" model="res.groups">
        <field name="name">Invoice Applicant</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_account_move_invoice_applicant" model="ir.rule">
        <field name="name">Invoice Applicant Own Vendor Bills</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('invoice_request_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_applicant'))]"/>
    </record>

    <record id="rule_account_move_line_invoice_applicant" model="ir.rule">
        <field name="name">Invoice Applicant Own Vendor Bill Lines</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.invoice_request_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_applicant'))]"/>
    </record>
</odoo>
