<odoo>
    <record id="view_statement_period_list_iffm" model="ir.ui.view">
        <field name="name">statement.period.list.iffm</field>
        <field name="model">statement.period</field>
        <field name="inherit_id" ref="wd_charge_pricing.view_statement_period_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="handover_total_amount" optional="show"/>
                <field name="clearance_total_amount" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_statement_period_form_iffm" model="ir.ui.view">
        <field name="name">statement.period.form.iffm</field>
        <field name="model">statement.period</field>
        <field name="inherit_id" ref="wd_charge_pricing.view_statement_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">wd_iffm_required_highlight</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm_expense']" position="before">
                <button name="get_periodic_statement" type="object" string="Get Statement Periods" icon="fa-check-square" invisible="state in ('expense_confirmed', 'calculated', 'cancelled')"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="statement_time_type" readonly="state != 'draft'"/>
                <field name="operation_order_scope" readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='expense_confirmed_datetime']" position="after">
                <field name="handover_total_amount" readonly="1"/>
                <field name="clearance_total_amount" readonly="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Handover Orders">
                        <field name="handover_order_lines" context="{'form_view_ref': 'wd_iffm.view_handover_statement_period_form'}" mode="list,form">
                            <list delete="false" create="false">
                                <field name="waybill_bill_number"/>
                                <field name="name"/>
                                <field name="container_nums"/>
                                <field name="currency_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="amount_total_change"/>
                                <field name="manual_amount_total_change"/>
                                <button name="action_handover_remove_from_statement_period" type="object" icon="fa-trash" title="Remove" class="btn-link" invisible="statement_period_id_state != 'draft'"/>
                            </list>
                        </field>
                    </page>
                    <page string="Clearance Orders">
                        <field name="clearance_order_lines" context="{'form_view_ref': 'wd_iffm.view_clearance_statement_period_form'}" mode="list,form">
                            <list delete="false" create="false">
                                <field name="waybill_bill_number"/>
                                <field name="name"/>
                                <field name="container_nums"/>
                                <field name="currency_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="amount_total_change"/>
                                <field name="manual_amount_total_change"/>
                                <button name="action_clearance_remove_from_statement_period" type="object" icon="fa-trash" class="btn-link" title="Remove" invisible="statement_period_id_state != 'draft'"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
