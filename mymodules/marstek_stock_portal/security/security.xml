        <record id="rule_marstek_outbound_order_portal" model="ir.rule">
            <field name="name">Marstek Portal Outbound Project</field>
            <field name="model_id" ref="worlddepot.model_world_depot_outbound_order"/>
            <field name="domain_force">[('project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
