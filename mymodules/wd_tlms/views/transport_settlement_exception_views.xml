<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_exception_tree" model="ir.ui.view">
        <field name="name">tlmp.settlement.exception.tree</field>
        <field name="model">tlmp.settlement.exception</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exception_type"/>
                <field name="exception_category"/>
                <field name="priority" widget="badge" decoration-danger="priority=='urgent'" decoration-warning="priority=='high'"/>
                <field name="state" widget="badge"/>
                <field name="sla_status" widget="badge" decoration-danger="sla_status=='overdue'" decoration-warning="sla_status=='at_risk'"/>
                <field name="sla_deadline"/>
                <field name="assigned_to"/>
                <field name="source_display_name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_exception_form" model="ir.ui.view">
        <field name="name">tlmp.settlement.exception.form</field>
        <field name="model">tlmp.settlement.exception</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" string="Assign" type="object"/>
                    <button name="action_start_processing" string="Start Processing" type="object"/>
                    <button name="action_resolve" string="Resolve" type="object"/>
                    <button name="action_close" string="Close" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,processing,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="exception_type"/>
                            <field name="exception_category"/>
                            <field name="priority"/>
                            <field name="resolution_mode"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="sla_status" widget="badge"/>
                            <field name="sla_deadline"/>
                            <field name="assigned_to"/>
                            <field name="assigned_at"/>
                        </group>
                    </group>
                    <group string="Source Reference">
                        <group>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="source_display_name"/>
                        </group>
                        <group>
                            <field name="source_captured_at"/>
                            <field name="source_snapshot" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Case Link">
                        <field name="case_id"/>
                    </group>
                    <group string="Resolution">
                        <group>
                            <field name="resolution_note"/>
                            <field name="cancel_reason"/>
                        </group>
                        <group>
                            <field name="resolved_at"/>
                            <field name="resolved_by"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tlmp_exception" model="ir.actions.act_window">
        <field name="name">Exceptions</field>
        <field name="res_model">tlmp.settlement.exception</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_tlmp_exception_review_queue" model="ir.actions.act_window">
        <field name="name">Review Queue</field>
        <field name="res_model">tlmp.settlement.exception</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_review_queue': 1}</field>
    </record>

    <record id="view_tlmp_exception_filter" model="ir.ui.view">
        <field name="name">tlmp.settlement.exception.select</field>
        <field name="model">tlmp.settlement.exception</field>
        <field name="arch" type="xml">
            <search>
                <filter name="review_queue" string="Review Queue"
                        domain="[('state', 'not in', ('closed','cancelled'))]"/>
                <filter name="my_exceptions" string="My Exceptions"
                        domain="[('assigned_to', '=', uid)]"/>
                <separator/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="filter_high" string="High" domain="[('priority', '=', 'high')]"/>
                <separator/>
                <field name="exception_type"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="assigned_to"/>
            </search>
        </field>
    </record>
</odoo>
