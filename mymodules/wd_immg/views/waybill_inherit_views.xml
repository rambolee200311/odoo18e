<odoo>
    <record id="view_waybill_form_inherit_add_view_sn_button" model="ir.ui.view">
        <field name="name">waybill.form.inherit.add.view.create.handover.button</field>
        <field name="model">world.depot.waybill</field>
        <field name="inherit_id" ref="worlddepot.view_world_depot_waybill_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_arrival_wizard"
                            string="Cargo Arrival Confirmation"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-film"
                            invisible="is_arrived == True"
                            groups="wd_immg.group_customs_specialist"/>
                    <button name="action_create_handover"
                            type="object"
                            string="Create Handover"
                            class="oe_stat_button"
                            icon="fa-film"/>
                    <button name="action_create_clearance"
                            type="object"
                            string="Create Clearance"
                            class="oe_stat_button"
                            icon="fa-film"/>

                </div>
            </xpath>
            <xpath expr="//field[@name='eta']" position="before">
                <field name="handover_id" readonly="1" context="{'form_view_ref': 'wd_immg.view_operation_order_handover_form'}"/>
                <field name="clearance_id" readonly="1" context="{'form_view_ref': 'wd_immg.operation_order_clearance_form_view'}"/>
            </xpath>

            <xpath  expr="//field[@name='terminal_a']" position="after">
                <field name="is_arrived" readonly="1"/>
                </xpath>
            <xpath expr="//field[@name='hbl_number']" position="after">
                <field name="obl_number" readonly="state!='new'"/>
            </xpath>

        </field>
    </record>

</odoo>