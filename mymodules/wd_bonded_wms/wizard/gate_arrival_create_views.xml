<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wiz" model="ir.ui.view">
        <field name="name">wiz.form</field>
        <field name="model">gate.arrival.create</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="customs_file_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="bonded_inbound_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="container_no" required="1"/>
                    <field name="seal_no" required="1"/>
                    <field name="carrier_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="arrival_datetime" required="1"/>
                    <field name="plate_number"/>
                    <field name="driver_name"/>
                    <field name="driver_phone"/>
                </group>
                <footer>
                    <button name="action_create" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
