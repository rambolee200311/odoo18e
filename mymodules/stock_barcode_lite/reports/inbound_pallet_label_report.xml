<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="paperformat_inbound_pallet_label" model="report.paperformat">
            <field name="name">Inbound Pallet Label A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">6</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_inbound_pallet_label" model="ir.actions.report">
            <field name="name">Inbound Pallet Labels</field>
            <field name="model">world.depot.inbound.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_barcode_lite.report_inbound_pallet_label</field>
            <field name="report_file">stock_barcode_lite.report_inbound_pallet_label</field>
            <field name="paperformat_id" ref="paperformat_inbound_pallet_label"/>
            <field name="binding_model_id" ref="worlddepot.model_world_depot_inbound_order"/>
            <field name="binding_type">report</field>
        </record>
    </data>

    <template id="report_inbound_pallet_label_header">
        <div class="inbound-label-header">
            <p class="inbound-label-title">World Depot B.V.</p>
            <p class="inbound-label-subtitle">Inbound Order</p>
            <table class="inbound-label-info">
                <tr>
                    <td class="label">Bill No:</td>
                    <td><span t-field="o.billno"/></td>
                    <td class="label">Owner:</td>
                    <td><span t-esc="o.owner.name"/></td>
                </tr>
                <tr>
                    <td class="label">Arrival Date:</td>
                    <td>
                        <span t-if="o.a_date" t-esc="o.a_date.strftime('%Y-%m-%d')"/>
                    </td>
                    <td class="label">Reference:</td>
                    <td><span t-field="o.reference"/></td>
                </tr>
                <tr>
                    <td class="label">BL No:</td>
                    <td><span t-field="o.bl_no"/></td>
                    <td class="label">Container No:</td>
                    <td><span t-field="o.cntr_no"/></td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_inbound_pallet_label">
        <t t-set="data_report_margin_top" t-value="0"/>
        <t t-set="data_report_header_spacing" t-value="0"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article"
                     t-att-data-oe-model="o._name"
                     t-att-data-oe-id="o.id"
                     t-att-data-oe-lang="o.env.context.get('lang')">
                <style>
                @page {
                    margin-top: 0;
                    margin-bottom: 6mm;
                    margin-left: 6mm;
                    margin-right: 6mm;
                }
                html,
                body,
                #wrapwrap,
                main {
                    margin-top: 0 !important;
                    padding-top: 0 !important;
                }
                .inbound-label-page {
                    font-family: Arial, sans-serif;
                    color: #111827;
                    font-size: 14px;
                    padding-top: 0;
                    margin-top: 0;
                }
                .pallet-label-page {
                    page-break-before: always;
                }
                .inbound-label-header {
                    border-bottom: 2px solid #111827;
                    padding-bottom: 8px;
                    margin-top: 0;
                    margin-bottom: 10px;
                }
                .inbound-label-title {
                    font-size: 24px;
                    font-weight: bold;
                    margin: 0 0 3px 0;
                }
                .inbound-label-subtitle {
                    font-size: 18px;
                    font-weight: bold;
                    margin: 0;
                }
                .inbound-label-info {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 6px;
                }
                .inbound-label-info td {
                    padding: 3px 14px 3px 0;
                    vertical-align: top;
                }
                .inbound-label-info .label {
                    width: 120px;
                    font-weight: bold;
                    white-space: nowrap;
                }
                .pallet-block {
                    border: 1px solid #111827;
                    margin-bottom: 0;
                    padding: 14px;
                    page-break-inside: avoid;
                    break-inside: avoid;
                    -webkit-column-break-inside: avoid;
                }
                .pallet-header {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 8px;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                .pallet-header th,
                .pallet-header td {
                    border: 1px solid #d1d5db;
                    padding: 10px;
                }
                .pallet-header th {
                    background: #6f797f;
                    color: #ffffff;
                    font-weight: bold;
                    text-align: left;
                }
                .pallet-header .qr-title {
                    width: 180px;
                    text-align: center;
                }
                .pallet-no {
                    font-size: 28px;
                    font-weight: bold;
                }
                .pallet-info-line + .pallet-info-line {
                    margin-top: 12px;
                }
                .pallet-info-label {
                    display: inline-block;
                    min-width: 170px;
                }
                .pallet-qr {
                    width: 180px;
                    text-align: center;
                    vertical-align: middle;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                .product-table {
                    width: 100%;
                    border-collapse: collapse;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                .product-table th,
                .product-table td {
                    border: 1px solid #d1d5db;
                    padding: 9px;
                }
                .product-table th {
                    background: #f3f4f6;
                    font-weight: bold;
                    text-align: left;
                }
                .product-table .qty {
                    width: 110px;
                    text-align: right;
                    white-space: nowrap;
                }
                .product-table .uom {
                    width: 130px;
                    white-space: nowrap;
                }
                .product-table .blank {
                    width: 170px;
                    white-space: nowrap;
                }
                img.keep-no-break {
                    display: inline-block;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            </style>

                <t t-if="o.inbound_order_product_ids">
                    <t t-foreach="o.inbound_order_product_ids" t-as="pallet">
                        <div t-attf-class="page inbound-label-page {{ '' if pallet_index == 0 else 'pallet-label-page' }}">
                            <t t-call="stock_barcode_lite.report_inbound_pallet_label_header"/>
                            <div class="pallet-block">
                                <table class="pallet-header">
                                    <thead>
                                        <tr>
                                            <th>Pallet Information</th>
                                            <th class="qr-title">QR Code</th>
                                        </tr>
                                    </thead>
                                    <tr>
                                        <td>
                                            <div class="pallet-no">
                                                <div class="pallet-info-line">
                                                    <span class="pallet-info-label">Pallet No:</span>
                                                    <span t-field="pallet.sunrise_pallet_no"/>
                                                </div>
                                                <div class="pallet-info-line">
                                                    <span class="pallet-info-label">Container No:</span>
                                                    <span t-field="o.cntr_no"/>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="pallet-qr">
                                            <t t-if="pallet.sunrise_pallet_no">
                                                <div t-field="pallet.sunrise_pallet_no" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 260, 'height': 260, 'img_style': 'width:150px;height:150px;', 'img_class': 'keep-no-break'}"/>
                                            </t>
                                            <t t-elif="pallet.pallet_no">
                                                <div t-field="pallet.pallet_no" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 260, 'height': 260, 'img_style': 'width:150px;height:150px;', 'img_class': 'keep-no-break'}"/>
                                            </t>
                                        </td>
                                    </tr>
                                </table>

                                <table class="product-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Barcode</th>
                                            <th class="qty">
                                                Quantity (<span t-esc="pallet.inbound_order_product_pallet_ids[:1].castunitid or 'Carton'"/>)
                                            </th>
                                            <th class="uom">
                                                <span t-esc="pallet.inbound_order_product_pallet_ids[:1].u8_aux_uom_name or 'UOM'"/>
                                            </th>
                                            <th class="blank"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="pallet.inbound_order_product_pallet_ids">
                                            <t t-foreach="pallet.inbound_order_product_pallet_ids" t-as="line">
                                                <tr>
                                                    <td><span t-esc="line.product_id.display_name"/></td>
                                                    <td><span t-field="line.product_id.barcode"/></td>
                                                    <td class="qty"><span t-field="line.quantity"/></td>
                                                    <td class="uom"><span t-field="line.ninnum"/></td>
                                                    <td class="blank"></td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="5">No product lines.</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="page inbound-label-page">
                        <t t-call="stock_barcode_lite.report_inbound_pallet_label_header"/>
                        <div class="pallet-block">No pallet lines.</div>
                    </div>
                </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
