<odoo>
    <record id="view_account_move_form_outbound_payable" model="ir.ui.view">
        <field name="name">account.move.form.outbound.payable</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm_outbound_payable_paid" type="object" string="Confirm Outbound Payable Payment" class="btn-primary" invisible="move_type != 'in_invoice' or not outbound_payable_id or payment_state != 'paid' or not bank_proof_attachment_ids or payment_info_synced"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="outbound_payable_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
