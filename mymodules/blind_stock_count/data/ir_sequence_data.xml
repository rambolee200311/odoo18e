<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_blind_stock_count" model="ir.sequence">
            <field name="name">Blind Stock Count</field>
            <field name="code">blind.stock.count</field>
            <field name="prefix">BSC-%(year)s%(month)s%(day)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
        <record id="sequence_blind_stock_count_pallet" model="ir.sequence">
            <field name="name">盲盘托盘号</field>
            <field name="code">blind.stock.count.pallet</field>
            <field name="prefix">Hoymiles-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
