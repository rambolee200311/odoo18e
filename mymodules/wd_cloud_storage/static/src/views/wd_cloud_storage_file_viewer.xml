<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wd_cloud_storage.FileViewer">
        <div t-if="props.previewStore.files"
             class="position-absolute w-100 h-100 start-0 top-0 d-flex justify-content-center align-items-center"
             style="z-index: 990; background-color: rgba(0, 0, 0, 0.7);">
            <FileViewer
                files="props.previewStore.files"
                startIndex="props.previewStore.startIndex || 0"
                close="props.previewStore.close"
                modal="false"
            />
        </div>
    </t>
</templates>