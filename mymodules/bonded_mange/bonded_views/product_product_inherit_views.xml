<odoo>
        <record id="view_product_product_form_trade_ref_inherit" model="ir.ui.view">
        <field name="name">product.product.form.trade.ref.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bonded Attributes" name="bonded_attributes">
                    <group>
                        <group>
                            <field name="origin_country"/>
                            <field name="goods_value"/>
                            <field name="customs_code"/>
                        </group>
                        <group>
                            <field name="article_number"/>
                            <field name="product_description"/>
                            <field name="technical_description"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
