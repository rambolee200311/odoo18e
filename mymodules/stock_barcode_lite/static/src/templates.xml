<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!-- 首页 - 两个菜单块 -->
    <t t-name="stock_barcode_lite.Homepage">
        <div class="o_stock_barcode_lite_homepage">
            <div class="container-fluid py-4">
                <div class="text-center mb-4">
                    <h1 class="display-6">Stock Barcode Lite</h1>
                    <p class="text-muted">Select a workflow to continue</p>
                </div>
                <div class="row justify-content-center g-4">
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_inbound_card" t-on-click="_onInboundClick">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-in me-2"/>Inbound
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Manage inbound orders and product imports.</p>
                                <button class="btn btn-primary mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Inbound
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_card" t-on-click="_onOutboundClick">
                            <div class="card-header bg-success text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-out me-2"/>Outbound
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Manage outbound orders and product exports.</p>
                                <button class="btn btn-success mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Outbound
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- 入库流程页面 -->
    <t t-name="stock_barcode_lite.InboundPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
        />

        <div class="o_sbl_inbound">
            <!-- 顶部导航栏 -->
            <div class="o_sbl_header">
                <button type="button" class="btn btn-secondary o_exit_btn me-2" t-on-click="exit" title="Back">
                    <i class="oi oi-chevron-left"/>
                </button>
                <div class="o_sbl_header_title">
                    <span class="fa fa-truck me-1"/>
                    <t t-if="state.order" t-esc="state.order.reference"/>
                    <t t-else="">Inbound</t>
                </div>
                <div class="o_sbl_header_mode" t-attf-class="o_mode_{{ state.scanMode }}">
                    <t t-esc="scanModeLabel"/>
                </div>
            </div>

            <!-- 提示消息 -->
            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                <t t-esc="state.message"/>
            </div>

            <!-- 步骤指引 -->
            <div t-if="state.scanMode === 'pallet' and currentLocation" class="o_sbl_step_hint">
                Location [<t t-esc="currentLocation.location_code"/>] — <t t-esc="remainingPalletsCount"/> pallet(s) to bind
            </div>
            <div t-if="state.scanMode === 'location'" class="o_sbl_step_hint">
                Scan location barcode to activate binding
            </div>

            <!-- 进度条 -->
            <div t-if="state.locations.length > 0" class="o_sbl_progress">
                <div class="progress-bar"
                     t-attf-style="width: {{ progressPercent }}%"
                     t-attf-class="bg-{{ progressPercent === 100 ? 'success' : 'primary' }}"/>
            </div>
            <div t-if="state.locations.length > 0" class="o_sbl_progress_text">
                <span><t t-esc="progressPercent"/>%</span>
                <span class="ms-2"><t t-esc="state.locations.filter(l => l.is_complete).length"/> / <t t-esc="state.locations.length"/> locations</span>
                <span class="ms-auto badge" t-attf-class="{{ isAllComplete ? 'bg-success' : 'bg-secondary' }}">
                    <t t-if="isAllComplete">All Done</t>
                    <t t-else=""><t t-esc="state.locations.filter(l => !l.is_complete).length"/> left</t>
                </span>
            </div>

            <!-- 库位列表 -->
            <div class="o_sbl_pallets">
                <t t-foreach="state.locations" t-as="loc" t-key="loc.location_code">
                    <div t-attf-class="o_sbl_pallet {{ loc.is_complete ? 'o_pallet_done' : '' }} {{ state.currentLocationIndex === state.locations.indexOf(loc) ? 'o_pallet_active' : '' }}">

                        <!-- 库位头 -->
                        <div class="o_pallet_header">
                            <div class="o_pallet_info">
                                <span class="fa fa-map-marker me-1"/>
                                <strong><t t-esc="loc.location_code"/></strong>
                                <span class="badge bg-success ms-1" t-if="loc.is_complete">
                                    <i class="fa fa-check"/> Done
                                </span>
                            </div>
                            <div class="o_pallet_qty">
                                <t t-esc="loc.expected_pallets.length"/> pallets
                            </div>
                        </div>

                        <!-- 托盘列表 -->
                        <div class="o_pallet_products">
                            <t t-foreach="loc.expected_pallets" t-as="pallet_no" t-key="pallet_no">
                                <div t-attf-class="o_pallet_product {{ loc.bound_pallets.has(pallet_no) ? 'o_product_done' : '' }}">
                                    <div class="o_product_info">
                                        <div class="o_product_name">
                                            <i class="fa fa-cube me-1 text-muted"/>
                                            <t t-esc="pallet_no"/>
                                        </div>
                                    </div>
                                    <div class="o_product_qty">
                                        <span t-attf-class="{{ loc.bound_pallets.has(pallet_no) ? 'text-success' : 'text-primary' }}">
                                            <i t-if="loc.bound_pallets.has(pallet_no)" class="fa fa-check"/>
                                            <i t-else="" class="fa fa-circle-o"/>
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- 无订单时显示提示 -->
            <div t-if="!state.order and !state.loading" class="o_sbl_empty_state">
                <div class="text-center text-muted p-4">
                    <i class="fa fa-inbox fa-3x mb-3"/>
                    <p>No inbound order loaded.</p>
                    <p class="small">Please select an inbound order from the menu.</p>
                </div>
            </div>

            <!-- 底部操作栏 -->
            <div class="o_sbl_footer">
                <button t-if="currentLocation" class="btn btn-outline-secondary btn-sm" t-on-click="skipCurrentLocation">
                    <i class="fa fa-share me-1"/>Skip Location
                </button>
                <button t-if="state.order" class="btn btn-secondary" t-on-click="resetScan">
                    <i class="fa fa-refresh me-1"/>Reset
                </button>
                <button t-if="state.order" class="btn btn-success flex-fill" t-on-click="confirmInbound" t-att-disabled="state.loading">
                    <i class="fa fa-check me-1"/>Confirm Inbound
                </button>
            </div>
        </div>
    </t>

    <!-- 出库流程页面 -->
    <t t-name="stock_barcode_lite.OutboundPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
        />

        <div class="o_sbl_outbound">
            <!-- 顶部导航栏 -->
            <div class="o_sbl_header">
                <button type="button" class="btn btn-secondary o_exit_btn me-2" t-on-click="exit" title="Back">
                    <i class="oi oi-chevron-left"/>
                </button>
                <div class="o_sbl_header_title">
                    <span class="fa fa-truck me-1"/>
                    <t t-if="state.order" t-esc="state.order.reference"/>
                    <t t-else="">Outbound</t>
                </div>
                <div class="o_sbl_header_mode" t-attf-class="o_mode_{{ state.scanMode }}">
                    <t t-esc="scanModeLabel"/>
                </div>
            </div>

            <!-- 提示消息 -->
            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                <t t-esc="state.message"/>
            </div>

            <!-- 步骤指引 -->
            <div t-if="stepHint" class="o_sbl_step_hint">
                <t t-esc="stepHint"/>
            </div>

            <!-- 进度条 -->
            <div t-if="state.pallets.length > 0" class="o_sbl_progress">
                <div class="progress-bar"
                     t-attf-style="width: {{ progressPercent }}%"
                     t-attf-class="bg-{{ progressPercent === 100 ? 'success' : 'primary' }}"/>
            </div>
            <div t-if="state.pallets.length > 0" class="o_sbl_progress_text">
                <span><t t-esc="progressPercent"/>%</span>
                <span class="ms-2"><t t-esc="state.totalScanned"/> / <t t-esc="state.totalRequired"/></span>
                <span class="ms-auto badge" t-attf-class="{{ isAllComplete ? 'bg-success' : 'bg-secondary' }}">
                    <t t-if="isAllComplete">All Done</t>
                    <t t-else=""><t t-esc="state.pallets.filter(p => !p.is_complete).length"/> left</t>
                </span>
            </div>

            <!-- 托盘列表 -->
            <div class="o_sbl_pallets">
                <t t-foreach="state.pallets" t-as="pallet" t-key="pallet.pallet_no">
                    <div t-attf-class="o_sbl_pallet {{ pallet.is_complete ? 'o_pallet_done' : '' }} {{ state.currentPalletIndex === state.pallets.indexOf(pallet) ? 'o_pallet_active' : '' }}">

                        <!-- 托盘头 -->
                        <div class="o_pallet_header">
                            <div class="o_pallet_info">
                                <span class="fa fa-cube me-1"/>
                                <strong><t t-esc="pallet.pallet_no"/></strong>
                                <span class="badge bg-dark ms-1" t-if="pallet.mode === 'whole'">Whole</span>
                                <span class="badge bg-warning text-dark ms-1" t-if="pallet.mode === 'disassembly'">Disassembly</span>
                                <span class="badge bg-success ms-1" t-if="pallet.is_complete">
                                    <i class="fa fa-check"/> Done
                                </span>
                            </div>
                            <div class="o_pallet_qty">
                                <t t-esc="pallet.products.reduce(s => s + (s.quantity || 0), 0)"/> items
                            </div>
                        </div>

                        <!-- 产品明细 -->
                        <div class="o_pallet_products">
                            <t t-foreach="pallet.products" t-as="item" t-key="item.id">
                                <div t-attf-class="o_pallet_product {{ (item.qty_done || 0) >= item.quantity ? 'o_product_done' : '' }} {{ state.currentPalletIndex === state.pallets.indexOf(pallet) and state.currentItemIndex === pallet.products.indexOf(item) ? 'o_item_active' : '' }}">
                                    <div class="o_product_info">
                                        <div class="o_product_name">
                                            <t t-esc="item.product_name"/>
                                        </div>
                                        <div class="o_product_meta text-muted small">
                                            <span t-if="item.product_code"><t t-esc="item.product_code"/></span>
                                            <span t-if="item.product_barcode"> / <t t-esc="item.product_barcode"/></span>
                                        </div>
                                        <!-- 已扫SN列表 -->
                                        <div t-if="item.sn_list and item.sn_list.length > 0" class="o_sn_list mt-1">
                                            <t t-foreach="item.sn_list" t-as="sn" t-key="sn">
                                                <span class="o_sn_tag"><t t-esc="sn"/></span>
                                            </t>
                                        </div>
                                        <div t-if="item.batch_count > 0" class="o_batch_count mt-1 text-success small">
                                            <i class="fa fa-hashtag me-1"/><t t-esc="item.batch_count"/> ×
                                        </div>
                                    </div>
                                    <div class="o_product_qty">
                                        <span t-attf-class="{{ (item.qty_done || 0) >= item.quantity ? 'text-success fw-bold' : 'text-primary' }}">
                                            <t t-esc="item.qty_done || 0"/>
                                        </span>
                                        <span class="text-muted"> / <t t-esc="item.quantity"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- 底部操作栏 -->
            <div class="o_sbl_footer">
                <button t-if="state.pallets.length > 0 and !isAllComplete and state.currentPallet" class="btn btn-outline-secondary btn-sm" t-on-click="skipCurrentItem">
                    <i class="fa fa-forward me-1"/>Skip Product
                </button>
                <button t-if="state.pallets.length > 0 and !isAllComplete and state.currentPallet and state.currentPallet.mode !== 'whole'" class="btn btn-outline-dark btn-sm" t-on-click="markCurrentPalletWhole">
                    <i class="fa fa-cube me-1"/>Whole
                </button>
                <button t-if="state.pallets.length > 0 and !isAllComplete" class="btn btn-outline-secondary btn-sm" t-on-click="skipCurrentPallet">
                    <i class="fa fa-share me-1"/>Skip Pallet
                </button>
                <button t-if="state.order" class="btn btn-secondary" t-on-click="resetScan">
                    <i class="fa fa-refresh me-1"/>Reset
                </button>
                <button t-if="isAllComplete" class="btn btn-success flex-fill" t-on-click="confirmOutbound" t-att-disabled="state.loading">
                    <i class="fa fa-check me-1"/>Confirm Outbound
                </button>
            </div>
        </div>
    </t>
</templates>
