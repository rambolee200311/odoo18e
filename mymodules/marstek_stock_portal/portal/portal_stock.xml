<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================== -->
    <!-- 1. 库存总览页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_stock" name="Stock Overview">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek 库存'}, {'url': None, 'name': '库存总览'}]"/>

            <div class="o_portal_content">
                <!-- 筛选表单 - 可折叠 -->
                <div class="card mb-4" id="stock_filter_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-filter me-2"/>
                            库存概览
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#stock_filter_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="stock_filter_collapse" class="collapse show">
                    <div class="card-body">
                        <form action="/my/marstek/stock" method="get" class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="container_no" class="form-label">柜号</label>
                                <input type="text" class="form-control" id="container_no" name="container_no" t-attf-value="#{filters.get('container_no', '')}" placeholder="请输入柜号"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="bl_no" class="form-label">提单号</label>
                                <input type="text" class="form-control" id="bl_no" name="bl_no" t-attf-value="#{filters.get('bl_no', '')}" placeholder="请输入提单号"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="product_code" class="form-label">产品编码</label>
                                <input type="text" class="form-control" id="product_code" name="product_code" t-attf-value="#{filters.get('product_code', '')}" placeholder="请输入产品编码"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="date_from" class="form-label">开始日期</label>
                                <input type="date" class="form-control" id="date_from" name="date_from" t-attf-value="#{filters.get('date_from', '')}"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="date_to" class="form-label">结束日期</label>
                                <input type="date" class="form-control" id="date_to" name="date_to" t-attf-value="#{filters.get('date_to', '')}"/>
                            </div>
                            <div class="col-12 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fa fa-search me-1"/>
                                    查询
                                </button>
                                <a href="/my/marstek/stock" class="btn btn-secondary">
                                    <i class="fa fa-refresh me-1"/>
                                    重置
                                </a>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <!-- 数据表格 - 可折叠 -->
                <div class="card" id="stock_table_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">库存列表</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary me-3">共 <t t-esc="pager.get('total', 0)"/> 条</span>
                            <!-- 导出按钮 -->
                            <a t-attf-href="/my/marstek/export/stock/csv?container_no=#{filters.get('container_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;product_code=#{filters.get('product_code', '')}&amp;date_from=#{filters.get('date_from', '')}&amp;date_to=#{filters.get('date_to', '')}"
                               t-attf-class="btn btn-primary #{'disabled' if not rows else ''}"
                               t-attf-title="#{'暂无可导出数据' if not rows else '导出 CSV'}">
                                <i class="fa fa-file-text-o me-1"/>
                                导出 CSV
                            </a>
                            <a t-attf-href="/my/marstek/export/stock/pdf?container_no=#{filters.get('container_no', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;product_code=#{filters.get('product_code', '')}&amp;date_from=#{filters.get('date_from', '')}&amp;date_to=#{filters.get('date_to', '')}"
                               t-attf-class="btn btn-primary #{'disabled' if not rows else ''}"
                               t-attf-title="#{'暂无可导出数据' if not rows else '导出 PDF'}">
                                <i class="fa fa-file-pdf-o me-1"/>
                                导出 PDF
                            </a>
                            <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#stock_table_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                    </div>
                    <div id="stock_table_collapse" class="collapse show">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-nowrap">托盘号</th>
                                            <th class="text-nowrap">柜号</th>
                                            <th class="text-nowrap">提单号</th>
                                            <th class="text-nowrap">产品编码</th>
                                            <th class="text-nowrap">产品名称</th>
                                            <th class="text-nowrap text-end">数量</th>
                                            <th class="text-nowrap">库位</th>
                                            <th class="text-nowrap">入库日期</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="row">
                                            <tr>
                                                <td><t t-esc="row.get('package_name', '')"/></td>
                                                <td>
                                                    <a t-if="row.get('container_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/container_stock?container_no=#{row.get('container_no', '')}">
                                                        <t t-esc="row.get('container_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('container_no', '')"/></t>
                                                </td>
                                                <td>
                                                    <a t-if="row.get('bl_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/inbounds?bl_no=#{row.get('bl_no', '')}">
                                                        <t t-esc="row.get('bl_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('bl_no', '')"/></t>
                                                </td>
                                                <td><t t-esc="row.get('product_code', '')"/></td>
                                                <td><t t-esc="row.get('product_name', '')"/></td>
                                                <td class="text-end"><t t-esc="row.get('quantity', 0)"/></td>
                                                <td><t t-esc="row.get('location_name', '')"/></td>
                                                <td><t t-esc="row.get('inbound_date', '')"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="not rows">
                                            <tr>
                                                <td colspan="8" class="text-center text-muted py-4">暂无数据</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div t-if="pager.get('page_count', 1) > 1" class="card-footer">
                            <t t-call="portal.pager"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
