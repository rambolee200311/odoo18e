<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unified Breadcrumb Template with Slash Separator -->
    <template id="portal_breadcrumbs_slash" name="Breadcrumbs with Slash Separator">
        <t t-if="breadcrumbs">
            <nav aria-label="breadcrumb" class="o_portal_breadcrumbs mb-3">
                <ol class="breadcrumb">
                    <t t-foreach="breadcrumbs" t-as="breadcrumb">
                        <t t-if="breadcrumb.get('url')">
                            <li class="breadcrumb-item">
                                <a t-att-href="breadcrumb['url']">
                                    <t t-esc="breadcrumb['name']"/>
                                </a>
                            </li>
                        </t>
                        <t t-else="">
                            <li class="breadcrumb-item active" aria-current="page">
                                <t t-esc="breadcrumb['name']"/>
                            </li>
                        </t>
                    </t>
                </ol>
            </nav>
        </t>
    </template>
</odoo>
