<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_stock_operation_portal" model="ir.ui.view">
        <field name="name">res.users.form.stock.operation.portal</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="before">
                <group string="Stock Operation Portal" name="stock_operation_portal" groups="base.group_system">
                    <field name="stock_operation_owner_line_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    <field name="stock_operation_project_line_ids" widget="many2many_tags" domain="[('owner', 'in', stock_operation_owner_line_ids)]" options="{'no_create': True, 'no_open': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
