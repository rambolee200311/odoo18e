<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================== -->
    <!-- 3. 入库查询列表页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_inbounds" name="Inbound Orders">
            <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek Stock'}, {'url': None, 'name': 'Inbound Orders'}]"/>

            <div class="o_portal_content">
                <!-- 筛选表单 - 可折叠 -->
                <div class="card mb-4" id="inbound_filter_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-filter me-2"/>
                            Inbound Orders
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#inbound_filter_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="inbound_filter_collapse" class="collapse show">
                    <div class="card-body">
                        <form action="/my/marstek/inbounds" method="get" class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="inbound_no" class="form-label">Inbound No. / Reference</label>
                                <input type="search" class="form-control" id="inbound_no" name="inbound_no" t-attf-value="#{filters.get('inbound_no', '')}" placeholder="Enter inbound no. or reference"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="bl_no" class="form-label">BL No.</label>
                                <input type="search" class="form-control" id="bl_no" name="bl_no" t-attf-value="#{filters.get('bl_no', '')}" placeholder="Enter BL no."/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="container_no" class="form-label">Container No.</label>
                                <input type="search" class="form-control" id="container_no" name="container_no" t-attf-value="#{filters.get('container_no', '')}" placeholder="Enter container no."/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="portal_inbound_status" class="form-label">Status</label>
                                <select class="form-select" id="portal_inbound_status" name="portal_inbound_status">
                                    <option value="">All</option>
                                    <option value="inbound_confirmed" t-att-selected="'selected' if filters.get('portal_inbound_status') == 'inbound_confirmed' else None">Confirmed</option>
                                    <option value="inbound_processing" t-att-selected="'selected' if filters.get('portal_inbound_status') == 'inbound_processing' else None">Processing</option>
                                    <option value="inbound_done" t-att-selected="'selected' if filters.get('portal_inbound_status') == 'inbound_done' else None">Completed</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="inbound_date_from" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="inbound_date_from" name="inbound_date_from" t-attf-value="#{filters.get('inbound_date_from', '')}"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label for="inbound_date_to" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="inbound_date_to" name="inbound_date_to" t-attf-value="#{filters.get('inbound_date_to', '')}"/>
                            </div>
                            <div class="col-12 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fa fa-search me-1"/>
                                    Search
                                </button>
                                <a href="/my/marstek/inbounds" class="btn btn-secondary">
                                    <i class="fa fa-refresh me-1"/>
                                    Reset
                                </a>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <!-- 数据查询结果 - 可折叠 -->
                <div class="card" id="inbound_table_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Inbound List</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary me-1">Total: <t t-esc="pager.get('total', 0)"/></span>
                            <!-- 视图切换按钮 -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="View Switch">
                                <input type="radio" class="btn-check" name="view_mode" id="view_table" value="table" t-att-checked="'checked' if filters.get('view_mode') == 'table' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="view_table" title="Table View">
                                    <i class="fa fa-table"/>
                                    <span class="d-none d-sm-inline ms-1">Table</span>
                                </label>
                                <input type="radio" class="btn-check" name="view_mode" id="view_card" value="card" t-att-checked="'checked' if filters.get('view_mode') != 'table' else None" autocomplete="off"/>
                                <label class="btn btn-outline-primary" for="view_card" title="Card View">
                                    <i class="fa fa-th-large"/>
                                    <span class="d-none d-sm-inline ms-1">Card</span>
                                </label>
                            </div>
                            <!-- 导出按钮 -->
                            <a t-attf-href="/my/marstek/export/inbounds/csv?inbound_no=#{filters.get('inbound_no', '')}&amp;reference=#{filters.get('reference', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;container_no=#{filters.get('container_no', '')}&amp;portal_inbound_status=#{filters.get('portal_inbound_status', '')}&amp;inbound_date_from=#{filters.get('inbound_date_from', '')}&amp;inbound_date_to=#{filters.get('inbound_date_to', '')}"
                               t-attf-class="btn btn-primary export-btn #{'disabled' if not rows else ''}"
                               t-attf-title="#{'No data to export' if not rows else 'Export CSV'}">
                                <i class="fa fa-file-text-o"/>
                                <span class="d-none d-sm-inline ms-1">Export CSV</span>
                            </a>
                            <a t-attf-href="/my/marstek/export/inbounds/pdf?inbound_no=#{filters.get('inbound_no', '')}&amp;reference=#{filters.get('reference', '')}&amp;bl_no=#{filters.get('bl_no', '')}&amp;container_no=#{filters.get('container_no', '')}&amp;portal_inbound_status=#{filters.get('portal_inbound_status', '')}&amp;inbound_date_from=#{filters.get('inbound_date_from', '')}&amp;inbound_date_to=#{filters.get('inbound_date_to', '')}"
                               t-attf-class="btn btn-primary export-btn #{'disabled' if not rows else ''}"
                               t-attf-title="#{'No data to export' if not rows else 'Export PDF'}">
                                <i class="fa fa-file-pdf-o"/>
                                <span class="d-none d-sm-inline ms-1">Export PDF</span>
                            </a>
                            <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#inbound_table_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                    </div>
                    <div id="inbound_table_collapse" class="collapse show">
                        <!-- 表格视图 -->
                        <div id="table_view" class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Inbound No.</th>
                                            <th>Reference</th>
                                            <th>BL No.</th>
                                            <th>Container No.</th>
                                            <th>Inbound Date</th>
                                            <th>Status</th>
                                            <th class="text-end">Total Qty</th>
                                            <th class="text-end">Pallets</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="row">
                                            <tr>
                                                <td>
                                                    <a t-if="row.get('inbound_id')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/inbounds/#{row.get('inbound_id')}">
                                                        <t t-esc="row.get('inbound_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('inbound_no', '')"/></t>
                                                </td>
                                                <td><t t-esc="row.get('reference', '')"/></td>
                                                <td>
                                                    <a t-if="row.get('bl_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/inbounds?bl_no=#{row.get('bl_no', '')}">
                                                        <t t-esc="row.get('bl_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('bl_no', '')"/></t>
                                                </td>
                                                <td>
                                                    <a t-if="row.get('container_no')" class="text-primary text-decoration-none fw-bold cursor-pointer" t-attf-href="/my/marstek/stock?container_no=#{row.get('container_no', '')}">
                                                        <t t-esc="row.get('container_no', '')"/>
                                                    </a>
                                                    <t t-else=""><t t-esc="row.get('container_no', '')"/></t>
                                                </td>
                                                <td><t t-esc="row.get('inbound_date', '')"/></td>
                                                <td>
                                                    <t t-if="row.get('portal_inbound_status') == 'inbound_confirmed'">
                                                        <span class="badge bg-info">Confirmed</span>
                                                    </t>
                                                    <t t-elif="row.get('portal_inbound_status') == 'inbound_processing'">
                                                        <span class="badge bg-warning">Processing</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-success">Completed</span>
                                                    </t>
                                                </td>
                                                <td class="text-end"><t t-esc="row.get('total_quantity', 0)"/></td>
                                                <td class="text-end"><t t-esc="row.get('total_pallets', 0)"/></td>
                                                <td>
                                                    <a t-attf-href="/my/marstek/inbounds/#{row.get('inbound_id')}" class="btn btn-sm btn-outline-primary">
                                                        View Details
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="not rows">
                                            <tr>
                                                <td colspan="9" class="text-center text-muted py-4">No data found</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- 卡片视图 -->
                        <div id="card_view" class="card-body p-3" style="display: none; text-align: left;">
                            <div class="stock-card-list" style="text-align: left;">
                                <t t-foreach="rows" t-as="row">
                                    <div class="stock-card-item" t-attf-data-inbound-id="{{ row.get('inbound_id') }}" style="text-align: left;">
                                        <!-- 卡片标题：点击折叠/展开 -->
                                        <div class="card-item-header" onclick="marstekToggleInboundCard(this)" style="display: flex; justify-content: space-between; align-items: flex-start;">
                                            <div class="card-summary" style="display: flex; flex-direction: column; gap: 6px; flex: 1; justify-content: flex-start;">
                                                <div class="summary-row" style="display: flex; align-items: center; gap: 8px; justify-content: flex-start;">
                                                    <span class="summary-item" style="display: flex; align-items: center; gap: 4px;">
                                                        <i class="fa fa-file-text-o me-1 text-primary"></i>
                                                        <strong>Reference:</strong> <t t-esc="row.get('reference', 'N/A')"/>
                                                    </span>
                                                </div>
                                                <div class="summary-row" style="display: flex; align-items: center; gap: 8px; justify-content: flex-start;">
                                                    <span class="summary-item" style="display: flex; align-items: center; gap: 4px;">
                                                        <i class="fa fa-cube me-1 text-info"></i>
                                                        <strong>Pallet:</strong> <t t-esc="row.get('pallet_summary', 'N/A')"/>
                                                    </span>
                                                </div>
                                                <div class="summary-row" style="display: flex; align-items: center; gap: 8px; justify-content: flex-start;">
                                                    <span class="summary-item" style="display: flex; align-items: center; gap: 4px;">
                                                        <i class="fa fa-shopping-cart me-1 text-success"></i>
                                                        <strong>Product:</strong> <t t-esc="row.get('product_summary', 'N/A')"/>
                                                    </span>
                                                    <span class="summary-status">
                                                        <t t-if="row.get('portal_inbound_status') == 'inbound_confirmed'">
                                                            <span class="badge bg-info">Confirmed</span>
                                                        </t>
                                                        <t t-elif="row.get('portal_inbound_status') == 'inbound_processing'">
                                                            <span class="badge bg-warning">Processing</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-success">Completed</span>
                                                        </t>
                                                    </span>
                                                </div>
                                            </div>
                                            <i class="card-arrow fa fa-chevron-down"></i>
                                        </div>
                                        <!-- 卡片详情：默认隐藏，点击展开时通过 AJAX 加载 -->
                                        <div class="card-item-details"></div>
                                    </div>
                                </t>
                                <t t-if="not rows">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-inbox fa-3x mb-3"></i>
                                        <p>No data found</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div t-if="pager.get('page_count', 1) > 1" class="card-footer">
                            <t t-call="portal.pager"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 4. 入库详情页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_inbound_detail" name="Inbound Detail">
            <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek Stock'}, {'url': '/my/marstek/inbounds', 'name': 'Inbound Orders'}, {'url': None, 'name': 'Inbound Detail'}]"/>

            <div class="o_portal_content">
                <!-- 入库单信息 - 可折叠 -->
                <div class="card mb-4" id="inbound_order_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-file-text-o me-2"/>
                            Inbound Order Info
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#inbound_order_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <!-- 始终显示的基础信息 -->
                    <div class="card-body pt-3 pb-2 border-bottom bg-light">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">Inbound No.</strong>
                                <div class="fw-bold"><t t-esc="order.billno if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">Reference</strong>
                                <div><t t-esc="order.reference if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">Inbound Date</strong>
                                <div><t t-esc="order.i_date if order else ''"/></div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <strong class="text-muted small">Status</strong>
                                <div>
                                    <t t-if="order and order.state == 'confirm'">
                                        <span class="badge bg-success">Confirmed</span>
                                    </t>
                                    <t t-elif="order and order.state == 'cancel'">
                                        <span class="badge bg-danger">Cancelled</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-secondary">New</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- 可折叠的详细信息 -->
                    <div id="inbound_order_collapse" class="collapse show">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <strong>BL No.:</strong>
                                    <span class="ms-2"><t t-esc="order.bl_no if order else ''"/></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>Container No.:</strong>
                                    <span class="ms-2"><t t-esc="order.cntr_no if order else ''"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 货盘明细 - 可折叠 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-list me-2"/>
                            Pallet Details
                        </h5>
                        <button class="btn btn-link text-decoration-none float-end p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#inbound_detail_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="inbound_detail_collapse" class="collapse show">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 inbound-detail-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Pallet No.</th>
                                            <th>Container No.</th>
                                            <th>BL No.</th>
                                            <th>Product Code</th>
                                            <th>Product Name</th>
                                            <th class="text-end">Qty</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="detail_rows" t-as="row">
                                            <tr>
                                                <td><t t-esc="row.get('package_name', '')"/></td>
                                                <td><t t-esc="row.get('container_no', '')"/></td>
                                                <td><t t-esc="row.get('bl_no', '')"/></td>
                                                <td><t t-esc="row.get('product_code', '')"/></td>
                                                <td><t t-esc="row.get('product_name', '')"/></td>
                                                <td class="text-end"><t t-esc="row.get('quantity', 0)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="not detail_rows">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">No data found</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 附件列表 - 可折叠 -->
                <t t-if="attachment_rows">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0 d-inline">
                                <i class="fa fa-paperclip me-2"/>
                                Attachments
                            </h5>
                            <button class="btn btn-link text-decoration-none float-end p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#inbound_attachment_collapse" aria-expanded="true">
                                <i class="fa fa-chevron-up collapse-icon"/>
                            </button>
                        </div>
                        <div id="inbound_attachment_collapse" class="collapse show">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0 inbound-attachment-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>File Name</th>
                                                <th>Type</th>
                                                <th>Size</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="attachment_rows" t-as="att">
                                                <tr>
                                                    <td><t t-esc="att.get('file_name', '')"/></td>
                                                    <td><t t-esc="att.get('file_type', '')"/></td>
                                                    <td><t t-esc="att.get('file_size', 0)"/> bytes</td>
                                                    <td class="text-center">
                                                        <a t-if="att.get('download_url')" t-attf-href="#{att.get('download_url')}" class="btn btn-sm btn-primary" target="_blank">
                                                            <i class="fa fa-download me-1"/>
                                                            Download
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- 返回按钮 -->
                <div class="mt-4">
                    <a href="/my/marstek/inbounds" class="btn btn-secondary">
                        <i class="fa fa-arrow-left me-1"/>
                        Back to List
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
