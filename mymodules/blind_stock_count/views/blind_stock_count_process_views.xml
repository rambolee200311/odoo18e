<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blind_stock_count_clearance_batch_form" model="ir.ui.view">
        <field name="name">blind.stock.count.clearance.batch.form</field>
        <field name="model">blind.stock.count.clearance.batch</field>
        <field name="arch" type="xml">
            <form string="Blind Stock Count Clearance Batch" duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" readonly="1"/>
                            <field name="work_package_id" required="1" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="category_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="requested_by_id" required="1" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="requested_at" required="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" required="1" readonly="1"/>
                            <field name="maximum_lines_per_clearance" required="1" readonly="1"/>
                            <field name="source_quant_count" required="1" readonly="1"/>
                            <field name="normalized_negative_quant_count" required="1" readonly="1"/>
                            <field name="released_orphan_reservation_quant_count" required="1" readonly="1"/>
                            <field name="released_orphan_reservation_quantity" required="1" readonly="1"/>
                            <field name="location_line_ids" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="error_message" readonly="1" invisible="not error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outbound Pickings">
                            <field name="outbound_picking_lines" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <header>
                                        <button name="action_queue_validate_blind_stock_count_pickings" type="object" string="Queue Validate Selected Pickings" class="btn-primary" groups="blind_stock_count.group_blind_stock_count_administrator,base.group_system"/>
                                    </header>
                                    <field name="name"/>
                                    <field name="picking_type_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="location_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="location_dest_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="state" widget="badge"/>
                                    <field name="blind_stock_count_validation_state" widget="badge" optional="hide"/>
                                    <field name="blind_stock_count_validation_error" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
