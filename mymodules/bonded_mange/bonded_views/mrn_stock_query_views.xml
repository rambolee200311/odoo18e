<!-- /.../bonded_views/mrn_stock_query_views.xml -->
<odoo>
    <record id="view_bonded_mrn_stock_query_list" model="ir.ui.view">
        <field name="name">bonded.mrn.stock.query.list</field>
        <field name="model">bonded.mrn.stock.query</field>
        <field name="arch" type="xml">
            <list create="1" edit="1" delete="1" default_order="id desc">
                <field name="name"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="product_id"/>
                <field name="mrn_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bonded_mrn_stock_query_form" model="ir.ui.view">
        <field name="name">bonded.mrn.stock.query.form</field>
        <field name="model">bonded.mrn.stock.query</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button name="action_query_mrn_stock" type="object" string="Query" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="actionBackToDraft" type="object" string="Back To Draft" class="btn-secondary"
                            invisible="state != 'done'" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state == 'done'"/>
                        <field name="start_time" required="1" readonly="state == 'done'"/>
                        <field name="end_time" required="1" readonly="state == 'done'"/>
                        <field name="unique_identifier" readonly="state == 'done'"/>
                        <field name="product_id" readonly="state == 'done'"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="mrn_id" readonly="state == 'done'" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="query_lines" nolabel="1" readonly="1"
                               options="{'no_create': True, 'no_open': True}">
                            <list create="0" edit="0" delete="0" default_order="id desc">
                                <field name="mrn_id"/>
                                <field name="product_id"/>
                                <field name="unique_identifier"/>
                                <field name="product_barcode"/>
                                <field name="product_weight"/>
                                <field name="customs_status" widget="badge"/>
                                <field name="mrn_status" widget="badge"/>
                                <field name="inbound_no"/>
                                <field name="outbound_no"/>
                                <field name="opening_qty"/>
                                <field name="inbound_qty"/>
                                <field name="outbound_qty"/>
                                <field name="stock_qty"/>
                                <field name="available_stock_qty"/>
                                <field name="operator_id" optional="show"/>
                                <field name="change_time" optional="show"/>
                                <field name="remark" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bonded_mrn_stock_query_search" model="ir.ui.view">
        <field name="name">bonded.mrn.stock.query.search</field>
        <field name="model">bonded.mrn.stock.query</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="mrn_id"/>
                <field name="unique_identifier"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="action_bonded_mrn_stock_query" model="ir.actions.act_window">
        <field name="name">Bonded Product Stock Query</field>
        <field name="res_model">bonded.mrn.stock.query</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_mange.view_bonded_mrn_stock_query_search"/>
    </record>

    <menuitem id="menu_bonded_mrn_stock_query" name="Bonded Product Stock Query"
              parent="bonded_mange.menu_bonded_root" action="action_bonded_mrn_stock_query" sequence="983"
              groups="base.group_user"/>
</odoo>
