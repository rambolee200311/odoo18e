<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_vas_user" model="res.groups">
        <field name="name">VAS User</field>
    </record>

    <record id="group_vas_manager" model="res.groups">
        <field name="name">VAS Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_vas_user'))]"/>
    </record>

    <record id="rule_vas_order_user_own" model="ir.rule">
        <field name="name">VAS User: own orders</field>
        <field name="model_id" ref="model_wd_vas_order"/>
        <field name="groups" eval="[(4, ref('group_vas_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_vas_order_manager_all" model="ir.rule">
        <field name="name">VAS Manager: all orders</field>
        <field name="model_id" ref="model_wd_vas_order"/>
        <field name="groups" eval="[(4, ref('group_vas_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_vas_order_line_user_own" model="ir.rule">
        <field name="name">VAS User: own order lines</field>
        <field name="model_id" ref="model_wd_vas_order_line"/>
        <field name="groups" eval="[(4, ref('group_vas_user'))]"/>
        <field name="domain_force">[('order_id.create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_vas_order_line_manager_all" model="ir.rule">
        <field name="name">VAS Manager: all order lines</field>
        <field name="model_id" ref="model_wd_vas_order_line"/>
        <field name="groups" eval="[(4, ref('group_vas_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
