<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wd_qooling_app.TemperaturePda">
        <main t-att-class="'o_qooling_pda ' + (isReadOnly ? 'is-readonly' : '')" data-testid="temperature-pda">
            <header class="o_qooling_pda__header"><div><span class="text-muted">FORMS / PDA</span><h1>Temperature Record <span class="o_qooling_pda__record-name" data-testid="temperature-pda-record-name"><t t-esc="state.record.name || 'New'"/></span></h1></div><button class="btn btn-outline-secondary" type="button" t-on-click="openWebForm">Open web form</button></header>
            <div t-if="state.error" class="alert alert-danger o_qooling_pda__feedback" data-testid="temperature-pda-error"><t t-esc="state.error"/></div>
            <div t-if="state.saved" class="alert alert-success o_qooling_pda__feedback" data-testid="temperature-pda-feedback"><t t-esc="state.saved"/></div>
            <div t-if="isReadOnly" class="alert alert-info" role="status">This record is read-only.</div>
            <section class="o_qooling_pda__body">
                <section class="o_qooling_pda__section" data-testid="temperature-pda-details">
                    <h2 class="o_qooling_pda__section-title">Details</h2>
                    <label>Date<input class="form-control" type="datetime-local" data-field="date" t-att-value="state.record.date" t-on-input="onFieldChange"/></label>
                    <label>Manager<select class="form-select" data-field="manager_id" t-on-change="onFieldChange"><option value="">Select manager</option><t t-foreach="state.users" t-as="user" t-key="user.id"><option t-att-value="user.id" t-att-selected="state.record.manager_id === user.id"><t t-esc="user.name"/></option></t></select></label>
                    <label>Customer<input class="form-control" data-field="customer" t-att-value="state.record.customer || ''" t-on-input="onFieldChange"/></label>
                    <label>Container number<input class="form-control" data-field="container_number" t-att-value="state.record.container_number || ''" t-on-input="onFieldChange"/></label>
                    <label>Location<select class="form-select" data-field="location_id" t-on-change="onFieldChange"><option value="">Select location</option><t t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id"><option t-att-value="warehouse.id" t-att-selected="state.record.location_id === warehouse.id"><t t-esc="warehouse.name"/></option></t></select></label>
                </section>
                <section class="o_qooling_pda__section" data-testid="temperature-pda-temperatures">
                    <h2 class="o_qooling_pda__section-title">Pallet temperatures</h2>
                    <form t-on-submit="addTemperature"><label>Quick temperature (°C)<input class="form-control" type="number" step="0.1" t-model="state.quickTemperature" data-testid="temperature-pda-quick-temperature"/></label></form>
                    <div class="list-group"><div t-foreach="state.lines" t-as="line" t-key="line.id" class="list-group-item d-flex gap-2"><strong><t t-esc="line.pallet_number"/></strong><input class="form-control" type="number" step="0.1" t-att-value="line.temperature" t-on-change="(event) => updateLine(line, event)"/></div></div>
                    <button type="button" class="btn btn-outline-danger mt-3" t-on-click="clearAll">Clear all temperatures</button>
                </section>
                <section class="o_qooling_pda__section" data-testid="temperature-pda-checks">
                    <h2 class="o_qooling_pda__section-title">Checks</h2>
                    <t t-foreach="checks" t-as="check" t-key="check[0]"><label><t t-esc="check[1]"/><select class="form-select" t-att-data-field="check[0]" t-on-change="onFieldChange"><option value="">Not recorded</option><option value="yes" t-att-selected="state.record[check[0]] === 'yes'">Yes</option><option value="no" t-att-selected="state.record[check[0]] === 'no'">No</option></select></label></t>
                </section>
                <section class="o_qooling_pda__section" data-testid="temperature-pda-evidence">
                    <h2 class="o_qooling_pda__section-title">Evidence</h2>
                    <div t-if="!isReadOnly" class="o_qooling_pda__upload"><label class="btn btn-secondary me-2"><i class="fa fa-camera me-1"/> Take photo<input class="d-none" type="file" accept="image/*" capture="environment" t-att-disabled="state.busy" t-on-change="onPhoto"/></label><label class="btn btn-secondary"><i class="fa fa-video-camera me-1"/> Record video<input class="d-none" type="file" accept="video/*" capture="environment" t-att-disabled="state.busy" t-on-change="onPhoto"/></label><label class="btn btn-outline-secondary ms-2"><i class="fa fa-paperclip me-1"/> Attach media<input class="d-none" type="file" accept="image/*,video/*" multiple="multiple" t-att-disabled="state.busy" t-on-change="onPhoto"/></label></div>
                    <ImagePreviewComponent t-if="state.photos.length" attachments="state.photos" editable="!isReadOnly" onRemove.bind="deletePhoto"/>
                    <label>Comments<textarea class="form-control" data-field="comments" t-on-input="onFieldChange"><t t-esc="state.record.comments || ''"/></textarea></label>
                </section>
                <section class="o_qooling_pda__section" data-testid="temperature-pda-signature">
                    <h2 class="o_qooling_pda__section-title">Signature</h2>
                    <canvas t-ref="signatureCanvas" class="o_qooling_pda__signature" data-testid="temperature-pda-signature-canvas" t-on-pointerdown="startSignature" t-on-pointermove="moveSignature" t-on-pointerup="endSignature" t-on-pointercancel="endSignature" t-on-touchstart="startSignature" t-on-touchmove="moveSignature" t-on-touchend="endSignature"/>
                    <button t-if="!isReadOnly" type="button" class="btn btn-outline-secondary mt-2" t-on-click="clearSignature">Clear signature</button>
                </section>
            </section>
            <footer class="o_qooling_pda__footer"><button t-if="!isReadOnly" class="btn btn-outline-primary" type="button" t-on-click="save" t-att-disabled="state.busy">Save draft</button><button t-if="!isReadOnly" class="btn btn-success" type="button" t-on-click="submit" t-att-disabled="state.busy">Submit</button></footer>
        </main>
    </t>
</templates>
