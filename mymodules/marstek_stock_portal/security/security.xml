            <field name="model_id" ref="worlddepot.model_world_depot_outbound_order_product"/>
            <field name="domain_force">[('outbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_outbound_order_docs_portal" model="ir.rule">
            <field name="name">Marstek Portal Outbound Docs Project</field>
            <field name="model_id" ref="worlddepot.model_world_depot_outbound_order_docs"/>
            <field name="domain_force">[('outbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_outbound_order_sn_detail_portal" model="ir.rule">
            <field name="name">Marstek Portal Outbound SN Detail Project</field>
            <field name="model_id" ref="worlddepot.model_world_depot_outbound_order_sn_detail"/>
            <field name="domain_force">[('project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
