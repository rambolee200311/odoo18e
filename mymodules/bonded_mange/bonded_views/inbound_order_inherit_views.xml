<odoo>
    <record id="view_inbound_order_product_form_trade_ref_inherit" model="ir.ui.view">
        <field name="name">inbound.order.product.form.trade.ref.inherit</field>
        <field name="model">world.depot.inbound.order.product</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbound_order_product_pallet_ids']/list/field[@name='product_id']"
                   position="before">
                <field name="is_bonded" column_invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='inbound_order_product_pallet_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="origin_country" required="is_bonded" options="{'no_create': True, 'no_open': True}"/>
                <field name="goods_value" required="is_bonded"/>
                <field name="hs_code" readonly="1" required="is_bonded"/>
                <field name="weight" required="is_bonded"/>
                <field name="customs_code" readonly="1" required="is_bonded"/>
            </xpath>
        </field>
    </record>










    <record id="view_inbound_order_form_identifier_inherit" model="ir.ui.view">
        <field name="name">inbound.order.form.identifier.inherit</field>
        <field name="model">world.depot.inbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pick_type']" position="after">
                <field name="unique_identifier" readonly="1"/>
                <field name="file_identifier"  readonly="state != 'new'"/>
                 <field name="t1_document_number" required="is_bonded==True" readonly="state != 'new'"/>
                <field name="t1_status" readonly="state != 'new'"/>
                <field name="t1_closed_date" readonly="1"/>
                <field name="used_mrn_ids" invisible="1"/>

                <field name="mrn_id" readonly="state != 'new'" options="{'no_open': True}"/>
                <field name="mrn_status" readonly="1"/>
<!--                <button name="action_open_mrn_detail" type="object" string="MRN Detail" class="btn-link" icon="fa-external-link" invisible="not mrn_id"/>-->
            </xpath>
        </field>
    </record>



    <record id="view_inbound_order_search_identifier_inherit" model="ir.ui.view">
        <field name="name">inbound.order.search.identifier.inherit</field>
        <field name="model">world.depot.inbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='billno']" position="after">
                <field name="unique_identifier"/>
                <field name="file_identifier"/>
                <field name="mrn_id" readonly="1"/>
                <field name="mrn_status"/>
            </xpath>
            <xpath expr="//search/filter[@name='state_not_cancel']" position="before">
                <filter name="has_unique_identifier" string="Has Unique Identifier"
                        domain="[('unique_identifier', '!=', False)]"/>
                <filter name="has_file_identifier" string="Has File Identifier"
                        domain="[('file_identifier', '!=', False)]"/>

                <filter name="mrn_status_pending" string="MRN Pending" domain="[('mrn_status', '=', 'pending_declaration')]"/>
                <filter name="mrn_status_declared" string="MRN Declared" domain="[('mrn_status', '=', 'declared')]"/>
                <filter name="mrn_status_cleared" string="MRN Cleared" domain="[('mrn_status', '=', 'cleared')]"/>
            </xpath>
        </field>
    </record>
</odoo>