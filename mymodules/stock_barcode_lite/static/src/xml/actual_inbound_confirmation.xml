<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="stock_barcode_lite.ActualInboundConfirmationPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="none"
            touch-action="none"
        />

        <div class="o_sbl_inbound">
            <div class="o_sbl_header">
                <button type="button" class="btn btn-link text-dark p-1" t-on-click="exit" title="Home">
                    <i class="fa fa-arrow-left"/>
                </button>
                <div class="o_sbl_header_title">
                    <i class="fa fa-check-circle text-primary me-1"/>
                    Actual Inbound Confirmation
                </div>
            </div>

            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                <t t-esc="state.message"/>
            </div>

            <div class="o_sbl_step_indicator">
                <div class="o_step_item active">
                    <div class="o_step_circle">1</div>
                    <div class="o_step_label">Scan Order</div>
                </div>
            </div>

            <div class="o_sbl_step_hint">
                <i class="fa fa-qrcode me-2"/>
                Scan the inbound order QR code to confirm actual inbound
            </div>

            <div class="o_sbl_empty_state text-center text-muted py-5">
                <i class="fa fa-truck-loading fa-4x mb-3 d-block opacity-25"/>
                <p class="mb-1 fw-bold">Ready to Scan</p>
                <p class="small">Scan an inbound order barcode to open the confirmation wizard</p>
            </div>

            <div class="o_sbl_footer">
                <button class="btn btn-secondary" t-on-click="exit">
                    <i class="fa fa-home me-1"/>Home
                </button>
            </div>
        </div>
    </t>
</templates>