<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_charge_line_view_list" model="ir.ui.view">
        <field name="name">bonded.charge.line.list</field>
        <field name="model">bonded.charge.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="charge_date"/>
                <field name="bonded_book_id"/>
                <field name="charge_item_id"/>
                <field name="charge_unit_id"/>
                <field name="quantity"/>
                <field name="unit_price" widget="monetary"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bonded_charge_line_view_form" model="ir.ui.view">
        <field name="name">bonded.charge.line.form</field>
        <field name="model">bonded.charge.line</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <sheet>
                    <group>
                        <group string="Charge">
                            <field name="charge_item_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="charge_unit_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="charge_date" required="1"/>
                            <field name="quantity" required="1"/>
                            <field name="unit_price" required="1" widget="monetary"/>
                            <field name="amount" readonly="1" widget="monetary"/>
                            <field name="currency_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group string="References">
                            <field name="bonded_book_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="customs_file_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="bonded_inbound_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="bonded_outbound_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="gate_arrival_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
