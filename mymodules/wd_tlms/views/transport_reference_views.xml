<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_transport_reference_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.reference.tree</field>
        <field name="model">tlmp.transport.reference</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref_type"/>
                <field name="ref_value"/>
                <field name="reference_role"/>
                <field name="source_system"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="partner_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_transport_reference_form" model="ir.ui.view">
        <field name="name">tlmp.transport.reference.form</field>
        <field name="model">tlmp.transport.reference</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="ref_type"/>
                            <field name="ref_value"/>
                            <field name="reference_role"/>
                            <field name="source_system"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Linked Document" name="linked">
                            <group>
                                <field name="res_model"/>
                                <field name="res_id"/>
                                <field name="reference" widget="selection"/>
                            </group>
                            <button name="action_open_linked_document"
                                    string="Open Linked Document"
                                    type="object"
                                    invisible="not res_model or not res_id"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tlmp_transport_reference_search" model="ir.ui.view">
        <field name="name">tlmp.transport.reference.search</field>
        <field name="model">tlmp.transport.reference</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref_value"/>
                <field name="ref_type"/>
                <field name="reference_role"/>
                <field name="source_system"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_tlmp_transport_reference" model="ir.actions.act_window">
        <field name="name">Transport References</field>
        <field name="res_model">tlmp.transport.reference</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
