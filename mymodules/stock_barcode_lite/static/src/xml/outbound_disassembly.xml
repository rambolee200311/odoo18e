<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!-- 拆托出库页面 - 货位 -> 托盘 -> [整托自动完成 | 拆托扫产品] (Backend-driven) -->
    <t t-name="stock_barcode_lite.DisassemblyOutboundPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="none"
            touch-action="none"
        />

        <div class="o_sbl_inbound o_sbl_disassembly_outbound">
            <div class="o_sbl_outbound_sticky_top">
                <!-- Header -->
                <div class="o_sbl_header">
                    <button type="button" class="btn btn-link text-dark p-1" t-on-click="exit" title="Home">
                        <i class="fa fa-arrow-left"/>
                    </button>
                    <div class="o_sbl_header_title">
                        <i class="fa fa-truck text-primary me-1"/>
                        <t t-if="orderReference">
                            <t t-esc="orderReference"/>
                        </t>
                        <t t-else="">Break Bulk Pick</t>
                    </div>
                    <div class="o_sbl_scan_mode" t-attf-class="o_mode_{{ state.nextStep }}">
                        <t t-esc="scanModeLabel"/>
                    </div>
                </div>

                <!-- 提示条 -->
                <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                    <t t-esc="state.message"/>
                </div>

                <!-- 出库单信息 -->
<!--            <div t-if="hasOrder" class="o_sbl_order_info">-->
<!--                <div class="o_order_row1">-->
<!--                    <span class="o_order_origin">-->
<!--                        <t t-if="orderOrigin"><t t-esc="orderOrigin"/></t>-->
<!--                    </span>-->
<!--                    <span class="o_order_partner">-->
<!--                        <i class="fa fa-user me-1"/>-->
<!--                        <t t-esc="orderPartner"/>-->
<!--                    </span>-->
<!--                </div>-->
<!--                <div class="o_order_row2" t-if="relatedPickingMessage">-->
<!--                    <i class="fa fa-exclamation-triangle text-warning me-1"/>-->
<!--                    <span class="text-warning"><t t-esc="relatedPickingMessage"/></span>-->
<!--                </div>-->
<!--            </div>-->

                <!-- 当前货位信息 -->
                <div t-if="hasLocation" class="o_sbl_location_bar">
                    <i class="fa fa-map-marker text-danger me-1"/>
                    <span class="me-1">Location:</span>
                    <strong class="text-primary"><t t-esc="currentLocationName"/></strong>
                    <span class="text-muted ms-1" t-if="currentLocationBarcode">(<t t-esc="currentLocationBarcode"/>)</span>
                </div>

                <!-- 当前Picking名称 -->
                <div t-if="hasOrder" class="o_sbl_picking_bar o_sbl_picking_summary">
                    <div class="o_picking_info_row">
                        <span class="o_picking_label">
                            <i class="fa fa-clipboard-list text-primary me-1"/>
                            Current Picking:
                        </span>
                        <span class="o_picking_name text-primary fw-bold">
                            <t t-esc="pickingDisplayName"/>
                        </span>
                        <span class="o_picking_state badge ms-2" t-attf-class="bg-{{ pickingStateBadgeClass }}">
                            <t t-esc="pickingStateLabel"/>
                        </span>
                    </div>
                </div>

                <!-- 当前Picking的其他信息 -->
                <div t-if="hasOrder" class="o_sbl_picking_bar o_sbl_picking_details">
                    <div class="o_picking_extra">
<!--                    <span t-if="orderOrigin" class="me-3">-->
<!--                        <i class="fa fa-link text-muted me-1"/>-->
<!--                        <t t-esc="orderOrigin"/>-->
<!--                    </span>-->
                        <span t-if="orderPartner">
                            <i class="fa fa-user text-muted me-1"/>
                            <t t-esc="orderPartner"/>
                        </span>
                        <span>
                            <i class="fa fa-cubes text-muted me-1"/>
                            Demand:
                            <strong class="ms-1">
                                <t t-esc="state.summary.scanned_quantity || 0"/> / <t t-esc="state.summary.total_quantity || 0"/>
                            </strong>
                        </span>
                    </div>
                    <button t-if="orderProductLines.length > 0"
                            type="button"
                            class="o_picking_products_toggle"
                            t-on-click="toggleOrderProductDetails"
                            t-att-aria-expanded="state.orderProductDetailsExpanded ? 'true' : 'false'">
                        <span>
                            <i class="fa fa-cubes text-muted me-1"/>
                            Product Details (<t t-esc="orderProductLines.length"/>)
                        </span>
                        <i t-if="state.orderProductDetailsExpanded" class="fa fa-chevron-up"/>
                        <i t-else="" class="fa fa-chevron-down"/>
                    </button>
                    <div t-if="state.orderProductDetailsExpanded" class="o_picking_products_list">
                        <t t-foreach="orderProductLines" t-as="item" t-key="item.order_product_key">
                            <div class="o_picking_product_line">
                                <div class="o_picking_product_info">
                                    <span class="o_picking_product_name">
                                        <t t-esc="item.product_barcode || item.default_code || item.product_name || 'Product'"/>
                                    </span>
                                </div>
                                <span class="o_picking_product_qty">
                                    <strong><t t-esc="item.scanned_quantity || 0"/> / <t t-esc="item.required_quantity || 0"/></strong>
                                </span>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- ═══ 扫描提示步骤条：Order -> Location -> Pallet -> [Product] [Lot] [Quantity] ═══ -->
            <div class="o_sbl_step_indicator">
                <div class="o_step_item" t-att-class="{ 'active': isScanOrderStep, 'done': hasOrder }">
                    <div class="o_step_circle">
                        <t t-if="hasOrder"><i class="fa fa-check"/></t>
                        <t t-else="">1</t>
                    </div>
                    <div class="o_step_label">Order</div>
                </div>
                <div class="o_step_line" t-att-class="{ 'active': hasOrder }"/>
                <div class="o_step_item" t-att-class="{ 'active': isScanLocationStep, 'done': hasLocation }">
                    <div class="o_step_circle">
                        <t t-if="hasLocation"><i class="fa fa-check"/></t>
                        <t t-else="">2</t>
                    </div>
                    <div class="o_step_label">Location</div>
                </div>
                <div class="o_step_line" t-att-class="{ 'active': hasLocation }"/>
                <div class="o_step_item" t-att-class="{ 'active': isScanPalletStep, 'done': state.stepProgress.palletDone }">
                    <div class="o_step_circle">
                        <t t-if="state.stepProgress.palletDone"><i class="fa fa-check"/></t>
                        <t t-else="">3</t>
                    </div>
                    <div class="o_step_label">Pallet</div>
                </div>
                <div class="o_step_line" t-att-class="{ 'active': isScanProductStep || isScanLotStep || isScanQuantityStep }"/>
                <div class="o_step_item" t-att-class="{ 'active': isScanProductStep, 'done': state.stepProgress.productDone }">
                    <div class="o_step_circle">
                        <t t-if="state.stepProgress.productDone"><i class="fa fa-check"/></t>
                        <t t-else="">4</t>
                    </div>
                    <div class="o_step_label">Product</div>
                </div>
                <div class="o_step_line" t-att-class="{ 'active': isScanLotStep || isScanQuantityStep }"/>
                <div class="o_step_item" t-att-class="{ 'active': isScanLotStep, 'done': state.stepProgress.lotDone }">
                    <div class="o_step_circle">
                        <t t-if="state.stepProgress.lotDone"><i class="fa fa-check"/></t>
                        <t t-else="">5</t>
                    </div>
                    <div class="o_step_label">Lot/SN</div>
                </div>
<!--                <div class="o_step_line" t-attf-class="{ active: isScanQuantityStep }"/>-->
<!--                <div class="o_step_item" t-attf-class="{ active: isScanQuantityStep }">-->
<!--                    <div class="o_step_circle">6</div>-->
<!--                    <div class="o_step_label">Quantity</div>-->
<!--                </div>-->
            </div>

            <!-- 扫描提示 -->
            <div class="o_sbl_step_hint">
                <i class="fa fa-qrcode me-2"/>
                <t t-esc="stepHint"/>
            </div>

            <!-- 数量输入 -->
            <div t-if="isScanQuantityStep" class="o_sbl_quantity_panel card mb-3">
                <div class="card-body">
                    <div class="o_quantity_context mb-2">
                        <span class="badge bg-info me-1">Product</span>
                        <strong><t t-esc="state.currentProduct?.display_name || state.currentProduct?.name || ''"/></strong>
                        <span class="text-muted ms-2" t-if="state.currentProduct?.default_code">
                            (<t t-esc="state.currentProduct.default_code"/>)
                        </span>
                        <span class="badge bg-secondary ms-2" t-if="state.currentLot?.name">Lot: <t t-esc="state.currentLot.name"/></span>
                    </div>
                    <div class="input-group">
                        <input
                            type="number"
                            step="any"
                            min="0"
                            class="form-control"
                            placeholder="Quantity"
                            t-att-value="state.quantityInput"
                            t-on-input="onQuantityInput"
                            t-on-keydown="submitQuantity"
                            autofocus="autofocus"
                        />
                        <button class="btn btn-primary"
                                style="background-color: #0d6efd; border-color: #0d6efd; color: white;"
                                t-on-click="submitQuantity"
                                t-att-disabled="state.loading">
                            <i class="fa fa-check me-1"/>Confirm
                        </button>
                    </div>
                </div>
            </div>

            <!-- 进度条 -->
            <div class="o_sbl_progress" t-if="state.summary &amp;&amp; state.summary.total_pallets > 0">
                <div class="progress">
                    <div class="progress-bar"
                         t-attf-style="width: {{ progressPercent }}%"
                         t-attf-class="bg-{{ progressPercent === 100 ? 'success' : 'primary' }}"/>
                </div>
            </div>
            <div class="o_sbl_progress_text" t-if="state.summary &amp;&amp; state.summary.total_pallets > 0">
                <span class="me-2">
                    <i class="fa fa-tasks me-1"/>
                    <t t-esc="progressPercent"/>%
                </span>
                <span class="me-2">
                    <t t-esc="state.summary.completed_pallets || 0"/> / <t t-esc="state.summary.total_pallets || 0"/> pallets
                </span>
                <span class="ms-auto">
                    <span class="badge" t-attf-class="{{ isAllComplete ? 'bg-success' : 'bg-warning text-dark' }}">
                        <t t-if="isAllComplete">
                            <i class="fa fa-check-circle me-1"/>All Done
                        </t>
                        <t t-else="">
                            <t t-esc="state.summary.pending_pallets || 0"/> pallets pending
                        </t>
                    </span>
                </span>
            </div>

            <!-- 托盘列表 -->
            <div class="o_sbl_pallets">
                <t t-if="palletList.length === 0 &amp;&amp; !state.loading">
                    <div class="o_sbl_empty_state text-center text-muted py-5">
                        <i class="fa fa-inbox fa-4x mb-3 d-block opacity-25"/>
                        <p class="mb-1 fw-bold">No Pallets Loaded</p>
                        <p class="small">
                            <t t-if="isScanLocationStep">Scan location barcode to start</t>
                            <t t-else="">Scan pallets to update</t>
                        </p>
                    </div>
                </t>

                <t t-foreach="palletList" t-as="pallet" t-key="pallet.package_id">
                    <div t-attf-class="o_sbl_pallet {{ pallet.is_complete ? 'o_pallet_updated' : '' }} {{ this.isCurrentHighlightedPallet(pallet.package_id) ? 'o_pallet_highlighted' : '' }}">
                        <!-- 托盘头部 -->
                        <div class="o_pallet_header" data-bs-toggle="collapse" t-attf-data-bs-target="#pallet_products_{{ pallet.package_id }}" aria-expanded="false">
                            <div class="o_pallet_row1">
                                <div class="o_pallet_info">
                                    <!-- 高亮托盘使用特殊的图标 -->
                                    <t t-if="this.isCurrentHighlightedPallet(pallet.package_id)">
                                        <i class="fa fa-cube o_pallet_icon_highlighted me-2"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-cube text-secondary me-2"/>
                                    </t>
                                    <strong class="o_pallet_name">
                                        <t t-esc="pallet.package_name || pallet.package_barcode || ('Pallet ' + pallet.package_id)"/>
                                    </strong>
                                </div>
                                <div class="o_pallet_right">
                                    <!-- 高亮标识 -->
                                    <t t-if="this.isCurrentHighlightedPallet(pallet.package_id)">
                                        <span class="badge o_pallet_current_badge me-1">
                                            <i class="fa fa-hand-pointer-o me-1"/>Current
                                        </span>
                                    </t>
                                    <span class="badge bg-success" t-if="pallet.is_complete">
                                        <i class="fa fa-check me-1"/>Done
                                    </span>
                                    <span class="badge" t-attf-class="{{ pallet.can_ship_whole ? 'bg-info' : 'bg-warning text-dark' }}" t-if="!pallet.is_complete">
                                        <t t-if="pallet.can_ship_whole">Whole</t>
                                        <t t-else="">Partial</t>
                                    </span>
                                    <i class="fa fa-chevron-down collapse-arrow"/>
                                </div>
                            </div>
                            <div class="o_pallet_row2">
                                <span class="o_pallet_product_count">
                                    <t t-esc="(pallet.products || []).length"/> items
                                </span>
                                <span class="o_pallet_location" t-if="pallet.location_name">
                                    <i class="fa fa-map-marker-alt text-muted me-1"/>
                                    <t t-esc="pallet.location_name"/>
                                </span>
                            </div>
                        </div>

                        <!-- 托盘内产品列表 - 默认折叠，当前扫描托盘通过 collapse show 展开 -->
                        <div t-attf-id="pallet_products_{{ pallet.package_id }}" t-att-class="getPalletProductsClass(pallet.package_id)">
                            <t t-if="!(pallet.products || []).length and !(pallet.package_id === state.currentPallet.id and pendingProductPreview)">
                                <div class="o_sbl_empty_state text-center text-muted py-4">
                                    <p class="mb-0 small">No products loaded</p>
                                </div>
                            </t>
                            <div t-if="pallet.package_id === state.currentPallet.id and pendingProductPreview"
                                 class="o_product_subcard o_product_pending">
                                <div class="o_product_row_top">
                                    <div class="o_product_icon"><i class="fa fa-box-open"/></div>
                                    <div class="o_product_name">
                                        <t t-esc="pendingProductPreview.display_name || pendingProductPreview.name"/>
                                    </div>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                </div>
                                <div class="o_product_row_bottom">
                                    <span t-if="pendingProductPreview.default_code" class="o_meta_code">
                                        <t t-esc="pendingProductPreview.default_code"/>
                                    </span>
                                    <span t-if="pendingProductPreview.barcode" class="o_meta_barcode">
                                        <i class="fa fa-barcode me-1"/><t t-esc="pendingProductPreview.barcode"/>
                                    </span>
                                    <span class="badge bg-light text-dark">
                                        <t t-esc="pendingProductPreview.tracking || 'none'"/>
                                    </span>
                                    <span t-if="state.currentLot?.name" class="o_meta_lot">
                                        <i class="fa fa-tag me-1"/><t t-esc="state.currentLot.name"/>
                                    </span>
                                </div>
                                <div class="o_product_pending_hint">
                                    <i class="fa fa-clock-o me-1"/><t t-esc="pendingProductStatus"/>
                                </div>
                            </div>
                            <t t-foreach="getPalletProductGroups(pallet)" t-as="group" t-key="group.key">
                                <t t-set="item" t-value="group.lines[0]"/>
                                <div t-attf-class="o_product_subcard {{ pallet.is_complete ? 'o_pallet_updated' : '' }}">
                                    <div class="o_product_row_top">
                                        <div class="o_product_icon">
                                            <i class="fa fa-box-open"/>
                                        </div>
                                        <div class="o_product_name">
                                            <t t-esc="group.product_name"/>
                                        </div>
                                        <div class="o_product_qty">
                                            <span class="o_qty_value"><t t-esc="group.scanned_quantity"/></span>
                                            <span class="o_qty_label">/ <t t-esc="group.quantity"/></span>
                                        </div>
                                    </div>
                                    <div class="o_product_row_bottom">
                                        <span t-if="group.default_code" class="o_meta_code"><t t-esc="group.default_code"/></span>
                                        <span t-if="group.product_barcode" class="o_meta_barcode">
                                            <i class="fa fa-barcode me-1"/>
                                            <t t-esc="group.product_barcode"/>
                                        </span>
                                        <span t-if="group.uom" class="o_meta_uom">
                                            <t t-esc="group.uom"/>
                                        </span>
                                    </div>
                                    <t t-if="group.is_serial">
                                        <button type="button" class="btn btn-sm btn-link px-0 mt-2 text-decoration-none"
                                                t-on-click.stop="() => this.toggleSerialGroup(pallet.package_id, group.product_id)"
                                                t-att-aria-expanded="this.isSerialGroupExpanded(pallet.package_id, group.product_id) ? 'true' : 'false'">
                                            <i t-attf-class="fa {{ this.isSerialGroupExpanded(pallet.package_id, group.product_id) ? 'fa-chevron-up' : 'fa-chevron-down' }} me-1"/>
                                            SN (<t t-esc="group.lines.length"/>)
                                        </button>
                                        <div t-if="this.isSerialGroupExpanded(pallet.package_id, group.product_id)" class="mt-1">
                                            <div t-foreach="group.lines" t-as="serialLine" t-key="serialLine.move_line_id"
                                                 class="d-flex align-items-center gap-2 py-1 border-top">
                                                <i class="fa fa-barcode text-muted"/>
                                                <span class="font-monospace"><t t-esc="serialLine.lot || '-'"/></span>
                                                <span class="small text-muted ms-auto">
                                                    <t t-esc="serialLine.scanned_quantity || 0"/> / <t t-esc="serialLine.quantity || 0"/>
                                                </span>
                                                <button t-if="serialLine.can_delete" type="button"
                                                        class="btn btn-sm btn-link text-danger p-0"
                                                        t-on-click.stop="() => this.deleteOutgoingScannedLine(serialLine)"
                                                        t-att-disabled="state.loading"
                                                        title="Delete scanned serial number"
                                                        aria-label="Delete scanned serial number">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                    <!-- 批次卡片 -->
                                    <div t-if="!group.is_serial and item.lot" class="o_lot_card mt-2">
                                        <div class="o_lot_card_header d-flex align-items-center">
                                            <i class="fa fa-tag me-1"/>
                                            <span class="o_lot_name"><t t-esc="item.lot"/></span>
                                            <span class="o_lot_qty ms-auto">
                                                <t t-esc="item.scanned_quantity || 0"/> / <t t-esc="item.quantity || 0"/>
                                            </span>
                                        </div>
                                        <div class="o_lot_card_body">
                                            <div class="o_lot_progress">
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar bg-success"
                                                         t-attf-style="width: {{ item.quantity ? Math.min((item.scanned_quantity || 0) / item.quantity * 100, 100) : 0 }}%"/>
                                                </div>
                                            </div>
                                            <div class="o_lot_status mt-1">
                                                <t t-if="item.is_complete">
                                                    <span class="badge bg-success"><i class="fa fa-check me-1"/>Complete</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-warning text-dark">
                                                        <t t-esc="Math.max((item.quantity || 0) - (item.scanned_quantity || 0), 0)"/> remaining
                                                    </span>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Footer -->
            <div class="o_sbl_footer">
                <button class="btn btn-outline-secondary" t-on-click="resetScan" t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-1"/>Reset
                </button>
                <button class="btn btn-primary"
                    style="display: block !important; visibility: visible !important; flex: 1.5;"
                    t-on-click="confirmOutbound"
                    t-att-disabled="state.loading">
                    <i class="fa fa-check-circle me-1"/>Confirm
                </button>
                <button class="btn btn-secondary" t-on-click="exit">
                    <i class="fa fa-home me-1"/>Home
                </button>
            </div>
        </div>
    </t>
</templates>
