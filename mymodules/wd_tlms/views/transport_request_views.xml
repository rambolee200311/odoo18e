<?xml version="1.0" encoding="utf-8"?>
 <odoo>
 
     <!-- List View -->
     <record id="view_tlmp_transport_request_tree" model="ir.ui.view">
         <field name="name">tlmp.transport.request.tree</field>
         <field name="model">tlmp.transport.request</field>
         <field name="arch" type="xml">
             <list string="Transport Requests" default_order="id desc">
                <field name="name"/>
                <field name="request_type"/>
                <field name="cargo_type"/>
                 <field name="partner_id" optional="show"/>
                 <field name="state" widget="badge"/>
                 <field name="carrier_id" optional="show"/>
                 <field name="warehouse_id" optional="show"/>
                 <field name="planned_pickup_date" optional="show"/>
                 <field name="source_type" optional="show"/>
             </list>
         </field>
     </record>
 
     <!-- Form View -->
     <record id="view_tlmp_transport_request_form" model="ir.ui.view">
         <field name="name">tlmp.transport.request.form</field>
         <field name="model">tlmp.transport.request</field>
         <field name="arch" type="xml">
             <form string="Transport Request">
                 <header>
                     <button name="action_go_schedule" type="object" string="Go to Schedule"
                             class="btn-primary"
                             invisible="request_type != 'plan_driven'"/>
                    <button name="action_create_transport_order" type="object" string="Create Transport Order"
                            invisible="request_type != 'plan_driven'"/>
                    <button name="action_start_inquiry" type="object" string="Start Inquiry"
                            class="btn-primary"
                            invisible="request_type != 'commercial' or has_accepted_quote"/>
                    <button name="action_create_orders_from_quotes" type="object" string="Create Order"
                            class="btn-primary"
                            invisible="request_type != 'commercial' or not has_accepted_quote"/>
                     <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                     <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                     <field name="state" widget="statusbar"/>
                 </header>
                 <sheet>
                     <group>
                         <group string="Identity">
                             <field name="name" readonly="1"/>
                             <field name="scene_id" options="{'no_create': True}"/>
                            <field name="request_type"/>
                             <field name="cargo_type"/>
                             <field name="source_type"/>
                             <field name="iff_requirement_ref"
                                    invisible="source_type != 'iff'"
                                    options="{'no_create': True, 'no_open': True}"/>
                         </group>
                         <group string="Partner &amp; Cargo">
                             <field name="partner_id"
                                    invisible="scene_code not in ('terminal_to_customer', 'warehouse_to_customer', 'customer_to_customer', 'customer_to_warehouse', 'container_swap')"
                                    options="{'no_create': True}"/>
                             <field name="customer_ref"/>
                             <field name="contact_person"/>
                             <field name="contact_phone"/>
                             <field name="cargo_description"/>
                         </group>
                     </group>
                     <group string="Business Matrix">
                         <group>
                             <field name="business_driver"/>
                             <field name="cargo_category" readonly="1"/>
                             <field name="carrier_type"/>
                         </group>
                         <group>
                             <field name="t1_attribute"/>
                             <field name="dg_attribute"/>
                             <field name="matrix_code" readonly="1"/>
                             <field name="matrix_version" readonly="1"/>
                             <field name="matrix_validation_result" widget="badge" readonly="1"/>
                         </group>
                     </group>
                     <group string="Vehicle Requirement">
                         <group>
                             <field name="vehicle_requirement_mode" readonly="1"/>
                             <field name="vehicle_requirement_mode_snapshot" readonly="1"/>
                             <field name="vehicle_body_type"
                                    invisible="vehicle_requirement_mode == 'exempted'"/>
                             <field name="vehicle_capacity_requirement"
                                    invisible="vehicle_requirement_mode == 'exempted'"/>
                         </group>
                         <group>
                             <field name="is_dangerous_goods" readonly="1"
                                    invisible="vehicle_requirement_mode == 'exempted'"/>
                             <field name="dg_adr_class"
                                    invisible="is_dangerous_goods != 'adr_dangerous' or vehicle_requirement_mode == 'exempted'"/>
                             <field name="dg_un_code"
                                    invisible="is_dangerous_goods != 'adr_dangerous' or vehicle_requirement_mode == 'exempted'"/>
                             <field name="vehicle_requirement_validation_result" widget="badge" readonly="1"/>
                             <field name="vehicle_requirement_snapshot_status" readonly="1"/>
                         </group>
                     </group>
                     <group string="Workflow">
                         <group>
                             <field name="validation_state" widget="badge" readonly="1"/>
                             <field name="fulfillment_status" widget="badge" readonly="1"/>
                             <field name="requested_qty"/>
                             <field name="planned_qty"/>
                         </group>
                         <group>
                             <field name="ordered_qty" readonly="1"/>
                             <field name="delivered_qty" readonly="1"/>
                             <field name="total_order_count" readonly="1"/>
                             <field name="settled_order_count" readonly="1"/>
                             <field name="closed_order_count" readonly="1"/>
                         </group>
                     </group>
                     <group string="Scene Details">
                         <group>
                             <field name="terminal_id"
                                    invisible="scene_code not in ('terminal_to_warehouse', 'terminal_to_customer')"
                                    options="{'no_create': True}"/>
                             <field name="warehouse_id"
                                    invisible="scene_code not in ('terminal_to_warehouse', 'warehouse_transfer', 'customer_to_warehouse', 'empty_depot')"
                                    options="{'no_create': True}"/>
                             <field name="source_warehouse_id" string="Origin Warehouse"
                                    invisible="scene_code not in ('warehouse_to_customer', 'warehouse_transfer')"
                                    options="{'no_create': True}"/>
                             <field name="delivery_address"
                                    invisible="scene_code not in ('terminal_to_customer', 'warehouse_to_customer', 'customer_to_customer', 'customer_to_warehouse')"/>
                             <field name="delivery_contact"
                                    invisible="scene_code not in ('terminal_to_customer', 'warehouse_to_customer', 'customer_to_customer', 'customer_to_warehouse')"/>
                             <field name="delivery_phone"
                                    invisible="scene_code not in ('terminal_to_customer', 'warehouse_to_customer', 'customer_to_customer', 'customer_to_warehouse')"/>
                         </group>
                         <group>
                             <field name="pallet_count" invisible="cargo_type != 'pallet'"/>
                             <field name="package_count" invisible="cargo_type not in ('pallet', 'piece')"/>
                             <field name="cargo_weight"/>
                             <field name="cargo_volume"/>
                         </group>
                     </group>
                     <group invisible="not scene_id">
                         <group string="Origin Address">
                         <field name="origin_street" placeholder="Street"/>
                         <field name="origin_zip" placeholder="Zip" class="col-2"/>
                         <field name="origin_city" placeholder="City"/>
                         <field name="origin_state_id" options="{'no_create': True}" placeholder="State"/>
                         <field name="origin_country_id" options="{'no_create': True}" placeholder="Country"/>
                     </group>
                     <group string="Destination Address">
                         <field name="destination_street" placeholder="Street"/>
                         <field name="destination_zip" placeholder="Zip" class="col-2"/>
                         <field name="destination_city" placeholder="City"/>
                         <field name="destination_state_id" options="{'no_create': True}" placeholder="State"/>
                         <field name="destination_country_id" options="{'no_create': True}" placeholder="Country"/>
                     </group>
                     </group>
                     <notebook>
                         <page string="Scheduling" invisible="request_type != 'plan_driven'" name="scheduling_page">
                             <group>
                                 <field name="carrier_id" options="{'no_create': True}"/>
                                 <field name="planned_pickup_date"/>
                                 <field name="driver_name"/>
                                 <field name="driver_phone"/>
                                 <field name="vehicle_plate"/>
                             </group>
                             <group string="Pickup Plans">
                                 <field name="pickup_plan_ids" readonly="1">
                                     <list>
                                         <field name="name"/>
                                         <field name="cargo_type"/>
                                         <field name="scheduled_date"/>
                                     </list>
                                 </field>
                             </group>
                         </page>
                         <page string="Container Lines" name="container_cargo_page"
                               invisible="cargo_type != 'container'">
                             <group>
                                <field name="cargo_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" optional="show"/>
                                        <field name="description" required="1"/>
                                        <field name="container_no"/>
                                        <field name="container_type"/>
                                        <field name="bl_number"/>
                                        <field name="seal_no"/>
                                        <field name="pallets_in_container" readonly="1"/>
                                        <field name="gross_weight" sum="Total"/>
                                        <field name="volume_m3" sum="Total"/>
                                    </list>
                                 </field>
                             </group>
                        </page>
                        <page string="Pallet Lines" name="pallet_cargo_page"
                               invisible="cargo_type != 'pallet'">
                             <group>
                                <field name="cargo_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" optional="show"/>
                                        <field name="description" required="1"/>
                                        <field name="commodity"/>
                                        <field name="qty" string="Pallets" sum="Total"/>
                                        <field name="pieces_per_pallet"/>
                                        <field name="pallet_gross_weight_kg"/>
                                        <field name="pallet_volume_m3"/>
                                        <field name="packages" sum="Total" readonly="1"/>
                                        <field name="gross_weight" sum="Total" readonly="1"/>
                                        <field name="volume_m3" sum="Total" readonly="1"/>
                                    </list>
                                 </field>
                             </group>
                        </page>
                        <page string="Piece Lines" name="piece_cargo_page"
                               invisible="cargo_type != 'piece'">
                             <group>
                                <field name="cargo_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" optional="show"/>
                                        <field name="description" required="1"/>
                                        <field name="qty" string="Pieces" sum="Total"/>
                                        <field name="piece_gross_weight_kg"/>
                                        <field name="piece_volume_m3"/>
                                        <field name="packages" sum="Total" readonly="1"/>
                                        <field name="gross_weight" sum="Total" readonly="1"/>
                                        <field name="volume_m3" sum="Total" readonly="1"/>
                                        <field name="equivalent_pallets" readonly="1" sum="Total"/>
                                    </list>
                                 </field>
                             </group>
                        </page>
                        <page string="Inquiry &amp; Quote" invisible="request_type != 'commercial'" name="inquiry_page">
                            <group string="Inquiries">
                                 <field name="inquiry_ids" readonly="1">
                                     <list>
                                         <field name="name"/>
                                         <field name="partner_id"/>
                                         <field name="state"/>
                                         <field name="total_amount" sum="Total"/>
                                     </list>
                                 </field>
                             </group>
                             <group string="Quotes">
                                 <field name="quote_ids" readonly="1">
                                     <list>
                                         <field name="name"/>
                                         <field name="partner_id"/>
                                         <field name="state"/>
                                         <field name="total_amount" sum="Total"/>
                                     </list>
                                 </field>
                             </group>
                         </page>
                         <page string="Notes" name="notes_page">
                             <group>
                                 <field name="special_requirements"/>
                                 <field name="has_dangerous_goods"/>
                                 <field name="customs_declaration_ref"/>
                             </group>
                         </page>
                     </notebook>
                 </sheet>
                 <chatter/>
             </form>
         </field>
     </record>
 
     <!-- Search View -->
     <record id="view_tlmp_transport_request_search" model="ir.ui.view">
         <field name="name">tlmp.transport.request.search</field>
         <field name="model">tlmp.transport.request</field>
         <field name="arch" type="xml">
             <search string="Search Transport Requests">
                 <field name="name"/>
                 <field name="partner_id"/>
                 <field name="carrier_id"/>
                 <field name="warehouse_id"/>
                 <separator/>
                 <filter string="Plan-Driven" name="plan_driven" domain="[('request_type', '=', 'plan_driven')]"/>
                 <filter string="Commercial" name="commercial" domain="[('request_type', '=', 'commercial')]"/>
                 <separator/>
                 <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                 <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                 <separator/>
                 <filter string="From IFF" name="from_iff" domain="[('source_type', '=', 'iff')]"/>
                 <filter string="Manual" name="manual" domain="[('source_type', '=', 'manual')]"/>
                 <group expand="0" string="Group By">
                     <filter string="Request Type" name="group_type" context="{'group_by': 'request_type'}"/>
                     <filter string="Cargo Type" name="group_cargo" context="{'group_by': 'cargo_type'}"/>
                 </group>
             </search>
         </field>
     </record>
 
     <!-- Window Action -->
     <record id="action_tlmp_request" model="ir.actions.act_window">
         <field name="name">Transport Requests</field>
         <field name="res_model">tlmp.transport.request</field>
         <field name="view_mode">list,form</field>
         <field name="search_view_id" ref="view_tlmp_transport_request_search"/>
     </record>
 
 </odoo>
