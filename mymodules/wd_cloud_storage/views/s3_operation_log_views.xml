<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_s3_operation_log_list" model="ir.ui.view">
        <field name="name">s3.operation.log.list</field>
        <field name="model">s3.operation.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="log_code" />
                <field name="user_name" />
                <field name="operate_time" />
                <field name="operate_type_id" />
                <field name="file_name" />
                <field name="operate_result" />
            </list>
        </field>
    </record>

    <record id="view_s3_operation_log_form" model="ir.ui.view">
        <field name="name">s3.operation.log.form</field>
        <field name="model">s3.operation.log</field>
        <field name="arch" type="xml">
            <form string="Operation Log" duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="log_code" readonly="1" />
                            <field name="user_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                            <field name="user_name" readonly="1" />
                            <field name="operate_time" readonly="1" />
                            <field name="operate_type_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                            <field name="operate_result" readonly="1" />
                        </group>
                        <group>
                            <field name="file_name" readonly="1" />
                            <field name="file_path" readonly="1" />
                            <field name="original_path" readonly="1" />
                            <field name="delete_reason" readonly="1" />
                            <field name="clean_reason" readonly="1" />
                            <field name="error_message" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>