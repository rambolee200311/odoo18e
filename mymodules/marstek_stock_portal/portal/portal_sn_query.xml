<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================== -->
    <!-- 7. SN 查询页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_sn_query" name="SN Query">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/marstek', 'name': 'Marstek Stock'}, {'url': None, 'name': 'SN Query'}]"/>

            <div class="o_portal_content">
                <!-- 页面标题 -->
                <div class="mb-4">
                    <h2>
                        <i class="fa fa-barcode me-2 text-secondary"/>
                        SN Serial Number Query
                    </h2>
                    <p class="text-muted">Enter a SN serial number to query outbound information of shipped products</p>
                </div>

                <!-- 查询表单 - 可折叠 -->
                <div class="card mb-4" id="sn_filter_card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 d-inline">
                            <i class="fa fa-search me-2"/>
                            Query Criteria
                        </h5>
                        <button class="btn btn-link text-decoration-none p-0 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#sn_filter_collapse" aria-expanded="true">
                            <i class="fa fa-chevron-up collapse-icon"/>
                        </button>
                    </div>
                    <div id="sn_filter_collapse" class="collapse show">
                    <div class="card-body">
                        <form action="/my/marstek/sn_query" method="get" class="row g-3">
                            <div class="col-12 col-md-8">
                                <label for="sn_code" class="form-label">SN Serial Number</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="sn_code"
                                       name="sn_code"
                                       t-attf-value="#{filters.get('sn_code', '')}"
                                       placeholder="Enter SN serial number"
                                       autofocus="1"/>
                            </div>
                            <div class="col-12 col-md-4 d-flex align-items-end">
                                <div class="d-grid gap-2 d-md-block">
                                    <button type="submit" class="btn btn-primary me-2" id="sn_query_btn">
                                        <i class="fa fa-search me-1"/>
                                        Search
                                    </button>
                                    <a href="/my/marstek/sn_query" class="btn btn-secondary">
                                        <i class="fa fa-refresh me-1"/>
                                        Reset
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <!-- 查询结果 -->
                <t t-if="sn_code">
                    <!-- 未找到 -->
                    <t t-if="sn_result.get('status') == 'NOT_FOUND'">
                        <div class="alert alert-warning" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            No outbound record found for SN "<t t-esc="sn_code"/>"
                            <br/>
                            <small class="text-muted">Note: SN records only apply to shipped products</small>
                        </div>
                    </t>

                    <!-- 找到结果 -->
                    <t t-if="sn_result.get('status') == 'FOUND' and sn_result.get('data')">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-check-circle me-2"/>
                                    Query Result
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- SN 信息卡片 -->
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="text-muted mb-1">SN Serial Number</h6>
                                                <h4 class="mb-0 text-primary">
                                                    <i class="fa fa-barcode me-2"/>
                                                    <t t-esc="sn_result['data'].get('sn_code', sn_code)"/>
                                                </h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="text-muted mb-1">Product Code</h6>
                                                <h4 class="mb-0">
                                                    <t t-esc="sn_result['data'].get('product_code', '-')"/>
                                                </h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 详细信息 -->
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <strong>Product Name:</strong>
                                        <span class="ms-2"><t t-esc="sn_result['data'].get('product_name', '-')"/></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <strong>Outbound No.:</strong>
                                        <span class="ms-2"><t t-esc="sn_result['data'].get('outbound_no', '-')"/></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <strong>Outbound Date:</strong>
                                        <span class="ms-2"><t t-esc="sn_result['data'].get('outbound_date', '-')"/></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <strong>Container No.:</strong>
                                        <span class="ms-2"><t t-esc="sn_result['data'].get('container_no', '-')"/></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <strong>BL No.:</strong>
                                        <span class="ms-2"><t t-esc="sn_result['data'].get('bl_no', '-')"/></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <strong>Status:</strong>
                                        <span class="ms-2">
                                            <t t-if="sn_result['data'].get('portal_outbound_status') == 'outbound_picking_done'">
                                                <span class="badge bg-success">Picking Completed</span>
                                            </t>
                                            <t t-elif="sn_result['data'].get('portal_outbound_status') == 'outbound_picking_processing'">
                                                <span class="badge bg-warning text-dark">Picking</span>
                                            </t>
                                            <t t-elif="sn_result['data'].get('portal_outbound_status') == 'outbound_confirmed'">
                                                <span class="badge bg-info">Confirmed</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary"><t t-esc="sn_result['data'].get('state', '-')"/></span>
                                            </t>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- 快速操作入口 -->
                <t>
<!--                <t t-if="not sn_code or sn_result.get('status') == 'NOT_FOUND'">-->
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fa fa-link me-2"/>
                                Quick Links
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <a href="/my/marstek/stock" class="btn btn-outline-primary w-100">
                                        <i class="fa fa-cubes me-2"/>
                                        Stock Overview
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="/my/marstek/inbounds" class="btn btn-outline-warning w-100">
                                        <i class="fa fa-arrow-down me-2"/>
                                        Inbound Orders
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="/my/marstek/outbounds" class="btn btn-outline-info w-100">
                                        <i class="fa fa-arrow-up me-2"/>
                                        Outbound Orders
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a href="/my/marstek/container_stock" class="btn btn-outline-success w-100">
                                        <i class="fa fa-truck me-2"/>
                                        Container Query
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
