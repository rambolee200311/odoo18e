<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_lite_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.barcode.lite.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="project_name" readonly="1" invisible="1"/>
                <!--                <field name="project_id" readonly="1"/>-->
                <field name="outbound_scan_mode" readonly="1"
                       invisible="project_name !='SUNRISE' or picking_type_code != 'outgoing'"/>
                <field name="new_pallet_count" readonly="state in ('done', 'cancel')"
                       invisible="project_name != 'SUNRISE' or picking_type_code != 'outgoing'"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="chenyang_force_button_validate" type="object" string="Chenyang Force Validate"
                        confirm="Are you sure you want to validate without scan checks?"
                        class="btn-secondary" invisible="project_name !='SUNRISE'"
                        groups="stock_barcode_lite.group_sunrise_stock_manager"/>
            </xpath>

        </field>
    </record>


    <record id="view_stock_move_line_detailed_operation_list_inherit_stock_barcode_lite" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.list.inherit.stock.barcode.lite</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="after">
                <field name="outbound_scanned_quantity"
                       string="Outbound Scanned Quantity"
                       readonly="0"
                       column_invisible="context.get('picking_code') != 'outgoing'"/>
                <field name="is_outbound_scanned"
                       string="Outbound Scanned"
                       readonly="0"
                       column_invisible="context.get('picking_code') != 'outgoing'"/>
                <field name="is_location_updated"
                       string="Location Updated"
                       readonly="0"
                       column_invisible="context.get('picking_code') != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_kanban_barcode_lite_inherit" model="ir.ui.view">
        <field name="name">stock.picking.kanban.barcode.lite.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_barcode.stock_picking_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='scheduled_date']" position="before">
                <field name="barcode_scan_mode" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_picking_internal_transfer_search">
        <field name="name">stock.picking.internal.transfer.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search>
                <field name="package_level_ids" string="Package"
                       filter_domain="['|',
           ('package_level_ids.package_id.barcode', '=', self),
           ('package_level_ids.package_id.name', 'ilike', self)]"/>
                <field name="pda_destination_location_id" string="Destination Location"/>
                <filter string="Active" name="state_not_cancel" domain="[('state', '!=', 'cancel')]"/>
                <filter name="is_pda_internal_transfer" domain="[('is_pda_internal_transfer', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_stock_lot_form_inherit_sunrise_specification" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.sunrise.specification</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[@name='main_group']" position="inside">
                <group col="2">
                    <field name="gross_weight"/>
                    <field name="product_dimensions"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
