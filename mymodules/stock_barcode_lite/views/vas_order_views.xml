<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_order_form_stock_barcode_lite" model="ir.ui.view">
        <field name="name">wd.vas.order.form.stock.barcode.lite</field>
        <field name="model">wd.vas.order</field>
        <field name="inherit_id" ref="wd_warehouse_value_add.view_vas_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='source_group']" position="replace">
                <group name="source_group">
                    <field name="order_type" required="source_type in ('manual', 'inbound', 'outbound', 'transfer')" invisible="source_type not in ('manual', 'inbound', 'outbound', 'transfer')" readonly="state != 'draft'"/>
                    <field name="warehouse_order_billno" invisible="state != 'draft' or source_type not in ('manual', 'inbound', 'outbound', 'transfer')" readonly="state != 'draft'"/>
                    <field name="source_type" invisible="source_type in ('manual', 'inbound', 'outbound', 'transfer')" readonly="1"/>
                    <field name="source_document_number" invisible="source_type in ('manual', 'inbound', 'outbound', 'transfer')" readonly="1"/>
                    <field name="source_document_name" invisible="source_type in ('manual', 'inbound', 'outbound', 'transfer')" readonly="1"/>
                    <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                    <field name="inbound_order_id" widget="advanced_record_picker" invisible="order_type != 'inbound'" readonly="state != 'draft'" domain="[('project', '=?', project_id)]" options="{'no_create': True, 'no_open': True, 'picker_profile': 'wd_warehouse_value_add_inbound'}"/>
                    <field name="outbound_order_id" widget="advanced_record_picker" invisible="order_type != 'outbound'" readonly="state != 'draft'" domain="[('project', '=?', project_id)]" options="{'no_create': True, 'no_open': True, 'picker_profile': 'wd_warehouse_value_add_outbound'}"/>
                    <field name="transfer_order_id" widget="advanced_record_picker" invisible="order_type != 'transfer'" readonly="state != 'draft'" domain="[('project', '=?', project_id)]" options="{'no_create': True, 'no_open': True, 'picker_profile': 'wd_warehouse_value_add_transfer'}"/>
                    <field name="warehouse_id" readonly="1" force_save="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="source_picking_id" readonly="1" invisible="source_type in ('manual', 'inbound', 'outbound', 'transfer')" options="{'no_create': True, 'no_open': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_vas_order_list_stock_barcode_lite" model="ir.ui.view">
        <field name="name">wd.vas.order.list.stock.barcode.lite</field>
        <field name="model">wd.vas.order</field>
        <field name="inherit_id" ref="wd_warehouse_value_add.view_vas_order_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_type']" position="replace"><field name="order_type"/></xpath>
            <xpath expr="//field[@name='source_document_number']" position="replace"><field name="warehouse_order_billno"/></xpath>
        </field>
    </record>

    <record id="view_vas_order_search_stock_barcode_lite" model="ir.ui.view">
        <field name="name">wd.vas.order.search.stock.barcode.lite</field>
        <field name="model">wd.vas.order</field>
        <field name="inherit_id" ref="wd_warehouse_value_add.view_vas_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_type']" position="replace"><field name="order_type"/></xpath>
            <xpath expr="//field[@name='source_document_number']" position="replace"><field name="warehouse_order_billno"/></xpath>
            <xpath expr="//filter[@name='group_source_type']" position="replace"><filter name="group_order_type" string="Order Type" context="{'group_by': 'order_type'}"/></xpath>
        </field>
    </record>

    <delete id="view_vas_operation_type_list_stock_barcode_lite" model="ir.ui.view"/>
    <delete id="view_vas_operation_type_form_stock_barcode_lite" model="ir.ui.view"/>
    <delete id="view_vas_operation_type_search_stock_barcode_lite" model="ir.ui.view"/>
</odoo>
