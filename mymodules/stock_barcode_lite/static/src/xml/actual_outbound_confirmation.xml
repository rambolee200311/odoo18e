<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="stock_barcode_lite.ActualOutboundConfirmationPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="none"
            touch-action="none"
        />

        <div class="o_sbl_inbound o_sbl_outbound_confirmation">
            <div class="o_sbl_outbound_sticky_top">
                <div class="o_sbl_header">
                    <button type="button" class="btn btn-link text-dark p-1" t-on-click="exit" title="Home">
                        <i class="fa fa-arrow-left"/>
                    </button>
                    <div class="o_sbl_header_title">
                        <i class="fa fa-check-circle text-success me-1"/>Outbound Confirmation
                    </div>
                    <div class="o_sbl_scan_mode" t-attf-class="o_mode_{{ state.nextStep }}">
                        <t t-esc="stepLabel"/>
                    </div>
                </div>

                <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                    <t t-esc="state.message"/>
                </div>

                <div class="o_sbl_step_hint">
                    <i class="fa fa-qrcode me-2"/>
                    <t t-esc="stepHint"/>
                </div>

                <div t-if="state.confirmationId" class="o_sbl_picking_bar">
                    <div class="o_picking_info_row">
                        <span class="o_picking_label">
                            <i class="fa fa-clipboard-list text-success me-1"/>Outbound Order:
                        </span>
                        <strong class="o_picking_name text-success">
                            <t t-esc="state.outboundCode || state.outboundOrderId || '-'"/>
                        </strong>
                        <span t-if="state.confirmationId" class="badge bg-secondary">
                            Confirmation #<t t-esc="state.confirmationId"/>
                        </span>
                        <span t-if="state.confirmationMode" class="badge bg-info text-dark">
                            <t t-esc="state.confirmationMode"/>
                        </span>
                    </div>
                </div>
            </div>

            <div t-if="state.nextStep === 'scan_outbound'" class="o_sbl_confirmation_empty text-center text-muted">
                <i class="fa fa-truck fa-4x mb-3 d-block opacity-25"/>
                <p class="mb-1 fw-bold">Ready to Scan</p>
                <p class="small">Scan an outbound order barcode to open its active secondary confirmation</p>
            </div>

            <div t-if="state.nextStep === 'scan_destination_pallet'" class="o_sbl_confirmation_content">
                <div class="o_sbl_confirmation_summary">
                    <div class="card border-success">
                        <div class="card-body py-2">
                            <div class="small text-muted">Destination Pallets Scanned</div>
                            <strong class="fs-5">
                                <t t-esc="state.summary.scanned_destination_pallets"/> /
                                <t t-esc="state.summary.total_destination_pallets"/>
                            </strong>
                        </div>
                    </div>
                    <div class="card border-secondary">
                        <div class="card-body py-2">
                            <div class="small text-muted">Unpackaged Move Lines</div>
                            <strong class="fs-5"><t t-esc="unpackagedMoveLinesDisplay"/></strong>
                        </div>
                    </div>
                </div>

                <div class="o_sbl_confirmation_pallets">
                    <div t-foreach="state.destinationPallets" t-as="pallet" t-key="pallet.id"
                         t-attf-class="o_sbl_confirmation_pallet {{ pallet.is_scanned ? 'is-scanned' : '' }}">
                        <div class="o_sbl_confirmation_pallet_icon">
                            <i t-attf-class="fa {{ pallet.is_scanned ? 'fa-check-circle text-success' : 'fa-cube text-muted' }}"/>
                        </div>
                        <div class="o_sbl_confirmation_pallet_info">
                            <strong><t t-esc="pallet.name"/></strong>
                            <span class="small text-muted"><t t-esc="pallet.barcode"/></span>
                        </div>
                        <span t-if="pallet.is_scanned" class="badge bg-success">Scanned</span>
                        <span t-else="" class="badge bg-secondary">Pending</span>
                    </div>
                    <div t-if="!state.destinationPallets.length" class="text-center text-muted py-4">
                        No destination pallets are included in this confirmation.
                    </div>
                </div>
            </div>

            <div t-if="state.nextStep === 'confirm_unpacked'" class="o_sbl_confirmation_empty text-center">
                <i class="fa fa-cubes fa-4x mb-3 d-block text-warning opacity-50"/>
                <p class="mb-1 fw-bold">Only Loose Goods Remain</p>
                <p class="small text-muted">
                    The current confirmation contains <strong><t t-esc="state.summary.unpackaged_move_lines"/></strong>
                    unpackaged move line(s). Confirm them in one step or cancel and return later.
                </p>
            </div>

            <div class="o_sbl_footer">
                <button class="btn btn-secondary" t-on-click="exit">
                    <i class="fa fa-home me-1"/>Home
                </button>
                <button t-if="state.nextStep === 'scan_destination_pallet'"
                        class="btn btn-success flex-grow-1"
                        t-on-click="validateConfirmation"
                        t-att-disabled="state.loading || !state.summary.scanned_destination_pallets">
                    <i class="fa fa-check me-1"/>Validate Secondary Outbound
                </button>
                <button t-if="state.nextStep === 'confirm_unpacked'"
                        class="btn btn-success flex-grow-1"
                        t-on-click="confirmUnpacked"
                        t-att-disabled="state.loading">
                    <i class="fa fa-truck me-1"/>Confirm Loose Goods
                </button>
            </div>
        </div>
    </t>
</templates>
