<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunrise_monthly_category_pallet_report_list" model="ir.ui.view">
        <field name="name">sunrise.monthly.category.pallet.report.list</field>
        <field name="model">sunrise.monthly.category.pallet.report</field>
        <field name="arch" type="xml">
            <list string="Sunrise Monthly Category Pallet Reports">
                <field name="name"/>
                <field name="month_from"/>
                <field name="month_to"/>
                <field name="sunrise_product_category_name"/>
                <field name="state"/>
                <field name="refreshed_by_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="refreshed_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_monthly_category_pallet_report_form" model="ir.ui.view">
        <field name="name">sunrise.monthly.category.pallet.report.form</field>
        <field name="model">sunrise.monthly.category.pallet.report</field>
        <field name="arch" type="xml">
            <form string="Sunrise Monthly Category Pallet Report" duplicate="false">
                <header>
                    <button name="action_refresh_report" type="object" string="Refresh" class="oe_highlight"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="month_from" required="1"/>
                            <field name="month_to" required="1"/>
                            <field name="sunrise_product_category_name"/>
                        </group>
                        <group>
                            <field name="refreshed_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="refreshed_datetime" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Monthly Category Pallets">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="report_id" column_invisible="True"/>
                                    <field name="month_date"/>
                                    <field name="sunrise_product_category_name"/>
                                    <field name="opening_pallet_count" sum="Total"/>
                                    <field name="inbound_pallet_count" sum="Total"/>
                                    <field name="outbound_pallet_count" sum="Total"/>
                                    <field name="closing_pallet_count" sum="Total"/>
                                    <field name="average_outbound_stock_days"/>
                                    <field name="average_closing_stock_days"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_monthly_category_pallet_report_line_list" model="ir.ui.view">
        <field name="name">sunrise.monthly.category.pallet.report.line.list</field>
        <field name="model">sunrise.monthly.category.pallet.report.line</field>
        <field name="arch" type="xml">
            <list string="Sunrise Monthly Category Pallet Lines" create="0" delete="0" edit="0">
                <field name="month_date"/>
                <field name="sunrise_product_category_name"/>
                <field name="opening_pallet_count" sum="Total"/>
                <field name="inbound_pallet_count" sum="Total"/>
                <field name="outbound_pallet_count" sum="Total"/>
                <field name="closing_pallet_count" sum="Total"/>
                <field name="average_outbound_stock_days"/>
                <field name="average_closing_stock_days"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_monthly_category_pallet_report_line_form" model="ir.ui.view">
        <field name="name">sunrise.monthly.category.pallet.report.line.form</field>
        <field name="model">sunrise.monthly.category.pallet.report.line</field>
        <field name="arch" type="xml">
            <form string="Sunrise Monthly Category Pallet Line" duplicate="false" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="month_date" readonly="1"/>
                            <field name="sunrise_product_category_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="opening_pallet_count" readonly="1"/>
                            <field name="inbound_pallet_count" readonly="1"/>
                            <field name="outbound_pallet_count" readonly="1"/>
                            <field name="closing_pallet_count" readonly="1"/>
                            <field name="average_outbound_stock_days" readonly="1"/>
                            <field name="average_closing_stock_days" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sunrise_monthly_category_pallet_report" model="ir.actions.act_window">
        <field name="name">Sunrise Monthly Category Pallet Report</field>
        <field name="res_model">sunrise.monthly.category.pallet.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sunrise_monthly_category_pallet_report_list"/>
    </record>
</odoo>
