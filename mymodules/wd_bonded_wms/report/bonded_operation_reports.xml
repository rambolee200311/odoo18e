<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_bonded_operation" model="report.paperformat">
        <field name="name">Bonded Operation A4</field><field name="format">A4</field><field name="orientation">Portrait</field><field name="margin_top">10</field><field name="margin_bottom">10</field><field name="margin_left">10</field><field name="margin_right">10</field><field name="header_line" eval="False"/><field name="header_spacing">0</field><field name="dpi">90</field><field name="css_margins" eval="True"/>
    </record>
    <record id="action_report_bonded_inbound_order" model="ir.actions.report">
        <field name="name">Inbound Report</field><field name="model">bonded.inbound</field><field name="report_type">qweb-pdf</field><field name="report_name">wd_bonded_wms.report_bonded_inbound_order</field><field name="report_file">wd_bonded_wms.report_bonded_inbound_order</field><field name="paperformat_id" ref="paperformat_bonded_operation"/><field name="print_report_name">'Inbound Report - %s' % (object.name)</field><field name="binding_model_id" ref="model_bonded_inbound"/><field name="binding_type">report</field>
    </record>
    <record id="action_report_bonded_inbound_picking" model="ir.actions.report">
        <field name="name">Inbound Picking Report</field><field name="model">bonded.inbound</field><field name="report_type">qweb-pdf</field><field name="report_name">wd_bonded_wms.report_bonded_inbound_picking</field><field name="report_file">wd_bonded_wms.report_bonded_inbound_picking</field><field name="paperformat_id" ref="paperformat_bonded_operation"/><field name="print_report_name">'Inbound Picking - %s' % (object.name)</field><field name="binding_model_id" ref="model_bonded_inbound"/><field name="binding_type">report</field>
    </record>
    <record id="action_report_bonded_inbound_pallet" model="ir.actions.report">
        <field name="name">Inbound Pallet Report</field><field name="model">bonded.inbound</field><field name="report_type">qweb-pdf</field><field name="report_name">wd_bonded_wms.report_bonded_inbound_pallet</field><field name="report_file">wd_bonded_wms.report_bonded_inbound_pallet</field><field name="paperformat_id" ref="paperformat_bonded_operation"/><field name="print_report_name">'Inbound Pallet Report - %s' % (object.name)</field><field name="binding_model_id" ref="model_bonded_inbound"/><field name="binding_type">report</field>
    </record>
    <record id="action_report_bonded_outbound_order" model="ir.actions.report">
        <field name="name">Outbound Report</field><field name="model">bonded.outbound</field><field name="report_type">qweb-pdf</field><field name="report_name">wd_bonded_wms.report_bonded_outbound_order</field><field name="report_file">wd_bonded_wms.report_bonded_outbound_order</field><field name="paperformat_id" ref="paperformat_bonded_operation"/><field name="print_report_name">'Outbound Report - %s' % (object.name)</field><field name="binding_model_id" ref="model_bonded_outbound"/><field name="binding_type">report</field>
    </record>
    <record id="action_report_bonded_outbound_picking" model="ir.actions.report">
        <field name="name">Outbound Picking Report</field><field name="model">bonded.outbound</field><field name="report_type">qweb-pdf</field><field name="report_name">wd_bonded_wms.report_bonded_outbound_picking</field><field name="report_file">wd_bonded_wms.report_bonded_outbound_picking</field><field name="paperformat_id" ref="paperformat_bonded_operation"/><field name="print_report_name">'Outbound Picking - %s' % (object.name)</field><field name="binding_model_id" ref="model_bonded_outbound"/><field name="binding_type">report</field>
    </record>
    <template id="report_bonded_inbound_order"><t t-call="web.basic_layout"><t t-foreach="docs" t-as="o"><div class="page" style="font-family:Helvetica,Arial,sans-serif;padding-bottom:12px;"><table style="width:100%;border-collapse:collapse;table-layout:fixed;margin-bottom:12px;"><colgroup><col/><col style="width:180px;"/></colgroup><tr><td style="vertical-align:top;"><div style="font-size:30px;color:#333;font-weight:700;margin-bottom:6px;"><t t-esc="o.env.company.name"/></div><h2 style="margin:0 0 6px;font-size:24px;">Inbound Order</h2><div style="font-size:18px;color:#555;"><div><strong>Inbound No:</strong> <span t-field="o.name"/></div><div><strong>Owner:</strong> <span t-field="o.owner_id"/></div><div><strong>Expected Arrival:</strong> <span t-field="o.expected_date"/></div><div><strong>Reference:</strong> <span t-field="o.reference"/></div><div><strong>BL No:</strong> <span t-field="o.bl_no"/></div><div><strong>Container No:</strong> <span t-field="o.cntr_no"/></div></div></td><td style="text-align:center;vertical-align:top;"><div style="border:1px solid #e6e6e6;padding:8px;border-radius:6px;background:#fafafa;display:inline-block;"><div style="font-size:11px;color:#666;margin-bottom:6px;"><strong>Inbound Order QR</strong></div><div t-field="o.name" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 180, 'height': 180, 'img_style': 'width:140px;height:140px;'}"/><div style="margin-top:6px;font-weight:600;word-break:break-word;"><span t-field="o.name"/></div></div></td></tr></table><div t-if="o.picking_id" style="margin:0 0 12px;page-break-inside:avoid;"><div style="border:1px solid #e6e6e6;padding:8px;border-radius:6px;background:#fafafa;display:inline-block;"><div style="font-size:11px;color:#666;margin-bottom:6px;"><strong>Picking QR</strong></div><div t-field="o.picking_id.name" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 180, 'height': 180, 'img_style': 'width:140px;height:140px;'}"/><div style="margin-top:6px;font-weight:600;"><span t-field="o.picking_id.name"/></div></div></div><table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:16px;page-break-inside:avoid;"><thead style="background:#343a40;color:#fff;display:table-header-group;"><tr><th style="padding:8px;border:1px solid #ddd;text-align:left;">Pallet No</th><th style="padding:8px;border:1px solid #ddd;text-align:left;">Product</th><th style="padding:8px;border:1px solid #ddd;text-align:right;">Quantity</th><th style="padding:8px;border:1px solid #ddd;text-align:right;">Gross Weight</th><th style="padding:8px;border:1px solid #ddd;text-align:right;">Net Weight</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td style="padding:8px;border:1px solid #eee;word-break:break-word;"><span t-field="line.pallet_no"/></td><td style="padding:8px;border:1px solid #eee;"><span t-field="line.product_id.display_name"/></td><td style="padding:8px;border:1px solid #eee;text-align:right;"><span t-field="line.planned_qty"/> <span t-field="line.uom_id.name"/></td><td style="padding:8px;border:1px solid #eee;text-align:right;"><span t-field="line.gross_weight"/></td><td style="padding:8px;border:1px solid #eee;text-align:right;"><span t-field="line.net_weight"/></td></tr></tbody></table><div t-if="o.remark" style="margin-top:12px;padding:12px;background:#fff3cd;border:1px solid #ffeaa7;border-radius:6px;"><strong>Remarks:</strong><div t-field="o.remark"/></div></div></t></t></template>
    <template id="report_bonded_outbound_order"><t t-call="web.basic_layout"><t t-foreach="docs" t-as="o"><div class="page" style="font-family:Helvetica,Arial,sans-serif;"><h2>Outbound Order</h2><table style="width:100%;border-collapse:collapse;margin-bottom:12px;"><tr><td><strong>Outbound No:</strong> <span t-field="o.name"/></td><td><strong>Reference:</strong> <span t-field="o.reference"/></td></tr><tr><td><strong>Project:</strong> <span t-field="o.project_id"/></td><td><strong>Owner:</strong> <span t-field="o.owner_id"/></td></tr><tr><td><strong>Planned Date:</strong> <span t-field="o.expected_date"/></td><td><strong>MRN:</strong> <span t-field="o.mrn"/></td></tr></table><table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:13px;"><thead style="background:#343a40;color:#fff;display:table-header-group;"><tr><th style="padding:7px;border:1px solid #ddd;text-align:left;">Unique Identifier No.</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Product</th><th style="padding:7px;border:1px solid #ddd;text-align:right;">Quantity</th><th style="padding:7px;border:1px solid #ddd;text-align:right;">Unit Price</th><th style="padding:7px;border:1px solid #ddd;text-align:right;">Subtotal</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td style="padding:7px;border:1px solid #ddd;word-break:break-word;"><span t-field="line.inbound_tracking_no"/></td><td style="padding:7px;border:1px solid #ddd;"><span t-field="line.product_id.display_name"/></td><td style="padding:7px;border:1px solid #ddd;text-align:right;"><span t-field="line.demand_qty"/> <span t-field="line.uom_id.name"/></td><td style="padding:7px;border:1px solid #ddd;text-align:right;"><span t-field="line.declared_unit_price"/></td><td style="padding:7px;border:1px solid #ddd;text-align:right;"><span t-field="line.subtotal_value"/></td></tr></tbody></table></div></t></t></template>
    <template id="report_bonded_inbound_pallet"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-foreach="pallet_groups_by_order.get(o.id, [])" t-as="pallet"><div class="page" style="font-family:Arial,sans-serif;color:#111827;page-break-after:always;"><h1 style="font-size:30px;margin:0 0 8px;">Pallet Report</h1><table style="width:100%;border-collapse:collapse;table-layout:fixed;border:1px solid #111827;"><tr><td style="padding:12px;border:1px solid #111827;vertical-align:top;"><h2 style="font-size:26px;margin:0 0 12px;word-break:break-word;">Pallet No: <t t-esc="pallet['package'].name"/></h2><table style="width:100%;border-collapse:collapse;font-size:14px;"><tr><td style="border:1px solid #111827;padding:6px;font-weight:bold;">Inbound No</td><td style="border:1px solid #111827;padding:6px;"><span t-field="o.name"/></td><td style="border:1px solid #111827;padding:6px;font-weight:bold;">Reference</td><td style="border:1px solid #111827;padding:6px;"><span t-field="o.reference"/></td></tr><tr><td style="border:1px solid #111827;padding:6px;font-weight:bold;">Owner</td><td style="border:1px solid #111827;padding:6px;"><span t-field="o.owner_id"/></td><td style="border:1px solid #111827;padding:6px;font-weight:bold;">Container No</td><td style="border:1px solid #111827;padding:6px;"><span t-field="o.cntr_no"/></td></tr></table></td><td style="width:220px;border:1px solid #111827;text-align:center;vertical-align:middle;"><div t-field="pallet['package'].name" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 240, 'height': 240, 'img_style': 'width:180px;height:180px;'}"/><div style="font-size:13px;font-weight:bold;word-break:break-word;"><t t-esc="pallet['package'].name"/></div></td></tr></table><table style="width:100%;border-collapse:collapse;table-layout:fixed;margin-top:12px;font-size:16px;"><thead style="display:table-header-group;background:#f3f4f6;"><tr><th style="border:1px solid #111827;padding:8px;text-align:left;">Product</th><th style="border:1px solid #111827;padding:8px;text-align:right;">Quantity</th><th style="border:1px solid #111827;padding:8px;text-align:right;">Gross Weight</th><th style="border:1px solid #111827;padding:8px;text-align:right;">Net Weight</th></tr></thead><tbody><tr t-foreach="pallet['lines']" t-as="line" style="page-break-inside:avoid;"><td style="border:1px solid #111827;padding:8px;word-break:break-word;"><span t-field="line.product_id.display_name"/></td><td style="border:1px solid #111827;padding:8px;text-align:right;"><span t-field="line.planned_qty"/> <span t-field="line.uom_id.name"/></td><td style="border:1px solid #111827;padding:8px;text-align:right;"><span t-field="line.gross_weight"/></td><td style="border:1px solid #111827;padding:8px;text-align:right;"><span t-field="line.net_weight"/></td></tr></tbody></table></div></t></t></t></template>
    <template id="report_bonded_inbound_picking"><t t-call="web.basic_layout"><t t-foreach="docs" t-as="o"><div class="page" style="font-family:Helvetica,Arial,sans-serif;"><h2>Inbound Picking</h2><p><strong>Inbound No:</strong> <span t-field="o.name"/> <strong style="margin-left:24px;">Picking:</strong> <span t-field="o.picking_id.name"/></p><t t-foreach="pallet_groups_by_order.get(o.id, [])" t-as="pallet"><section style="page-break-inside:avoid;margin:0 0 14px;"><h3 style="margin:0;padding:8px;background:#343a40;color:#fff;word-break:break-word;">Pallet: <t t-esc="pallet['name']"/></h3><table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:13px;"><thead><tr><th style="padding:7px;border:1px solid #ddd;text-align:left;">Product</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Lot/SN</th><th style="padding:7px;border:1px solid #ddd;text-align:right;">Quantity</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Destination</th></tr></thead><tbody><tr t-foreach="pallet['move_lines']" t-as="move_line"><td style="padding:7px;border:1px solid #ddd;"><span t-field="move_line.product_id.display_name"/></td><td style="padding:7px;border:1px solid #ddd;word-break:break-word;"><span t-field="move_line.lot_id.name"/></td><td style="padding:7px;border:1px solid #ddd;text-align:right;"><span t-field="move_line.quantity"/> <span t-field="move_line.product_uom_id.name"/></td><td style="padding:7px;border:1px solid #ddd;"><span t-field="move_line.location_dest_id.complete_name"/></td></tr></tbody></table></section></t></div></t></t></template>
    <template id="report_bonded_outbound_picking"><t t-call="web.basic_layout"><t t-foreach="docs" t-as="o"><div class="page" style="font-family:Helvetica,Arial,sans-serif;"><h2>Outbound Picking</h2><p><strong>Outbound No:</strong> <span t-field="o.name"/> <strong style="margin-left:24px;">Picking:</strong> <span t-field="o.picking_id.name"/></p><t t-foreach="pallet_groups_by_order.get(o.id, [])" t-as="pallet"><section style="page-break-inside:avoid;margin:0 0 14px;"><h3 style="margin:0;padding:8px;background:#343a40;color:#fff;word-break:break-word;">Pallet: <t t-esc="pallet['name']"/></h3><table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:13px;"><thead><tr><th style="padding:7px;border:1px solid #ddd;text-align:left;">Unique Identifier No.</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Product</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Lot/SN</th><th style="padding:7px;border:1px solid #ddd;text-align:right;">Quantity</th><th style="padding:7px;border:1px solid #ddd;text-align:left;">Source Location</th></tr></thead><tbody><tr t-foreach="pallet['move_lines']" t-as="move_line"><td style="padding:7px;border:1px solid #ddd;word-break:break-word;"><span t-field="move_line.move_id.bonded_stock_id.inbound_tracking_no"/></td><td style="padding:7px;border:1px solid #ddd;"><span t-field="move_line.product_id.display_name"/></td><td style="padding:7px;border:1px solid #ddd;word-break:break-word;"><span t-field="move_line.lot_id.name"/></td><td style="padding:7px;border:1px solid #ddd;text-align:right;"><span t-field="move_line.quantity"/> <span t-field="move_line.product_uom_id.name"/></td><td style="padding:7px;border:1px solid #ddd;"><span t-field="move_line.location_id.complete_name"/></td></tr></tbody></table></section></t></div></t></t></template>
</odoo>
