<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_s3_recycle_entry_list" model="ir.ui.view">
        <field name="name">s3.recycle.entry.list</field>
        <field name="model">s3.recycle.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="file_id" />
                <field name="deleted_by_id" />
                <field name="deletion_datetime" />
                <field name="expiry_datetime" />
                <field name="remaining_days" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_s3_recycle_entry_form" model="ir.ui.view">
        <field name="name">s3.recycle.entry.form</field>
        <field name="model">s3.recycle.entry</field>
        <field name="arch" type="xml">
            <form string="Recycle Entry" duplicate="false">
                <header>
                    <button name="action_restore" string="Restore" type="object" class="btn-primary" invisible="state != 'active'" />
                    <button name="action_purge" string="Purge" type="object" class="btn-secondary" invisible="state != 'active'" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="file_id" required="1" options="{'no_create': True, 'no_open': True}" />
                            <field name="deleted_by_id" required="1" options="{'no_create': True, 'no_open': True}" />
                            <field name="owner_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                            <field name="deletion_datetime" readonly="1" />
                            <field name="expiry_datetime" readonly="1" />
                            <field name="remaining_days" readonly="1" />
                            <field name="state" readonly="1" />
                        </group>
                        <group>
                            <field name="original_s3_key" required="1" readonly="1" />
                            <field name="recycle_s3_key" required="1" readonly="1" />
                            <field name="delete_reason" readonly="1" />
                            <field name="clean_reason" readonly="1" />
                            <field name="restore_datetime" readonly="1" />
                            <field name="purged_datetime" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>