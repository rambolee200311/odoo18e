<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wd_qooling_app.InboundPda">
        <main t-att-class="'o_qooling_pda ' + (isReadOnly ? 'is-readonly' : '')" data-testid="inbound-pda">
            <header class="o_qooling_pda__header">
                <div>
                    <span class="text-muted">FORMS / PDA</span>
                    <h1>Inbound Record <span class="o_qooling_pda__record-name" data-testid="inbound-pda-record-name"><t t-esc="state.record.name || 'New'"/></span></h1>
                </div>
                <button class="btn btn-outline-secondary" type="button" t-on-click="openWebForm"
                        data-testid="inbound-pda-web">Open web form</button>
            </header>
            <div t-if="state.error" class="alert alert-danger o_qooling_pda__feedback" role="alert" data-testid="inbound-pda-error"><t t-esc="state.error"/></div>
            <div t-if="state.saved" class="alert alert-success o_qooling_pda__feedback" data-testid="inbound-pda-feedback"><t t-esc="state.saved"/></div>
            <div t-if="isReadOnly" class="alert alert-info" role="status">This record is read-only.</div>
            <section class="o_qooling_pda__body">
                <section class="o_qooling_pda__section" data-testid="inbound-pda-details">
                    <h2 class="o_qooling_pda__section-title">Details</h2>
                    <label>Location<select class="form-select" required="required" data-field="location_id" t-on-change="onFieldChange">
                        <option value="">Select warehouse</option><t t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id"><option t-att-value="warehouse.id" t-att-selected="state.record.location_id === warehouse.id"><t t-esc="warehouse.name"/></option></t>
                    </select></label>
                    <label>Date<input class="form-control" type="date" t-att-value="state.record.date" data-field="date" t-on-input="onFieldChange"/></label>
                    <label>Warehouse operator<select class="form-select" data-field="warehouse_operator_id" t-on-change="onFieldChange">
                        <option value="">Select warehouse operator</option><t t-foreach="state.users" t-as="user" t-key="user.id"><option t-att-value="user.id" t-att-selected="state.record.warehouse_operator_id === user.id"><t t-esc="user.name"/></option></t>
                    </select></label>
                    <label>Supervisor<select class="form-select" data-field="supervisor_id" t-on-change="onFieldChange">
                        <option value="">Select supervisor</option><t t-foreach="state.users" t-as="user" t-key="user.id"><option t-att-value="user.id" t-att-selected="state.record.supervisor_id === user.id"><t t-esc="user.name"/></option></t>
                    </select></label>
                    <label>Business Reference<input class="form-control" t-att-value="state.record.ref_no || ''" data-field="ref_no" t-on-input="onFieldChange"/></label>
                    <label>Goods Status<select class="form-select" data-field="goods_status" t-on-change="onFieldChange"><option value="">Select</option><option value="free_union_goods" t-att-selected="state.record.goods_status === 'free_union_goods'">Free union goods</option><option value="t1" t-att-selected="state.record.goods_status === 't1'">T1</option></select></label>
                    <label>Unloading permission received?<select class="form-select" data-field="unloading_permission" t-on-change="onFieldChange"><option value="">Select</option><option value="yes" t-att-selected="state.record.unloading_permission === 'yes'">Yes</option><option value="no_stop_unloading" t-att-selected="state.record.unloading_permission === 'no_stop_unloading'">No, stop unloading and ask project manager</option></select></label>
                    <label>MRN Number<input class="form-control" t-att-value="state.record.mrn_number || ''" data-field="mrn_number" t-on-input="onFieldChange"/></label>
                    <label>Seal Number<input class="form-control" t-att-value="state.record.seal_number || ''" data-field="seal_number" t-on-input="onFieldChange"/></label>
                    <label>SKAL (Bio Product)<select class="form-select" data-field="skal_bio_product" t-on-change="onFieldChange"><option value="">Select</option><option value="yes" t-att-selected="state.record.skal_bio_product === 'yes'">Yes</option><option value="no" t-att-selected="state.record.skal_bio_product === 'no'">No</option></select></label>
                    <label>B/L required?<select class="form-select" data-field="bl_required" t-on-change="onFieldChange"><option value="">Select</option><option value="required" t-att-selected="state.record.bl_required === 'required'">Required</option><option value="not_required" t-att-selected="state.record.bl_required === 'not_required'">Not required</option></select></label>
                    <t t-if="state.record.bl_required === 'required'">
                        <label>B/L (Bill of Loading)<input class="form-control" t-att-value="state.record.bl_number || ''" data-field="bl_number" t-on-input="onFieldChange"/></label>
                    </t>
                    <label>Container Number / Shipment Number<input class="form-control" t-att-value="state.record.container_shipment_number || ''" data-field="container_shipment_number" t-on-input="onFieldChange"/></label>
                    <label>Gas measurement<select class="form-select" data-field="gas_measurement" t-on-change="onFieldChange"><option value="">Select</option><option value="yes" t-att-selected="state.record.gas_measurement === 'yes'">Yes</option><option value="no" t-att-selected="state.record.gas_measurement === 'no'">No</option><option value="not_applicable" t-att-selected="state.record.gas_measurement === 'not_applicable'">Not Applicable</option></select></label>
                </section>
                <section class="o_qooling_pda__section" data-testid="inbound-pda-adr">
                    <h2 class="o_qooling_pda__section-title">ADR &amp; temperature</h2>
                    <label>ADR<select class="form-select" data-field="adr" t-on-change="onFieldChange"><option value="no" t-att-selected="state.record.adr === 'no'">No</option><option value="yes" t-att-selected="state.record.adr === 'yes'">Yes</option></select></label>
                    <t t-if="state.record.adr === 'yes'">
                        <label>UN Number<select class="form-select" data-field="un_number" t-on-change="onFieldChange"><option value="">Select</option><option value="3171" t-att-selected="state.record.un_number === '3171'">3171</option><option value="3480" t-att-selected="state.record.un_number === '3480'">3480</option><option value="3481" t-att-selected="state.record.un_number === '3481'">3481</option></select></label>
                        <label>Temperature measured<select class="form-select" data-field="temperature_measured" t-on-change="onFieldChange"><option value="">Select</option><option value="yes" t-att-selected="state.record.temperature_measured === 'yes'">Yes</option><option value="no" t-att-selected="state.record.temperature_measured === 'no'">No</option></select></label>
                        <label>Temperature of each pallet is registered<select class="form-select" data-field="pallet_temperature_registered" t-on-change="onFieldChange"><option value="">Select</option><option value="yes" t-att-selected="state.record.pallet_temperature_registered === 'yes'">Yes</option><option value="no" t-att-selected="state.record.pallet_temperature_registered === 'no'">No</option></select></label>
                    </t>
                    <label>Average temperature per pallet (°C)<input class="form-control" type="number" step="0.1" t-att-value="state.record.average_temperature_per_pallet || ''" data-field="average_temperature_per_pallet" t-on-input="onFieldChange"/></label>
                    <label>Amount of pallets<input class="form-control" type="number" min="0" step="1" t-att-value="state.record.amount_of_pallets || ''" data-field="amount_of_pallets" t-on-input="onFieldChange"/></label>
                    <label>Amount of cartons<input class="form-control" type="number" min="0" step="1" t-att-value="state.record.amount_of_cartons || ''" data-field="amount_of_cartons" t-on-input="onFieldChange"/></label>
                </section>
                <section class="o_qooling_pda__section" data-testid="inbound-pda-checks">
                    <h2 class="o_qooling_pda__section-title">Checks</h2>
                    <label class="form-check"><input type="checkbox" t-att-checked="state.record.checked_visible_damage" data-field="checked_visible_damage" t-on-change="onFieldChange"/> Checked for visible damage or packaging issues</label>
                    <label class="form-check"><input type="checkbox" t-att-checked="state.record.checked_received_quantity" data-field="checked_received_quantity" t-on-change="onFieldChange"/> Number received has been checked</label>
                    <label class="form-check"><input type="checkbox" t-att-checked="state.record.checked_product_quality" data-field="checked_product_quality" t-on-change="onFieldChange"/> Product quality and condition have been checked</label>
                    <label>Packaging condition<select class="form-select" data-field="packaging_condition" t-on-change="onFieldChange"><option value="">Select</option><option value="good" t-att-selected="state.record.packaging_condition === 'good'">Good</option><option value="not_good" t-att-selected="state.record.packaging_condition === 'not_good'">Not good</option></select></label>
                </section>
                <section class="o_qooling_pda__section" data-testid="inbound-pda-evidence">
                    <h2 class="o_qooling_pda__section-title">Evidence</h2>
                    <label>Comments<textarea class="form-control" data-field="comments" t-on-input="onFieldChange"><t t-esc="state.record.comments || ''"/></textarea></label>
                    <div t-if="!isReadOnly" class="o_qooling_pda__upload">
                        <label class="btn btn-secondary me-2">
                            <i class="fa fa-camera me-1" aria-hidden="true"/> Take photo
                            <input class="d-none" type="file" accept="image/*" capture="environment" t-att-disabled="state.busy"
                                   t-on-change="onPhoto"/>
                        </label>
                        <label class="btn btn-secondary">
                            <i class="fa fa-video-camera me-1" aria-hidden="true"/> Record video
                            <input class="d-none" type="file" accept="video/*" capture="environment" t-att-disabled="state.busy"
                                   t-on-change="onPhoto"/>
                        </label>
                        <label class="btn btn-outline-secondary ms-2">
                            <i class="fa fa-paperclip me-1" aria-hidden="true"/> Attach media
                            <input class="d-none" type="file" accept="image/*,video/*" multiple="multiple" t-att-disabled="state.busy"
                                   t-on-change="onPhoto"/>
                        </label>
                    </div>
                    <ImagePreviewComponent t-if="state.photos.length" attachments="state.photos" editable="!isReadOnly" onRemove.bind="deletePhoto"/>
                </section>
                <section class="o_qooling_pda__section" data-testid="inbound-pda-signature-step">
                    <h2 class="o_qooling_pda__section-title">Signature</h2>
                    <label>Warehouse signature</label>
                    <canvas t-ref="signatureCanvas" class="o_qooling_pda__signature" data-testid="inbound-pda-signature"/>
                    <button t-if="!isReadOnly" type="button" class="btn btn-outline-secondary mt-2" t-on-click="clearSignature">Clear signature</button>
                    <p class="small text-muted">The same warehouse signature field is used by the web form.</p>
                </section>
            </section>
            <footer class="o_qooling_pda__footer">
                <button t-if="!isReadOnly" class="btn btn-outline-primary" type="button" t-on-click="save" t-att-disabled="state.busy" data-testid="inbound-pda-save">Save draft</button>
                <button t-if="!isReadOnly" class="btn btn-success" type="button" t-on-click="submit" t-att-disabled="state.busy" data-testid="inbound-pda-submit">Submit</button>
            </footer>
        </main>
    </t>
</templates>
