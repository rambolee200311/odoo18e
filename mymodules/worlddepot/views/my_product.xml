<odoo>
    <record id="view_product_template_form_inherit_dg" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dg</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="before">
                <group string="Linglong Fields" col="2">
                    <field name="nine_digit_linglong_code" invisible="categ_id!=11"/>
                </group>
            </xpath>
        </field>
    </record>
