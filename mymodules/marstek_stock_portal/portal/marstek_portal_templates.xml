<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================== -->
    <!-- 1. 门户主页卡片 -->
    <!-- =========================================== -->
    <template id="portal_my_home_marstek" name="Marstek 库存门户入口" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//*[hasclass('o_portal_my_home')]" position="inside">
            <div class="mt-3">
                <a href="/my/marstek/stock" class="text-decoration-none">
                    <div class="card">
                        <div class="card-body">
                            <h5><i class="fa fa-cubes me-2"/>Marstek 库存</h5>
                            <p class="text-muted mb-0">查看您的库存和订单信息</p>
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <!-- =========================================== -->
    <!-- 2. Marstek 门户主页 -->
    <!-- =========================================== -->
    <template id="portal_marstek_home" name="Marstek 库存门户">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[('marstek_home', 'Marstek 库存')]"/>
            </t>

            <h1>Marstek 库存查询</h1>
            <p class="text-muted">请选择下方功能查看您的库存和订单信息。</p>

            <div class="row mt-4">
                <!-- 库存概览 -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5><i class="fa fa-cubes me-2"/>库存概览</h5>
                            <p class="text-muted">查看所有库存（按货盘/集装箱/BL）</p>
                            <a href="/my/marstek/stock" class="btn btn-primary">查看</a>
                        </div>
                    </div>
                </div>

                <!-- 集装箱查询 -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5><i class="fa fa-search me-2"/>集装箱查询</h5>
                            <p class="text-muted">按集装箱号查询库存</p>
                            <a href="/my/marstek/container_stock" class="btn btn-primary">查询</a>
                        </div>
                    </div>
                </div>

                <!-- 入库单查询 -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5><i class="fa fa-arrow-down me-2"/>入库单查询</h5>
                            <p class="text-muted">查看和管理入库单</p>
                            <a href="/my/marstek/inbounds" class="btn btn-primary">查看</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 3. 库存概览页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_stock_overview" name="库存概览">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('stock_overview', '库存概览')
                ]"/>
            </t>

            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <!-- 搜索栏 -->
            <div class="mb-4">
                <form method="get" action="/my/marstek/stock">
                    <div class="input-group">
                        <input type="text" class="form-control" name="search" placeholder="按货盘号、集装箱号、BL号、产品搜索..." t-att-value="filters.get('search', '')"/>
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="fa fa-search"/> 搜索
                        </button>
                        <a class="btn btn-outline-primary" href="/my/marstek/stock">
                            <i class="fa fa-refresh"/> 重置
                        </a>
                    </div>
                </form>
            </div>

            <!-- 空状态 -->
            <t t-if="not rows">
                <p class="alert alert-warning">There are currently no stock records for your account.</p>
            </t>

            <!-- 数据表格 -->
            <t t-if="rows" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>货盘号</th>
                        <th>集装箱号</th>
                        <th>BL号</th>
                        <th>产品代码</th>
                        <th>产品名称</th>
                        <th class="text-end">数量</th>
                        <th>库位</th>
                        <th>入库日期</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row">
                        <td><t t-esc="row['package_name']"/></td>
                        <td><t t-esc="row['container_no']"/></td>
                        <td><t t-esc="row['bl_no']"/></td>
                        <td><t t-esc="row['product_code']"/></td>
                        <td><t t-esc="row['product_name']"/></td>
                        <td class="text-end"><t t-esc="row['quantity']"/></td>
                        <td><t t-esc="row['location_name']"/></td>
                        <td><t t-esc="row['inbound_date']"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 4. 集装箱查询页面 (核心功能) -->
    <!-- =========================================== -->
    <template id="portal_marstek_container_query" name="集装箱查询">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('container_query', '集装箱查询')
                ]"/>
            </t>

            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <h2 class="mb-3">集装箱查询</h2>
            <p class="text-muted">输入集装箱号查看该集装箱内的所有货盘和库存。</p>

            <!-- 搜索表单 -->
            <form method="get" action="/my/marstek/container_stock" class="mb-4">
                <div class="input-group">
                    <input type="text" class="form-control" name="container_no"
                           placeholder="输入集装箱号..." t-att-value="container_no"/>
                    <button class="btn btn-primary" type="submit">
                        <i class="fa fa-search"/> 查询
                    </button>
                    <a class="btn btn-outline-secondary" href="/my/marstek/container_stock">
                        重置
                    </a>
                </div>
            </form>

            <!-- 查询结果 -->
            <t t-if="container_no and stock_result.get('lines')">
                <!-- 汇总卡片 -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="text-muted mb-1">货盘总数</h6>
                                <h3><t t-esc="len(stock_result['lines'])"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="text-muted mb-1">库存总量</h6>
                                <h3><t t-esc="stock_result['total_quantity']"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="text-muted mb-1">BL号</h6>
                                <h3><t t-esc="stock_result['bl_no'] or '-'"/></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 数据表格 -->
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>货盘号</th>
                            <th>产品代码</th>
                            <th>产品名称</th>
                            <th class="text-end">数量</th>
                            <th>库位</th>
                            <th>入库日期</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="stock_result['lines']" t-as="row">
                            <td><t t-esc="row['package_name']"/></td>
                            <td><t t-esc="row['product_code']"/></td>
                            <td><t t-esc="row['product_name']"/></td>
                            <td class="text-end"><t t-esc="row['quantity']"/></td>
                            <td><t t-esc="row['location_name']"/></td>
                            <td><t t-esc="row['inbound_date']"/></td>
                        </tr>
                    </tbody>
                </t>
            </t>

            <t t-elif="container_no and not stock_result.get('lines')">
                <p class="alert alert-warning">未找到集装箱 <strong><t t-esc="container_no"/></strong> 的数据</p>
            </t>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 5. 入库单列表页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_inbound_list" name="入库单列表">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('inbound_list', '入库单')
                ]"/>
            </t>

            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <!-- 搜索栏 -->
            <div class="mb-4">
                <form method="get" action="/my/marstek/inbounds">
                    <div class="input-group">
                        <input type="text" class="form-control" name="inbound_no" placeholder="入库单号..."
                               t-att-value="filters.get('inbound_no', '')"/>
                        <input type="text" class="form-control" name="bl_no" placeholder="BL号..."
                               t-att-value="filters.get('bl_no', '')"/>
                        <input type="text" class="form-control" name="container_no" placeholder="集装箱号..."
                               t-att-value="filters.get('container_no', '')"/>
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="fa fa-search"/> 搜索
                        </button>
                        <a class="btn btn-outline-primary" href="/my/marstek/inbounds">
                            <i class="fa fa-refresh"/> 重置
                        </a>
                    </div>
                </form>
            </div>

            <!-- 空状态 -->
            <t t-if="not rows">
                <p class="alert alert-warning">There are currently no inbound orders for your account.</p>
            </t>

            <!-- 数据表格 -->
            <t t-if="rows" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>入库单号</th>
                        <th>BL号</th>
                        <th>集装箱号</th>
                        <th>入库日期</th>
                        <th class="text-end">货盘数</th>
                        <th class="text-end">总量</th>
                        <th>状态</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row">
                        <td>
                            <a t-attf-href="/my/marstek/inbounds/{{ row['id'] }}">
                                <t t-esc="row['billno']"/>
                            </a>
                        </td>
                        <td><t t-esc="row['bl_no']"/></td>
                        <td><t t-esc="row['cntr_no']"/></td>
                        <td><t t-esc="row['date']"/></td>
                        <td class="text-end"><t t-esc="row['pallets']"/></td>
                        <td class="text-end"><t t-esc="row['total_quantity']"/></td>
                        <td>
                            <span class="badge" t-attf-class="bg-{{ row.get('state_color', 'secondary') }}">
                                <t t-esc="row.get('state_text', '')"/>
                            </span>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 6. 出库单列表页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_outbound_list" name="出库单列表">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('outbound_list', '出库单')
                ]"/>
            </t>

            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <p class="alert alert-info">出库单功能开发中...</p>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 7. 出库单详情页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_outbound_detail" name="出库单详情">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('outbound_list', '出库单'),
                    ('outbound_detail', '详情')
                ]"/>
            </t>

            <p class="alert alert-info">出库单详情功能开发中...</p>
        </t>
    </template>

    <!-- =========================================== -->
    <!-- 8. SN码查询页面 -->
    <!-- =========================================== -->
    <template id="portal_marstek_sn_query" name="SN码查询">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_breadcrumbs">
                <t t-set="segments" t-value="[
                    ('marstek_home', 'Marstek 库存'),
                    ('sn_query', 'SN码查询')
                ]"/>
            </t>

            <p class="alert alert-info">SN码查询功能开发中...</p>
        </t>
    </template>

</odoo>
