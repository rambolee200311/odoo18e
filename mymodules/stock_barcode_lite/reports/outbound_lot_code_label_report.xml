<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_outbound_pallet_label" model="report.paperformat">
        <field name="name">Outbound Pallet Label A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>


    <record id="action_report_outbound_lot_code_label" model="ir.actions.report">
        <field name="name">Outbound Lot Code Labels</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_barcode_lite.report_outbound_lot_code_label</field>
        <field name="report_file">stock_barcode_lite.report_outbound_lot_code_label</field>
        <field name="print_report_name">'Outbound Lot Labels - %s' % (
                object.vsourcebillcode or object.billno or object.reference or object.id)</field>
        <field name="paperformat_id" ref="paperformat_outbound_pallet_label"/>
        <field name="binding_model_id" ref="worlddepot.model_world_depot_outbound_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_outbound_lot_code_label">
        <t t-set="data_report_margin_top" t-value="6"/>
        <t t-set="data_report_header_spacing" t-value="0"/>
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
                <t t-foreach="sections_by_order.get(o.id, [])" t-as="section">
                    <t t-set="picking" t-value="section['picking']"/>
                    <t t-set="lines" t-value="section['lines']"/>
                    <t t-foreach="range(0, len(lines), 4)" t-as="page_start">
                        <div class="page label-page">
                            <style>
                                @page {
                                    margin-top: 10mm !important;
                                    margin-bottom: 6mm;
                                    margin-left: 6mm;
                                    margin-right: 6mm;
                                }

                                html,
                                body,
                                #wrapwrap,
                                main {
                                    margin-top: 0 !important;
                                    padding-top: 0 !important;
                                }

                                .outbound-label-header {
                                    page-break-inside: avoid;
                                    break-inside: avoid;
                                    min-height: 38mm;
                                    margin-bottom: 3mm;
                                    border-bottom: 2px solid #111827;
                                }

                                .outbound-header-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                }

                                .outbound-header-main {
                                    vertical-align: top;
                                    padding: 0 4mm 2mm 0;
                                }

                                .outbound-picking-qr-cell {
                                    width: 38mm;
                                    text-align: center;
                                    vertical-align: top;
                                    padding: 0 0 2mm 3mm;
                                    font-size: 9px;
                                    font-weight: bold;
                                    line-height: 1.1;
                                }

                                .outbound-picking-qr-cell img {
                                    width: 30mm !important;
                                    height: 30mm !important;
                                }

                                .outbound-label-title {
                                    font-size: 22px;
                                    font-weight: bold;
                                    margin: 0 0 2px 0;
                                }

                                .outbound-label-subtitle {
                                    font-size: 16px;
                                    font-weight: bold;
                                    margin: 0 0 3mm 0;
                                }

                                .outbound-label-info {
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    font-size: 12px;
                                }

                                .outbound-label-info td {
                                    border: 1px solid #111827;
                                    padding: 2px 5px;
                                    vertical-align: top;
                                }

                                .outbound-label-info .label {
                                    width: 28mm;
                                    font-weight: bold;
                                    white-space: nowrap;
                                }

                                .label-page {
                                    padding: 4mm 0 0 0;
                                    margin-top: 0;
                                    font-family: Arial, sans-serif;
                                    page-break-before: always;
                                    page-break-inside: avoid;
                                    break-inside: avoid;
                                    box-sizing: border-box;
                                }

                                .label-table {
                                    width: 100%;
                                    border-collapse: separate;
                                    border-spacing: 0;
                                    table-layout: fixed;
                                    border: 0;
                                }

                                .label-cell {
                                    width: 50%;
                                    height: 96mm;
                                    vertical-align: top;
                                    padding: 1.5mm;
                                    box-sizing: border-box;
                                    border: 0;
                                }

                                .label-card {
                                    width: 100%;
                                    height: 92mm;
                                    border: 2px solid #111827;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    overflow: hidden;
                                    max-height: 92mm;
                                }

                                .label-card td {
                                    box-sizing: border-box;
                                    border-left: 0;
                                    border-right: 0;
                                    border-top: 0;
                                }

                                .top-row {
                                    height: 36mm;
                                }

                                .top-row td {
                                    border-bottom: 1px solid #111827;
                                }

                                .spec-row {
                                    height: 11mm;
                                }

                                .spec-row td {
                                    border-bottom: 1px solid #111827;
                                }

                                .bottom-row {
                                    height: 45mm;
                                }

                                .product-text {
                                    width: 58%;
                                    padding: 4mm;
                                    vertical-align: middle;
                                    font-size: 13px;
                                    font-weight: 700;
                                    line-height: 1.25;
                                    word-break: break-word;
                                }

                                .product-qr-cell {
                                    width: 42%;
                                    padding: 3mm;
                                    vertical-align: middle;
                                    text-align: center;
                                    font-size: 9px;
                                    font-weight: 600;
                                }

                                .spec-cell {
                                    padding: 2mm 4mm;
                                    vertical-align: middle;
                                    font-size: 13px;
                                    font-weight: 700;
                                    white-space: nowrap;
                                }

                                .lot-qr-cell {
                                    width: 46%;
                                    padding: 3mm 2mm 3mm 5mm;
                                    vertical-align: middle;
                                    text-align: center;
                                    font-size: 9px;
                                    font-weight: 600;
                                }

                                .lot-info-cell {
                                    width: 54%;
                                    padding: 3mm 4mm 3mm 3mm;
                                    vertical-align: middle;
                                    font-size: 12px;
                                    font-weight: 700;
                                    line-height: 1.65;
                                    word-break: break-word;
                                }

                                .qr-caption {
                                    margin-top: 1mm;
                                    font-size: 9px;
                                    font-weight: 600;
                                }
                            </style>
                            <div class="outbound-label-header">
                                <table class="outbound-header-table">
                                    <tr>
                                        <td class="outbound-header-main">
                                            <p class="outbound-label-title">World Depot B.V.</p>
                                            <p class="outbound-label-subtitle">Outbound Order</p>
                                            <table class="outbound-label-info">
                                                <tr>
                                                    <td class="label">Bill No:</td>
                                                    <td><span t-field="o.billno"/></td>
                                                    <td class="label">Owner:</td>
                                                    <td><span t-esc="o.owner.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="label">Reference:</td>
                                                    <td><span t-field="o.reference"/></td>
                                                    <td class="label">Picking:</td>
                                                    <td><span t-field="picking.name"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td class="outbound-picking-qr-cell" t-if="picking">
                                            <div t-field="picking.name"
                                                 t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 260, 'height': 260, 'img_style': 'width:30mm;height:30mm;', 'img_class': 'keep-no-break'}"/>
                                            <div><span t-esc="section['title']"/></div>
                                            <div><span t-field="picking.name"/></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <table class="label-table">
                                <tr>
                                    <td class="label-cell">
                                        <t t-if="page_start &lt; len(lines)">
                                            <t t-call="stock_barcode_lite.report_outbound_lot_code_label_card">
                                                <t t-set="line" t-value="lines[page_start]"/>
                                            </t>
                                        </t>
                                    </td>
                                    <td class="label-cell">
                                        <t t-if="page_start + 1 &lt; len(lines)">
                                            <t t-call="stock_barcode_lite.report_outbound_lot_code_label_card">
                                                <t t-set="line" t-value="lines[page_start + 1]"/>
                                            </t>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label-cell">
                                        <t t-if="page_start + 2 &lt; len(lines)">
                                            <t t-call="stock_barcode_lite.report_outbound_lot_code_label_card">
                                                <t t-set="line" t-value="lines[page_start + 2]"/>
                                            </t>
                                        </t>
                                    </td>
                                    <td class="label-cell">
                                        <t t-if="page_start + 3 &lt; len(lines)">
                                            <t t-call="stock_barcode_lite.report_outbound_lot_code_label_card">
                                                <t t-set="line" t-value="lines[page_start + 3]"/>
                                            </t>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_outbound_lot_code_label_card">
        <t t-set="product_code" t-value="line.product_id.default_code or line.product_id.barcode or ''"/>
        <t t-set="lot_code" t-value="line.lot_name or ''"/>
        <table class="label-card">
            <tr class="top-row">
                <td class="product-text">
                    <span t-field="line.product_id.display_name"/>
                </td>
                <td class="product-qr-cell">
                    <span t-out="product_code"
                          t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 160, 'height': 160, 'img_style': 'width:34mm;height:34mm;'}"/>
                    <div class="qr-caption">Product QR Code</div>
                </td>
            </tr>

            <tr class="spec-row">
                <td class="spec-cell" colspan="2">
                    Specification:
                    <span t-esc="line.box_in_qty"/>
                    <span t-esc="line.u8_aux_uom_name or ''"/>
                </td>
            </tr>

            <tr class="bottom-row">
                <td class="lot-qr-cell">
                    <span t-out="lot_code"
                          t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 170, 'height': 170, 'img_style': 'width:36mm;height:36mm;'}"/>
                    <div class="qr-caption">Lot QR Code</div>
                </td>
                <td class="lot-info-cell">
                    <div>Lot No: <span t-esc="line.lot_name or ''"/></div>
                    <div>MFG Date: <span t-esc="line.m_date or ''"/></div>
                    <div>EXP Date: <span t-esc="line.e_date or ''"/></div>
                </td>
            </tr>
        </table>
    </template>


</odoo>
