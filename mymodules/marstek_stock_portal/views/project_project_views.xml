        <field name="name">project.project.form.portal.stock.location.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="outbound_pick_type" position="after">
                <field name="portal_stock_location_line_ids" widget="many2many_tags" domain="[('usage', 'in', ('view', 'internal', 'transit'))]" options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>
</odoo>
