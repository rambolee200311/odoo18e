<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunrise_product_specification_import_list" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.list</field>
        <field name="model">sunrise.product.specification.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="state"/>
                <field name="total_count"/>
                <field name="success_count"/>
                <field name="warning_count"/>
                <field name="failed_count"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_product_specification_import_form" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.form</field>
        <field name="model">sunrise.product.specification.import</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_import_sunrise_product_batch_specification"
                            type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done,partial,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" readonly="state != 'draft'"/>
                            <field name="file" filename="filename" required="1" readonly="state != 'draft'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_count" readonly="1"/>
                            <field name="success_count" readonly="1"/>
                            <field name="warning_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="remark" readonly="state != 'draft'"/>
                        <field name="message" readonly="1"/>
                    </group>

                    <notebook>
                        <page name="import_lines" string="Import Lines">
                            <field name="line_ids">
                                <list create="false" delete="false">
                                    <field name="row_number"/>
                                    <field name="state"/>
                                    <button name="action_retry_import"
                                            type="object"
                                            string="Retry"
                                            class="btn-primary"
                                            invisible="state != 'failed'"/>
                                    <field name="product_code"/>
                                    <field name="lot_name"/>
                                    <field name="gross_weight"/>
                                    <field name="product_dimensions"/>
                                    <field name="sunrise_uom_conversion_rate"/>
                                    <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="error_msg"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_product_specification_import_search" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.search</field>
        <field name="model">sunrise.product.specification.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="filename"/>
                <field name="state"/>
                <filter name="state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="state_partial" string="Partial" domain="[('state', '=', 'partial')]"/>
                <filter name="state_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_sunrise_product_specification_import_line_list" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.line.list</field>
        <field name="model">sunrise.product.specification.import.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="import_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="row_number"/>
                <field name="state"/>
                <button name="action_retry_import"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        invisible="state != 'failed'"/>
                <field name="product_code"/>
                <field name="lot_name"/>
                <field name="gross_weight"/>
                <field name="product_dimensions"/>
                <field name="sunrise_uom_conversion_rate"/>
                <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="error_msg"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_product_specification_import_line_form" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.line.form</field>
        <field name="model">sunrise.product.specification.import.line</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_retry_import"
                            type="object"
                            string="Retry"
                            class="btn-primary"
                            invisible="state != 'failed'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="import_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="row_number" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_template_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <group string="Import Data">
                        <group>
                            <field name="product_code" readonly="state != 'failed'"/>
                            <field name="lot_name" readonly="state != 'failed'"/>
                            <field name="gross_weight" readonly="state != 'failed'"/>
                        </group>
                        <group>
                            <field name="product_dimensions" readonly="state != 'failed'"/>
                            <field name="sunrise_uom_conversion_rate" readonly="state != 'failed'"/>
                        </group>
                    </group>

                    <group>
                        <field name="error_msg" readonly="1"/>
                        <field name="remark" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_product_specification_import_line_search" model="ir.ui.view">
        <field name="name">sunrise.product.specification.import.line.search</field>
        <field name="model">sunrise.product.specification.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="import_id"/>
                <field name="product_code"/>
                <field name="lot_name"/>
                <field name="state"/>
                <filter name="state_success" string="Success" domain="[('state', '=', 'success')]"/>
                <filter name="state_warning" string="Warning" domain="[('state', '=', 'warning')]"/>
                <filter name="state_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_import" string="Import" context="{'group_by': 'import_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_sunrise_product_specification_import" model="ir.actions.act_window">
        <field name="name">Sunrise Batch Specification Imports</field>
        <field name="res_model">sunrise.product.specification.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sunrise_product_specification_import_search"/>
    </record>

    <record id="action_sunrise_product_specification_import_line" model="ir.actions.act_window">
        <field name="name">Sunrise Batch Specification Import Lines</field>
        <field name="res_model">sunrise.product.specification.import.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sunrise_product_specification_import_line_search"/>
    </record>

    <menuitem id="menu_sunrise_product_batch_specification_import"
              name="Sunrise Batch Specification Imports"
              parent="menu_stock_barcode_lite_configuration"
              action="action_sunrise_product_specification_import"
              sequence="35"/>

    <menuitem id="menu_sunrise_product_batch_specification_import_line"
              name="Sunrise Batch Specification Import Lines"
              parent="menu_stock_barcode_lite_configuration"
              action="action_sunrise_product_specification_import_line"
              sequence="36"/>
</odoo>
