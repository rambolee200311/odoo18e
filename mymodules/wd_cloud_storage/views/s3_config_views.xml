<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_s3_config_list" model="ir.ui.view">
        <field name="name">s3.config.list</field>
        <field name="model">s3.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="s3_bucket" />
                <field name="s3_region" />
                <field name="global_attachment_to_cloud" />
                <field name="max_file_size_mb" />
                <field name="company_id" />
            </list>
        </field>
    </record>

    <record id="view_s3_config_form" model="ir.ui.view">
        <field name="name">s3.config.form</field>
        <field name="model">s3.config</field>
        <field name="arch" type="xml">
            <form string="Cloud Config" duplicate="false">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-secondary" />
                    <button name="action_init_public_folders" string="Init Public Folders" type="object" class="btn-secondary" groups="wd_cloud_storage.group_wd_cloud_storage_admin" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" />
                            <field name="s3_access_key" required="1" password="1" />
                            <field name="s3_secret_key" required="1" password="1" />
                            <field name="s3_region" required="1" />
                            <field name="s3_bucket" required="1" />
                            <field name="presigned_url_expiry" required="1" />
                            <field name="retention_days" required="1"/>
                            <field name="company_id" required="1" readonly="1" options="{'no_create': True, 'no_open': True}" />
                        </group>
                        <group>
                            <field name="prefix_private" required="1" />
                            <field name="prefix_public" required="1" />
                            <field name="prefix_temp" required="1" />
                            <field name="prefix_recycle" required="1" />
                            <field name="attachment_prefix" required="1" />
                            <field name="global_attachment_to_cloud" />
                            <field name="max_file_size_mb" required="1" />
                            <field name="allowed_file_types" />
                            <field name="log_retention_days" required="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>