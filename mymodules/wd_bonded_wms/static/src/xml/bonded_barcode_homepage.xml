<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="wd_bonded_wms.BondedBarcodeHomepage">
        <div class="o_bonded_barcode_homepage">
            <div class="container-fluid py-2">
                <div class="section-header">
                    <h5 class="section-title">Inbound</h5>
                </div>
                <div class="row g-3 g-md-4">
                    <div class="col-12 col-md-6">
                        <div class="card h-100 shadow-sm o_bonded_barcode_card">
                            <div class="card-header bg-light text-dark">
                                <h3 class="mb-0"><i class="fa fa-sign-in me-2"/>Inbound Picking Scan</h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Scan an inbound picking, destination locations and pallets.</p>
                                <button class="btn btn-primary mt-3" t-on-click="_onInboundClick"><i class="fa fa-arrow-right me-2"/>Go</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section-header">
                    <h5 class="section-title">Outbound</h5>
                </div>
                <div class="row g-3 g-md-4">
                    <div class="col-12 col-md-6">
                        <div class="card h-100 shadow-sm o_bonded_barcode_card">
                            <div class="card-header bg-light text-dark">
                                <h3 class="mb-0"><i class="fa fa-sign-out me-2"/>Full Pallet Pick</h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Scan and pick complete pallets for outbound orders.</p>
                                <button class="btn btn-success mt-3" t-on-click="_onOutboundWholeClick"><i class="fa fa-arrow-right me-2"/>Go</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card h-100 shadow-sm o_bonded_barcode_card">
                            <div class="card-header bg-light text-dark">
                                <h3 class="mb-0"><i class="fa fa-sign-out me-2"/>Break Bulk Pick</h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Scan pallets and pick individual products and quantities.</p>
                                <button class="btn btn-success mt-3" t-on-click="_onOutboundBreakClick"><i class="fa fa-arrow-right me-2"/>Go</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section-header">
                    <h5 class="section-title">Internal Transfer</h5>
                </div>
                <div class="row g-3 g-md-4">
                    <div class="col-12 col-md-6">
                        <div class="card h-100 shadow-sm o_bonded_barcode_card">
                            <div class="card-header bg-light text-dark">
                                <h3 class="mb-0"><i class="fa fa-arrows-alt me-2"/>Internal Transfer</h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Scan a destination location and pallets to move stock.</p>
                                <button class="btn btn-info mt-3" t-on-click="_onInternalTransferClick"><i class="fa fa-arrow-right me-2"/>Go</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
