        <record id="rule_marstek_ir_attachment_portal" model="ir.rule">
            <field name="name">Marstek Portal Attachment Read Only</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[
                '|', '|', '|',
                '&amp;', ('res_model', '=', 'world.depot.inbound.order'), ('res_id', 'in', user.env['world.depot.inbound.order'].sudo().search([('project.owner', '=', user.marstek_owner_id.id or 0)]).ids),
                '&amp;', ('res_model', '=', 'world.depot.outbound.order'), ('res_id', 'in', user.env['world.depot.outbound.order'].sudo().search([('project.owner', '=', user.marstek_owner_id.id or 0)]).ids),
                '&amp;', ('res_model', '=', 'world.depot.inbound.order.docs'), ('res_id', 'in', user.env['world.depot.inbound.order.docs'].sudo().search([('inbound_order_id.project.owner', '=', user.marstek_owner_id.id or 0)]).ids),
                '&amp;', ('res_model', '=', 'world.depot.outbound.order.docs'), ('res_id', 'in', user.env['world.depot.outbound.order.docs'].sudo().search([('outbound_order_id.project.owner', '=', user.marstek_owner_id.id or 0)]).ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
