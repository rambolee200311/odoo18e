<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_s3_rename_file_wizard_form" model="ir.ui.view">
        <field name="name">s3.rename.file.wizard.form</field>
        <field name="model">s3.rename.file.wizard</field>
        <field name="arch" type="xml">
            <form string="Rename File" duplicate="false">
                <sheet>
                    <group>
                        <field name="file_id" invisible="1" required="1" readonly="1"/>
                        <field name="new_name" string="Name" required="1" placeholder="New file name"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <data noupdate="1">
        <record id="action_s3_rename_file_wizard" model="ir.actions.act_window">
            <field name="name">Rename File</field>
            <field name="res_model">s3.rename.file.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_s3_rename_file_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>