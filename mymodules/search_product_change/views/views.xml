<odoo>

  <record id="view_product_template_batch_search_wizard_form" model="ir.ui.view">
    <field name="name">product.template.batch.search.wizard.form</field>
    <field name="model">product.template.batch.search.wizard</field>
    <field name="arch" type="xml">
      <form string="Batch Search Products" duplicate="false">
        <sheet>
          <group>
            <field name="name_text" placeholder="Example: AAA,BBB,CCC"/>
          </group>
          <footer>
            <button name="action_search" type="object" string="Search" class="btn-primary"/>
            <button special="cancel" string="Cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_product_template_batch_search_wizard" model="ir.actions.act_window">
    <field name="name">Batch Search Products</field>
    <field name="res_model">product.template.batch.search.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

<menuitem id="menu_product_template_batch_search_wizard"
                  name="Batch Search Products"
                  parent="stock.menu_stock_inventory_control"
                  action="action_product_template_batch_search_wizard"
                  sequence="220"/>

</odoo>
