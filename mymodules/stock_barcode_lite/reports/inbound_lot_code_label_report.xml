<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_inbound_lot_code_label" model="ir.actions.report">
        <field name="name">Inbound Product Lot Code Labels</field>
        <field name="model">world.depot.inbound.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_barcode_lite.report_inbound_lot_code_label</field>
        <field name="report_file">stock_barcode_lite.report_inbound_lot_code_label</field>
        <field name="print_report_name">'Inbound Lot Labels - %s' % (object.vsourcebillcode or object.billno or object.reference or object.id)</field>
        <field name="paperformat_id" ref="paperformat_inbound_pallet_label"/>
        <field name="binding_model_id" ref="worlddepot.model_world_depot_inbound_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_inbound_lot_code_label">
        <t t-set="data_report_margin_top" t-value="6"/>
        <t t-set="data_report_header_spacing" t-value="0"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lines" t-value="lines_by_order.get(o.id, [])"/>
                <t t-foreach="range(0, len(lines), 4)" t-as="page_start">
                    <div class="page label-page">
                        <style>
                            @page {
                                margin-top: 10mm !important;
                                margin-bottom: 6mm;
                                margin-left: 6mm;
                                margin-right: 6mm;
                            }

                            html,
                            body,
                            #wrapwrap,
                            main {
                                margin-top: 0 !important;
                                padding-top: 0 !important;
                            }

                            .inbound-label-header {
                                page-break-inside: avoid;
                                break-inside: avoid;
                                min-height: 31mm;
                                margin-bottom: 3mm;
                                border-bottom: 2px solid #111827;
                            }

                            .inbound-label-title {
                                font-size: 22px;
                                font-weight: bold;
                                margin: 0 0 2px 0;
                            }

                            .inbound-label-subtitle {
                                font-size: 16px;
                                font-weight: bold;
                                margin: 0 0 3mm 0;
                            }

                            .inbound-label-info {
                                width: 100%;
                                border-collapse: collapse;
                                table-layout: fixed;
                                font-size: 12px;
                            }

                            .inbound-label-info td {
                                border: 1px solid #111827;
                                padding: 2px 5px;
                                vertical-align: top;
                            }

                            .inbound-label-info .label {
                                width: 28mm;
                                font-weight: bold;
                                white-space: nowrap;
                            }

                            .label-page {
                                padding: 4mm 0 0 0;
                                margin-top: 0;
                                font-family: Arial, sans-serif;
                                page-break-before: always;
                                page-break-inside: avoid;
                                break-inside: avoid;
                                box-sizing: border-box;
                            }

                            .label-table {
                                width: 100%;
                                border-collapse: separate;
                                border-spacing: 0;
                                table-layout: fixed;
                                border: 0;
                            }

                            .label-cell {
                                width: 50%;
                                height: 96mm;
                                vertical-align: top;
                                padding: 1.5mm;
                                box-sizing: border-box;
                                border: 0;
                            }

                            .label-row-top .label-cell {
                                padding-bottom: 5mm;
                            }

                            .label-row-bottom .label-cell {
                                padding-top: 5mm;
                            }

                            .label-card {
                                width: 100%;
                                height: 92mm;
                                border: 2px solid #111827;
                                border-collapse: collapse;
                                table-layout: fixed;
                                overflow: hidden;
                                max-height: 92mm;
                            }

                            .label-card td {
                                box-sizing: border-box;
                                border-left: 0;
                                border-right: 0;
                                border-top: 0;
                                overflow: hidden;
                            }

                            .top-row,
                            .top-row td {
                                height: 36mm;
                                max-height: 36mm;
                            }

                            .top-row td {
                                border-bottom: 1px solid #111827;
                            }

                            .spec-row,
                            .spec-row td {
                                height: 11mm;
                                max-height: 11mm;
                            }

                            .spec-row td {
                                border-bottom: 1px solid #111827;
                            }

                            .bottom-row,
                            .bottom-row td {
                                height: 45mm;
                                max-height: 45mm;
                            }

                            .product-text {
                                width: 58%;
                                height: 36mm;
                                max-height: 36mm;
                                padding: 4mm;
                                vertical-align: middle;
                                font-size: 13px;
                                font-weight: 700;
                                line-height: 1.25;
                                word-break: break-word;
                                overflow: hidden;
                            }

                            .product-name-text {
                                display: block;
                                max-height: 18mm;
                                overflow: hidden;
                                line-height: 1.2;
                            }

                            .product-qr-cell {
                                width: 42%;
                                height: 36mm;
                                max-height: 36mm;
                                padding: 3mm;
                                vertical-align: middle;
                                text-align: center;
                                font-size: 9px;
                                font-weight: 600;
                                overflow: hidden;
                            }

                            .spec-cell {
                                padding: 2mm 4mm;
                                vertical-align: middle;
                                font-size: 13px;
                                font-weight: 700;
                                white-space: nowrap;
                            }

                            .lot-qr-cell {
                                width: 46%;
                                padding: 3mm 2mm 3mm 5mm;
                                vertical-align: middle;
                                text-align: center;
                                font-size: 9px;
                                font-weight: 600;
                            }

                            .lot-info-cell {
                                width: 54%;
                                padding: 3mm 4mm 3mm 3mm;
                                vertical-align: middle;
                                font-size: 12px;
                                font-weight: 700;
                                line-height: 1.65;
                                word-break: break-word;
                            }

                            .qr-caption {
                                margin-top: 1mm;
                                font-size: 9px;
                                font-weight: 600;
                            }
                        </style>
                        <div class="inbound-label-header">
                            <p class="inbound-label-title">World Depot B.V.</p>
                            <p class="inbound-label-subtitle">Inbound Order</p>
                            <table class="inbound-label-info">
                                <tr>
                                    <td class="label">Reference:</td>
                                    <td><span t-field="o.reference"/></td>
                                    <td class="label">Owner:</td>
                                    <td><span t-esc="o.owner.name"/></td>
                                </tr>
                                <tr>
                                    <td class="label">Arrival Date:</td>
                                    <td colspan="3"><span t-if="o.a_date" t-esc="o.a_date.strftime('%Y-%m-%d')"/></td>
                                </tr>
                                <tr>
                                    <td class="label">BL No:</td>
                                    <td><span t-field="o.bl_no"/></td>
                                    <td class="label">Container No:</td>
                                    <td><span t-field="o.cntr_no"/></td>
                                </tr>
                            </table>
                        </div>

                        <table class="label-table">
                            <tr class="label-row-top">
                                <td class="label-cell">
                                    <t t-if="page_start &lt; len(lines)">
                                        <t t-call="stock_barcode_lite.report_inbound_lot_code_label_card">
                                            <t t-set="line" t-value="lines[page_start]"/>
                                        </t>
                                    </t>
                                </td>
                                <td class="label-cell">
                                    <t t-if="page_start + 1 &lt; len(lines)">
                                        <t t-call="stock_barcode_lite.report_inbound_lot_code_label_card">
                                            <t t-set="line" t-value="lines[page_start + 1]"/>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                            <tr class="label-row-bottom">
                                <td class="label-cell">
                                    <t t-if="page_start + 2 &lt; len(lines)">
                                        <t t-call="stock_barcode_lite.report_inbound_lot_code_label_card">
                                            <t t-set="line" t-value="lines[page_start + 2]"/>
                                        </t>
                                    </t>
                                </td>
                                <td class="label-cell">
                                    <t t-if="page_start + 3 &lt; len(lines)">
                                        <t t-call="stock_barcode_lite.report_inbound_lot_code_label_card">
                                            <t t-set="line" t-value="lines[page_start + 3]"/>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_inbound_lot_code_label_card">
        <t t-set="product_code" t-value="line.product_id.default_code or line.product_id.barcode or ''"/>
        <t t-set="lot_code" t-value="line.lot_name or ''"/>
        <table class="label-card">
            <tr class="top-row">
                <td class="product-text">
                    <span class="product-name-text" t-field="line.product_id.display_name"/>
                </td>
                <td class="product-qr-cell">
                    <span t-out="product_code"
                          t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 160, 'height': 160, 'img_style': 'width:34mm;height:34mm;'}"/>
                    <div class="qr-caption">Product QR Code</div>
                </td>
            </tr>

            <tr class="spec-row">
                <td class="spec-cell" colspan="2">
                    Specification:
                    <span t-esc="line.box_in_qty"/>
                    <span t-esc="line.u8_aux_uom_name or ''"/>
                </td>
            </tr>

            <tr class="bottom-row">
                <td class="lot-qr-cell">
                    <span t-out="lot_code"
                          t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 170, 'height': 170, 'img_style': 'width:36mm;height:36mm;'}"/>
                    <div class="qr-caption">Lot QR Code</div>
                </td>
                <td class="lot-info-cell">
                    <div>Lot No: <span t-esc="line.lot_name or ''"/></div>
                    <div>MFG Date: <span t-esc="line.m_date or ''"/></div>
                    <div>EXP Date: <span t-esc="line.e_date or ''"/></div>
                </td>
            </tr>
        </table>
    </template>
</odoo>
