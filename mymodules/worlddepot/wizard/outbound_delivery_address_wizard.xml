<odoo>
    <record id="view_world_depot_delivery_address_wizard_form" model="ir.ui.view">
        <field name="name">world.depot.delivery.address.wizard.form</field>
        <field name="model">world.depot.delivery.address.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Delivery Address" duplicate="false">
                <sheet>
                    <field name="outbound_order_id" invisible="1" required="1"/>
                    <field name="is_parsed" invisible="1" readonly="1"/>
                    <group>
                        <field name="raw_text" placeholder="Paste delivery address text."/>
                        <button name="action_parse_delivery_text" type="object" string="Parse" icon="fa-map-marker"
                                class="btn-secondary"/>
                        <button name="action_parse_delivery_text_with_deepseek" type="object" string="Parse with DeepSeek"
                                icon="fa-magic" class="btn-secondary"/>
                    </group>
                    <group>
                        <field name="parsed_recipient_name" readonly="1"/>
                        <field name="recipient_id" required="1" readonly="1"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="address_mode" widget="radio"/>
                        <field name="delivery_partner_id"
                               domain="['&amp;', ('active', '=', True), '|', ('id', '=', recipient_id), '&amp;', ('parent_id', '=', recipient_id), ('type', '=', 'delivery')]"
                               required="address_mode == 'existing'"
                               invisible="address_mode != 'existing'"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="street" required="address_mode == 'new'"
                               readonly="address_mode == 'existing'"/>

                        <field name="city" required="address_mode == 'new'"
                               readonly="address_mode == 'existing'"/>

                        <field name="zip" required="address_mode == 'new'"
                               readonly="address_mode == 'existing'"/>

                        <field name="country_id" required="address_mode == 'new'"
                               readonly="address_mode == 'existing'"
                               options="{'no_create': True, 'no_open': True}"/>

                        <field name="phone" readonly="address_mode == 'existing'"/>

                        <field name="mobile"
                               readonly="address_mode == 'existing'"/>

                        <field name="email"
                               readonly="address_mode == 'existing'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_delivery_address" type="object" string="Use Address"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
