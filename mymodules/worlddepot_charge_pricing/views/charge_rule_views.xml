<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_charge_rule" model="ir.actions.act_window">
        <field name="name">Fee Rules</field>
        <field name="res_model">charge.rule</field>
        <field name="view_mode">list,form</field>
    </record>

<!-- Menu-->
    <menuitem id="menu_wd_charge_rule"
              name="Fee Rules"
              parent="menu_wd_charge_root"
              action="worlddepot_charge_pricing.action_charge_rule"
              sequence="20"/>
    <!-- Tree -->
    <record id="view_charge_rule_tree" model="ir.ui.view">
        <field name="name">charge.rule.tree</field>
        <field name="model">charge.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="base_rate"/>
                <field name="currency_id"/>
                <field name="trigger_event"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_charge_rule_form" model="ir.ui.view">
        <field name="name">charge.rule.form</field>
        <field name="model">charge.rule</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="rule_type" required="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id" required="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="base_rate"/>
                            <field name="trigger_event"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="effective_from" required="1"/>
                            <field name="effective_to"/>
                            <field name="rule_config"/>
                            <field name="remark"/>
                        </group>
                        <group>
                            <field name="condition_expr"
                                   placeholder="e.g. order_type == 'customs' and container_count &gt; 1"/>
                        </group>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
