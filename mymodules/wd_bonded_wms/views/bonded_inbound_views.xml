<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_inbound_view_tree" model="ir.ui.view">
        <field name="name">bonded.inbound.tree</field>
        <field name="model">bonded.inbound</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="t1_customs_file_id"/>
                <field name="bonded_book_id"/>
                <field name="project_id"/>
                <field name="inbound_tracking_id"/>
                <field name="expected_date"/>
                <field name="total_value" widget="monetary"/>
                <field name="state"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <record id="bonded_inbound_view_form" model="ir.ui.view">
        <field name="name">bonded.inbound.form</field>
        <field name="model">bonded.inbound</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_create_t1_in_customs_file" string="Create T1 Inbound" type="object" invisible="state != 'confirmed' or t1_customs_file_id" class="btn-primary"/>
                    <button name="action_return_to_draft" string="Return to Draft" type="object" invisible="state != 'confirmed' or t1_customs_file_id"/>
                    <button name="action_create_picking" string="Create Stock Picking" type="object" invisible="state != 'released'" class="btn-primary"/>
                    <button name="action_done" string="Set to Done" type="object" invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed', 'declared')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,declared,released,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Inbound Info">
                            <field name="name" readonly="1"/>
                            <field name="bonded_book_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="package_generation_mode" invisible="1"/>
                            <field name="inbound_tracking_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="t1_customs_file_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="warehouse" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="warehouse_address" readonly="1"/>
                            <field name="pick_type" required="1" readonly="state != 'draft'" domain="[('code', '=', 'incoming'), ('warehouse_id', '=', warehouse)]" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group string="Schedule">
                            <field name="expected_date" readonly="state != 'draft'"/>
                            <field name="total_value" readonly="1" widget="monetary"/>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="picking_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" default_order="pallet_no,id">
                                    <field name="eligible_bonded_product_ids" column_invisible="1"/>
                                    <field name="bonded_product_id" domain="[('id', 'in', eligible_bonded_product_ids)]" required="1" options="{'no_create': True, 'no_open': False}"/>
<!--                                    <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>-->
                                    <field name="uom_id" readonly="1"/>
                                    <field name="customer_batch_no"/>
                                    <field name="pallet_no" required="parent.package_generation_mode in ('inbound', 'picking')"/>
                                    <field name="package_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="planned_qty"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="declared_unit_price" required="1" widget="monetary"/>
                                    <field name="subtotal_value" readonly="1" widget="monetary"/>
                                    <field name="gross_weight"/>
                                    <field name="net_weight"/>

                                    <field name="done_qty"/>

                                    <field name="available_customs_file_line_ids" column_invisible="1"/>
<!--                                    <field name="customs_file_line_id" domain="[('customs_file_id', '=', parent.t1_customs_file_id), ('product_id', '=', product_id), ('id', 'in', available_customs_file_line_ids)]" readonly="not parent.t1_customs_file_id" options="{'no_create': True, 'no_open': False}"/>-->
                                </list>
                            </field>
                        </page>
                        <page name="gate_arrivals" string="Gate Arrival">
                            <field name="gate_arrival_ids" mode="list,form" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="container_no"/>
                                    <field name="mrn"/>
                                    <field name="arrival_datetime"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
