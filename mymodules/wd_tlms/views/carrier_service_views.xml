<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_carrier_service_tree" model="ir.ui.view">
        <field name="name">tlmp.carrier.service.tree</field>
        <field name="model">tlmp.carrier.service</field>
        <field name="arch" type="xml">
            <list string="Carrier Services" default_order="sequence">
                <field name="code"/>
                <field name="name"/>
                <field name="carrier_id" optional="show"/>
                <field name="service_type" widget="badge"/>
                <field name="transport_type_ids" widget="many2many_tags" optional="show"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_carrier_service_form" model="ir.ui.view">
        <field name="name">tlmp.carrier.service.form</field>
        <field name="model">tlmp.carrier.service</field>
        <field name="arch" type="xml">
            <form string="Carrier Service">
                <sheet>
                    <group>
                        <group string="Service Info">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="carrier_id" options="{'no_create': True}"/>
                            <field name="service_type"/>
                        </group>
                        <group string="Capabilities">
                            <field name="transport_type_ids" widget="many2many_tags"/>
                            <field name="tracking_url_template" placeholder="https://track.example.com/{tracking_number}"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tlmp_carrier_service" model="ir.actions.act_window">
        <field name="name">Carrier Services</field>
        <field name="res_model">tlmp.carrier.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
