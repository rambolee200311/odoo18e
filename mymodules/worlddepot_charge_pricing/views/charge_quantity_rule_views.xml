<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_charge_quantity_rule" model="ir.actions.act_window">
        <field name="name">Quantity Rules</field>
        <field name="res_model">charge.quantity.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_wd_charge_quantity_rule"
              name="Quantity Rules"
              parent="menu_wd_charge_root"
              action="worlddepot_charge_pricing.action_charge_quantity_rule"
              sequence="30"/>


    <!-- Tree -->
    <record id="view_charge_quantity_rule_tree" model="ir.ui.view">
        <field name="name">charge.quantity.rule.tree</field>
        <field name="model">charge.quantity.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="source_field"/>
                <field name="min_value"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_charge_quantity_rule_form" model="ir.ui.view">
        <field name="name">charge.quantity.rule.form</field>
        <field name="model">charge.quantity.rule</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="source_field" required="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="min_value"/>
                        </group>
                        <group>
                            <field name="remark"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
