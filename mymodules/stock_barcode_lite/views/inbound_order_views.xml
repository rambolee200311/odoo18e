    <record id="view_chenyang_chemical_inbound_order_product_form_inherit" model="ir.ui.view">
        <field name="name">chenyang.chemical.inbound.order.product.form.inherit</field>
        <field name="model">world.depot.inbound.order.product</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_product_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//field[@name='pallet_no']" position="after">-->
<!--                <field name="creation_source" readonly="1"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='pallet_no']" position="after">
                <field name="sunrise_pallet_no" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='inbound_order_product_pallet_ids']/list/field[@name='product_id']" position="after">
                <field name="cprojectid" optional="show"/>
                <field name="ndiscounttaxtype" optional="show"/>
                <field name="vsourcebillcode" optional="show"/>
                <field name="vsourcerowno" optional="show"/>
                <field name="box_type" optional="show"/>
                <field name="box_qty" optional="show"/>
                <field name="box_in_qty" optional="show"/>
                <field name="u8_aux_qty" optional="show"/>
                <field name="u8_conversion_rate" optional="show"/>
                <field name="ninnum" optional="show"/>
                <field name="castunitid" optional="show"/>
                <field name="u8_aux_uom_name" optional="show"/>
                <field name="is_lot" readonly="1" optional="show"/>
                <field name="lot_name" readonly="1" optional="show"/>
                <field name="m_date" optional="show"/>
                <field name="e_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_chenyang_chemical_inbound_order_product_pallet_tree_inherit" model="ir.ui.view">
        <field name="name">chenyang.chemical.inbound.order.product.pallet.tree.inherit</field>
        <field name="model">world.depot.inbound.order.products.pallet</field>
        <field name="inherit_id" ref="worlddepot.view_inbound_order_product_pallet_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="cprojectid" optional="show"/>
                <field name="ndiscounttaxtype" optional="show"/>
                <field name="vsourcebillcode" optional="show"/>
                <field name="vsourcerowno" optional="show"/>
                <field name="box_type" optional="show"/>
                <field name="box_qty" optional="show"/>
                <field name="castunitid" optional="show"/>
                <field name="box_in_qty" optional="show"/>
                <field name="u8_aux_uom_name" optional="show"/>
                <field name="u8_aux_qty" optional="show"/>
                <field name="u8_conversion_rate" optional="show"/>
                <field name="ninnum" optional="show"/>
                <field name="is_lot" readonly="1" optional="show"/>
                <field name="lot_name" readonly="1" optional="show"/>
                <field name="m_date" optional="show"/>
                <field name="e_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
