<odoo>
    <record id="view_modify_lot_name_form" model="ir.ui.view">
        <field name="name">modify.lot.name.form</field>
        <field name="model">modify.lot.name</field>
        <field name="arch" type="xml">
            <form string="Modify Lot Name" duplicate="false">
                <header>
                    <button name="action_confirm_modify" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_rollback_modify" type="object" string="Rollback" class="btn-primary"
                            confirm="Are you sure you want to rollback this SN modification?"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="allowed_product_line_ids" invisible="1"/>
                            <field name="reference" readonly="1"/>
                            <field name="picking_id" required="1" readonly="state != 'draft'"
                                   domain="[('picking_type_id.code', '=', 'internal')]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="change_type" required="1" readonly="state != 'draft'" invisible="1"/>
                            <field name="project_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="reason" required="1" readonly="state != 'draft'"/>
                            <field name="error_message" readonly="1"/>
                            <field name="changed_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="change_date" readonly="1"/>
                            <field name="rollback_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="rollback_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="policy" readonly="1" style="height: 330px;"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="SN List">
                            <field name="sn_change_lines" readonly="state != 'draft'">
                                <list editable="bottom" string="SN List">
                                    <field name="product_id" required="1"
                                           domain="[('id', 'in', parent.allowed_product_line_ids)]"
                                           options="{'no_create': True, 'no_open': False}"/>
                                    <field name="old_name" required="1"/>
                                    <field name="new_name" required="1"/>
                                    <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open': True}"
                                           optional="hide"/>
                                    <field name="move_line_id" readonly="1"
                                           options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                    <field name="error_message" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_modify_lot_name_tree" model="ir.ui.view">
        <field name="name">modify.lot.name.tree</field>
        <field name="model">modify.lot.name</field>
        <field name="arch" type="xml">
            <list string="Modify Lot Name">
                <field name="reference"/>
                <field name="picking_id"/>
                <field name="project_id"/>
                <field name="state"/>
                <field name="changed_by_id"/>
                <field name="change_date"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="action_modify_lot_name" model="ir.actions.act_window">
        <field name="name">Modify Lot Name</field>
        <field name="res_model">modify.lot.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_modify_lot_name"
              name="Modify Lot Name"
              parent="worlddepot.outbound_logi_menu"
              action="action_modify_lot_name"
              sequence="660"/>
</odoo>
