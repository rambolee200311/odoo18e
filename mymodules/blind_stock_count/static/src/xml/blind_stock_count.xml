<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="blind_stock_count.ScanPage">
        <input t-ref="barcodeInput" type="text" class="o_hidden_barcode_input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" inputmode="none" touch-action="none" t-on-input="onBarcodeInput" t-on-keydown="onBarcodeKeydown" t-on-blur="onBarcodeBlur" t-att-disabled="state.loading || (state.count &amp;&amp; state.count.state === 'done')"/>
        <div class="o_blind_stock_count_scan o_sbl_inbound">
            <div class="o_sbl_header">
                <div class="o_sbl_header_title"><i class="fa fa-clipboard text-primary me-1"/>Blind Stock Count</div>
                <div t-attf-class="o_sbl_header_mode {{ state.nextStep === 'scan_location' ? 'o_mode_step' : state.nextStep === 'scan_pallet' ? 'o_mode_pallet' : state.nextStep === 'scan_product' ? 'o_mode_product' : state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity' ? 'o_mode_qty' : state.nextStep === 'scan_serial_numbers' || state.nextStep === 'scan_lot_name' ? 'o_mode_sn' : 'o_mode_order' }}">
                    <t t-if="state.nextStep === 'select_work_package'">Work Package</t>
                    <t t-elif="state.nextStep === 'scan_location'">Location</t>
                    <t t-elif="state.nextStep === 'scan_pallet'">Pallet</t>
                    <t t-elif="state.nextStep === 'scan_product'">Product</t>
                    <t t-elif="state.nextStep === 'scan_lot_name'">Batch Number</t>
                    <t t-elif="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'">Quantity</t>
                    <t t-else="">Serial Number</t>
                </div>
            </div>

            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}"><t t-esc="state.message"/></div>

            <div t-if="state.count" class="o_sbl_location_bar">
                <i class="fa fa-map-marker text-danger me-1"/><span class="me-1">Location:</span><strong class="text-primary"><t t-esc="state.count.location_name"/></strong>
                <span class="ms-3"><i class="fa fa-briefcase text-muted me-1"/>Work Package: <strong><t t-esc="state.workPackageName"/></strong></span>
                <span class="ms-3">Round: <strong><t t-esc="state.count.recount_round"/></strong></span>
                <span class="text-muted float-end"><t t-esc="state.count.name"/></span>
            </div>
            <div t-if="state.nextStep === 'scan_location' &amp;&amp; !state.count &amp;&amp; state.workPackageName" class="o_sbl_location_bar">
                <i class="fa fa-briefcase text-muted me-1"/><span class="me-1">Work Package:</span><strong class="text-primary"><t t-esc="state.workPackageName"/></strong>
            </div>

            <div class="o_sbl_step_indicator">
                <div t-attf-class="o_step_item {{ state.nextStep === 'select_work_package' ? 'active' : '' }} {{ state.nextStep !== 'select_work_package' &amp;&amp; state.workPackageId ? 'done' : '' }}">
                    <div class="o_step_circle"><t t-if="state.nextStep !== 'select_work_package' &amp;&amp; state.workPackageId"><i class="fa fa-check"/></t><t t-else="">1</t></div><div class="o_step_label">Work Package</div>
                </div>
                <div t-attf-class="o_step_line {{ state.locationVerified ? 'active' : '' }}"/>
                <div t-attf-class="o_step_item {{ state.nextStep === 'scan_location' ? 'active' : '' }} {{ state.locationVerified ? 'done' : '' }}">
                    <div class="o_step_circle"><t t-if="state.locationVerified"><i class="fa fa-check"/></t><t t-else="">2</t></div><div class="o_step_label">Location</div>
                </div>
                <div t-attf-class="o_step_line {{ state.pallet ? 'active' : '' }}"/>
                <div t-attf-class="o_step_item {{ state.nextStep === 'scan_pallet' ? 'active' : '' }} {{ state.pallet ? 'done' : '' }}">
                    <div class="o_step_circle"><t t-if="state.pallet"><i class="fa fa-check"/></t><t t-else="">3</t></div><div class="o_step_label">Pallet</div>
                </div>
                <div t-attf-class="o_step_line {{ state.product ? 'active' : '' }}"/>
                <div t-attf-class="o_step_item {{ state.nextStep === 'scan_product' ? 'active' : '' }} {{ state.product ? 'done' : '' }}">
                    <div class="o_step_circle"><t t-if="state.product"><i class="fa fa-check"/></t><t t-else="">4</t></div><div class="o_step_label">Product</div>
                </div>
                <div t-attf-class="o_step_line {{ state.product ? 'active' : '' }}"/>
                <div t-attf-class="o_step_item {{ state.nextStep === 'scan_serial_numbers' || state.nextStep === 'scan_lot_name' || state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity' ? 'active' : '' }}">
                    <div class="o_step_circle">5</div><div class="o_step_label">SN / Lot / Qty</div>
                </div>
            </div>

            <div class="o_sbl_step_hint">
                <i t-if="state.nextStep !== 'input_quantity' &amp;&amp; state.nextStep !== 'input_lot_quantity'" class="fa fa-qrcode me-2"/>
                <i t-if="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'" class="fa fa-pencil-square-o me-2"/>
                <t t-if="state.nextStep === 'select_work_package'">Select the work package before starting the blind stock count.</t>
                <t t-elif="state.nextStep === 'scan_location'">Scan the internal location barcode.</t>
                <t t-elif="state.nextStep === 'scan_pallet'">Scan a pallet barcode.</t>
                <t t-elif="state.nextStep === 'scan_product'">Scan a product barcode in the selected work package category.</t>
                <t t-elif="state.nextStep === 'scan_lot_name'">Scan the batch number.</t>
                <t t-elif="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'">Enter the actual quantity and tap Record. Tap Product to cancel.</t>
                <t t-else="">Scan serial number(s). Separate multiple serial numbers with commas if needed.</t>
            </div>

            <div class="o_sbl_pallets">
                <t t-if="state.nextStep === 'select_work_package'">
                    <div class="card border-primary shadow-sm mx-auto" style="max-width: 560px;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3"><i class="fa fa-briefcase fa-2x text-primary me-3"/><div><h5 class="mb-1">Select Work Package</h5><p class="text-muted small mb-0">Only products in this work package category can be scanned.</p></div></div>
                            <label class="form-label" for="blind_stock_count_work_package">Work Package</label>
                            <div class="input-group">
                                <select id="blind_stock_count_work_package" class="form-select" t-on-change="onWorkPackageChange" t-att-disabled="state.loading"><option value="">Select work package</option><t t-foreach="state.workPackages" t-as="workPackage" t-key="workPackage.id"><option t-att-value="workPackage.id" t-att-data-name="workPackage.name"><t t-esc="workPackage.name"/> — <t t-esc="workPackage.category_name"/></option></t></select>
                                <button class="btn btn-primary" t-on-click="confirmWorkPackage" t-att-disabled="state.loading"><i class="fa fa-check me-1"/>Confirm</button>
                            </div>
                        </div>
                    </div>
                </t>

                <t t-if="state.nextStep === 'scan_location'">
                    <div class="o_sbl_empty_state text-center text-muted py-5"><i class="fa fa-map-marker fa-4x mb-3 d-block"/><p class="mb-1 fw-bold">Waiting for Internal Location</p><p class="small">Use the scanner to scan the location barcode.</p></div>
                </t>

                <t t-if="state.count &amp;&amp; state.locationVerified &amp;&amp; !state.pallet &amp;&amp; !state.pallets.length">
                    <div class="o_sbl_empty_state text-center text-muted py-5"><i class="fa fa-cube fa-4x mb-3 d-block"/><p class="mb-1 fw-bold">Waiting for Pallet</p><p class="small">Use the scanner to scan a pallet barcode.</p></div>
                </t>

                <t t-foreach="state.pallets" t-as="pallet" t-key="pallet.id">
                    <div t-attf-class="o_sbl_pallet {{ state.pallet &amp;&amp; state.pallet.id === pallet.id ? 'o_pallet_highlighted' : '' }}">
                        <div class="o_pallet_header" t-on-click="selectPallet.bind(this, pallet)">
                            <div class="o_pallet_row1"><div class="o_pallet_info"><i class="fa fa-cube o_pallet_icon_highlighted me-2"/><strong class="o_pallet_name"><t t-esc="pallet.name"/></strong></div><div class="o_pallet_right"><span t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id" class="badge o_pallet_current_badge"><i class="fa fa-bullseye me-1"/>Current</span><i class="fa fa-chevron-down collapse-arrow ms-2"/></div></div>
                            <div class="o_pallet_row2"><span class="o_pallet_product_count"><t t-esc="pallet.line_count || 0"/> recorded lines</span><span t-if="pallet.barcode" class="o_pallet_location"><i class="fa fa-barcode text-muted me-1"/><t t-esc="pallet.barcode"/></span><span t-if="!pallet.barcode" class="o_pallet_location">No pallet barcode</span></div>
                            <div t-if="pallet.product_summaries.length" class="o_pallet_row2"><span class="o_pallet_product_count"><i class="fa fa-list-ul text-muted me-1"/>Products: <t t-foreach="pallet.product_summaries" t-as="productSummary" t-key="productSummary.id"><span><t t-esc="productSummary.name"/> × <t t-esc="productSummary.counted_qty"/></span><t t-if="!productSummary_last">, </t></t></span></div>
                        </div>
                        <div t-attf-id="blind_stock_count_pallet_lines_{{ pallet.id }}" t-attf-class="o_pallet_products collapse {{ state.expandedPalletId === pallet.id ? 'show' : '' }}">
                            <div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.product &amp;&amp; !(state.product.tracking === 'none' &amp;&amp; state.product.manual_line_id)" class="o_product_subcard border border-primary border-2 shadow-sm" style="background-color: #eef5ff;"><div class="o_product_row_top"><div class="o_product_icon"><i class="fa fa-box-open"/></div><div class="o_product_name"><t t-esc="state.product.name"/></div><span class="badge bg-primary"><t t-if="state.product.tracking === 'none'">Enter Qty</t><t t-elif="state.product.tracking === 'lot'">Scan Lot</t><t t-else="">Scan SN</t></span><span t-if="state.product.tracking === 'serial'" class="badge bg-info ms-2">Scanned SN: <t t-esc="state.product.scanned_serial_count || 0"/></span></div><div class="o_product_row_bottom"><span t-if="state.product.barcode" class="o_meta_barcode"><i class="fa fa-barcode me-1"/><t t-esc="state.product.barcode"/></span><span t-if="state.product.tracking === 'none'" class="o_meta_uom">Enter actual quantity</span><span t-if="state.product.tracking === 'lot'" class="o_meta_lot">Scan batch number</span><span t-if="state.product.tracking === 'serial'" class="o_meta_lot">Scan serial number</span><span t-if="state.product.tracking === 'lot' &amp;&amp; state.lotName" class="o_meta_lot ms-2">Lot: <t t-esc="state.lotName"/></span></div></div>
                            <div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.nextStep === 'input_quantity' &amp;&amp; !state.editingLineId" class="card border-primary shadow-sm mx-2 mb-2"><div class="card-body p-3"><label class="form-label fw-bold" for="blind_stock_count_quantity">Actual Quantity</label><div class="input-group"><input id="blind_stock_count_quantity" type="number" min="0" step="any" class="form-control form-control-lg" placeholder="Enter actual quantity" t-model="state.quantity" t-att-disabled="state.loading"/><button class="btn btn-primary" t-on-click="addManualQuantity" t-att-disabled="state.loading"><i class="fa fa-check me-1"/>Record</button></div></div></div>
                            <div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.nextStep === 'input_lot_quantity'" class="card border-primary shadow-sm mx-2 mb-2"><div class="card-body p-3"><div class="text-muted small mb-2">Batch Number: <strong><t t-esc="state.lotName"/></strong></div><label class="form-label fw-bold" for="blind_stock_count_lot_quantity">Actual Quantity</label><div class="input-group"><input id="blind_stock_count_lot_quantity" type="number" min="0" step="any" class="form-control form-control-lg" placeholder="Enter actual quantity" t-model="state.quantity" t-att-disabled="state.loading"/><button class="btn btn-primary" t-on-click="addLotQuantity" t-att-disabled="state.loading"><i class="fa fa-check me-1"/>Record</button></div></div></div>
                            <t t-if="!(pallet.product_lines || []).length &amp;&amp; !(state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.product)"><div class="o_sbl_empty_state text-center text-muted py-4"><p class="mb-0 small">No product has been recorded for this pallet.</p></div></t>
                            <t t-foreach="pallet.product_lines || []" t-as="line" t-key="line.id">
                                <div t-attf-class="o_product_subcard {{ state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.lastScannedLineIds.includes(line.id) ? 'border border-success border-2 shadow-sm' : '' }}" t-attf-style="{{ state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.lastScannedLineIds.includes(line.id) ? 'background-color: #eefaf2;' : line.tracking === 'none' &amp;&amp; state.count.state !== 'done' ? 'cursor: pointer;' : '' }}" t-on-click="editManualQuantity.bind(this, pallet, line)"><div class="o_product_row_top"><div class="o_product_icon"><i class="fa fa-box-open"/></div><div class="o_product_name"><t t-esc="line.name"/></div><div class="o_product_qty"><span class="o_qty_value"><t t-esc="line.counted_qty"/></span><span class="o_qty_label"> counted</span></div><span t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.lastScannedLineIds.includes(line.id)" class="badge bg-success ms-2">Last scanned</span><button t-if="state.count.state !== 'done'" class="btn btn-sm btn-outline-danger rounded-circle d-inline-flex align-items-center justify-content-center p-0 ms-1" style="width: 28px; height: 28px;" title="Delete" aria-label="Delete" t-on-click="deleteLine.bind(this, pallet, line)"><i class="fa fa-trash"/></button></div><div class="o_product_row_bottom"><span t-if="line.barcode" class="o_meta_barcode"><i class="fa fa-barcode me-1"/><t t-esc="line.barcode"/></span><span t-if="line.lot_name" class="o_meta_lot"><i class="fa fa-tag me-1"/><t t-if="line.tracking === 'lot'">Lot: </t><t t-else="">SN: </t><t t-esc="line.lot_name"/></span><span t-if="!line.lot_name &amp;&amp; state.count.state !== 'done'" class="o_meta_uom">Tap to edit quantity</span></div></div>
                                <div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.nextStep === 'input_quantity' &amp;&amp; state.editingLineId === line.id" class="card border-primary shadow-sm mx-2 mb-2"><div class="card-body p-3"><label class="form-label fw-bold" for="blind_stock_count_quantity">Actual Quantity</label><div class="input-group"><input id="blind_stock_count_quantity" type="number" min="0" step="any" class="form-control form-control-lg" placeholder="Enter actual quantity" t-model="state.quantity" t-att-disabled="state.loading"/><button class="btn btn-primary" t-on-click="addManualQuantity" t-att-disabled="state.loading"><i class="fa fa-check me-1"/>Record</button></div></div></div>
                            </t>
                        </div>
                    </div>
                </t>

            </div>

            <div t-if="state.count &amp;&amp; state.count.state !== 'done'" class="o_sbl_footer">
                <button class="btn btn-outline-secondary" t-on-click="switchProduct" t-att-disabled="state.loading || !state.pallet">Product</button>
                <button class="btn btn-outline-secondary" t-on-click="switchPallet" t-att-disabled="state.loading || !state.count">Pallet</button>
                <button class="btn btn-primary" style="flex: 1.5;" t-on-click="completeCount" t-att-disabled="state.loading || !state.count">Complete</button>
            </div>
            <div t-if="state.count &amp;&amp; state.count.state === 'done' &amp;&amp; state.count.can_return_to_counting" class="o_sbl_footer">
                <button class="btn btn-secondary" style="flex: 1.5;" t-on-click="returnToCounting" t-att-disabled="state.loading">Return to Counting</button>
            </div>
        </div>
    </t>
    <t t-name="blind_stock_count.CheckScanPage">
        <input t-ref="checkBarcodeInput" type="text" class="o_hidden_barcode_input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" inputmode="none" touch-action="none" t-on-input="onBarcodeInput" t-on-keydown="onBarcodeKeydown" t-on-blur="onBarcodeBlur" t-att-disabled="state.loading || (state.check &amp;&amp; state.check.state === 'done')"/>
        <div class="o_blind_stock_count_scan o_sbl_inbound">
            <div class="o_sbl_header"><div class="o_sbl_header_title"><i class="fa fa-check-square-o text-success me-1"/>Blind Stock Count Check</div><div t-attf-class="o_sbl_header_mode {{ state.nextStep === 'scan_location' ? 'o_mode_step' : state.nextStep === 'scan_pallet' ? 'o_mode_pallet' : state.nextStep === 'scan_product' ? 'o_mode_product' : state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity' ? 'o_mode_qty' : 'o_mode_sn' }}"><t t-if="state.nextStep === 'scan_location'">Location</t><t t-elif="state.nextStep === 'scan_pallet'">Pallet</t><t t-elif="state.nextStep === 'scan_product'">Product</t><t t-elif="state.nextStep === 'scan_lot_name'">Batch Number</t><t t-elif="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'">Quantity</t><t t-else="">Serial Number</t></div></div>
            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}"><t t-esc="state.message"/></div>
            <div t-if="state.check" class="o_sbl_location_bar"><i class="fa fa-map-marker text-danger me-1"/><span class="me-1">Location:</span><strong class="text-primary"><t t-esc="state.check.location_name"/></strong><span class="ms-3">Blind Stock Count: <strong><t t-esc="state.check.count_name"/></strong></span><span class="text-muted float-end"><t t-esc="state.check.name"/></span></div>
            <div class="o_sbl_step_indicator"><div t-attf-class="o_step_item {{ state.nextStep === 'scan_location' ? 'active' : '' }} {{ state.locationVerified ? 'done' : '' }}"><div class="o_step_circle"><t t-if="state.locationVerified"><i class="fa fa-check"/></t><t t-else="">1</t></div><div class="o_step_label">Location</div></div><div t-attf-class="o_step_line {{ state.locationVerified ? 'active' : '' }}"/><div t-attf-class="o_step_item {{ state.nextStep === 'scan_pallet' ? 'active' : '' }} {{ state.pallet ? 'done' : '' }}"><div class="o_step_circle"><t t-if="state.pallet"><i class="fa fa-check"/></t><t t-else="">2</t></div><div class="o_step_label">Pallet</div></div><div t-attf-class="o_step_line {{ state.pallet ? 'active' : '' }}"/><div t-attf-class="o_step_item {{ state.nextStep === 'scan_product' ? 'active' : '' }} {{ state.product ? 'done' : '' }}"><div class="o_step_circle"><t t-if="state.product"><i class="fa fa-check"/></t><t t-else="">3</t></div><div class="o_step_label">Product</div></div><div t-attf-class="o_step_line {{ state.product ? 'active' : '' }}"/><div t-attf-class="o_step_item {{ state.nextStep === 'scan_serial_numbers' || state.nextStep === 'scan_lot_name' || state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity' ? 'active' : '' }}"><div class="o_step_circle">4</div><div class="o_step_label">SN / Qty</div></div></div>
            <div class="o_sbl_step_hint"><i t-if="state.nextStep !== 'input_quantity' &amp;&amp; state.nextStep !== 'input_lot_quantity'" class="fa fa-qrcode me-2"/><i t-if="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'" class="fa fa-pencil-square-o me-2"/><t t-if="state.nextStep === 'scan_location'">Scan the count location barcode to verify this check.</t><t t-elif="state.nextStep === 'scan_pallet'">Scan a pallet. A pallet not in the blind count is recorded as an anomaly.</t><t t-elif="state.nextStep === 'scan_product'">Scan a product. Products outside the work package or not in the blind count are recorded as anomalies.</t><t t-elif="state.nextStep === 'scan_lot_name'">Scan the batch number.</t><t t-elif="state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity'">Enter the sampled quantity and tap Record.</t><t t-else="">Scan one or more serial numbers. Multiple serial numbers may be separated with commas.</t></div>
            <div class="o_sbl_pallets">
                <t t-if="state.check &amp;&amp; state.nextStep === 'scan_location'"><div class="o_sbl_empty_state text-center text-muted py-4"><i class="fa fa-map-marker fa-4x mb-3 d-block"/><p class="mb-1 fw-bold">Verify Count Location</p><p class="small">Scan <t t-esc="state.check.location_name"/> before scanning a pallet.</p></div></t>
                <t t-if="state.check &amp;&amp; state.locationVerified &amp;&amp; !state.pallet &amp;&amp; !state.pallets.length"><div class="o_sbl_empty_state text-center text-muted py-5"><i class="fa fa-cube fa-4x mb-3 d-block"/><p class="mb-1 fw-bold">Waiting for Pallet</p><p class="small">Use the scanner to scan a pallet barcode.</p></div></t>
                <t t-foreach="state.pallets" t-as="pallet" t-key="pallet.id"><div t-attf-class="o_sbl_pallet {{ state.pallet &amp;&amp; state.pallet.id === pallet.id ? 'o_pallet_highlighted' : '' }}"><div class="o_pallet_header" t-on-click="selectPallet.bind(this, pallet)"><div class="o_pallet_row1"><div class="o_pallet_info"><i class="fa fa-cube o_pallet_icon_highlighted me-2"/><strong class="o_pallet_name"><t t-esc="pallet.name"/></strong></div><div class="o_pallet_right"><span t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id" class="badge o_pallet_current_badge"><i class="fa fa-bullseye me-1"/>Current</span><i class="fa fa-chevron-down collapse-arrow ms-2"/></div></div><div class="o_pallet_row2"><span class="o_pallet_product_count"><t t-esc="pallet.line_count || 0"/> sampled lines</span><span t-if="pallet.barcode" class="o_pallet_location"><i class="fa fa-barcode text-muted me-1"/><t t-esc="pallet.barcode"/></span></div><div t-if="pallet.product_summaries.length" class="o_pallet_row2"><span class="o_pallet_product_count"><i class="fa fa-list-ul text-muted me-1"/>Products: <t t-foreach="pallet.product_summaries" t-as="productSummary" t-key="productSummary.id"><span><t t-esc="productSummary.name"/> × <t t-esc="productSummary.checked_qty"/></span><t t-if="!productSummary_last">, </t></t></span></div></div><div t-attf-class="o_pallet_products collapse {{ state.expandedPalletId === pallet.id ? 'show' : '' }}"><div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.product" t-attf-class="o_product_subcard border border-2 shadow-sm {{ state.product.anomaly_status ? 'border-warning' : 'border-success' }}" t-attf-style="{{ state.product.anomaly_status ? 'background-color: #fff8e6;' : 'background-color: #eefaf2;' }}"><div class="o_product_row_top"><div class="o_product_icon"><i class="fa fa-box-open"/></div><div class="o_product_name"><t t-esc="state.product.name"/></div><span t-attf-class="badge {{ state.product.anomaly_status ? 'bg-warning text-dark' : 'bg-success' }}"><t t-if="state.product.anomaly_status === 'out_of_scope'">Out of Scope</t><t t-elif="state.product.anomaly_status">Not in Blind Count</t><t t-elif="state.product.tracking === 'none'">Enter Qty</t><t t-elif="state.product.tracking === 'lot'">Scan Lot</t><t t-else="">Scan SN</t></span><span t-if="state.product.tracking === 'serial'" class="badge bg-info ms-2">Checked SN: <t t-esc="state.product.checked_serial_count || 0"/></span></div><div class="o_product_row_bottom"><span t-if="state.product.barcode" class="o_meta_barcode"><i class="fa fa-barcode me-1"/><t t-esc="state.product.barcode"/></span><span t-if="state.product.tracking === 'none'" class="o_meta_uom">Enter sampled quantity</span><span t-if="state.product.tracking === 'lot'" class="o_meta_lot">Scan batch number</span><span t-if="state.product.tracking === 'serial'" class="o_meta_lot">Scan serial number</span><span t-if="state.product.tracking === 'lot' &amp;&amp; state.lotName" class="o_meta_lot ms-2">Lot: <t t-esc="state.lotName"/></span></div></div><div t-if="state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; (state.nextStep === 'input_quantity' || state.nextStep === 'input_lot_quantity')" class="card border-success shadow-sm mx-2 mb-2"><div class="card-body p-3"><div t-if="state.lotName" class="text-muted small mb-2">Batch Number: <strong><t t-esc="state.lotName"/></strong></div><label class="form-label fw-bold" for="blind_stock_count_check_quantity">Sampled Quantity</label><div class="input-group"><input id="blind_stock_count_check_quantity" type="number" min="0" step="any" class="form-control form-control-lg" placeholder="Enter sampled quantity" t-model="state.quantity" t-att-disabled="state.loading"/><button class="btn btn-success" t-on-click="addQuantity" t-att-disabled="state.loading"><i class="fa fa-check me-1"/>Record</button></div></div></div><t t-if="!(pallet.product_lines || []).length &amp;&amp; !(state.pallet &amp;&amp; state.pallet.id === pallet.id &amp;&amp; state.product)"><div class="o_sbl_empty_state text-center text-muted py-4"><p class="mb-0 small">No sampled product has been recorded for this pallet.</p></div></t><t t-foreach="pallet.product_lines || []" t-as="line" t-key="line.id"><div t-attf-class="o_product_subcard {{ state.lastScannedLineIds.includes(line.id) ? 'border border-success border-2 shadow-sm' : '' }}" t-attf-style="{{ state.lastScannedLineIds.includes(line.id) ? 'background-color: #eefaf2;' : '' }}"><div class="o_product_row_top"><div class="o_product_icon"><i class="fa fa-box-open"/></div><div class="o_product_name"><t t-esc="line.name"/></div><div class="o_product_qty"><span class="o_qty_value"><t t-esc="line.checked_qty"/></span><span class="o_qty_label"> checked</span></div><span t-attf-class="badge ms-2 {{ line.match_status === 'matched' ? 'bg-success' : line.match_status === 'out_of_scope' ? 'bg-warning text-dark' : 'bg-danger' }}"><t t-if="line.match_status === 'matched'">Matched</t><t t-elif="line.match_status === 'not_in_blind'">Not in Blind Count</t><t t-elif="line.match_status === 'out_of_scope'">Out of Scope</t><t t-else="">Not Matched</t></span></div><div class="o_product_row_bottom"><span t-if="line.barcode" class="o_meta_barcode"><i class="fa fa-barcode me-1"/><t t-esc="line.barcode"/></span><span t-if="line.lot_name" class="o_meta_lot"><i class="fa fa-tag me-1"/><t t-if="line.tracking === 'lot'">Lot: </t><t t-else="">SN: </t><t t-esc="line.lot_name"/></span></div></div></t></div></div></t>
            <div t-if="state.check" class="card border-success shadow-sm mx-2 mb-3"><div class="card-body p-3"><label class="form-label fw-bold" for="blind_stock_count_check_conclusion">Conclusion</label><select id="blind_stock_count_check_conclusion" class="form-select mb-2" t-model="state.conclusion" t-att-disabled="state.loading || state.check.state === 'done'"><option value="pending" disabled="disabled">Pending — select a final conclusion</option><option value="passed">Passed</option><option value="failed">Failed</option><option value="uncertain">Uncertain</option></select><label class="form-label fw-bold" for="blind_stock_count_check_conclusion_note">Conclusion Notes</label><textarea id="blind_stock_count_check_conclusion_note" class="form-control" rows="2" placeholder="Optional conclusion notes" t-model="state.conclusionNote" t-att-disabled="state.loading || state.check.state === 'done'"/></div></div>
            </div>
            <div t-if="state.check &amp;&amp; state.check.state !== 'done'" class="o_sbl_footer"><button class="btn btn-outline-secondary" t-on-click="switchProduct" t-att-disabled="state.loading || !state.pallet">Product</button><button class="btn btn-outline-secondary" t-on-click="switchPallet" t-att-disabled="state.loading || !state.check || !state.locationVerified">Pallet</button><button class="btn btn-success" style="flex: 1.5;" t-on-click="completeCheck" t-att-disabled="state.loading || !state.check">Complete</button></div>
        </div>
    </t>
    <t t-name="blind_stock_count.Homepage">
        <div class="o_stock_barcode_lite_homepage o_blind_stock_count_homepage">
            <div class="container-fluid py-2">
                <div class="row">
                    <div class="col-10 offset-1 col-md-6 offset-md-3 col-lg-3 offset-lg-0"><div class="section-header"><h5 class="section-title">Blind Stock Count PDA</h5></div></div>
                </div>
                <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x mb-3 d-block"/><span>Loading...</span></div>
                <div t-else="" class="row justify-content-center g-4">
                    <div t-if="state.access.can_count" class="col-11 col-md-6 col-lg-4"><div class="card h-100 shadow-sm o_homepage_card" t-on-click="openPdaList"><div class="card-header bg-primary text-white"><h3 class="mb-0"><i class="fa fa-briefcase me-2"/>Active Work Packages</h3></div><div class="card-body d-flex flex-column"><p class="text-muted mb-auto">Select a work package, start a new count, or continue an unfinished count.</p><button class="btn btn-primary mt-3"><i class="fa fa-arrow-right me-2"/>Open</button></div></div></div>
                    <div t-if="state.access.can_check" class="col-11 col-md-6 col-lg-4"><div class="card h-100 shadow-sm o_homepage_card" t-on-click="openCheckPdaList"><div class="card-header bg-success text-white"><h3 class="mb-0"><i class="fa fa-check-square-o me-2"/>Check PDA</h3></div><div class="card-body d-flex flex-column"><p class="text-muted mb-auto">Open a pending check, then scan pallet, product, and serial number or quantity.</p><button class="btn btn-success mt-3"><i class="fa fa-arrow-right me-2"/>Open</button></div></div></div>
                    <div t-if="state.access.can_manage_work_packages" class="col-11 col-md-6 col-lg-4"><div class="card h-100 shadow-sm o_homepage_card" t-on-click="openNewWorkPackage"><div class="card-header bg-secondary text-white"><h3 class="mb-0"><i class="fa fa-plus-circle me-2"/>New Work Package</h3></div><div class="card-body d-flex flex-column"><p class="text-muted mb-auto">Create a work package before starting blind stock counts.</p><button class="btn btn-secondary mt-3"><i class="fa fa-plus me-2"/>Create</button></div></div></div>
                    <div t-if="!state.access.can_count &amp;&amp; !state.access.can_check &amp;&amp; !state.access.can_manage_work_packages" class="col-11 text-center text-muted py-5"><i class="fa fa-lock fa-4x mb-3 d-block"/><p class="mb-0">No PDA access is available.</p></div>
                </div>
            </div>
        </div>
    </t>
    <t t-name="blind_stock_count.PdaList">
        <div class="o_stock_barcode_lite_homepage o_blind_stock_count_pda_list">
            <div class="container-fluid py-2">
                <div class="row"><div class="col-10 offset-1 col-md-6 offset-md-3 col-lg-4 offset-lg-0"><div class="section-header"><h5 class="section-title">Active Work Packages</h5></div></div></div>
                <div t-if="state.message" class="alert alert-danger"><t t-esc="state.message"/></div>
                <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x mb-3 d-block"/><span>Loading...</span></div>
                <t t-if="!state.loading &amp;&amp; !state.workPackage">
                    <div t-if="!state.workPackages.length" class="text-center text-muted py-5"><i class="fa fa-briefcase fa-4x mb-3 d-block"/><p class="mb-0">No work packages found.</p></div>
                    <t t-foreach="state.workPackages" t-as="workPackage" t-key="workPackage.id">
                        <div class="card shadow-sm mb-3 o_homepage_card" t-on-click="selectWorkPackage.bind(this, workPackage)"><div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="fa fa-briefcase me-2"/><t t-esc="workPackage.name"/></h5></div><div class="card-body"><div class="mb-1"><strong>Product Category:</strong> <t t-esc="workPackage.category_name"/></div><div t-if="workPackage.owner_name" class="mb-1"><strong>Owner:</strong> <t t-esc="workPackage.owner_name"/></div><div class="text-muted small"><t t-if="workPackage.location_names">Location Scope: <t t-esc="workPackage.location_names"/></t><t t-else="">Location Scope: Any internal location</t></div><button class="btn btn-primary mt-3"><i class="fa fa-arrow-right me-1"/>Open Work Package</button></div></div>
                    </t>
                </t>
                <t t-if="!state.loading &amp;&amp; state.workPackage">
                    <div class="d-flex align-items-center justify-content-between mb-3"><div><h5 class="mb-1"><i class="fa fa-briefcase me-2"/><t t-esc="state.workPackage.name"/></h5><span class="text-muted">Work package blind stock count records</span></div><button class="btn btn-outline-secondary" t-on-click="backToWorkPackages"><i class="fa fa-arrow-left me-1"/>Work Packages</button></div>
                    <div class="card border-primary shadow-sm mb-4"><div class="card-body"><div class="mb-1"><strong>Product Category:</strong> <t t-esc="state.workPackage.category_name"/></div><div t-if="state.workPackage.owner_name" class="mb-1"><strong>Owner:</strong> <t t-esc="state.workPackage.owner_name"/></div><div class="text-muted small"><t t-if="state.workPackage.location_names">Location Scope: <t t-esc="state.workPackage.location_names"/></t><t t-else="">Location Scope: Any internal location</t></div><button class="btn btn-primary mt-3" t-on-click="openNewCount"><i class="fa fa-qrcode me-1"/>Start New Count</button></div></div>
                    <h5 class="mb-3">Locations</h5>
                    <div t-if="!state.locationGroups.length" class="text-center text-muted py-4"><p class="mb-0">No blind stock count records.</p></div>
                    <t t-foreach="state.locationGroups" t-as="locationGroup" t-key="locationGroup.id"><div class="card shadow-sm mb-3"><div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="fa fa-map-marker me-2"/><t t-esc="locationGroup.name"/><span class="badge bg-light text-dark float-end"><t t-esc="locationGroup.counts.length"/> rounds</span></h5></div><div class="card-body"><t t-foreach="locationGroup.counts" t-as="count" t-key="count.id"><div t-attf-class="border rounded p-3 mb-2 {{ locationGroup.currentCountId === count.id ? 'border-primary border-2' : count.is_replaced ? 'opacity-50' : '' }}" t-on-click="openPdaCount.bind(this, count)"><div class="d-flex align-items-center justify-content-between"><strong><t t-esc="count.name"/></strong><span t-attf-class="badge {{ count.state === 'counting' ? 'bg-primary' : count.state === 'done' ? 'bg-secondary' : count.state === 'draft' ? 'bg-warning text-dark' : 'bg-light text-dark' }}"><t t-esc="count.state"/></span></div><div class="small text-muted mt-1">Round: <t t-esc="count.recount_round"/><t t-if="count.recounted_from_name"> · Recount of: <t t-esc="count.recounted_from_name"/></t></div><div class="small text-muted"><t t-esc="count.date"/></div><div class="mt-2"><span t-if="locationGroup.currentCountId === count.id" class="badge bg-success me-2">Current</span><span t-if="count.is_replaced" class="badge bg-secondary me-2">Replaced</span><button t-if="count.state === 'draft' || count.state === 'counting'" class="btn btn-sm btn-primary"><i class="fa fa-qrcode me-1"/>Continue Scan</button><button t-elif="count.state === 'done'" class="btn btn-sm btn-outline-secondary"><i class="fa fa-eye me-1"/>View in PDA</button><span t-else="" class="text-muted small">Unavailable</span></div></div></t></div></div></t>
                </t>
            </div>
        </div>
    </t>
    <t t-name="blind_stock_count.CheckPdaList">
        <div class="o_stock_barcode_lite_homepage o_blind_stock_count_pda_list"><div class="container-fluid py-2"><div class="row"><div class="col-10 offset-1 col-md-6 offset-md-3 col-lg-4 offset-lg-0"><div class="section-header"><h5 class="section-title">Check PDA</h5></div></div></div><div t-if="state.message" class="alert alert-danger"><t t-esc="state.message"/></div><div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x mb-3 d-block"/><span>Loading...</span></div><t t-if="!state.loading"><div t-if="!state.checks.length" class="text-center text-muted py-5"><i class="fa fa-check-square-o fa-4x mb-3 d-block"/><p class="mb-0">No blind stock count checks.</p></div><t t-foreach="state.checks" t-as="check" t-key="check.id"><div class="card shadow-sm mb-3 o_homepage_card" t-on-click="openCheck.bind(this, check)"><div t-attf-class="card-header {{ check.state === 'checking' ? 'bg-success text-white' : check.state === 'done' ? 'bg-secondary text-white' : 'bg-warning text-dark' }}"><h5 class="mb-0"><i class="fa fa-check-square-o me-2"/><t t-esc="check.name"/><span class="badge bg-light text-dark float-end"><t t-esc="check.state"/></span></h5></div><div class="card-body"><div class="mb-1"><strong>Blind Stock Count:</strong> <t t-esc="check.count_name"/></div><div class="mb-1"><strong>Work Package:</strong> <t t-esc="check.work_package_name"/></div><div t-if="check.state === 'done'" class="mb-1"><strong>Conclusion:</strong> <t t-esc="check.conclusion"/></div><div class="text-muted small">Location: <t t-esc="check.location_name"/></div><button t-attf-class="btn mt-3 {{ check.state === 'checking' ? 'btn-success' : check.state === 'done' ? 'btn-secondary' : 'btn-warning' }}"><i class="fa fa-qrcode me-1"/><t t-if="check.state === 'checking'">Continue Check</t><t t-elif="check.state === 'done'">View Check</t><t t-else="">Start Check</t></button></div></div></t></t></div></div>
    </t>
</templates>
