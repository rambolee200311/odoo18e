    <menuitem id="menu_bonded_eori_entity" name="EORI Entities" parent="menu_bonded_masters" action="action_bonded_eori_entity" sequence="40"/>
    <menuitem id="menu_bonded_customs_authorization" name="Customs Authorizations" parent="menu_bonded_masters" action="action_bonded_customs_authorization" sequence="50"/>
    <menuitem id="menu_bonded_charge_unit" name="Charge Units" parent="menu_bonded_masters" action="action_bonded_charge_unit" sequence="60"/>
    <menuitem id="menu_bonded_charge_item" name="Charge Items" parent="menu_bonded_masters" action="action_bonded_charge_item" sequence="70"/>
    <menuitem id="menu_bonded_customs" name="Customs Declaration" parent="menu_bonded_root" sequence="20"/>
