<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_form_stock_barcode_lite_inherit" model="ir.ui.view">
        <field name="name">project.project.form.stock.barcode.lite.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="worlddepot.view_project_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_check_origin_doc']" position="before">
                <field name="warehouse" options="{'no_create': True, 'no_open': True}"/>
                <field name="package_generation_mode"/>
                <field name="barcode_scan_mode" required="1"/>
                <field name="inbound_pick_type" domain = "[('code', '=', 'incoming'),
                     ('warehouse_id', '=', warehouse),
                     ('warehouse_id', '!=', False)]" options="{'no_create': True, 'no_open': False}"/>
                <field name="outbound_pick_type" domain = "[('code', 'in',  ['outgoing', 'internal']),
                     ('warehouse_id', '=', warehouse),
                     ('warehouse_id', '!=', False)]" options="{'no_create': True, 'no_open': False}"/>
            </xpath>
        </field>
    </record>
</odoo>
