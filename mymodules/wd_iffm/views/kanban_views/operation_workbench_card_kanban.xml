<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- operation.workbench.card 看板视图 -->
    <record id="view_operation_workbench_card_kanban" model="ir.ui.view">
        <field name="name">operation.workbench.card.kanban</field>
        <field name="model">operation.workbench.card</field>
        <field name="arch" type="xml">
                <kanban default_group_by="lane_id" js_class="workbench_kanban" class="wd_iffm_kanban"
                        records_draggable="1" quick_create="0"
                        group_create="1" group_edit="1" group_delete="1" groups_draggable="1">
                <field name="name"/>
                <field name="waybill_id"/>
                <field name="lane_code"/>
                <field name="lane_id"/>
                <field name="source_model"/>
                <field name="source_id"/>
                <field name="is_main"/>
                <field name="display_state"/>
                <field name="extra_data"/>
                <templates>
                    <!-- 卡片主体 -->
                    <t t-name="card">
                        <div class="oe_kanban_card"
                             t-att-data-id="record.id.raw_value"
                             t-att-data-waybill-id="record.waybill_id.raw_value"
                             t-att-data-lane="record.lane_code.raw_value">
                            <!-- 卡片头部 -->
                            <div class="o_kanban_card_header d-flex align-items-start gap-1">
                                <div class="o_kanban_card_header_title flex-grow-1 min-w-0">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_card_header_tags">
                                    <!-- 根据 lane 显示对应状态流程 -->
                                    <!-- waybill: new -> confirm -> done -->
                                    <div t-if="record.lane_code.raw_value == 'waybill'" class="d-flex align-items-center gap-1 flex-wrap">
                                        <span t-attf-class="{{ record.display_state.raw_value == 'new' ? 'badge text-bg-primary' : (record.display_state.raw_value == 'confirm' or record.display_state.raw_value == 'done' ? 'text-success' : 'badge text-bg-secondary') }}">
                                            <t t-if="record.display_state.raw_value == 'confirm' or record.display_state.raw_value == 'done'"><i class="fa fa-check fw-bold me-1"/> </t>New
                                        </span>
                                        <span t-attf-class="{{ record.display_state.raw_value == 'confirm' ? 'badge text-bg-warning' : (record.display_state.raw_value == 'done' ? 'text-success' : 'badge text-bg-secondary') }}">
                                            <t t-if="record.display_state.raw_value == 'done'"><i class="fa fa-check fw-bold me-1"/> </t>Confirm
                                        </span>
                                        <span t-attf-class="{{ record.display_state.raw_value == 'done' ? 'badge text-bg-success' : 'badge text-bg-secondary' }}">Done</span>
                                        <span t-if="record.display_state.raw_value == 'cancel'" class="badge text-bg-danger">Cancelled</span>
                                    </div>
                                    <!-- handover: open -> paying -> paid -> releasing -> released -> close -->
                                    <div t-if="record.lane_code.raw_value == 'handover'" class="d-flex align-items-center gap-1 flex-wrap">
                                        <!-- Open -->
                                        <span t-if="record.display_state.raw_value == 'open'" class="badge text-bg-primary">Open</span>
                                        <span t-else="" class="text-success"><i class="fa fa-check fw-bold"/> Open</span>
                                        <!-- Paying -->
                                        <span t-if="record.display_state.raw_value == 'paying'" class="badge text-bg-warning">Paying</span>
                                        <span t-elif="['paid','releasing','released','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Paying</span>
                                        <span t-else="" class="badge text-bg-secondary">Paying</span>
                                        <!-- Paid -->
                                        <span t-if="record.display_state.raw_value == 'paid'" class="badge text-bg-info">Paid</span>
                                        <span t-elif="['releasing','released','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Paid</span>
                                        <span t-else="" class="badge text-bg-secondary">Paid</span>
                                        <!-- Releasing -->
                                        <span t-if="record.display_state.raw_value == 'releasing'" class="badge text-bg-warning">Releasing</span>
                                        <span t-elif="['released','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Releasing</span>
                                        <span t-else="" class="badge text-bg-secondary">Releasing</span>
                                        <!-- Released -->
                                        <span t-if="record.display_state.raw_value == 'released'" class="badge text-bg-info">Released</span>
                                        <span t-elif="record.display_state.raw_value == 'close'" class="text-success"><i class="fa fa-check fw-bold"/> Released</span>
                                        <span t-else="" class="badge text-bg-secondary">Released</span>
                                        <!-- Close -->
                                        <span t-if="record.display_state.raw_value == 'close'" class="badge text-bg-success">Close</span>
                                        <span t-else="" class="badge text-bg-secondary">Close</span>
                                        <!-- Cancelled -->
                                        <span t-if="record.display_state.raw_value == 'cancelled'" class="badge text-bg-danger">Cancelled</span>
                                    </div>
                                    <!-- clearance: open -> paying -> paid -> clearancing -> clearanced -> close -->
                                    <div t-if="record.lane_code.raw_value == 'clearance'" class="d-flex align-items-center gap-1 flex-wrap">
                                        <!-- Open -->
                                        <span t-if="record.display_state.raw_value == 'open'" class="badge text-bg-primary">Open</span>
                                        <span t-else="" class="text-success"><i class="fa fa-check fw-bold"/> Open</span>
                                        <!-- Paying -->
                                        <span t-if="record.display_state.raw_value == 'paying'" class="badge text-bg-warning">Paying</span>
                                        <span t-elif="['paid','clearancing','clearanced','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Paying</span>
                                        <span t-else="" class="badge text-bg-secondary">Paying</span>
                                        <!-- Paid -->
                                        <span t-if="record.display_state.raw_value == 'paid'" class="badge text-bg-info">Paid</span>
                                        <span t-elif="['clearancing','clearanced','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Paid</span>
                                        <span t-else="" class="badge text-bg-secondary">Paid</span>
                                        <!-- Clearancing -->
                                        <span t-if="record.display_state.raw_value == 'clearancing'" class="badge text-bg-warning">Clearancing</span>
                                        <span t-elif="['clearanced','close'].includes(record.display_state.raw_value)" class="text-success"><i class="fa fa-check fw-bold"/> Clearancing</span>
                                        <span t-else="" class="badge text-bg-secondary">Clearancing</span>
                                        <!-- Clearanced -->
                                        <span t-if="record.display_state.raw_value == 'clearanced'" class="badge text-bg-info">Clearanced</span>
                                        <span t-elif="record.display_state.raw_value == 'close'" class="text-success"><i class="fa fa-check fw-bold"/> Clearanced</span>
                                        <span t-else="" class="badge text-bg-secondary">Clearanced</span>
                                        <!-- Close -->
                                        <span t-if="record.display_state.raw_value == 'close'" class="badge text-bg-success">Close</span>
                                        <span t-else="" class="badge text-bg-secondary">Close</span>
                                        <!-- Cancelled -->
                                        <span t-if="record.display_state.raw_value == 'cancelled'" class="badge text-bg-danger">Cancelled</span>
                                    </div>
                                </div>
                            </div>

                            <!-- 卡片内容 -->
                            <div class="o_kanban_card_content">
                                <!-- 预报卡片内容 -->
                                <div t-if="record.lane_code.raw_value == 'waybill'">
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">H/L：</span>
                                        <span t-esc="record.extra_data.raw_value.hbl_number or 'N/A'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">M/L：</span>
                                        <span t-esc="record.extra_data.raw_value.mbl_number or 'N/A'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Container Number：</span>
                                        <span t-esc="record.extra_data.raw_value.container_number or '未绑定'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Bill No：</span>
<!--                                        <span t-esc="record.extra_data.raw_value.billno or record.extra_data.raw_value.bl_number or record.extra_data.raw_value.hbl_number or 'N/A'"/>-->
                                        <span t-esc="record.extra_data.raw_value.billno or 'N/A'"/>
                                    </div>
                                </div>
                                <!-- 换单卡片内容 -->
                                <div t-if="record.lane_code.raw_value == 'handover'">
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">B/L：</span>
                                        <span t-esc="record.extra_data.raw_value.bl_number or '0'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Container Number：</span>
                                        <span t-esc="record.extra_data.raw_value.container_nums or '0'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Issue Date：</span>
                                        <span t-esc="record.extra_data.raw_value.do_issue_datetime || ''"/>
                                    </div>
                                </div>
                                <!-- 清关卡片内容 -->
                                <div t-if="record.lane_code.raw_value == 'clearance'">
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">B/L：</span>
                                        <span t-esc="record.extra_data.raw_value.bl_number or 'N/A'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Container Number：</span>
                                        <span t-esc="record.extra_data.raw_value.container_nums or '0'"/>
                                    </div>
                                    <div class="o_kanban_card_content_row">
                                        <span class="text-muted">Clearance Date：</span>
                                        <span t-esc="record.extra_data.raw_value.clearance_finish_datetime || ''"/>
                                    </div>
                                </div>
                                <!-- 备注 -->
                                <div class="text-muted small" t-if="record.extra_data.raw_value.extra_remark">
                                    <i class="fa fa-comment-o"/> <t t-esc="record.extra_data.raw_value.extra_remark"/>
                                </div>
                            </div>

                            <!-- 卡片底部 -->
                            <div class="o_kanban_card_footer">
                                <button type="object" name="action_model_form_views" class="btn btn-sm btn-secondary">
                                    详情
                                </button>
                                <button t-if="record.is_main.raw_value and record.lane_code.raw_value != 'waybill'" type="object" name="action_card_create_child" class="btn btn-sm btn-light border">
                                    + 子单
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
