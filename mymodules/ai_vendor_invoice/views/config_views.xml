<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wd_ai_provider_config_list" model="ir.ui.view">
        <field name="name">wd.ai.provider.config.list</field>
        <field name="model">wd.ai.provider.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="document_input_mode"/>
                <field name="api_base_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_wd_ai_provider_config_form" model="ir.ui.view">
        <field name="name">wd.ai.provider.config.form</field>
        <field name="model">wd.ai.provider.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="api_base_url"/>
                        <field name="api_key" password="True"/>
                        <field name="model_name"/>
                        <field name="document_input_mode"/>
                        <field name="max_internal_retry"/>
                        <field name="http_timeout"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_wd_ai_provider_config" model="ir.actions.act_window">
        <field name="name">AI Provider Configurations</field>
        <field name="res_model">wd.ai.provider.config</field>
        <field name="view_mode">list,form</field>
    </record>

