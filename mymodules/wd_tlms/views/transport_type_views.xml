<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_transport_type_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.type.tree</field>
        <field name="model">tlmp.transport.type</field>
        <field name="arch" type="xml">
            <list string="Transport Types" default_order="sequence">
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="mode" widget="badge"/>
                <field name="sequence"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_transport_type_form" model="ir.ui.view">
        <field name="name">tlmp.transport.type.form</field>
        <field name="model">tlmp.transport.type</field>
        <field name="arch" type="xml">
            <form string="Transport Type">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="mode"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tlmp_transport_type" model="ir.actions.act_window">
        <field name="name">Transport Types</field>
        <field name="res_model">tlmp.transport.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
