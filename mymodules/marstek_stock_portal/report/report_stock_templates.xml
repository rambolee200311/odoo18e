<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Stock Export PDF -->
        <template id="report_marstek_stock_export_pdf">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Stock Export Report</h2>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Pallet No</th>
                                    <th>Container No</th>
                                    <th>BL No</th>
                                    <th>Product Code</th>
                                    <th>Product Name</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Location</th>
                                    <th>Inbound Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="row">
                                    <tr>
                                        <td><t t-esc="row[0]"/></td>
                                        <td><t t-esc="row[1]"/></td>
                                        <td><t t-esc="row[2]"/></td>
                                        <td><t t-esc="row[3]"/></td>
                                        <td><t t-esc="row[4]"/></td>
                                        <td class="text-end"><t t-esc="row[5]"/></td>
                                        <td><t t-esc="row[6]"/></td>
                                        <td><t t-esc="row[7]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <!-- Container Stock Export PDF -->
        <template id="report_marstek_container_stock_export_pdf">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Container Stock Export Report</h2>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Container No</th>
                                    <th>BL No</th>
                                    <th class="text-end">Total Qty</th>
                                    <th class="text-end">Pallet Count</th>
                                    <th>Pallet No</th>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Location</th>
                                    <th>Inbound Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="row">
                                    <tr>
                                        <td><t t-esc="row[0]"/></td>
                                        <td><t t-esc="row[1]"/></td>
                                        <td class="text-end"><t t-esc="row[2]"/></td>
                                        <td class="text-end"><t t-esc="row[3]"/></td>
                                        <td><t t-esc="row[4]"/></td>
                                        <td><t t-esc="row[5]"/></td>
                                        <td class="text-end"><t t-esc="row[6]"/></td>
                                        <td><t t-esc="row[7]"/></td>
                                        <td><t t-esc="row[8]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <!-- Inbounds Export PDF -->
        <template id="report_marstek_inbounds_export_pdf">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Inbound Orders Export Report</h2>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Inbound No</th>
                                    <th>Reference</th>
                                    <th>BL No</th>
                                    <th>Container No</th>
                                    <th>Inbound Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Total Qty</th>
                                    <th class="text-end">Pallet Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="row">
                                    <tr>
                                        <td><t t-esc="row[0]"/></td>
                                        <td><t t-esc="row[1]"/></td>
                                        <td><t t-esc="row[2]"/></td>
                                        <td><t t-esc="row[3]"/></td>
                                        <td><t t-esc="row[4]"/></td>
                                        <td><t t-esc="row[5]"/></td>
                                        <td class="text-end"><t t-esc="row[6]"/></td>
                                        <td class="text-end"><t t-esc="row[7]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <!-- Outbounds Export PDF -->
        <template id="report_marstek_outbounds_export_pdf">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Outbound Orders Export Report</h2>
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Outbound No</th>
                                    <th>BL No</th>
                                    <th>Container No</th>
                                    <th>Outbound Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Total Qty</th>
                                    <th>Picking No</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="row">
                                    <tr>
                                        <td><t t-esc="row[0]"/></td>
                                        <td><t t-esc="row[1]"/></td>
                                        <td><t t-esc="row[2]"/></td>
                                        <td><t t-esc="row[3]"/></td>
                                        <td><t t-esc="row[4]"/></td>
                                        <td class="text-end"><t t-esc="row[5]"/></td>
                                        <td><t t-esc="row[6]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
