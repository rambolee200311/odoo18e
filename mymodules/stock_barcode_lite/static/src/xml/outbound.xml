            <div t-if="stepHint" class="o_sbl_step_hint">
                <t t-esc="stepHint"/>
            </div>

            <!-- 当前货位信息 -->
            <div t-if="state.currentLocation" class="o_sbl_location_bar">
                <i class="fa fa-map-marker text-danger me-1"/>
                <span class="me-1">Location:</span>
                <strong class="text-primary"><t t-esc="state.currentLocation.location_barcode"/></strong>
            </div>

            <!-- 扫描步骤指示器 -->
            <div t-if="state.order" class="o_sbl_step_indicator">
                <div class="o_step_item" t-attf-class="{ active: state.scanMode === 'step', done: state.scanMode !== 'step' }">
                    <div class="o_step_circle">
                        <t t-if="state.scanMode !== 'step'"><i class="fa fa-check"/></t>
                        <t t-else="">1</t>
                    </div>
                    <div class="o_step_label">Step (P/D)</div>
