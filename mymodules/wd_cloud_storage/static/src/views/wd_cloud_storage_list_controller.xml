<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wd_cloud_storage.WdCloudStorageListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <div class="btn-group" t-if="!editedRecord and props.showButtons and show_new_menu">
                    <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        New
                    </button>
                    <ul class="dropdown-menu">
                        <li t-if="state.can_upload">
                            <button type="button" class="dropdown-item" t-on-click="on_click_upload">Upload</button>
                        </li>
                        <li t-if="state.can_create_folder">
                            <button type="button" class="dropdown-item" t-on-click="on_click_create_folder">New Folder</button>
                        </li>
                    </ul>
                    <input t-if="state.can_upload" type="file" class="d-none" t-ref="uploadInput" t-on-change="on_upload_file_change"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
