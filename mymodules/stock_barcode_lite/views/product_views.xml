<odoo>


    <record id="view_product_product_form_inherit_template_field" model="ir.ui.view">
        <field name="name">product.product.form.inherit.template.field</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="product_tmpl_id"
                       string="Product Template"
                       readonly="1"
                       required="id"
                       invisible="not id"/>
            </xpath>
        </field>
    </record>
    <record id="view_product_template_form_product_weight_dimensions" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
       <xpath expr="//page[@name='inventory']//div[@name='volume']" position="after">
            <label for="gross_weight"/>
            <div class="o_row" name="sunrise_gross_weight">
                <field name="gross_weight" class="oe_inline"/>
            </div>

            <label for="product_dimensions"/>
            <div class="o_row" name="sunrise_product_dimensions">
                <field name="product_dimensions" class="oe_inline"/>
            </div>
        </xpath>
        </field>
    </record>


