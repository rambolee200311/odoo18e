<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blind_stock_count_print_pallet_labels_form" model="ir.ui.view">
        <field name="name">blind.stock.count.print.pallet.labels.form</field>
        <field name="model">blind.stock.count.print.pallet.labels</field>
        <field name="arch" type="xml">
            <form string="Print Blind Stock Count Labels" duplicate="false">
                <group>
                    <field name="start_position" required="1"/>
                    <field name="end_position" required="1"/>
                </group>
                <p class="text-muted">Prints the selected inclusive ID-ascending range from the current list filters. For example: 1-500, then 501-1000.</p>
                <footer>
                    <button name="action_print_labels" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
