<templates xml:space="preserve">
    <t t-name="wd_qooling_app.QoolingPhotoGalleryField">
        <div class="o_qooling_photo_gallery">
            <div class="o_qooling_photo_gallery__grid">
                <t t-foreach="files" t-as="file" t-key="file.id">
                    <div class="o_qooling_photo_gallery__item">
                        <video t-if="isVideo(file)" t-att-src="getUrl(file.id)" class="o_qooling_photo_gallery__image"
                               muted="muted" preload="metadata"/>
                        <img t-else="" t-att-src="getUrl(file.id)" t-att-alt="file.name" class="o_qooling_photo_gallery__image"/>
                        <div class="o_qooling_photo_gallery__actions">
                            <button type="button" class="btn btn-sm btn-light o_qooling_photo_gallery__enlarge"
                                    t-on-click="() => openPreview(file.id)"
                                    aria-label="Preview media" title="Preview media">
                                <i class="fa fa-search-plus" aria-hidden="true"/>
                            </button>
                            <button t-if="canEdit" type="button" class="btn btn-sm btn-danger o_qooling_photo_gallery__delete"
                                    t-on-click="() => onFileRemove(file.id)"
                                    aria-label="Delete media" title="Delete media">
                                <i class="fa fa-trash" aria-hidden="true"/>
                            </button>
                        </div>
                    </div>
                </t>
            </div>
            <FileInput t-if="canEdit and hasRecordId"
                acceptedFileExtensions="'image/*,video/*'"
                multiUpload="true"
                onUpload.bind="onFileUploaded"
                resModel="props.record.resModel"
                resId="props.record.resId"
            >
                <button type="button" class="btn btn-secondary o_qooling_photo_gallery__upload">
                    <i class="fa fa-paperclip me-1" aria-hidden="true"/> Attach photos or videos
                </button>
            </FileInput>
            <div t-if="canEdit &amp;&amp; !hasRecordId" class="alert alert-info mt-2 mb-0">
                Save the draft before uploading media.
            </div>
            <div t-if="state.previewId" class="o_qooling_photo_gallery__preview" role="dialog"
                 t-on-click="closePreview">
                <video t-if="isVideo(getPreviewFile())" t-att-src="getUrl(state.previewId)"
                       controls="controls" autoplay="autoplay" t-on-click.stop="() => {}"/>
                <img t-else="" t-att-src="getUrl(state.previewId)" alt="Enlarged photo"
                     t-on-click.stop="() => {}"/>
            </div>
        </div>
    </t>
</templates>
