<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_charge_unit_list" model="ir.ui.view">
        <field name="name">world.depot.charge.unit.list</field>
        <field name="model">world.depot.charge.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_charge_unit_form" model="ir.ui.view">
        <field name="name">world.depot.charge.unit.form</field>
        <field name="model">world.depot.charge.unit</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_charge_item_list" model="ir.ui.view">
        <field name="name">world.depot.charge.item.list</field>
        <field name="model">world.depot.charge.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="full_item_name"/>
                <field name="item_name" optional="hide"/>
                <field name="parent_id" optional="hide"/>

                <field name="operation_type"/>
<!--                <field name="active" widget="boolean_toggle"/>-->
            </list>
        </field>
    </record>

    <record id="view_charge_item_form" model="ir.ui.view">
        <field name="name">world.depot.charge.item.form</field>
        <field name="model">world.depot.charge.item</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            Item of Charge
                        </h1>
                        <h2>
                            <field name="full_item_name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="item_name" required="1"/>
                            <field name="parent_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="operation_type"/>

                        </group>
                        <group>
                            <field name="charge_billing_object"/>
                            <field name="is_weight_tier" invisible="not charge_billing_object"/>
                            <field name="minimum_gross_weight" invisible="not is_weight_tier" required="is_weight_tier"/>
                            <field name="maximum_gross_weight" invisible="not is_weight_tier"/>
                            <field name="charge_based_on_max"/>
<!--                            <field name="active"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="unit_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_charge_item_search" model="ir.ui.view">
        <field name="name">world.depot.charge.item.search</field>
        <field name="model">world.depot.charge.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_name"/>
                <field name="full_item_name"/>
                <field name="parent_id"/>
                <field name="unit_id"/>
                <filter name="group_by_parent" string="Parent Item" context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_charge_unit" model="ir.actions.act_window">
        <field name="name">Charge Units</field>
        <field name="res_model">world.depot.charge.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_charge_item" model="ir.actions.act_window">
        <field name="name">Charge Items</field>
        <field name="res_model">world.depot.charge.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_parent': 1}</field>
    </record>

</odoo>
