<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_customs_file_view_tree" model="ir.ui.view">
        <field name="name">bonded.customs.file.tree</field>
        <field name="model">bonded.customs.file</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="declaration_no"/>
                <field name="declaration_type"/>
                <field name="mrn"/>
                <field name="declarant_eori_entity_id"/>
                <field name="consignor_eori"/>
                <field name="consignee_eori"/>
                <field name="total_packages"/>
                <field name="invoice_amount" widget="monetary"/>
                <field name="state"/>
                <field name="declaration_date"/>
            </list>
        </field>
    </record>

    <record id="bonded_customs_file_view_form" model="ir.ui.view">
        <field name="name">bonded.customs.file.form</field>
        <field name="model">bonded.customs.file</field>
        <field name="arch" type="xml">
            <form create="false" duplicate="false" class="bonded_required_highlight">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state not in ('draft', 'to_be_submitted')" class="btn-primary"/>
                    <button name="action_approve" string="Approve (Simulate)" type="object" invisible="state != 'submitted' or declaration_type not in ('t1_in', 't1_out')" class="btn-success"/>
                    <button name="action_complete_clearance" string="Complete Clearance" type="object" invisible="state != 'submitted' or declaration_type != 'clearance_out'" class="btn-success"/>
                    <button name="action_close_t1" string="Close T1" type="object" invisible="state != 'customs_approved' or declaration_type != 't1_out'" class="btn-success"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" class="btn-danger"/>
                    <button name="action_done" string="Close T1" type="object" invisible="state != 'customs_approved' or declaration_type != 't1_in'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'to_be_submitted', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,customs_approved,done" readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="state != 'customs_rejected'">
                        <i class="fa fa-times-circle"/> Rejected: <field name="rejection_reason"/>
                    </div>
                    <group readonly="state != 'draft'">
                        <group string="Declaration Header (SAD/C88)">
                            <field name="declaration_no" readonly="1"/>
                            <field name="declaration_type"/>
                            <field name="bonded_book_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="mrn" invisible="id"/>
                            <field name="mrn_id" invisible="not id" domain="[('customs_file_id', '=', id)]" context="{'default_customs_file_id': id}" options="{'create_name_field': 'mrn'}"/>
                            <field name="customs_code"/>
                        </group>
                        <group string="Parties">
                            <field name="consignor_eori_entity_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="consignor_eori"/>
                            <field name="consignee_eori_entity_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="consignee_eori"/>
                            <field name="declarant_eori_entity_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="declarant_eori"/>
                            <field name="procedure_code"/>
                            <field name="bonded_warehouse_no"/>
                            <field name="previous_doc_no"/>
                        </group>
                        <group string="Transport">
                            <field name="origin_country_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="destination_country_id" required="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="transport_mode"/>
                            <field name="estimated_distance_km" invisible="transport_mode != 'road'"/>
                            <field name="transit_deadline"/>
                        </group>
                        <group string="Cargo">
                            <field name="total_packages"/>
                            <field name="total_gross_weight"/>
                            <field name="invoice_amount" widget="monetary"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Declaration Lines (Box6)" readonly="state != 'draft'">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="item_no"/>
                                    <field name="eligible_bonded_product_ids" column_invisible="1"/>
                                    <field name="bonded_product_id" domain="[('id', 'in', eligible_bonded_product_ids)]" required="1" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="hs_code"/>
                                    <field name="origin_country_id" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                                    <field name="gross_weight"/>
                                    <field name="net_weight"/>
                                    <field name="line_value" widget="monetary"/>
                                    <field name="initial_customs_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gate Arrivals" invisible="declaration_type not in ('t1_in')">
                            <field name="gate_arrival_ids" mode="list,form" context="{'default_customs_file_id': id, 'from_t1_customs_file': True}" readonly="state == 'done'">
                                <list create="true" delete="false">
                                    <field name="name"/>
                                    <field name="bonded_inbound_id"/>
                                    <field name="container_no"/>
                                    <field name="mrn"/>
                                    <field name="arrival_datetime"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bonded Inbound" invisible="declaration_type != 't1_in'">
                            <field name="inbound_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="inbound_tracking_id"/>
                                    <field name="expected_date"/>
                                    <field name="total_value" widget="monetary"/>
                                    <field name="state"/>
                                    <field name="picking_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inbound Tracking" invisible="declaration_type != 't1_in'">
                            <field name="inbound_tracking_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="bonded_inbound_id"/>
                                    <field name="mrn"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <group>
                                <field name="declaration_attachment_line_ids" widget="attachment_preview" readonly="state != 'draft'"/>
                                <field name="response_attachment_line_ids" widget="attachment_preview" readonly="state != 'draft'"/>
                                <field name="approval_no" readonly="1"/>
                                <field name="approval_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bonded_customs_file_view_search" model="ir.ui.view">
        <field name="name">bonded.customs.file.search</field>
        <field name="model">bonded.customs.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="declaration_no"/>
                <field name="mrn"/>
                <field name="declarant_eori_entity_id"/>
                <field name="consignor_eori"/>
                <field name="consignee_eori"/>
                <filter name="t1_in" string="T1 In" domain="[('declaration_type','=','t1_in')]"/>
                <filter name="clearance_out" string="Customs Clearance Out" domain="[('declaration_type','=','clearance_out')]"/>
                <filter name="t1_out" string="T1 Out" domain="[('declaration_type','=','t1_out')]"/>
                <separator/>
                <filter name="approved" string="Approved" domain="[('state','=','customs_approved')]"/>
                <filter name="pending" string="Submitted" domain="[('state','=','submitted')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_type" string="Type" context="{'group_by':'declaration_type'}"/>
                    <filter name="by_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
