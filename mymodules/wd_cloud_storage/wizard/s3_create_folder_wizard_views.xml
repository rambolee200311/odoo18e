<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_s3_create_folder_wizard_form" model="ir.ui.view">
        <field name="name">s3.create.folder.wizard.form</field>
        <field name="model">s3.create.folder.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Folder">
                <sheet>
                    <group>
                        <field name="node_id" invisible="1"/>
                        <field name="folder_name" string="Name" placeholder="Finance"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_s3_create_folder_wizard" model="ir.actions.act_window">
        <field name="name">Add Folder</field>
        <field name="res_model">s3.create.folder.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_s3_create_folder_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
