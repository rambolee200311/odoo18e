<odoo>
    <template id="report_bonded_mrn_stock_query_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .mrn-title {
                                font-size: 18px;
                                font-weight: 700;
                                text-align: center;
                                margin-bottom: 8px;
                            }

                            .mrn-head {
                                font-size: 11px;
                                margin-bottom: 8px;
                            }

                            .mrn-table {
                                width: 100%;
                                border-collapse: collapse;
                                font-size: 9px;
                            }

                            .mrn-table th, .mrn-table td {
                                border: 1px solid #333;
                                padding: 3px 4px;
                                vertical-align: middle;
                            }

                            .mrn-table th {
                                background: #f1f1f1;
                                font-weight: 700;
                            }

                            .key {
                                font-weight: 700;
                            }
                        </style>

                        <div class="mrn-title">MRN Product Stock Query Report</div>
                        <div class="mrn-head">
                            <div><span class="key">Query Name:</span> <span t-esc="o.name or ''"/></div>
                            <div><span class="key">Start Time:</span> <span t-field="o.start_time"
                                                                            t-options="{'widget': 'datetime'}"/></div>
                            <div><span class="key">End Time:</span> <span t-field="o.end_time"
                                                                          t-options="{'widget': 'datetime'}"/></div>
                            <div><span class="key">Unique Identifier:</span> <span
                                    t-esc="o.unique_identifier or 'ALL'"/></div>

                            <div><span class="key">Product:</span> <span
                                    t-esc="o.product_id.display_name if o.product_id else 'ALL'"/></div>
                            <div><span class="key">MRN:</span> <span
                                    t-esc="o.mrn_id.code if o.mrn_id else 'ALL'"/></div>
                        </div>

                        <table class="mrn-table">
                            <thead>
                                <tr>
                                    <th>MRN</th>
                                    <th>Product</th>
                                    <th>Barcode</th>
                                    <th>Customs Status</th>
                                    <th>MRN Status</th>
                                    <th>Inbound No</th>
                                    <th>Outbound No</th>
                                    <th>Qty Before Start</th>
                                    <th>Inbound Qty</th>
                                    <th>Outbound Qty</th>
                                    <th>Stock Qty</th>
                                    <th>Operator</th>
                                    <th>Change Time</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-if="not o.query_lines">
                                    <td colspan="14" style="text-align:center;">No data</td>
                                </tr>
                                <tr t-foreach="o.query_lines" t-as="line">
                                    <td class="key"><span t-esc="line.mrn_id.code if line.mrn_id else ''"/></td>
                                    <td><span t-esc="line.product_id.display_name or ''"/></td>
                                    <td><span t-esc="line.product_barcode or ''"/></td>
                                    <td><span
                                            t-esc="dict(line._fields['customs_status'].selection).get(line.customs_status, '')"/></td>
                                    <td><span
                                            t-esc="dict(line._fields['mrn_status'].selection).get(line.mrn_status, '')"/></td>
                                    <td><span t-esc="line.inbound_no or ''"/></td>
                                    <td><span t-esc="line.outbound_no or ''"/></td>
                                    <td><span t-esc="line.opening_qty or 0.0"/></td>
                                    <td><span t-esc="line.inbound_qty or 0.0"/></td>
                                    <td><span t-esc="line.outbound_qty or 0.0"/></td>
                                    <td class="key"><span t-esc="line.stock_qty or 0.0"/></td>
                                    <td><span t-esc="line.operator_id.name if line.operator_id else ''"/></td>
                                    <td><span t-field="line.change_time" t-options="{'widget': 'datetime'}"/></td>
                                    <td><span t-esc="line.remark or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
