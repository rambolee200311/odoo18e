<odoo>

    <record id="view_outbound_order_tree_unique_identifier_inherit" model="ir.ui.view">
        <field name="name">world.depot.outbound.order.list.unique.identifier.inherit</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='billno']" position="after">
                <!--                <field name="unique_identifier" optional="show"/>-->
                <!--                <field name="bonded_flag" readonly="1" widget="badge"-->
                <!--                       decoration-danger="bonded_flag in ('bonded')"-->
                <!--                       decoration-info="bonded_flag in ('non_bonded')"/>-->
            </xpath>
             <xpath expr="//list/field[@name='billno']" position="attributes">
                <attribute name="string">Outbound No</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_inbound_pallet_line_m2o_list_simple" model="ir.ui.view">
        <field name="name">world.depot.inbound.order.products.pallet.list.simple</field>
        <field name="model">world.depot.inbound.order.products.pallet</field>
        <field name="arch" type="xml">
            <list string="Inbound Pallet Line" create="false" edit="false" delete="false">
                <field name="unique_identifier"/>
                <field name="inbound_no"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>
    <record id="view_outbound_order_form_trade_ref_inherit" model="ir.ui.view">
        <field name="name">outbound.order.form.trade.ref.inherit</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pick_type']" position="after">
                <!--                <field name="unique_identifier" optional="show"/>-->
                <field name="bonded_flag"
                       force_save="1"
                       required="1"
                       decoration-danger="bonded_flag in ('true')"
                       decoration-info="bonded_flag in ('false')"/>
                <field name="customs_document_id" readonly="state != 'new'"
                       options="{'no_create': True}"/>
                <field name="mrn_id" options="{'no_open': True , 'no_create': True}" readonly="state != 'new'"/>
                <field name="cmr_sign_time" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='outbound_order_product_ids']" position="attributes">
                <attribute name="context">{'outbound_show_unique_identifier_only': 1}</attribute>
            </xpath>
            <xpath expr="//field[@name='outbound_order_product_ids']/list/field[@name='product_id']" position="after">
                <field name="inbound_pallet_id"
                       readonly="parent.state != 'new'"
                       options="{'no_create': True, 'no_open': True}"
                       context="{
                       'outbound_show_unique_identifier_only': 1,
                       'outbound_bonded_flag': parent.bonded_flag,
           'outbound_warehouse_id': parent.warehouse,
           'list_view_ref': 'bonded_mange.view_inbound_pallet_line_m2o_list_simple',}"
                       domain="[('product_id', '=', product_id),
           ('inbound_order_product_id.inbound_order_id.state', '=', 'confirm'),
           ('inbound_order_product_id.inbound_order_id.stock_picking_id.state', '=', 'done')]"/>
                <field name="unique_identifier" column_invisible="1"/>
                <field name="origin_country"/>
                <field name="goods_value"/>
                <field name="hs_code" readonly="1"/>
                <!--                <field name="weight"/>-->
                <field name="customs_code" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>