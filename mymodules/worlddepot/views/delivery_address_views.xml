<odoo>
    <record id="view_world_depot_delivery_address_form" model="ir.ui.view">
        <field name="name">world.depot.delivery.address.form</field>
        <field name="model">world.depot.delivery.address</field>
        <field name="arch" type="xml">
            <form string="Delivery Address" duplicate="false">
                <sheet>
                    <group>
                        <field name="recipient_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="active"/>
                        <field name="street" required="1"/>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="phone"/>
                        <field name="mobile"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_inherit_delivery_address" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.delivery.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery Addresses" name="delivery_addresses">
                    <field name="delivery_address_ids" context="{'default_recipient_id': id}">
                        <list editable="bottom">
                            <field name="street" required="1"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>