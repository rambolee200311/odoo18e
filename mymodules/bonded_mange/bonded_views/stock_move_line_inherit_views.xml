<odoo>
    <record id="view_move_line_tree_identifier_history_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.list.identifier.history.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date desc,id desc</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
            <xpath expr="//list/field[@name='reference']" position="after">
                <field name="unique_identifier" optional="show"/>
                <field name="file_identifier" optional="show"/>
                <field name="io_picking_id" optional="show"/>
                <field name="oo_picking_id" optional="show"/>
                <field name="in_no" optional="show"/>
                <field name="pick_no" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_detailed_identifier_history_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.list.detailed.identifier.history.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date desc,id desc</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
            <xpath expr="//list/field[@name='picking_id']" position="after">
                <field name="io_picking_id" optional="show"/>
                <field name="oo_picking_id" optional="show"/>
                <field name="in_no" optional="show"/>
                <field name="pick_no" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="unique_identifier" optional="show"/>
                <field name="file_identifier" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_identifier_history_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.form.identifier.history.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">0</attribute>
            </xpath>
            <xpath expr="//group/group/field[@name='reference']" position="after">
                <field name="unique_identifier" readonly="1"/>
                <field name="file_identifier" readonly="1"/>
                <field name="io_picking_id" readonly="1"/>
                <field name="oo_picking_id" readonly="1"/>
                <field name="in_no" readonly="1"/>
                <field name="pick_no" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- stock.move.line operation list -->
    <record id="view_stock_move_line_operation_tree_trade_ref_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operation.list.trade.ref.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="after">
                <field name="origin_country" optional="hide"/>
                <field name="goods_value" optional="hide"/>
                <field name="hs_code" readonly="1" optional="hide"/>
                <field name="weight" optional="hide"/>
                <field name="customs_code" readonly="1" optional="hide"/>
            </xpath>
                   <xpath expr="//list/field[@name='quantity'][1]" position="after">
                <field name="unique_identifier" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- stock.move.line detailed operation list -->
    <record id="view_stock_move_line_detailed_operation_tree_trade_ref_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.list.trade.ref.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="after">
                <field name="origin_country" optional="hide"/>
                <field name="goods_value" optional="hide"/>
                <field name="hs_code" readonly="1" optional="hide"/>
                <field name="weight" optional="hide"/>
                <field name="customs_code" readonly="1" optional="hide"/>
            </xpath>
                 <xpath expr="//list/field[@name='quantity'][1]" position="after">
                <field name="unique_identifier" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
