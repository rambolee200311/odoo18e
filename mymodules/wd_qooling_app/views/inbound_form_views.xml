<odoo>
    <record id="view_qooling_inbound_form_list" model="ir.ui.view">
        <field name="name">wd.qooling.inbound.form.list</field>
        <field name="model">wd.qooling.inbound.form</field>
        <field name="arch" type="xml">
            <list string="Inbound Forms">
                <field name="name"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="supervisor_id"/>
                <field name="state"/>
                <field name="ref_no"/>
            </list>
        </field>
    </record>

    <record id="view_qooling_inbound_form_search" model="ir.ui.view">
        <field name="name">wd.qooling.inbound.form.search</field>
        <field name="model">wd.qooling.inbound.form</field>
        <field name="arch" type="xml">
            <search string="Inbound Forms">
                <field name="date"/>
                <field name="filled_in_by_id"/>
                <field name="ref_no"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
            </search>
        </field>
    </record>

    <record id="view_qooling_inbound_form" model="ir.ui.view">
        <field name="name">wd.qooling.inbound.form</field>
        <field name="model">wd.qooling.inbound.form</field>
        <field name="arch" type="xml">
            <form string="Inbound Form">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'submitted'"
                            groups="wd_qooling_app.group_qooling_inbound_reviewer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="warehouse_operator_id" readonly="state != 'draft'"/>
                            <field name="supervisor_id" readonly="state != 'draft'"/>
                            <field name="filled_in_by_id" readonly="1"/>
                            <field name="filing_date" readonly="state != 'draft'"/>
                            <field name="ref_no" readonly="state != 'draft'"/>
                            <field name="mrn_number" readonly="state != 'draft'"/>
                            <field name="seal_number" readonly="state != 'draft'"/>
                            <field name="skal_bio_product" readonly="state != 'draft'"/>
                            <field name="bl_required" readonly="state != 'draft'"/>
                            <field name="bl_number" invisible="bl_required != 'required'" required="bl_required == 'required'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="goods_status" readonly="state != 'draft'"/>
                            <field name="unloading_permission" readonly="state != 'draft'"/>
                            <field name="container_shipment_number" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checks">
                            <group>
                                <field name="checked_visible_damage" readonly="state != 'draft'"/>
                                <field name="checked_received_quantity" readonly="state != 'draft'"/>
                                <field name="checked_product_quality" readonly="state != 'draft'"/>
                                <field name="packaging_condition" readonly="state != 'draft'"/>
                                <field name="gas_measurement" readonly="state != 'draft'"/>
                                <field name="gas_measurement_status" readonly="state != 'draft'"/>
                                <field name="ventilated" readonly="state != 'draft'"/>
                                <field name="status_after_ventilation" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="ADR and Temperature">
                            <group>
                                <field name="adr" readonly="state != 'draft'"/>
                                <field name="un_number" invisible="adr != 'yes'" required="adr == 'yes'" readonly="state != 'draft'"/>
                                <field name="temperature_measured" invisible="adr != 'yes'" required="adr == 'yes'" readonly="state != 'draft'"/>
                                <field name="pallet_temperature_registered" invisible="adr != 'yes'" required="adr == 'yes'" readonly="state != 'draft'"/>
                                <field name="average_temperature_per_pallet" readonly="state != 'draft'"/>
                                <field name="amount_of_pallets" readonly="state != 'draft'"/>
                                <field name="amount_of_cartons" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Evidence">
                            <group>
                                <field name="photo_ids" widget="attachment_preview" readonly="state != 'draft'"
                                       options="{'accepted_file_extensions': 'image/*,video/*', 'number_of_files': 20, 'auto_create': True}"/>
                                <field name="comments" readonly="state != 'draft'"/>
                                <field name="warehouse_signature" widget="qooling_signature" readonly="state != 'draft'"/>
                                <field name="signer_id" readonly="1"/>
                                <field name="signature_time" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qooling_inbound_form" model="ir.actions.act_window">
        <field name="name">Inbound Forms</field>
        <field name="res_model">wd.qooling.inbound.form</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an Inbound Form</p>
        </field>
    </record>

    <menuitem id="menu_qooling_root" name="Qooling"/>
    <menuitem id="menu_qooling_inbound" name="Inbound Forms"
              parent="menu_qooling_root" action="action_qooling_inbound_form"
              groups="base.group_user,wd_qooling_app.group_qooling_inbound_user"/>
</odoo>
