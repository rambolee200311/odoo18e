<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_location_import_list" model="ir.ui.view">
        <field name="name">move.line.location.import.list</field>
        <field name="model">move.line.location.import</field>
        <field name="arch" type="xml">
            <list edit="false" delete="false">
                <field name="name"/>
                <field name="filename"/>
                <field name="picking_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="state"/>
                <field name="total_count"/>
                <field name="valid_count"/>
                <field name="error_count"/>
                <field name="validation_datetime"/>
                <field name="import_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_move_line_location_import_form" model="ir.ui.view">
        <field name="name">move.line.location.import.form</field>
        <field name="model">move.line.location.import</field>
        <field name="arch" type="xml">
            <form duplicate="false" delete="false">
                <header>
                    <button name="action_validate_file" type="object" string="Validate File" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_validate_file" type="object" string="Revalidate" class="btn-primary"
                            invisible="state not in ('failed', 'validated')"/>
                    <button name="action_confirm_import" type="object" string="Confirm Import" class="btn-primary"
                            invisible="state != 'validated'"/>
                    <button name="action_open_import_lines" type="object" string="View Import Lines"
                            invisible="not import_lines"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,failed,imported"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" required="1"/>
                            <field name="file" filename="filename" readonly="state != 'draft'" required="1"/>
                            <field name="filename" invisible="1" force_save="1"/>
                            <field name="picking_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="total_count" readonly="1"/>
                            <field name="valid_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                            <field name="validation_datetime" readonly="1"/>
                            <field name="import_datetime" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="import_lines" string="Import Lines">
                            <field name="import_lines" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="row_number"/>
                                    <field name="state"/>
                                    <field name="error_field_names"/>
                                    <field name="source_move_line_external_id"/>
                                    <field name="source_product_name"/>
                                    <field name="source_lot_name"/>
                                    <field name="source_package_name"/>
                                    <field name="source_quantity_text"/>
                                    <field name="source_uom_name"/>
                                    <field name="source_location_name"/>
                                    <field name="matched_picking_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="move_line_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="target_location_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="validation_details"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_move_line_location_import_search" model="ir.ui.view">
        <field name="name">move.line.location.import.search</field>
        <field name="model">move.line.location.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="filename"/>
                <field name="picking_id"/>
                <field name="state"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="state_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="state_imported" string="Imported" domain="[('state', '=', 'imported')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_picking" string="Picking" context="{'group_by': 'picking_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_move_line_location_import_line_list" model="ir.ui.view">
        <field name="name">move.line.location.import.line.list</field>
        <field name="model">move.line.location.import.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="import_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="row_number"/>
                <field name="state"/>
                <field name="error_field_names"/>
                <field name="matched_picking_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="source_move_line_external_id"/>
                <field name="source_product_name"/>
                <field name="source_lot_name"/>
                <field name="source_package_name"/>
                <field name="source_quantity_text"/>
                <field name="source_uom_name"/>
                <field name="source_location_name"/>
                <field name="target_location_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="validation_details"/>
            </list>
        </field>
    </record>

    <record id="view_move_line_location_import_line_form" model="ir.ui.view">
        <field name="name">move.line.location.import.line.form</field>
        <field name="model">move.line.location.import.line</field>
        <field name="arch" type="xml">
            <form duplicate="false" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="import_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="row_number" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="error_field_names" readonly="1"/>
                            <field name="source_move_line_external_id" readonly="1"/>
                            <field name="move_line_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="matched_picking_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_location_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="source_product_name" readonly="1"/>
                            <field name="current_product_name" readonly="1"/>
                            <field name="source_lot_name" readonly="1"/>
                            <field name="current_lot_name" readonly="1"/>
                            <field name="source_package_name" readonly="1"/>
                            <field name="current_package_name" readonly="1"/>
                            <field name="source_quantity_text" readonly="1"/>
                            <field name="current_quantity" readonly="1"/>
                            <field name="source_uom_name" readonly="1"/>
                            <field name="current_uom_name" readonly="1"/>
                            <field name="source_location_name" readonly="1"/>
                            <field name="current_location_name" readonly="1"/>
                            <field name="source_is_location_updated" readonly="1"/>
                            <field name="snapshot_write_datetime" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="validation_details" readonly="1"/>
                        <field name="validation_log" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_move_line_location_import_line_search" model="ir.ui.view">
        <field name="name">move.line.location.import.line.search</field>
        <field name="model">move.line.location.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="import_id"/>
                <field name="matched_picking_id"/>
                <field name="source_product_name"/>
                <field name="source_lot_name"/>
                <field name="source_package_name"/>
                <field name="source_location_name"/>
                <field name="state"/>
                <field name="error_field_names"/>
                <filter name="state_valid" string="Valid" domain="[('state', '=', 'valid')]"/>
                <filter name="state_error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="state_stale" string="Stale" domain="[('state', '=', 'stale')]"/>
                <filter name="state_imported" string="Imported" domain="[('state', '=', 'imported')]"/>
                <separator/>
                <filter name="group_import" string="Import" context="{'group_by': 'import_id'}"/>
                <filter name="group_picking" string="Picking" context="{'group_by': 'matched_picking_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_error_field" string="Error Fields" context="{'group_by': 'error_field_names'}"/>
            </search>
        </field>
    </record>

    <record id="action_move_line_location_import" model="ir.actions.act_window">
        <field name="name">Sunrise Move Line Location Imports</field>
        <field name="res_model">move.line.location.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_move_line_location_import_search"/>
    </record>

    <record id="action_move_line_location_import_line" model="ir.actions.act_window">
        <field name="name">Sunrise Move Line Location Import Lines</field>
        <field name="res_model">move.line.location.import.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_move_line_location_import_line_search"/>
    </record>
    <menuitem id="menu_move_line_location_import"
              name="Sunrise Move Line Location Imports"
              parent="menu_stock_barcode_lite_import"
              action="action_move_line_location_import"
              sequence="50"/>
</odoo>
