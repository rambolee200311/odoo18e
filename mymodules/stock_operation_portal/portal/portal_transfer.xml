<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transfer Orders List -->
    <template id="portal_operation_transfers" name="Transfer Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-set="page_name" value="'operation_transfers'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    <div class="mb-3">
                        <a href="/my/operation" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left"/> Back to Menu
                        </a>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2>Transfer Orders</h2>
                        <a href="/my/operation/transfers/create" class="btn btn-warning">
                            <i class="fa fa-plus"/> Create Transfer Order
                        </a>
                    </div>
                    
                    <!-- Filter Form -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <form method="get" class="row g-3">
                                <div class="col-md-3">
                                    <input type="text" name="reference" class="form-control" 
                                           placeholder="Reference" t-att-value="filters.get('reference', '')"/>
                                </div>
                                <div class="col-md-3">
                                    <select name="state" class="form-control">
                                        <option value="">All Status</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-warning">Search</button>
                                    <a href="/my/operation/transfers" class="btn btn-secondary">Reset</a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>From Location</th>
                                    <th>To Location</th>
                                    <th>Scheduled Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td><span t-esc="row.get('reference', '-')"/></td>
                                    <td><span t-esc="row.get('location_from_id', '-')"/></td>
                                    <td><span t-esc="row.get('location_to_id', '-')"/></td>
                                    <td><span t-esc="row.get('scheduled_date', '-')"/></td>
                                    <td><span t-esc="row.get('state', '-')"/></td>
                                    <td>
                                        <a t-attf-href="/my/operation/transfers/{{ row.get('id') }}" 
                                           class="btn btn-sm btn-info">View</a>
                                    </td>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="6" class="text-center text-muted">No records found</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Transfer Order Detail -->
    <template id="portal_operation_transfer_detail" name="Transfer Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-set="page_name" value="'operation_transfer_detail'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    <div class="mb-3">
                        <a href="/my/operation/transfers" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left"/> Back to List
                        </a>
                    </div>
                    <h2>Transfer Order Detail</h2>
                    <div class="alert alert-info">Order details will be displayed here</div>
                </div>
            </div>
        </t>
    </template>

    <!-- Transfer Order Form -->
    <template id="portal_operation_transfer_form" name="Create Transfer Order">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-set="page_name" value="'operation_transfer_create'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    <div class="mb-3">
                        <a href="/my/operation/transfers" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left"/> Back to List
                        </a>
                    </div>
                    <h2>Create Transfer Order</h2>
                    <div class="alert alert-info">Form will be available soon</div>
                </div>
            </div>
        </t>
    </template>
</odoo>
