<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunrise_stock_report_list" model="ir.ui.view">
        <field name="name">sunrise.stock.report.list</field>
        <field name="model">sunrise.stock.report</field>
        <field name="arch" type="xml">
            <list string="Sunrise Pallet Aging Reports">
                <field name="name" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="location_scope" optional="show"/>
                <field name="product_template_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="lot_name" optional="show"/>
                <field name="opening_product_summary" optional="show"/>
                <field name="inbound_product_summary" optional="show"/>
                <field name="outbound_product_summary" optional="show"/>
                <field name="closing_product_summary" optional="show"/>
                <field name="average_age_days" optional="show"/>
                <field name="maximum_age_days" optional="show"/>
                <field name="over_180_pallet_count" optional="show"/>
                <field name="opening_pallet_count" optional="show"/>
                <field name="inbound_pallet_count" optional="show"/>
                <field name="outbound_pallet_count" optional="show"/>
                <field name="closing_pallet_count" optional="show"/>
                <field name="state" optional="show"/>
                <field name="refreshed_by_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="refreshed_datetime" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_stock_report_form" model="ir.ui.view">
        <field name="name">sunrise.stock.report.form</field>
        <field name="model">sunrise.stock.report</field>
        <field name="arch" type="xml">
            <form string="Sunrise Pallet Aging Report" duplicate="false">
                <header>
                    <button name="action_refresh_report" type="object" string="Refresh Report" class="oe_highlight"/>
                    <button name="action_view_report_lines" type="object" icon="fa-table" title="View Pallet Summary"/>
                    <button name="action_export_pallet_summary_excel" type="object" string="Export Pallet Summary" invisible="state != 'done'"/>
                    <button name="action_export_product_stock_excel" type="object" string="Export Product / Lot Stock" invisible="state != 'done'"/>
<!--                    <button name="action_export_operation_excel" type="object" string="Export Operations" invisible="state != 'done'"/>-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
<!--                            <field name="owner_id" options="{'no_create': True, 'no_open': True}"/>-->
                            <field name="location_scope"/>
                            <field name="product_template_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="lot_name"/>
                        </group>
                        <group>
                            <field name="average_age_days" readonly="1"/>
                            <field name="maximum_age_days" readonly="1"/>
                            <field name="over_180_pallet_count" readonly="1"/>
                            <field name="opening_pallet_count" readonly="1"/>
                            <field name="inbound_pallet_count" readonly="1"/>
                            <field name="outbound_pallet_count" readonly="1"/>
                            <field name="closing_pallet_count" readonly="1"/>
                            <field name="opening_product_summary" readonly="1"/>
                            <field name="inbound_product_summary" readonly="1"/>
                            <field name="outbound_product_summary" readonly="1"/>
                            <field name="closing_product_summary" readonly="1"/>
                            <field name="refreshed_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="refreshed_datetime" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pallet Summary">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="report_id" column_invisible="True" optional="show"/>
<!--                                    <field name="warehouse_id"/>-->
<!--                                    <field name="owner_id"/>-->
<!--                                    <field name="row_type"/>-->
                                    <field name="package_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="cproject_ids" optional="show"/>
<!--                                    <field name="product_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                                    <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                                    <field name="uom_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                                    <field name="pallet_no"/>-->

                                    <field name="lifecycle_state" optional="show"/>
                                    <field name="lifecycle_start_datetime" optional="show"/>
                                    <field name="consumed_datetime" optional="show"/>
                                    <field name="closing_location_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
<!--                                    <field name="inbound_order_names"/>-->
<!--                                    <field name="outbound_order_names"/>-->
<!--                                    <field name="inbound_picking_names"/>-->
<!--                                    <field name="outbound_picking_names"/>-->
                                    <field name="opening_pallet_count" sum="Total" optional="show"/>
                                    <field name="inbound_pallet_count" sum="Total" optional="show"/>
                                    <field name="outbound_pallet_count" sum="Total" optional="show"/>
                                    <field name="closing_pallet_count" sum="Total" optional="show"/>
                                    <field name="original_product_quantity" optional="show"/>
                                    <field name="opening_product_summary" optional="show"/>
                                    <field name="inbound_product_summary" optional="show"/>
                                    <field name="outbound_product_summary" optional="show"/>
                                    <field name="closing_product_summary" optional="show"/>
                                    <field name="closing_age_days" optional="show"/>
                                    <field name="period_stock_days" optional="show"/>
<!--                                    <field name="first_inbound_picking_id" options="{'no_create': True, 'no_open': True}"/>-->
                                    <field name="anomaly_message" optional="show"/>
                                    <button name="action_view_stock_lines" type="object" icon="fa-cubes" title="View Stock Details"/>
<!--                                    <button name="action_view_operation_lines" type="object" icon="fa-list" title="View Operations"/>-->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_stock_report_line_pallet_form" model="ir.ui.view">
        <field name="name">sunrise.stock.report.line.form</field>
        <field name="model">sunrise.stock.report.line</field>
        <field name="arch" type="xml">
            <form string="Sunrise Pallet Aging Line" duplicate="false" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_id" invisible="1" options="{'no_create': True, 'no_open': True}"/>
<!--                            <field name="row_type" readonly="1"/>-->
                            <field name="package_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="cproject_ids" readonly="1"/>
<!--                            <field name="product_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="product_template_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="uom_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="pallet_no" readonly="1"/>-->
                            <field name="closing_location_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
<!--                            <field name="warehouse_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="owner_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
                            <field name="lifecycle_state" readonly="1"/>
                            <field name="lifecycle_start_datetime" readonly="1"/>
                            <field name="consumed_datetime" readonly="1"/>
<!--                            <field name="first_inbound_order_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="first_inbound_picking_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>-->
<!--                            <field name="picking_state_summary" readonly="1"/>-->
                            <field name="anomaly_message" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pallet Statistics">
                        <group>
                            <field name="opening_pallet_count" readonly="1"/>
                            <field name="inbound_pallet_count" readonly="1"/>
                            <field name="outbound_pallet_count" readonly="1"/>
                            <field name="closing_pallet_count" readonly="1"/>
                            <field name="original_product_quantity" readonly="1"/>
                            <field name="period_stock_days" readonly="1"/>
                            <field name="closing_age_days" readonly="1"/>
                        </group>
                        <group>
                            <field name="opening_product_summary" readonly="1" sum="Total"/>
                            <field name="inbound_product_summary" readonly="1" sum="Total"/>
                            <field name="outbound_product_summary" readonly="1" sum="Total"/>
                            <field name="closing_product_summary" readonly="1" sum="Total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Details">
                            <field name="stock_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="report_line_id" column_invisible="True" optional="show"/>
                                    <field name="product_template_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="lot_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="closing_location_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="stock_state" optional="show"/>
                                    <field name="opening_quantity" optional="show" sum="Total"/>
                                    <field name="inbound_quantity" optional="show" sum="Total"/>
                                    <field name="outbound_quantity" optional="show" sum="Total"/>
                                    <field name="on_hand_quantity" optional="show" sum="Total"/>
<!--                                    <field name="reserved_quantity"/>-->
<!--                                    <field name="available_quantity"/>-->
                                    <field name="uom_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operation Details">
                            <field name="operation_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="report_line_id" column_invisible="True" optional="show"/>
                                    <field name="direction" optional="show"/>
                                    <field name="inbound_order_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="outbound_order_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="picking_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="picking_state" optional="show"/>
                                    <field name="product_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="lot_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="planned_quantity" optional="show" sum="Total"/>
<!--                                    <field name="reserved_quantity" optional="show" sum="Total"/>-->
                                    <field name="done_quantity" optional="show" sum="Total"/>
                                    <field name="uom_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                    <field name="operation_datetime" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunrise_stock_report_line_list" model="ir.ui.view">
        <field name="name">sunrise.stock.report.line.list</field>
        <field name="model">sunrise.stock.report.line</field>
        <field name="arch" type="xml">
            <list string="Sunrise Pallet Aging Lines" create="0" delete="0" edit="0">
                <field name="report_id" column_invisible="True" optional="show"/>
<!--                <field name="warehouse_id"/>-->
<!--                <field name="owner_id"/>-->
<!--                <field name="row_type"/>-->
                <field name="package_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="cproject_ids" optional="show"/>
<!--                <field name="product_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                <field name="uom_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                <field name="pallet_no"/>-->
                <field name="closing_location_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="lifecycle_state" optional="show"/>
                <field name="lifecycle_start_datetime" optional="show"/>
                <field name="consumed_datetime" optional="show"/>
<!--                <field name="first_inbound_order_id" options="{'no_create': True, 'no_open': True}" optional="show"/>-->
<!--                <field name="first_inbound_picking_id" options="{'no_create': True, 'no_open': True}"/>-->
<!--                <field name="inbound_order_names"/>-->
<!--                <field name="outbound_order_names"/>-->
<!--                <field name="inbound_picking_names"/>-->
<!--                <field name="outbound_picking_names"/>-->
<!--                <field name="picking_state_summary"/>-->
                <field name="opening_pallet_count" sum="Total" optional="show"/>
                <field name="inbound_pallet_count" sum="Total" optional="show"/>
                <field name="outbound_pallet_count" sum="Total" optional="show"/>
                <field name="closing_pallet_count" sum="Total" optional="show"/>
                <field name="original_product_quantity" optional="show"/>
                <field name="opening_product_summary" optional="show"/>
                <field name="inbound_product_summary" optional="show"/>
                <field name="outbound_product_summary" optional="show"/>
                <field name="closing_product_summary" optional="show"/>
                <field name="closing_age_days" optional="show"/>
                <field name="period_stock_days" optional="show"/>
                <field name="anomaly_message" optional="show"/>
                <button name="action_view_stock_lines" type="object" icon="fa-cubes" title="View Stock Details"/>
                <button name="action_view_operation_lines" type="object" icon="fa-list" title="View Operations"/>
            </list>
        </field>
    </record>

    <record id="view_sunrise_stock_report_product_line_list" model="ir.ui.view">
        <field name="name">sunrise.stock.report.product.line.list</field>
        <field name="model">sunrise.stock.report.product.line</field>
        <field name="arch" type="xml">
            <list string="Pallet Stock Details" create="0" delete="0" edit="0">
                <field name="report_line_id" column_invisible="True" optional="show"/>
                <field name="product_template_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="lot_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="closing_location_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="stock_state" optional="show"/>
                <field name="opening_quantity" optional="show"/>
                <field name="inbound_quantity" optional="show"/>
                <field name="outbound_quantity" optional="show"/>
                <field name="on_hand_quantity" optional="show"/>
<!--                <field name="reserved_quantity"/>-->
<!--                <field name="available_quantity"/>-->
                <field name="uom_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
<!--                <field name="variant_summary"/>-->
<!--                <field name="quantity_summary"/>-->
<!--                <field name="reservation_note"/>-->
            </list>
        </field>
    </record>

    <record id="view_sunrise_stock_report_operation_line_list" model="ir.ui.view">
        <field name="name">sunrise.stock.report.operation.line.list</field>
        <field name="model">sunrise.stock.report.operation.line</field>
        <field name="arch" type="xml">
            <list string="Pallet Operations" create="0" delete="0" edit="0">
                <field name="report_line_id" column_invisible="True" optional="show"/>
                <field name="direction" optional="show"/>
                <field name="inbound_order_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="outbound_order_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="picking_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="picking_state" optional="show"/>
                <field name="product_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="lot_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="planned_quantity" optional="show"/>
<!--                <field name="reserved_quantity"/>-->
                <field name="done_quantity" optional="show"/>
                <field name="uom_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="operation_datetime" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_sunrise_stock_report" model="ir.actions.act_window">
        <field name="name">Sunrise Pallet Aging Report</field>
        <field name="res_model">sunrise.stock.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sunrise_stock_report_list"/>
    </record>
</odoo>
