<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bonded_outbound_view_tree" model="ir.ui.view">
        <field name="name">bonded.outbound.tree</field>
        <field name="model">bonded.outbound</field>
        <field name="arch" type="xml">
            <list string="Bonded Outbound">
                <field name="name" optional="show"/>
                <field name="inbound_tracking_no" string="Unique Identifier No." optional="show"/>
                <field name="customs_file_id" optional="show"/>
                <field name="customs_file_state" optional="show"/>
                <field name="mrn_id" optional="show" options="{'no_create': True, 'no_open': True}"/>
                <field name="mrn_status" optional="show"/>
                <field name="t1_status" optional="show"/>
                <field name="t1_closed_date" optional="show"/>
                <field name="picking_id" optional="show"/>
                <field name="picking_status" optional="show"/>
                <field name="picking_validation_time" optional="show"/>
                <field name="bonded_book_id" optional="show"/>
                <field name="outbound_type" optional="show"/>
                <field name="warehouse" optional="show"/>
                <field name="is_dangerous" optional="hide" widget="boolean_toggle"/>
                <field name="total_value" widget="monetary" optional="show"/>
                <field name="remark" optional="show"/>
                <field name="order_type" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="order_date" optional="show"/>
                <field name="expected_date" optional="show"/>
                <field name="owner_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="unload_company" optional="show"/>
                <field name="load_ref" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="bonded_outbound_view_search" model="ir.ui.view">
        <field name="name">bonded.outbound.search</field>
        <field name="model">bonded.outbound</field>
        <field name="arch" type="xml">
            <search string="Bonded Outbound">
                <field name="name"/>
                <field name="customs_file_id"/>
                <field name="mrn_id"/>
                <field name="reference"/>
                <field name="order_date"/>
                <field name="owner_id"/>
                <field name="project_id"/>
                <field name="warehouse"/>
                <field name="bonded_book_id"/>
                <field name="outbound_type"/>
                <field name="state"/>
                <field name="customs_file_state"/>
                <field name="mrn_status"/>
                <field name="t1_status"/>
                <field name="picking_id"/>
                <field name="picking_status"/>
                <filter string="Active Outbound" name="state_not_cancelled" domain="[('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="state_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Declared" name="state_declared" domain="[('state', '=', 'declared')]"/>
                <filter string="Released" name="state_released" domain="[('state', '=', 'released')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="state_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="state_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="T1 Closed" name="t1_closed" domain="[('outbound_type', '=', 't1_transit'), ('t1_status', '=', 'done')]"/>
                <filter string="T1 Open" name="t1_open" domain="[('outbound_type', '=', 't1_transit'), ('t1_status', '!=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_bonded_book" string="Bonded Book" context="{'group_by': 'bonded_book_id'}"/>
                    <filter name="group_by_warehouse" string="Warehouse" context="{'group_by': 'warehouse'}"/>
                    <filter name="group_by_outbound_type" string="Outbound Type" context="{'group_by': 'outbound_type'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bonded_outbound_view_form" model="ir.ui.view">
        <field name="name">bonded.outbound.form</field>
        <field name="model">bonded.outbound</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="bonded_required_highlight">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed', 'declared')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,declared,released,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Outbound Order</h1>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_outbound_customs_file" string="Create T1 Outbound" type="object" invisible="state not in ('confirmed', 'declared') or outbound_type != 't1_transit'" class="btn-primary"/>
                        <button name="action_create_outbound_customs_file" string="Create Clearance Outbound" type="object" invisible="state not in ('confirmed', 'declared') or outbound_type != 'l2f'" class="btn-primary"/>
                        <button name="action_create_picking" string="Create Stock Picking" type="object" invisible="state != 'released'" class="oe_stat_button" icon="fa-file-text"/>
                    </div>
                    <group col="2">
                        <group col="2" string="Main">
                            <field name="order_type" required="1" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="order_date" required="1" readonly="state != 'draft'"/>
                            <field name="expected_date" string="Planned Date" required="1" readonly="state != 'draft'"/>
                            <field name="bonded_book_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="project_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="owner_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="warehouse" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': False}"/>
                            <field name="warehouse_address" readonly="1"/>
                            <field name="outbound_type" required="1" readonly="state != 'draft'"/>
                            <field name="is_dangerous" readonly="state != 'draft'"/>
                        </group>
                        <group col="2" string="Info">
                            <field name="pick_type" required="1" readonly="state != 'draft'" domain="[('code', 'in', ['outgoing', 'internal']), ('warehouse_id', '=', warehouse)]" options="{'no_create': True, 'no_open': False}"/>
                            <field name="customs_file_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="customs_file_state" readonly="1"/>
                            <field name="mrn_id" readonly="state in ('in_progress', 'done', 'cancelled')" options="{'no_create': True, 'no_open': True}"/>
                            <field name="mrn_status" readonly="1"/>
                            <field name="t1_status" readonly="1"/>
                            <field name="t1_closed_date" readonly="1"/>
                            <field name="picking_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="picking_status" readonly="1"/>
                            <field name="picking_validation_time" readonly="1"/>
                            <field name="total_value" readonly="1" widget="monetary"/>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="total_net_weight" readonly="1"/>
                            <field name="total_gross_weight" readonly="1"/>
                            <field name="remark" readonly="state != 'draft'"/>
                            <field name="remark1" readonly="state != 'draft'"/>
                            <field name="confirm_user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="confirm_time_user_tz" readonly="1"/>
                            <field name="confirm_time_server" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Delivery">
                            <group col="2">
                                <group col="2">
                                    <field name="delivery_method"/>
                                    <field name="unload_company" required="1" readonly="state == 'cancelled'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="delivery_street" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_city" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_zip" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_country_id" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="delivery_phone" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_mobile" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_email" invisible="delivery_method == 'pickup'" readonly="state == 'cancelled'"/>
                                    <field name="delivery_remark" readonly="state == 'cancelled'"/>
                                </group>
                                <group col="2">
                                    <field name="load_ref" required="delivery_method in ('pickup', 'parcel')"/>
                                    <field name="load_date"/>
                                    <field name="delivery_company" invisible="delivery_method in ('pickup', 'parcel')" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="delivery_number" invisible="delivery_method in ('pickup', 'parcel')"/>
                                    <field name="plate_number" invisible="delivery_method in ('pickup', 'parcel')"/>
                                    <field name="receiver_sign_back_date"/>
                                    <field name="pod_attachment_line_ids" widget="attachment_preview" options="{'auto_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Products">
                            <group col="2">
                                <field name="pallet_count" readonly="state != 'draft'"/>
                                <field name="pallet_weight" readonly="state != 'draft'"/>
                            </group>
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="eligible_bonded_product_ids" column_invisible="1"/>
                                    <field name="bonded_product_id" string="Product" domain="[('id', 'in', eligible_bonded_product_ids)]" required="1" readonly="parent.state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="uom_id" column_invisible="1" readonly="1" force_save="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="bonded_stock_id" string="Unique Identifier No." required="1" readonly="parent.state != 'draft'" options="{'no_create': True, 'no_open': True}" context="{'outbound_show_tracking_only': 1, 'list_view_ref': 'wd_bonded_wms.view_bonded_stock_m2o_tracking_list'}" domain="[('bonded_book_id', '=', parent.bonded_book_id), ('product_id', '=', product_id), ('quantity', '>', 0), ('locked', '=', False), ('current_customs_status', '=', 'entrepot'), ('inbound_id.state', '=', 'done'), ('inbound_id.picking_id.state', '=', 'done')]"/>
                                    <button name="action_open_stock_selection" string="Select Stock" type="object" class="btn-secondary" invisible="parent.state != 'draft'"/>
                                    <field name="inbound_tracking_no" column_invisible="1"/>
                                    <field name="origin_country_id" string="Country of Origin" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="declared_unit_price" string="Goods Value" required="1" readonly="parent.state != 'draft'" widget="monetary"/>
                                    <field name="hs_code" string="HS Code" readonly="1"/>
                                    <field name="net_weight" string="Net Weight (kg)" readonly="1"/>
                                    <field name="gross_weight" string="Gross Weight (kg)" readonly="1"/>
                                    <field name="un_code" string="UN Number" readonly="1"/>
                                    <field name="demand_qty" string="Planned Quantity" required="1" readonly="parent.state != 'draft'"/>
                                    <field name="remark" string="Remark" readonly="parent.state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customs Declarations">
                            <field name="customs_file_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="declaration_no"/>
                                    <field name="declaration_type"/>
                                    <field name="mrn_id"/>
                                    <field name="declaration_date"/>
                                    <field name="invoice_amount" widget="monetary"/>
                                    <field name="state"/>
                                    <field name="approval_no"/>
                                    <field name="t1_closed_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
