<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_lite_outbound_order_form_inherit" model="ir.ui.view">
        <field name="name">stock.barcode.lite.outbound.order.form.inherit</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//field[@name='pick_type']" position="attributes">
                <attribute name="domain">
                    [('code', '=', 'outgoing' if project_name == 'SUNRISE' else 'internal'),
                     ('warehouse_id', '=', warehouse),
                     ('warehouse_id', '!=', False)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='picking_PICK']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_Out']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_PICK_date']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_Out_date']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>
            <xpath expr="//button[@name='view_outbound_order_sn_details']" position="attributes">
                <attribute name="invisible">project_name == 'SUNRISE'</attribute>
            </xpath>
            <xpath expr="//field[@name='outbound_order_product_ids']/list/field[@name='quantity']"
                   position="attributes">
                <attribute name="sum">Total Quantity</attribute>
            </xpath>
            <xpath expr="//field[@name='is_adr']" position="before">
                <field name="organic" readonly="1" invisible="1"/>
                <field name="vsourcebillcode" readonly="state != 'new'" invisible="project_name != 'SUNRISE'"/>
                <field name="cwarehouseid" readonly="state != 'new'" invisible="project_name !='SUNRISE'"/>
                <field name="ccustomerid" readonly="state != 'new'" invisible="project_name != 'SUNRISE'"/>
            </xpath>

            <xpath expr="//field[@name='confirm_time_server']" position="after">
                <field name="whole_pallet_picking_id" readonly="1" invisible="project_name != 'SUNRISE'"/>
                <field name="partial_pallet_picking_id" readonly="1" invisible="project_name !='SUNRISE'"/>
                <field name="outgoing_picking_lines" readonly="1" invisible="project_name != 'SUNRISE'"
                       widget="many2many_tags"/>
                <field name="o_date" string='Manual Outbound Date' invisible="project_name != 'SUNRISE'"
                       readonly="set_sunrise_outbound_sync == True"
                       help="If filled in, the system will report the outbound transaction using this date and time. If left blank, it will use the outbound pick validation time."/>
                <field name="eta"
                       invisible="project_name != 'SUNRISE'"
                       readonly="set_sunrise_outbound_sync == True"
                       required="u8c_delivery_method == 'wd' and project_name == 'SUNRISE'"
                       help="For warehouse delivery (wd), enter the estimated arrival date at the customer's warehouse."/>
            </xpath>
            <xpath expr="//field[@name='delivery_method']" position="after">
                <field name="u8c_delivery_method" readonly="state != 'new'" required="project_name == 'SUNRISE'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="transport_cost_reference" readonly="state != 'new'"
                       invisible="project_name != 'SUNRISE' or u8c_delivery_method != 'wd'"/>
                <field name="transport_cost" readonly="state != 'new'"
                       invisible="project_name != 'SUNRISE' or u8c_delivery_method != 'wd'"/>
                <field name="time_slot" readonly="state in ('confirm', 'cancel')"
                       required="u8c_delivery_method  == 'pickup' and project_name == 'SUNRISE'"
                       invisible="project_name !='SUNRISE'or u8c_delivery_method  != 'pickup'"/>
                <field name="consignee_id"
                       readonly="state != 'new'"
                       required="project_name == 'SUNRISE'"
                       invisible="project_name != 'SUNRISE'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>

            <xpath expr="//button[@name='action_create_picking_PICK']" position="after">
                <button name="action_sunrise_create_outgoing_stock_picking"
                        type="object"
                        string="Sunrise Create outgoing Picking"
                        class="oe_stat_button"
                        icon="fa-file-text"
                        invisible="project_name !='SUNRISE'"/>
                <button name="action_sunrise_prepare_recreate_outgoing_picking"
                        type="object"
                        string="Prepare Recreate Picking"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        confirm="This will return completed outbound pickings and remove old picking links. Continue?"
                        invisible="project_name != 'SUNRISE' or state != 'confirm'"
                        groups="stock_barcode_lite.group_sunrise_stock_manager"/>
            </xpath>
            <xpath expr="//field[@name='outbound_order_product_ids']" position="after">
                <group invisible="project_name != 'SUNRISE'">
                    <field name="sunrise_pallet_count" readonly="1"/>
                    <!--                    <field name="new_pallet_count_total" readonly="1"/>-->
                </group>
            </xpath>
            <xpath expr="//field[@name='outbound_order_product_ids']/list/field[@name='product_id']" position="after">
                <!--                <field name="de_palletize" optional="show" column_invisible="parent.project_name !='SUNRISE'"/>-->
                <field name="package_id" optional="show" column_invisible="parent.project_name !='SUNRISE'"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="package_barcode" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="source_product_code" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="product_ean" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="cprojectid" optional="hide" column_invisible="parent.project_name != 'SUNRISE'"/>
                <field name="ndiscounttaxtype" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="vsourcebillcode" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="vsourcerowno" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="cspaceid" optional="hide" column_invisible="parent.project_name != 'SUNRISE'"/>
                <field name="box_type" optional="show" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="box_qty" optional="show" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="box_in_qty" optional="show" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="ninnum" sum="Total PCS" optional="hide"
                       column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="u8_aux_qty" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="u8_conversion_rate" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="castunitid" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="u8_aux_uom_name" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="is_lot" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="lot_name" optional="show" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="gross_weight" readonly="1" force_save="1" optional="show"/>
                <field name="pallet_dimensions" readonly="1" force_save="1" optional="show"
                       column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="m_date" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
                <field name="e_date" optional="hide" column_invisible="parent.project_name !='SUNRISE'"/>
            </xpath>

            <xpath expr="//field[@name='outbound_order_product_ids']" position="before">
                <div class="mb-2">
                    <button name="action_open_outbound_product_import_wizard"
                            type="object"
                            string="Import Products"
                            class="btn btn-primary"
                            icon="fa-upload"
                            invisible="state != 'new'"
                            groups="stock_barcode_lite.group_sunrise_stock_manager"/>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Sunrise Sync" invisible="project_name != 'SUNRISE'">
                    <group string="Outbound Sync" col="2">
                        <group col="2">
                            <div class="oe_button_box" name="button_box">
                                <button name="action_sync_u8c_outbound"
                                        type="object"
                                        string="Sync U8C Outbound"
                                        class="btn-primary" icon="fa-upload"/>
                            </div>
                            <field name="set_sunrise_outbound_sync" readonly="1"/>
                        </group>
                        <group col="2">

                            <field name="set_sunrise_outbound_sync_time" readonly="1"/>
                            <field name="sunrise_outbound_task_number" readonly="1"/>
                            <field name="sunrise_outbound_sync_error_msg" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pickup Info Sync" col="2" invisible="u8c_delivery_method  != 'pickup'">

                        <button name="action_sync_u8c_pickup_delivery"
                                type="object"
                                string="Sync Pickup Info"
                                class="btn-primary" icon="fa-upload"/>

                        <field name="set_sunrise_pickup_delivery_sync" readonly="1"/>

                        <field name="set_sunrise_pickup_delivery_sync_time" readonly="1"/>
                        <field name="sunrise_pickup_delivery_sync_error_msg" readonly="1"/>

                    </group></page>
            </xpath>
        </field>
    </record>


    <record id="view_stock_barcode_lite_outbound_order_product_form_inherit" model="ir.ui.view">
        <field name="name">stock.barcode.lite.outbound.order.product.form.inherit</field>
        <field name="model">world.depot.outbound.order.product</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_product_standalone_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pallet_no']" position="after">
                <field name="package_id" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'" options="{'no_create': True, 'no_open': True}"/>
                <field name="package_barcode" readonly="1" invisible="project_name != 'SUNRISE'"/>
                <field name="source_product_code" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="product_ean" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <!--                <field name="de_palletize" readonly="outbound_order_state != 'new'"-->
                <!--                       invisible="project_name != 'SUNRISE'"/>-->
                <field name="cprojectid" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="ndiscounttaxtype" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="vsourcebillcode" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="vsourcerowno" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="cspaceid" optional="show" invisible="project_name != 'SUNRISE'"/>
                <field name="box_type" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="box_qty" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="box_in_qty" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="ninnum" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="u8_aux_qty" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="u8_conversion_rate" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="castunitid" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="u8_aux_uom_name" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="is_lot" readonly="outbound_order_state != 'new'" required="1"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="lot_name" readonly="outbound_order_state != 'new'" required="is_lot == 'Y'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="gross_weight" readonly="1" force_save="1" optional="show"/>
                <field name="pallet_dimensions" readonly="1" force_save="1" optional="show"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="m_date" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
                <field name="e_date" readonly="outbound_order_state != 'new'"
                       invisible="project_name != 'SUNRISE'"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_barcode_lite_sunrise_outbound_order_search" model="ir.ui.view">
        <field name="name">stock.barcode.lite.sunrise.outbound.order.search</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="arch" type="xml">
            <search string="Sunrise Outbound Orders">
                <field name="vsourcebillcode"/>
                <field name="billno"/>
                <field name="reference"/>
                <field name="load_ref"/>
                <field name="u8c_delivery_method"/>
                <!--                <field name="organic"/>-->
                <field name="date"/>
                <field name="p_date"/>
                <field name="state"/>

                <filter string="Has Whole Pallet Picking" name="has_whole_pallet_picking"
                        domain="[('whole_pallet_picking_id', '!=', False)]"/>
                <filter string="Has Partial Pallet Picking" name="has_partial_pallet_picking"
                        domain="[('partial_pallet_picking_id', '!=', False)]"/>

                <filter string="Pickup" name="u8c_delivery_method_pickup"
                        domain="[('u8c_delivery_method', '=', 'pickup')]"/>
                <filter string="WD Transport" name="u8c_delivery_method_wd"
                        domain="[('u8c_delivery_method', '=', 'wd')]"/>
                <filter string="Organic" name="organic_true" domain="[('organic', '=', True)]"/>
                <filter string="Non-organic" name="organic_false" domain="[('organic', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Active Orders" name="state_not_cancel" domain="[('state', '!=', 'cancel')]"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="U8C Delivery Method" name="group_u8c_delivery_method"
                            context="{'group_by': 'u8c_delivery_method'}"/>
                    <filter string="Organic" name="group_organic" context="{'group_by': 'organic'}"/>
                    <filter string="Planned Date" name="group_p_date" context="{'group_by': 'p_date'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_stock_barcode_lite_sunrise_outbound_order_list_inherit" model="ir.ui.view">
        <field name="name">stock.barcode.lite.sunrise.outbound.order.list.inherit</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="organic"
                       optional="show"
                       column_invisible="not context.get('show_sunrise_fields')"/>
                <field name="vsourcebillcode"
                       optional="show"
                       column_invisible="not context.get('show_sunrise_fields')"/>
                <field name="set_sunrise_outbound_sync"
                       optional="show"
                       column_invisible="not context.get('show_sunrise_fields')"/>
                <field name="set_sunrise_pickup_delivery_sync"
                       optional="show"
                       column_invisible="not context.get('show_sunrise_fields')"/>

            </xpath>
        </field>
    </record>
</odoo>
