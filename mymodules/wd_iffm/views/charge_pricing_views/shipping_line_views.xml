<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wd_iffm_shipping_line_list" model="ir.ui.view">
        <field name="name">wd.iffm.shipping.line.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_wd_iffm_shipping_line_form" model="ir.ui.view">
        <field name="name">wd.iffm.shipping.line.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Shipping Line" duplicate="false">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="is_shipping_line" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wd_iffm_shipping_lines" model="ir.actions.act_window">
        <field name="name">Shipping Lines</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_shipping_line', '=', True)]</field>
        <field name="context">{'default_is_shipping_line': True}</field>
    </record>

    <record id="action_wd_iffm_shipping_lines_list_view" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_wd_iffm_shipping_line_list"/>
        <field name="act_window_id" ref="action_wd_iffm_shipping_lines"/>
    </record>

    <record id="action_wd_iffm_shipping_lines_form_view" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wd_iffm_shipping_line_form"/>
        <field name="act_window_id" ref="action_wd_iffm_shipping_lines"/>
    </record>

<!--    <menuitem id="menu_wd_iffm_shipping_lines" name="Shipping Lines" parent="menu_wd_base_config" action="action_wd_iffm_shipping_lines" sequence="30"/>-->
</odoo>
