<odoo>
    <record id="view_product_template_form_sunrise_code_inherit" model="ir.ui.view">
    <field name="name">product.template.form.sunrise.code.inherit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='categ_id']" position="after">
            <field name="sunrise_category_name" invisible="1"/>
            <field name="sunrise_code" invisible="sunrise_category_name != 'SUNRISE'" required="sunrise_category_name == 'SUNRISE'"/>
        </xpath>
    </field>
</record>
</odoo>