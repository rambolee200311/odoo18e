<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- Actions -->
    <record id="action_bonded_book" model="ir.actions.act_window">
        <field name="name">Bonded Books</field>
        <field name="res_model">bonded.book</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_value_limit" model="ir.actions.act_window">
        <field name="name">Value Limits</field>
        <field name="res_model">bonded.value.limit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_eori_entity" model="ir.actions.act_window">
        <field name="name">EORI Entities</field>
        <field name="res_model">bonded.eori.entity</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_customs_authorization" model="ir.actions.act_window">
        <field name="name">Customs Authorizations</field>
        <field name="res_model">bonded.customs.authorization</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_book_line" model="ir.actions.act_window">
        <field name="name">Bonded Goods Ledger</field>
        <field name="res_model">bonded.book.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_book_line_view_search"/>
    </record>
    <record id="action_bonded_customs_file" model="ir.actions.act_window">
        <field name="name">Customs Declarations</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_bonded_customs_file_t1_in" model="ir.actions.act_window">
        <field name="name">T1 Inbound</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type','=','t1_in')]</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_bonded_customs_file_b3_in" model="ir.actions.act_window">
        <field name="name">B3 Inbound</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type','=','b3_in')]</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_bonded_customs_file_b3_out" model="ir.actions.act_window">
        <field name="name">B3 Outbound</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type','=','b3_out')]</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_bonded_customs_file_t1_out" model="ir.actions.act_window">
        <field name="name">T1 Outbound</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type','=','t1_out')]</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_bonded_mrn_ledger" model="ir.actions.act_window">
        <field name="name">MRN Control Ledger</field>
        <field name="res_model">bonded.customs.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type','in',('t1_in','t1_out'))]</field>
        <field name="search_view_id" ref="bonded_customs_file_view_search"/>
    </record>
    <record id="action_gate_arrival" model="ir.actions.act_window">
        <field name="name">Gate Arrivals</field>
        <field name="res_model">gate.arrival</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_inbound" model="ir.actions.act_window">
        <field name="name">Bonded Inbound</field>
        <field name="res_model">bonded.inbound</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_outbound" model="ir.actions.act_window">
        <field name="name">Bonded Outbound</field>
        <field name="res_model">bonded.outbound</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_stock" model="ir.actions.act_window">
        <field name="name">Bonded Stock</field>
        <field name="res_model">bonded.stock</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bonded_stock_view_search"/>
    </record>
    <record id="action_bonded_verification" model="ir.actions.act_window">
        <field name="name">Verifications</field>
        <field name="res_model">bonded.verification</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">bonded.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_product" model="ir.actions.act_window">
        <field name="name">Bonded Products</field>
        <field name="res_model">bonded.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_monthly_report" model="ir.actions.act_window">
        <field name="name">Monthly Reports</field>
        <field name="res_model">bonded.monthly.report</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_stock_snapshot" model="ir.actions.act_window">
        <field name="name">Daily Snapshots</field>
        <field name="res_model">bonded.stock.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bonded_charge_unit" model="ir.actions.act_window"><field name="name">Charge Units</field><field name="res_model">bonded.charge.unit</field><field name="view_mode">list,form</field></record>
    <record id="action_bonded_charge_item" model="ir.actions.act_window"><field name="name">Charge Items</field><field name="res_model">bonded.charge.item</field><field name="view_mode">list,form</field></record>
    <record id="action_bonded_charge_line" model="ir.actions.act_window"><field name="name">Bonded Charges</field><field name="res_model">bonded.charge.line</field><field name="view_mode">list,form</field></record>

    <!-- Menus -->
