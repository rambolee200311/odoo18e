<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_outbound_confirmation_form" model="ir.ui.view">
        <field name="name">stock.outbound.confirmation.form</field>
        <field name="model">stock.outbound.confirmation</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_add_all_unpackaged_move_lines" string="Add All Unpackaged Move Lines" type="object" class="btn-primary" invisible="state in ('done', 'cancelled') or confirmation_mode == 'package'"/>
                </header>
                <sheet>
                    <group>
                        <field name="picking_line_ids" widget="many2many_tags" readonly="state in ('done', 'cancelled')"/>
                        <field name="confirmation_mode" readonly="state in ('done', 'cancelled')"/>
                        <field name="state" readonly="1"/>
                        <field name="company_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="confirmed_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="confirmed_datetime" readonly="1"/>
                        <field name="available_destination_package_line_ids" invisible="1"/>
                        <field name="available_unpackaged_move_line_ids" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Destination Pallets">
                            <field name="confirmation_lines" readonly="state in ('done', 'cancelled')">
                                <list editable="bottom">
                                    <field name="destination_package_id" domain="[('id', 'in', parent.available_destination_package_line_ids)]" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="move_line_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                    <field name="scanned_by_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="scanned_datetime" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Unpackaged Move Lines">
                            <field name="unpackaged_move_line_ids" widget="many2many_tags" domain="[('id', 'in', available_unpackaged_move_line_ids)]" readonly="state in ('done', 'cancelled')"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
