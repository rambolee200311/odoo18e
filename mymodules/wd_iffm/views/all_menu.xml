<odoo>

    <menuitem id="menu_wd_charge_root" name="Import Freight Forwarder Management" sequence="10"
              web_icon="wd_iffm,static/src/img/img.png" groups="wd_iffm.group_import_user,base.group_system"/>

    <record id="action_wd_iffm_vendor_bill" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['&amp;', ('move_type', '=', 'in_invoice'), '|', ('handover_id', '!=', False), ('clearance_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_wd_invoice_management" name="Invoice Management" parent="menu_wd_charge_root" sequence="50"/>
    <menuitem id="menu_wd_vendor_bill" name="Vendor Bills" parent="menu_wd_invoice_management"
              action="action_wd_iffm_vendor_bill" sequence="10"/>

    <menuitem id="charge_account_menu" name="Charge Management" parent="menu_wd_charge_root" sequence="60"/>

    <menuitem id="charge_item_menu" name="Charge Management" parent="charge_account_menu"
              action="wd_charge_pricing.action_charge_item" sequence="10"/>

    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_charge_receivable_quotation"/>
    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_vendor_cost_quotation"/>
    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_charge_quotation"/>
    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_charge_item"/>
    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_charge_unit"/>
    <delete model="ir.ui.menu" id="wd_charge_pricing.menu_charge_pricing_root"/>

    <menuitem id="menu_wd_charge_quotation" name="Quotations" parent="menu_wd_charge_root" sequence="41"/>
    <menuitem id="menu_wd_charge_receivable_quotation" name="Receivable Quotations" parent="menu_wd_charge_quotation" action="wd_charge_pricing.action_charge_quotation" sequence="10"/>
    <menuitem id="menu_wd_charge_payable_quotation" name="Payable Quotations" parent="menu_wd_charge_quotation" action="wd_charge_pricing.action_vendor_cost_quotation" sequence="20"/>
    <menuitem id="menu_wd_charge_unit" name="Charge Units" parent="charge_account_menu" action="wd_charge_pricing.action_charge_unit" sequence="30"/>


    <record id="action_wd_iffm_expense_account" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_account_list"/>
        <field name="search_view_id" ref="account.view_account_search"/>
        <field name="domain">[('account_category', '=', 'expense')]</field>
    </record>
    <menuitem id="menu_chart_of_accounts_readonly"
              name="Chart of Accounts"
              parent="charge_account_menu"
              action="action_wd_iffm_expense_account"
              sequence="20" groups="base.group_system"/>

</odoo>
