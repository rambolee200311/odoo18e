<odoo>
    <record id="view_stock_picking_tree_customs_status_inherit" model="ir.ui.view">
        <field name="name">stock.picking.list.customs.status.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='picking_type_id']" position="after">
                <field name="customs_status" optional="show" widget="badge"
                       decoration-danger="customs_status in ( 'entrepot')"
                       decoration-info="customs_status in ('vrij')"
                       decoration-warning="customs_status in ('rto', 'ivv', 'accijns')"/>
            </xpath>
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="unique_identifier" optional="show"/>
                <field name="bonded_flag" readonly="1" widget="badge"
                       decoration-danger="bonded_flag in ('true')"
                       decoration-info="bonded_flag in ('false')"/>

            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_inherit_warehouse_filter_picking_type" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.warehouse.filter.picking.type</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field name="bonded_flag" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">bonded_flag == 'true'</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="mrn_id" readonly="1" string="Source Document" invisible="bonded_flag != 'true'"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="mrn_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                <field name="mrn_status" readonly="1"/>
                <field name="customs_status" readonly="1" widget="badge"
                       decoration-danger="customs_status in ('entrepot')"
                       decoration-info="customs_status in ('vrij')"
                       decoration-warning="customs_status in ('rto', 'ivv', 'accijns')"
                />

                <!--                <button name="action_open_mrn_detail" type="object" string="MRN Detail" class="btn-link"-->
                <!--                        icon="fa-external-link" invisible="not mrn_id"/>-->
                <field name="cmr_sign_time"
                       invisible="picking_type_code not in ('outgoing')"
                       readonly="state == 'done'"/>
                <field name="cmr_sign_file"
                       invisible="picking_type_code not in ('outgoing')"
                       readonly="state == 'done'"/>
                <field name="cmr_sign_filename"
                       invisible="picking_type_code not in ('outgoing')"
                       readonly="state == 'done'"/>
                <field name="unique_identifier" readonly="1" invisible="picking_type_code== 'outgoing'"/>
                <field name="file_identifier" readonly="1" invisible="picking_type_code== 'outgoing'"/>
                <field name="bonded_flag" readonly="0" widget="badge"
                       invisible="not inbound_order_id and not outbound_order_id and not mrn_id"
                       decoration-danger="bonded_flag in ('bonded')"
                       decoration-info="bonded_flag in ('non_bonded')" force_save="1"/>
                <field name="manual_bonded_flag"
                       string="Bonded Flag"
                       invisible="inbound_order_id or outbound_order_id or mrn_id"
                       readonly="state in ('done', 'cancel')"/>
                <field name="customs_document_id" options="{'no_create': True}" readonly="1"/>
                <field name="t1_document_number" readonly="1"/>
                <field name="t1_status" readonly="1"/>
                <field name="t1_closed_date" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="bonded_flag" column_invisible="1"/>
                <field name="customs_mutation_type" column_invisible="parent.bonded_flag != 'true'"
                       readonly="state in ('done', 'cancel')"/>
            </xpath>

        </field>
    </record>


    <record id="view_picking_search_identifier_inherit" model="ir.ui.view">
        <field name="name">stock.picking.search.identifier.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='origin']" position="after">
                <field name="unique_identifier"/>
                <field name="bonded_flag" readonly="1" widget="badge"
                       decoration-danger="bonded_flag in ('bonded')"
                       decoration-info="bonded_flag in ('non_bonded')"/>

                <field name="file_identifier"/>
                <field name="customs_status"/>
                <field name="mrn_id"/>
                <field name="mrn_status"/>
                <field name="t1_document_number"/>
                <field name="t1_status"/>
            </xpath>
            <xpath expr="//search/group[@expand='0']" position="before">
                <filter name="has_unique_identifier" string="Has Unique Identifier"
                        domain="[('unique_identifier', '!=', False)]"/>
                <filter name="has_file_identifier" string="Has File Identifier"
                        domain="[('file_identifier', '!=', False)]"/>
            </xpath>

            <xpath expr="//search/filter[@name='delivery']" position="after">
                <filter name="customs_bonded" string="Bonded/Entrepot"
                        domain="[('customs_status', 'in', ['bonded', 'entrepot'])]"/>
                <filter name="customs_non_bonded" string="Vrij/Non-bonded"
                        domain="[('customs_status', 'in', ['vrij', 'non_bonded'])]"/>
                <filter name="customs_rto" string="RTO" domain="[('customs_status', '=', 'rto')]"/>
                <filter name="customs_accijns" string="Accijns" domain="[('customs_status', '=', 'accijns')]"/>
                <filter name="customs_ivv" string="IVV" domain="[('customs_status', 'in', ['ivv'])]"/>
            </xpath>
            <xpath expr="//search/group[@expand='0']" position="inside">
                <filter string="Customs Status" name="group_by_customs_status" domain="[]"
                        context="{'group_by': 'customs_status'}"/>
                <filter string="T1 Status" name="group_by_t1_status" domain="[]" context="{'group_by':'t1_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>