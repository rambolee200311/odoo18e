<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!-- 首页 - 两个菜单块 -->
    <t t-name="stock_barcode_lite.Homepage">
        <div class="o_stock_barcode_lite_homepage">
            <div class="container-fluid py-4">
                <div class="text-center mb-4">
                    <h1 class="display-6">Stock Barcode Lite</h1>
                    <p class="text-muted">Select a workflow to continue</p>
                </div>
                <div class="row justify-content-center g-4">
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_inbound_card" t-on-click="_onInboundClick">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-in me-2"/>Inbound
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Manage inbound orders and product imports.</p>
                                <button class="btn btn-primary mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Inbound
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 shadow-sm o_homepage_card o_outbound_card" t-on-click="_onOutboundClick">
                            <div class="card-header bg-success text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-sign-out me-2"/>Outbound
                                </h3>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="text-muted mb-auto">Manage outbound orders and product exports.</p>
                                <button class="btn btn-success mt-3">
                                    <i class="fa fa-arrow-right me-2"/>Go to Outbound
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- 入库流程页面 -->
    <t t-name="stock_barcode_lite.InboundPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
        />

        <div class="o_sbl_inbound">
            <div class="o_sbl_header">
                <button type="button" class="btn btn-link text-dark p-1" t-on-click="exit" title="Home">
                    <i class="fa fa-arrow-left"/>
                </button>
                <div class="o_sbl_header_title">
                    <i class="fa fa-truck text-primary me-1"/>
                    <t t-if="hasPicking">
                        <t t-esc="pickingLabel"/>
                    </t>
                    <t t-else="">Inbound</t>
                </div>
                <div class="o_sbl_scan_mode" t-attf-class="o_mode_{{ state.nextStep }}">
                    <t t-esc="scanModeLabel"/>
                </div>
            </div>

            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                <t t-esc="state.message"/>
            </div>

            <!-- ═══ 入库单信息卡片 ═══ -->
            <div t-if="hasPicking" class="o_sbl_picking_card">
                <div class="o_sbl_picking_info">
                    <div class="o_picking_row">
                        <span class="o_picking_label">Origin:</span>
                        <span class="o_picking_value"><t t-esc="pickingOrigin"/></span>
                    </div>
                    <div class="o_picking_row">
                        <span class="o_picking_label">Ref:</span>
                        <span class="o_picking_value"><t t-esc="pickingReference"/></span>
                    </div>
                    <div class="o_picking_row">
                        <span class="o_picking_label">Partner:</span>
                        <span class="o_picking_value"><t t-esc="pickingPartner"/></span>
                    </div>
                    <div class="o_picking_row">
                        <span class="o_picking_label">Status:</span>
                        <span class="badge" t-attf-class="{{ getStateBadgeClass(pickingState) }}">
                            <t t-esc="getStateLabel(pickingState)"/>
                        </span>
                    </div>
                </div>
            </div>

            <!-- ═══ 当前货位信息 ═══ -->
            <div t-if="hasLocation" class="o_sbl_location_bar">
                <i class="fa fa-map-marker text-danger me-1"/>
                <span class="me-1">Current Location:</span>
                <strong class="text-primary"><t t-esc="currentLocationName"/></strong>
                <span class="text-muted ms-1" t-if="currentLocationBarcode">(<t t-esc="currentLocationBarcode"/>)</span>
            </div>

            <!-- ═══ 扫描提示步骤条 ═══ -->
            <div class="o_sbl_step_indicator">
                <div class="o_step_item" t-attf-class="{ active: isScanPickingStep, done: hasPicking }">
                    <div class="o_step_circle">
                        <t t-if="hasPicking"><i class="fa fa-check"/></t>
                        <t t-else="">1</t>
                    </div>
                    <div class="o_step_label">Picking</div>
                </div>
                <div class="o_step_line" t-attf-class="{ active: hasPicking }"/>
                <div class="o_step_item" t-attf-class="{ active: isScanLocationStep, done: hasLocation }">
                    <div class="o_step_circle">
                        <t t-if="hasLocation"><i class="fa fa-check"/></t>
                        <t t-else="">2</t>
                    </div>
                    <div class="o_step_label">Location</div>
                </div>
                <div class="o_step_line" t-attf-class="{ active: hasLocation }"/>
                <div class="o_step_item" t-attf-class="{ active: isScanPackageStep }">
                    <div class="o_step_circle">3</div>
                    <div class="o_step_label">Pallet</div>
                </div>
            </div>

            <div class="o_sbl_step_hint">
                <i class="fa fa-qrcode me-2"/>
                <t t-esc="stepHint"/>
            </div>

<!--            <div class="o_sbl_summary row g-2 mb-2">-->
<!--                <t t-foreach="summaryCards || []" t-as="card" t-key="card.key">-->
<!--                    <div class="col-6 col-md-4">-->
<!--                        <div class="card shadow-sm h-100">-->
<!--                            <div class="card-body py-1 px-2">-->
<!--                                <div class="text-muted small"><t t-esc="card.label"/></div>-->
<!--                                <div class="fs-6 fw-bold"><t t-esc="card.value"/></div>-->
<!--                            </div>-->
<!--                        </div>-->
<!--                    </div>-->
<!--                </t>-->
<!--            </div>-->

            <!-- ═══ 进度条 ═══ -->
            <div class="o_sbl_progress" t-if="state.summary &amp;&amp; state.summary.total_move_lines > 0">
                <div class="progress">
                    <div class="progress-bar"
                         t-attf-style="width: {{ progressPercent }}%"
                         t-attf-class="bg-{{ progressPercent === 100 ? 'success' : 'primary' }}"/>
                </div>
            </div>
            <div class="o_sbl_progress_text" t-if="state.summary &amp;&amp; state.summary.total_move_lines > 0">
                <span class="me-2">
                    <i class="fa fa-tasks me-1"/>
                    <t t-esc="progressPercent"/>%
                </span>
                <span class="me-2">
                    <t t-esc="state.summary.updated_move_lines || 0"/> / <t t-esc="state.summary.total_move_lines || 0"/> lines
                </span>
                <span class="ms-auto">
                    <span class="badge" t-attf-class="{{ isAllComplete ? 'bg-success' : 'bg-warning text-dark' }}">
                        <t t-if="isAllComplete">
                            <i class="fa fa-check-circle me-1"/>All Done
                        </t>
                        <t t-else="">
                            <t t-esc="state.summary.pending_pallets || 0"/> pallets pending
                        </t>
                    </span>
                </span>
            </div>

            <div class="o_sbl_pallets">
                <t t-if="palletList.length === 0 &amp;&amp; !state.loading">
                    <div class="o_sbl_empty_state text-center text-muted py-5">
                        <i class="fa fa-inbox fa-4x mb-3 d-block opacity-25"/>
                        <p class="mb-1 fw-bold">No Pallets Loaded</p>
                        <p class="small">
                            <t t-if="isScanPickingStep">Scan an incoming picking barcode to load pallets</t>
                            <t t-else="">Scan pallets to update their locations</t>
                        </p>
                    </div>
                </t>

                <t t-foreach="palletList" t-as="pallet" t-key="pallet.package_id">
                    <div t-attf-class="o_sbl_pallet {{ pallet.is_location_updated ? 'o_pallet_updated' : '' }}">
                        <!-- 托盘头部 - 点击可展开/折叠 -->
                        <div class="o_pallet_header" data-bs-toggle="collapse" t-attf-data-bs-target="#pallet_products_{{ pallet.package_id }}" aria-expanded="false">
                            <!-- 第一行：托盘名称 + 折叠箭头 -->
                            <div class="o_pallet_row1">
                                <div class="o_pallet_info">
                                    <i class="fa fa-cube text-secondary me-2"/>
                                    <strong class="o_pallet_name">
                                        <t t-esc="pallet.package_name || pallet.package_barcode || ('Package ' + pallet.package_id)"/>
                                    </strong>
                                </div>
                                <div class="o_pallet_right">
                                    <i class="fa fa-chevron-down collapse-arrow"/>
                                </div>
                            </div>
                            <!-- 第二行：徽章 + 数量 + 货位 -->
                            <div class="o_pallet_row2">
                                <span class="badge bg-success" t-if="pallet.is_location_updated">
                                    <i class="fa fa-check me-1"/>Updated
                                </span>
                                <span class="o_pallet_product_count">
                                    <t t-esc="(pallet.products || []).length"/> items
                                </span>
                                <span class="o_pallet_location" t-if="pallet.location_name">
                                    <i class="fa fa-map-marker-alt text-muted me-1"/>
                                    <t t-esc="pallet.location_name"/>
                                </span>
                            </div>
                        </div>

                        <!-- 托盘内产品列表 - 默认折叠 -->
                        <div t-attf-id="pallet_products_{{ pallet.package_id }}" class="o_pallet_products collapse">
                            <t t-if="!(pallet.products || []).length">
                                <div class="o_sbl_empty_state text-center text-muted py-4">
                                    <p class="mb-0 small">No products loaded</p>
                                </div>
                            </t>
                            <t t-foreach="pallet.products || []" t-as="item" t-key="item.move_line_id">
                                <div t-attf-class="o_product_subcard {{ pallet.is_location_updated ? 'o_pallet_updated' : '' }}">
                                    <div class="o_product_row_top">
                                        <div class="o_product_icon">
                                            <i class="fa fa-box-open"/>
                                        </div>
                                        <div class="o_product_name">
                                            <t t-esc="item.product_name"/>
                                        </div>
                                        <div class="o_product_qty">
                                            <span class="o_qty_value"><t t-esc="item.qty_done || item.quantity || 0"/></span>
                                            <span class="o_qty_label">/ <t t-esc="item.quantity || 0"/></span>
                                        </div>
                                    </div>
                                    <div class="o_product_row_bottom">
                                        <span t-if="item.default_code" class="o_meta_code"><t t-esc="item.default_code"/></span>
                                        <span t-if="item.product_barcode" class="o_meta_barcode">
                                            <i class="fa fa-barcode me-1"/>
                                            <t t-esc="item.product_barcode"/>
                                        </span>
                                        <span t-if="item.lot" class="o_meta_lot">
                                            <i class="fa fa-tag me-1"/>
                                            <t t-esc="item.lot"/>
                                        </span>
                                        <span t-if="item.dest_location" class="o_product_location">
                                            <i class="fa fa-arrow-right me-1"/>
                                            <t t-esc="item.dest_location"/>
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <div class="o_sbl_footer">
                <button class="btn btn-outline-secondary" t-on-click="resetScan" t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-1"/>Reset
                </button>
                <button class="btn btn-primary flex-fill"
                        style="background-color: #0d6efd; border-color: #0d6efd; color: white; display: block !important; visibility: visible !important;"
                        t-on-click="confirmInbound"
                        t-att-disabled="state.loading">
                    <i class="fa fa-check-circle me-1"/>Confirm Inbound
                </button>
                <button class="btn btn-secondary" t-on-click="exit">
                    <i class="fa fa-home me-1"/>Home
                </button>
            </div>
        </div>
    </t>

    <!-- 出库流程页面 -->
    <t t-name="stock_barcode_lite.OutboundPage">
        <input
            t-ref="barcodeInput"
            type="text"
            class="o_hidden_barcode_input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
        />

        <div class="o_sbl_outbound">
            <div class="o_sbl_header">
                <button type="button" class="btn btn-secondary o_exit_btn me-2" t-on-click="exit" title="Back">
                    <i class="oi oi-chevron-left"/>
                </button>
                <div class="o_sbl_header_title">
                    <span class="fa fa-truck me-1"/>
                    <t t-if="state.order" t-esc="state.order.reference"/>
                    <t t-else="">Outbound</t>
                </div>
                <div class="o_sbl_header_mode" t-attf-class="o_mode_{{ state.scanMode }}">
                    <t t-esc="scanModeLabel"/>
                </div>
            </div>

            <div t-if="state.message" t-attf-class="o_sbl_alert alert alert-{{ state.messageType }}">
                <t t-esc="state.message"/>
            </div>

            <div t-if="stepHint" class="o_sbl_step_hint">
                <t t-esc="stepHint"/>
            </div>

            <!-- ═══ 当前货位信息 ═══ -->
            <div t-if="state.currentLocation" class="o_sbl_location_bar">
                <i class="fa fa-map-marker text-danger me-1"/>
                <span class="me-1">Location:</span>
                <strong class="text-primary"><t t-esc="state.currentLocation.location_barcode"/></strong>
            </div>

            <!-- ═══ 扫描步骤指示器 ═══ -->
            <div t-if="state.order" class="o_sbl_step_indicator">
                <div class="o_step_item" t-attf-class="{ active: state.scanMode === 'step', done: state.scanMode !== 'step' }">
                    <div class="o_step_circle">
                        <t t-if="state.scanMode !== 'step'"><i class="fa fa-check"/></t>
                        <t t-else="">1</t>
                    </div>
                    <div class="o_step_label">Step (P/D)</div>
                </div>
                <div class="o_step_line" t-attf-class="{ active: ['location', 'pallet', 'product', 'qty', 'sn'].includes(state.scanMode) }"/>
                <div class="o_step_item" t-attf-class="{ active: ['location', 'pallet', 'product', 'qty', 'sn'].includes(state.scanMode) &amp;&amp; !state.currentLocation }">
                    <div class="o_step_circle">
                        <t t-if="state.currentLocation"><i class="fa fa-check"/></t>
                        <t t-else="">2</t>
                    </div>
                    <div class="o_step_label">Location</div>
                </div>
                <div class="o_step_line" t-attf-class="{ active: ['pallet', 'product', 'qty', 'sn'].includes(state.scanMode) }"/>
                <div class="o_step_item" t-attf-class="{ active: ['pallet', 'product', 'qty', 'sn'].includes(state.scanMode) }">
                    <div class="o_step_circle">3</div>
                    <div class="o_step_label">Pallet</div>
                </div>
                <div class="o_step_line" t-attf-class="{ active: ['product', 'qty', 'sn'].includes(state.scanMode) }"/>
                <div class="o_step_item" t-attf-class="{ active: ['product', 'qty', 'sn'].includes(state.scanMode) }">
                    <div class="o_step_circle">4</div>
                    <div class="o_step_label">Product</div>
                </div>
            </div>

            <div t-if="state.pallets.length &gt; 0" class="o_sbl_progress">
                <div class="progress-bar"
                     t-attf-style="width: {{ progressPercent }}%"
                     t-attf-class="bg-{{ progressPercent === 100 ? 'success' : 'primary' }}"/>
            </div>
            <div t-if="state.pallets.length &gt; 0" class="o_sbl_progress_text">
                <span><t t-esc="progressPercent"/>%</span>
                <span class="ms-2"><t t-esc="state.totalScanned"/> / <t t-esc="state.totalRequired"/></span>
                <span class="ms-auto badge" t-attf-class="{{ isAllComplete ? 'bg-success' : 'bg-secondary' }}">
                    <t t-if="isAllComplete">All Done</t>
                    <t t-else=""><t t-esc="state.pallets.filter(p => !p.is_complete).length"/> left</t>
                </span>
            </div>

            <div class="o_sbl_pallets">
                <t t-foreach="state.pallets || []" t-as="pallet" t-key="pallet.pallet_no">
                    <div t-attf-class="o_sbl_pallet {{ pallet.is_complete ? 'o_pallet_done' : '' }} {{ state.currentPalletIndex === state.pallets.indexOf(pallet) ? 'o_pallet_active' : '' }}">
                        <div class="o_pallet_header">
                            <div class="o_pallet_info">
                                <span class="fa fa-cube me-1"/>
                                <strong><t t-esc="pallet.pallet_no"/></strong>
                                <span class="badge bg-dark ms-1" t-if="pallet.mode === 'whole'">Whole</span>
                                <span class="badge bg-warning text-dark ms-1" t-if="pallet.mode === 'disassembly'">Disassembly</span>
                                <span class="badge bg-success ms-1" t-if="pallet.is_complete">
                                    <i class="fa fa-check"/> Done
                                </span>
                            </div>
                            <div class="o_pallet_qty">
                                <t t-esc="(pallet.products || []).reduce((s, p) => s + (p.quantity || 0), 0)"/> items
                            </div>
                        </div>
                        <!-- 托盘关联的货位 -->
                        <div class="o_pallet_location" t-if="pallet.location_barcode">
                            <i class="fa fa-map-marker-alt text-muted me-1"/>
                            <span class="small text-muted"><t t-esc="pallet.location_barcode"/></span>
                        </div>

                        <div class="o_pallet_products">
                            <t t-foreach="pallet.products || []" t-as="item" t-key="item.id">
                                <div t-attf-class="o_pallet_product {{ (item.qty_done || 0) &gt;= item.quantity ? 'o_product_done' : '' }} {{ state.currentPalletIndex === state.pallets.indexOf(pallet) &amp;&amp; state.currentItemIndex === pallet.products.indexOf(item) ? 'o_item_active' : '' }}">
                                    <div class="o_product_info">
                                        <div class="o_product_name">
                                            <t t-esc="item.product_name"/>
                                        </div>
                                        <div class="o_product_meta text-muted small">
                                            <span t-if="item.product_code"><t t-esc="item.product_code"/></span>
                                            <span t-if="item.product_barcode"> / <t t-esc="item.product_barcode"/></span>
                                        </div>
                                        <div t-if="item.sn_list &amp;&amp; item.sn_list.length &gt; 0" class="o_sn_list mt-1">
                                            <t t-foreach="item.sn_list || []" t-as="sn" t-key="sn">
                                                <span class="o_sn_tag"><t t-esc="sn"/></span>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="o_product_qty">
                                        <span><t t-esc="item.qty_done || 0"/> / <t t-esc="item.quantity || 0"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <div t-if="!state.order &amp;&amp; !state.loading" class="o_sbl_empty_state">
                <div class="text-center text-muted p-4">
                    <i class="fa fa-inbox fa-3x mb-3"/>
                    <p>No outbound order loaded.</p>
                    <p class="small">Please select an outbound order from the menu.</p>
                </div>
            </div>

            <div class="o_sbl_footer">
                <button t-if="state.order" class="btn btn-secondary" t-on-click="resetScan">
                    <i class="fa fa-refresh me-1"/>Reset
                </button>
                <button t-if="state.order" class="btn btn-success flex-fill" t-on-click="confirmOutbound" t-att-disabled="state.loading">
                    <i class="fa fa-check me-1"/>Confirm Outbound
                </button>
            </div>
        </div>
    </t>
</templates>
