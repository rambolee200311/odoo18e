<odoo>
    <record id="view_outbound_order_form_payable" model="ir.ui.view">
        <field name="name">world.depot.outbound.order.form.payable</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="inherit_id" ref="worlddepot.view_outbound_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='outbound_order_charge_ids']" position="after">
                <separator string="Outbound Payables"/>
                <field name="payable_lines" context="{'default_outbound_order_id': id}" readonly="state == 'cancel'">
                        <list>
                            <field name="vendor_partner_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="vendor_invoice_num" required="1"/>
                            <field name="payable_date"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="payment_state" readonly="1"/>
                            <field name="remark"/>
                        </list>
                        <form string="Outbound Payable" duplicate="false">
                            <header>
                                <button name="action_request_payment" type="object" string="Request Payment" class="btn-primary" invisible="payment_state != 'draft'"/>
                                <button name="action_revoke_payment_request" type="object" string="Revoke Payment Request" invisible="payment_state != 'paying'"/>
                                <field name="payment_state" widget="statusbar" statusbar_visible="draft,paying,paid" readonly="1"/>
                            </header>
                            <sheet>
                                <group>
                                    <field name="outbound_order_id" required="1" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="company_id" required="1" readonly="payment_state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="vendor_invoice_num" required="1" readonly="payment_state != 'draft'"/>
                                    <field name="vendor_partner_id" required="1" readonly="payment_state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="payable_date" required="1" readonly="payment_state != 'draft'"/>
                                    <field name="currency_id" required="1" readonly="payment_state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="expense_account_id" required="1" readonly="payment_state != 'draft'" domain="[('account_type', '=', 'expense')]" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="amount_total" readonly="1"/>
                                    <field name="vendor_invoice_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="vendor_invoice_attachment_ids" widget="many2many_binary" required="1" readonly="payment_state != 'draft'"/>
                                    <field name="bank_proof_attachment_ids" widget="many2many_binary" readonly="1"/>
                                    <field name="apply_user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="apply_datetime" readonly="1"/>
                                    <field name="paid_user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="paid_datetime" readonly="1"/>
                                    <field name="remark" readonly="payment_state != 'draft'"/>
                                </group>
                                <field name="charge_lines" readonly="payment_state != 'draft'">
                                    <list editable="bottom">
                                        <field name="payable_id" column_invisible="1" required="1"/>
                                        <field name="charge_item_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="quantity" required="1"/>
                                        <field name="charge_unit_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="unit_price" required="1"/>
                                        <field name="manual_amount_total"/>
                                        <field name="amount" readonly="1"/>
                                        <field name="currency_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="remark"/>
                                    </list>
                                </field>
                            </sheet>
                        </form>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
