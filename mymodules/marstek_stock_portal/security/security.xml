<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module', '=', 'marstek_stock_portal'), ('name', 'in', ['rule_marstek_stock_quant_portal', 'rule_marstek_stock_move_line_portal', 'rule_marstek_stock_quant_package_portal', 'rule_marstek_inbound_order_portal', 'rule_marstek_inbound_order_product_portal', 'rule_marstek_inbound_order_products_pallet_portal', 'rule_marstek_inbound_order_docs_portal', 'rule_marstek_outbound_order_portal', 'rule_marstek_outbound_order_product_portal', 'rule_marstek_outbound_order_docs_portal', 'rule_marstek_outbound_order_sn_detail_portal', 'rule_marstek_ir_attachment_portal'])]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="rule_marstek_stock_quant_portal" model="ir.rule">
            <field name="name">Marstek Portal Stock Quant Project</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[('package_id', 'in', user.env['stock.move.line'].sudo().search([('state', '=', 'done'), ('picking_id.picking_type_id.code', '=', 'incoming'), ('picking_id.inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids), ('result_package_id', '!=', False)]).mapped('result_package_id').ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_stock_move_line_portal" model="ir.rule">
            <field name="name">Marstek Portal Stock Move Line Project</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="domain_force">['|', '|', ('package_id', 'in', user.env['stock.move.line'].sudo().search([('state', '=', 'done'), ('picking_id.picking_type_id.code', '=', 'incoming'), ('picking_id.inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids), ('result_package_id', '!=', False)]).mapped('result_package_id').ids), ('result_package_id', 'in', user.env['stock.move.line'].sudo().search([('state', '=', 'done'), ('picking_id.picking_type_id.code', '=', 'incoming'), ('picking_id.inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids), ('result_package_id', '!=', False)]).mapped('result_package_id').ids), '&amp;', '&amp;', ('package_id', '=', False), ('result_package_id', '=', False), '|', ('picking_id.inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids), ('picking_id.outbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_stock_quant_package_portal" model="ir.rule">
            <field name="name">Marstek Portal Stock Package Project</field>
            <field name="model_id" ref="stock.model_stock_quant_package"/>
            <field name="domain_force">[('id', 'in', user.env['stock.move.line'].sudo().search([('state', '=', 'done'), ('picking_id.picking_type_id.code', '=', 'incoming'), ('picking_id.inbound_order_id.project', 'in', user.stock_operation_project_line_ids.ids), ('result_package_id', '!=', False)]).mapped('result_package_id').ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_marstek_inbound_order_portal" model="ir.rule">
            <field name="name">Marstek Portal Inbound Project</field>
            <field name="model_id" ref="worlddepot.model_world_depot_inbound_order"/>
            <field name="domain_force">[('project', 'in', user.stock_operation_project_line_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

