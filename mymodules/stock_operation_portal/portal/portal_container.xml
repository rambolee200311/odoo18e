<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Operation Portal Home -->
    <template id="portal_operation_home" name="Stock Operations Home">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-set="page_name" value="'operation_home'"/>
            <div class="o_portal_wrap">
                <div class="container py-5">
                    <div class="mb-3">
                        <a href="/my/home" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left"/> Back to Home
                        </a>
                    </div>
                    <h1 class="mb-4">Stock Order</h1>
                    <div class="row">
                        <!-- Inbound Orders -->
                        <div class="col-12 col-md-6 col-lg-4 mb-4">
                            <a href="/my/operation/inbounds" class="text-decoration-none">
                                <div class="card h-100 o_marstek_card o_stock_operation_card o_stock_operation_card_inbound">
                                    <div class="card-body text-center">
                                        <div class="o_marstek_icon mb-3">
                                            <i class="fa fa-sign-in fa-3x text-primary"/>
                                        </div>
                                        <h4 class="text-black">Inbound Orders</h4>
                                        <p class="text-muted">View and manage inbound orders</p>
                                        <a href="/my/operation/inbounds" class="btn btn-primary">View</a>
                                        <a href="/my/operation/inbounds/create" class="btn btn-outline-primary">Create</a>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Outbound Orders -->
                        <div class="col-12 col-md-6 col-lg-4 mb-4">
                            <a href="/my/operation/outbounds" class="text-decoration-none">
                                <div class="card h-100 o_marstek_card o_stock_operation_card o_stock_operation_card_outbound">
                                    <div class="card-body text-center">
                                        <div class="o_marstek_icon mb-3">
                                            <i class="fa fa-sign-out fa-3x text-success"/>
                                        </div>
                                        <h4 class="text-black">Outbound Orders</h4>
                                        <p class="text-muted">View and manage outbound orders</p>
                                        <a href="/my/operation/outbounds" class="btn btn-success">View</a>
                                        <a href="/my/operation/outbounds/create" class="btn btn-outline-success">Create</a>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Transfer Orders -->
                        <div class="col-12 col-md-6 col-lg-4 mb-4">
                            <a href="/my/operation/transfers" class="text-decoration-none">
                                <div class="card h-100 o_marstek_card o_stock_operation_card o_stock_operation_card_transfer">
                                    <div class="card-body text-center">
                                        <div class="o_marstek_icon mb-3">
                                            <i class="fa fa-exchange fa-3x text-warning"/>
                                        </div>
                                        <h4 class="text-black">Transfer Orders</h4>
                                        <p class="text-muted">View and manage transfer orders</p>
                                        <a href="/my/operation/transfers" class="btn btn-warning">View</a>
                                        <a href="/my/operation/transfers/create" class="btn btn-outline-warning">Create</a>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
