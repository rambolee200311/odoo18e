<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_transport_inquiry_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.inquiry.tree</field>
        <field name="model">tlmp.transport.inquiry</field>
        <field name="arch" type="xml">
            <list string="Inquiries" default_order="id desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_amount" widget="monetary" sum="Total"/>
                <field name="carrier_notes" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="validity_date" optional="show"/>
                <field name="response_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_transport_inquiry_form" model="ir.ui.view">
        <field name="name">tlmp.transport.inquiry.form</field>
        <field name="model">tlmp.transport.inquiry</field>
        <field name="arch" type="xml">
            <form string="Inquiry">
                <header>
                    <button name="action_send" type="object" string="Send to Carrier"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_respond" type="object" string="Record Response"
                            invisible="state != 'sent'"/>
                    <button name="action_accept" type="object" string="Select Carrier"
                            invisible="state != 'responded'" class="btn-primary"/>
                    <button name="action_create_quote" type="object" string="Create Customer Quote"
                            invisible="state != 'accepted'" class="btn-primary"/>
                    <button name="action_close" type="object" string="Close Inquiry"
                            invisible="state not in ('sent', 'responded', 'accepted')"/>
                    <button name="action_reject" type="object" string="Reject Quote"
                            invisible="state != 'responded'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Inquiry Info">
                            <field name="name" readonly="1"/>
                            <field name="request_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="cargo_source_reference" readonly="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="close_reason"/>
                            <field name="selected_carrier_id" options="{'no_create': True}"/>
                            <field name="selected_quote_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="pickup_date"/>
                            <field name="delivery_deadline"/>
                            <field name="validity_date"/>
                        </group>
                    </group>
                    <group invisible="not request_id">
                        <group string="Origin Address">
                            <field name="origin_street" readonly="1"/>
                            <field name="origin_zip" readonly="1"/>
                            <field name="origin_city" readonly="1"/>
                            <field name="origin_state_id" readonly="1" options="{'no_create': True}"/>
                            <field name="origin_country_id" readonly="1" options="{'no_create': True}"/>
                        </group>
                        <group string="Destination Address">
                            <field name="destination_street" readonly="1"/>
                            <field name="destination_zip" readonly="1"/>
                            <field name="destination_city" readonly="1"/>
                            <field name="destination_state_id" readonly="1" options="{'no_create': True}"/>
                            <field name="destination_country_id" readonly="1" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Cargo">
                        <group>
                            <field name="cargo_summary"/>
                            <field name="weight_kg"/>
                            <field name="volume_m3"/>
                        </group>
                        <group>
                            <field name="total_amount" string="Carrier Quote" widget="monetary"/>
                            <field name="carrier_notes"/>
                        </group>
                    </group>
                    <group string="Vehicle Requirement" invisible="not vehicle_requirement_mode">
                        <group>
                            <field name="vehicle_requirement_display" readonly="1"/>
                            <field name="vehicle_requirement_mode" readonly="1"/>
                        </group>
                        <group invisible="vehicle_requirement_mode == 'exempted'">
                            <field name="vehicle_body_type" readonly="1"/>
                            <field name="vehicle_capacity_requirement" readonly="1"/>
                            <field name="is_dangerous_goods" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cargo Lines" name="lines_page">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="quantity"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_page">
                            <group>
                                <field name="carrier_notes"/>
                                <field name="response_date" readonly="1"/>
                                <field name="sent_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tlmp_transport_inquiry_search" model="ir.ui.view">
        <field name="name">tlmp.transport.inquiry.search</field>
        <field name="model">tlmp.transport.inquiry</field>
        <field name="arch" type="xml">
            <search string="Search Inquiries">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Responded" name="responded" domain="[('state', '=', 'responded')]"/>
                <filter string="Accepted" name="accepted" domain="[('state', '=', 'accepted')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Carrier" name="group_carrier" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tlmp_inquiry" model="ir.actions.act_window">
        <field name="name">Inquiries</field>
        <field name="res_model">tlmp.transport.inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tlmp_transport_inquiry_search"/>
    </record>
</odoo>
