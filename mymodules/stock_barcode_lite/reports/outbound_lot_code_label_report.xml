<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_outbound_pallet_label" model="report.paperformat">
        <field name="name">Outbound Pallet Label A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_outbound_lot_code_label" model="ir.actions.report">
        <field name="name">Outbound Picking Products</field>
        <field name="model">world.depot.outbound.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_barcode_lite.report_outbound_lot_code_label</field>
        <field name="report_file">stock_barcode_lite.report_outbound_lot_code_label</field>
        <field name="print_report_name">'Outbound Picking Products - %s' % (object.vsourcebillcode or object.billno or object.reference or object.id)</field>
        <field name="paperformat_id" ref="paperformat_outbound_pallet_label"/>
        <field name="binding_model_id" ref="worlddepot.model_world_depot_outbound_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_outbound_lot_code_label">
        <t t-set="data_report_margin_top" t-value="6"/>
        <t t-set="data_report_header_spacing" t-value="0"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-foreach="sections_by_order.get(o.id, [])" t-as="section">
                    <t t-set="picking" t-value="section['picking']"/>

                    <t t-set="pallet_groups" t-value="section['pallet_groups']"/>
                    <div class="page outbound-picking-page">
                            <style>
                                @page {
                                    margin-top: 10mm !important;
                                    margin-bottom: 7mm;
                                    margin-left: 7mm;
                                    margin-right: 7mm;
                                }

                                html,
                                body,
                                #wrapwrap,
                                main {
                                    margin-top: 0 !important;
                                    padding-top: 0 !important;
                                }

                                .outbound-picking-page {
                                    padding: 5mm 0 0 0;
                                    margin-top: 0;
                                    font-family: Arial, sans-serif;
                                    color: #111827;
                                    font-size: 12px;
                                    page-break-before: always;
                                    box-sizing: border-box;
                                }

                                .outbound-label-header {
                                    page-break-inside: avoid;
                                    break-inside: avoid;
                                    min-height: 38mm;
                                    margin-bottom: 4mm;
                                    border-bottom: 2px solid #111827;
                                }

                                .outbound-header-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                }

                                .outbound-header-main {
                                    vertical-align: top;
                                    padding: 0 4mm 2mm 0;
                                }

                                .outbound-picking-qr-cell {
                                    width: 38mm;
                                    text-align: center;
                                    vertical-align: top;
                                    padding: 0 0 2mm 3mm;
                                    font-size: 9px;
                                    font-weight: bold;
                                    line-height: 1.1;
                                }

                                .outbound-picking-qr-cell img {
                                    width: 30mm !important;
                                    height: 30mm !important;
                                }

                                .outbound-label-title {
                                    font-size: 22px;
                                    font-weight: bold;
                                    margin: 0 0 2px 0;
                                }

                                .outbound-label-subtitle {
                                    font-size: 16px;
                                    font-weight: bold;
                                    margin: 0 0 3mm 0;
                                }

                                .outbound-label-info {
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    font-size: 12px;
                                }

                                .outbound-label-info td {
                                    border: 1px solid #111827;
                                    padding: 2px 5px;
                                    vertical-align: top;
                                }

                                .outbound-label-info .label {
                                    width: 28mm;
                                    font-weight: bold;
                                    white-space: nowrap;
                                }

                                .pallet-section {
                                    margin-bottom: 5mm;
                                    page-break-inside: avoid;
                                    break-inside: avoid;
                                }

                                .pallet-title {
                                    background: #6f797f;
                                    color: #ffffff;
                                    font-weight: bold;
                                    padding: 7px 9px;
                                    border: 1px solid #111827;
                                    border-bottom: 0;
                                }

                                .picking-products-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                }

                                .picking-products-table th,
                                .picking-products-table td {
                                    border: 1px solid #d1d5db;
                                    padding: 7px;
                                    vertical-align: top;
                                }

                                .picking-products-table th {
                                    background: #f3f4f6;
                                    font-weight: bold;
                                    text-align: left;
                                }

                                .picking-products-table .product {
                                    width: 33%;
                                    word-break: break-word;
                                }

                                .picking-products-table .size {
                                    width: 15%;
                                    word-break: break-word;
                                }

                                .picking-products-table .barcode {
                                    width: 16%;
                                    word-break: break-word;
                                }

                                .picking-products-table .spec {
                                    width: 15%;
                                    word-break: break-word;
                                }

                                .picking-products-table .qty {
                                    width: 10%;
                                    text-align: right;
                                    white-space: nowrap;
                                }

                                .picking-products-table .uom {
                                    width: 11%;
                                    white-space: nowrap;
                                }

                                img.keep-no-break {
                                    display: inline-block;
                                    page-break-inside: avoid;
                                    break-inside: avoid;
                                }
                            </style>
                            <div class="outbound-label-header">
                                <table class="outbound-header-table">
                                    <tr>
                                        <td class="outbound-header-main">
                                            <p class="outbound-label-title">World Depot B.V.</p>
                                            <p class="outbound-label-subtitle">Outbound Picking Products</p>
                                            <table class="outbound-label-info">
                                                <tr>
                                                    <td class="label">Bill No:</td>
                                                    <td><span t-field="o.billno"/></td>
                                                    <td class="label">Owner:</td>
                                                    <td><span t-esc="o.owner.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="label">Reference:</td>
                                                    <td><span t-field="o.reference"/></td>
                                                    <td class="label">Picking:</td>
                                                    <td><span t-field="picking.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="label">Source Bill:</td>
                                                    <td><span t-field="o.vsourcebillcode"/></td>
                                                    <td class="label">Mode:</td>
                                                    <td><span t-esc="section['title']"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td class="outbound-picking-qr-cell" t-if="picking">
                                            <div t-field="picking.name"
                                                 t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 260, 'height': 260, 'img_style': 'width:30mm;height:30mm;', 'img_class': 'keep-no-break'}"/>
                                            <div><span t-esc="section['title']"/></div>
                                            <div><span t-field="picking.name"/></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <t t-foreach="pallet_groups" t-as="pallet_group">
                                <div class="pallet-section">
                                    <div class="pallet-title">Pallet No: <span t-esc="pallet_group['pallet_no']"/></div>
                                    <table class="picking-products-table">
                                        <thead>
                                            <tr>
                                                <th class="product">Product Name</th>
                                                <th class="size">Size</th>
                                                <th class="barcode">Barcode</th>
                                                <th class="spec">Specification</th>
                                                <th class="qty">Quantity</th>
                                                <th class="uom">Unit</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="pallet_group['lines']" t-as="line">
                                                <tr>
                                                    <td class="product"><span t-field="line.product_id.display_name"/></td>
                                                    <td class="size"><span t-esc="', '.join(line.product_id.product_template_attribute_value_ids.mapped('name')) or line.box_type or ''"/></td>
                                                    <td class="barcode"><span t-esc="line.product_id.barcode or ''"/></td>
                                                    <td class="spec">
                                                        <span t-esc="line.box_in_qty or ''"/>
                                                        <span t-esc="line.u8_aux_uom_name or ''"/>
                                                    </td>
                                                    <td class="qty"><span t-field="line.quantity"/></td>
                                                    <td class="uom"><span t-esc="line.castunitid or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
