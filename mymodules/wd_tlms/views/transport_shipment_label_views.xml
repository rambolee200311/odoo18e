<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_shipment_label_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.shipment.label.tree</field>
        <field name="model">tlmp.transport.shipment.label</field>
        <field name="arch" type="xml">
            <list string="Shipment Labels" default_order="id desc">
                <field name="name"/>
                <field name="order_id"/>
                <field name="carrier_service_id" optional="show"/>
                <field name="tracking_number"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('draft','generated')"
                       decoration-success="state == 'printed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_shipment_label_form" model="ir.ui.view">
        <field name="name">tlmp.transport.shipment.label.form</field>
        <field name="model">tlmp.transport.shipment.label</field>
        <field name="arch" type="xml">
            <form string="Shipment Label">
                <header>
                    <button name="action_generate" type="object" string="Generate"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print"
                            invisible="state not in ('generated','printed')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled','printed')"
                            confirm="Are you sure?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,printed"
                           clickable="False"/>
                </header>
                <sheet>
                    <group>
                        <group string="Label Info">
                            <field name="name" readonly="1"/>
                            <field name="order_id" options="{'no_create': True}"/>
                            <field name="carrier_service_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Tracking">
                            <field name="tracking_number"/>
                            <field name="carrier_tracking_url" placeholder="https://..."/>
                            <field name="label_pdf" widget="binary"
                                   filename="name"
                                   help="Upload carrier label PDF"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tlmp_shipment_label" model="ir.actions.act_window">
        <field name="name">Shipment Labels</field>
        <field name="res_model">tlmp.transport.shipment.label</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
