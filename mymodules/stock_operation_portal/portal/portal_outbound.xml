<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 出库订单列表 -->
    <template id="portal_operation_outbounds" name="Outbound Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/operation', 'name': 'Stock Operation'}, {'url': None, 'name': 'Outbound Orders'}]"/>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="stock_operation_portal.portal_breadcrumbs_slash"/>
            <t t-set="page_name" value="'operation_outbounds'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2>Outbound Orders</h2>
                        <a href="/my/operation/outbounds/create" class="btn btn-success">
                            <i class="fa fa-plus"/> Create Outbound Order
                        </a>
                    </div>
                    
                    <!-- 检索条件 -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <form method="get" class="row g-3">
                                <div class="col-md-2">
                                    <input type="text" name="reference" class="form-control" 
                                           placeholder="Reference" t-att-value="filters.get('reference', '')"/>
                                </div>
                                <div class="col-md-2">
                                    <input type="text" name="bl_no" class="form-control" 
                                           placeholder="B/L No" t-att-value="filters.get('bl_no', '')"/>
                                </div>
                                <div class="col-md-2">
                                    <input type="text" name="container_no" class="form-control" 
                                           placeholder="Container No" t-att-value="filters.get('container_no', '')"/>
                                </div>
                                <div class="col-md-2">
                                    <select name="state" class="form-control">
                                        <option value="">All Status</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-success">Search</button>
                                    <a href="/my/operation/outbounds" class="btn btn-secondary">Reset</a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- 检索结果-表格 -->
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>B/L No</th>
                                    <th>Container No</th>
                                    <th>Expected Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td><span t-esc="row.get('reference', '-')"/></td>
                                    <td><span t-esc="row.get('bl_no', '-')"/></td>
                                    <td><span t-esc="row.get('container_no', '-')"/></td>
                                    <td><span t-esc="row.get('expected_date', '-')"/></td>
                                    <td><span t-esc="row.get('state', '-')"/></td>
                                    <td>
                                        <a t-attf-href="/my/operation/outbounds/{{ row.get('id') }}" 
                                           class="btn btn-sm btn-info">View</a>
                                    </td>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="6" class="text-center text-muted">No records found</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 出库订单详情 -->
    <template id="portal_operation_outbound_detail" name="Outbound Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/operation', 'name': 'Stock Operation'}, {'url': '/my/operation/outbounds', 'name': 'Outbound Orders'}, {'url': None, 'name': 'Outbound Detail'}]"/>
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="stock_operation_portal.portal_breadcrumbs_slash"/>
            <t t-set="page_name" value="'operation_outbound_detail'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    
                    <h2>Outbound Order Detail</h2>
                    <div class="alert alert-info">Order details will be displayed here</div>
                </div>
            </div>
        </t>
    </template>

    <!-- 出库订单创建-表单 -->
    <template id="portal_operation_outbound_form" name="Create Outbound Order">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[{'url': '/my/home', 'name': 'Home'}, {'url': '/my/operation', 'name': 'Stock Operation'}, {'url': '/my/operation/outbounds', 'name': 'Outbound Orders'}, {'url': None, 'name': 'Create Outbound Order'}]"/>
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="stock_operation_portal.portal_breadcrumbs_slash"/>
            <t t-set="page_name" value="'operation_outbound_create'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    
                    <h2>Create Outbound Order</h2>
                    <div class="alert alert-info">Form will be available soon</div>
                </div>
            </div>
        </t>
    </template>
</odoo>
