<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_wd_cloud_storage_admin" model="res.groups">
            <field name="name">Cloud Storage Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>
        <record id="rule_s3_node_user" model="ir.rule">
            <field name="name">s3.node user access</field>
            <field name="model_id" ref="model_s3_node"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id),
                                        ('node_type_id.code', 'in', ('root', 'public', 'temp', 'recycle_root')),
                                        '&amp;', ('node_type_id.code', '=', 'recycle_bin'),
                                        ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_s3_node_admin" model="ir.rule">
            <field name="name">s3.node admin access</field>
            <field name="model_id" ref="model_s3_node"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>

        <record id="rule_s3_stored_file_user" model="ir.rule">
            <field name="name">s3.stored.file user access</field>
            <field name="model_id" ref="model_s3_stored_file"/>
            <field name="domain_force">['|',
                                        ('node_id.user_id', '=', user.id),
                                        ('node_id.node_type_id.code', '=', 'public')
                                        ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_s3_stored_file_admin" model="ir.rule">
            <field name="name">s3.stored.file admin access</field>
            <field name="model_id" ref="model_s3_stored_file"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>

        <record id="rule_s3_recycle_entry_user" model="ir.rule">
            <field name="name">s3.recycle.entry user access</field>
            <field name="model_id" ref="model_s3_recycle_entry"/>
            <field name="domain_force">[('deleted_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_s3_recycle_entry_admin" model="ir.rule">
            <field name="name">s3.recycle.entry admin access</field>
            <field name="model_id" ref="model_s3_recycle_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>

        <record id="rule_s3_operation_log_admin" model="ir.rule">
            <field name="name">s3.operation.log admin access</field>
            <field name="model_id" ref="model_s3_operation_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>

        <record id="rule_s3_permission_user" model="ir.rule">
            <field name="name">s3.permission user read access</field>
            <field name="model_id" ref="model_s3_permission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_s3_permission_admin" model="ir.rule">
            <field name="name">s3.permission admin access</field>
            <field name="model_id" ref="model_s3_permission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('wd_cloud_storage.group_wd_cloud_storage_admin'))]"/>
        </record>
    </data>
</odoo>